<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_mask"
    android:background="@color/hd_mask"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/sheet_panel"
        android:background="@drawable/bg_hd_sheet"
        android:paddingBottom="12dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_hd_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/hd_text"
            android:gravity="center"
            android:id="@+id/sheet_title"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hd_sheet_title"/>
        <View
            android:background="@color/hd_border"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sheet_switch"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/hd_text"
                android:id="@+id/sheet_switch_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hd_sheet_switch"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/hd_text_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"/>
        </LinearLayout>
        <View
            android:background="@color/hd_border"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hd_text"
            android:id="@+id/sheet_current"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/hd_border"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hd_red"
            android:id="@+id/sheet_exit"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hd_sheet_exit"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hd_text_2"
            android:gravity="center"
            android:id="@+id/sheet_cancel"
            android:background="@drawable/bg_hd_sheet_cancel"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hd_sheet_cancel"/>
    </LinearLayout>
</FrameLayout>
