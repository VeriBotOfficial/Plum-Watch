<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_step_line"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_10"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fl_step_dot"
            android:background="@drawable/shape_dial_promo_num_circle"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20">
            <TextView
                android:textSize="@dimen/sp_9"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tv_step_num"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_step_check"
                android:visibility="gone"
                android:layout_width="@dimen/dp_11"
                android:layout_height="@dimen/dp_11"
                android:src="@drawable/ic_dial_promo_check"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/sp_7"
            android:textColor="@color/color_888888"
            android:id="@+id/tv_step_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1"/>
    </LinearLayout>
</LinearLayout>
