<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/status_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/status_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:layout_marginVertical="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_layout">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_back"
            android:padding="14dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back_black"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_37"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_menu"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_ja_voice"
            android:paddingHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/string_one_trans"
            app:layout_constraintEnd_toStartOf="@+id/iv_menu"
            app:layout_constraintStart_toEndOf="@+id/iv_back"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/lan_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_swap"
                        android:padding="@dimen/dp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_tran_swap"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="marquee"
                        android:gravity="center"
                        android:id="@+id/tv_before_lan"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="简体中文"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_7"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:drawableEnd="@drawable/ic_jiantou_bottom"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        app:layout_constraintEnd_toStartOf="@+id/iv_swap"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="marquee"
                        android:gravity="center"
                        android:id="@+id/tv_after_lan"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="英文"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_7"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:drawableEnd="@drawable/ic_jiantou_bottom"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_swap"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/color_ff7300"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:alpha="0.4"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    app:layout_constraintTop_toBottomOf="@+id/lan_layout"/>
                <EditText
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_9a9a9a"
                    android:textColorHint="@color/color_6A6A6A"
                    android:gravity="start"
                    android:id="@+id/tv_one_trans_content"
                    android:background="@null"
                    android:paddingTop="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="@dimen/dp_200"
                    android:minHeight="@dimen/dp_140"
                    android:hint="@string/string_one_trans_tip"
                    android:paddingHorizontal="@dimen/dp_12"
                    app:layout_constraintBottom_toTopOf="@+id/operation_layout"
                    app:layout_constraintTop_toBottomOf="@+id/lan_layout"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/operation_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_60"
                    android:paddingHorizontal="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/shape_ff7300_stroke_s20"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_36"
                        android:paddingHorizontal="@dimen/dp_15"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_ff7300"
                            android:ellipsize="end"
                            android:id="@+id/tv_voice_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp_80"
                            android:text="男声"
                            android:maxLines="1"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_jiantou_bottom"
                            android:tint="@color/color_ff7300"
                            android:layout_marginStart="@dimen/dp_4"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_down_speak"
                        android:background="@drawable/shape_one_trans_btn"
                        android:visibility="visible"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_36"
                        android:text="@string/sound_tran_btn"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/dp_5"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_trans"
                        android:background="@drawable/shape_one_trans_btn"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_36"
                        android:text="@string/language_translate"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_down_speak"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.wakeup.commonui.view.AiEnergyExpendView
                        android:id="@+id/aee_ts1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="-10dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_trans"
                        app:layout_constraintEnd_toEndOf="@+id/tv_trans"/>
                    <com.wakeup.commonui.view.AiEnergyExpendView
                        android:id="@+id/aee_ts2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="-10dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_down_speak"
                        app:layout_constraintEnd_toEndOf="@+id/tv_down_speak"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_up_speak"
                        android:background="@drawable/shape_record_btn"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_36"
                        android:text="@string/ai_robot_btn_6"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/input_speak_tips_view"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_110"
                    android:layout_height="@dimen/dp_46"
                    app:layout_constraintBottom_toTopOf="@+id/operation_layout"
                    app:layout_constraintEnd_toEndOf="parent">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/speak_tip_layout"
                        android:background="@drawable/shape_ff7300_r12"
                        android:padding="@dimen/dp_10"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        app:layout_constraintBottom_toTopOf="@+id/iv_speak_triangle"
                        app:layout_constraintEnd_toEndOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/white"
                            android:id="@+id/tv_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/iv_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/chat_translate_load"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_speak_triangle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_triangle_nor"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/speak_tip_layout"
                        app:layout_constraintStart_toStartOf="@+id/speak_tip_layout"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/trans_switch_layout"
                android:background="@drawable/shape_white_r8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/language_translate"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/trans_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Switch
                    android:id="@+id/trans_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/device_notify_switch_thumb"
                    android:track="@drawable/device_notify_switch_track"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mutual_trans_layout"
                android:background="@drawable/shape_white_r8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/string_mutual_trans"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/mutual_trans_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Switch
                    android:id="@+id/mutual_trans_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/device_notify_switch_thumb"
                    android:track="@drawable/device_notify_switch_track"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/display_trans_switch_layout"
                android:background="@drawable/shape_white_r8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/string_only_display_trans"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/display_trans_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Switch
                    android:id="@+id/display_trans_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/device_notify_switch_thumb"
                    android:track="@drawable/device_notify_switch_track"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/window_switch_layout"
                android:background="@drawable/shape_white_r8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/string_display_window"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/window_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Switch
                    android:id="@+id/window_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/device_notify_switch_thumb"
                    android:track="@drawable/device_notify_switch_track"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
