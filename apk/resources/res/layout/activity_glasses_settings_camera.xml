<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/glasses_s_multi_media"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_video"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_video"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/glasses_s_video_l"
            android:layout_marginStart="8dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:id="@+id/tv_video_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrowgrey_right"
            android:layout_marginEnd="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_audio"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_audio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/glasses_s_audio_l"
            android:layout_marginStart="8dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:id="@+id/tv_audio_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrowgrey_right"
            android:layout_marginEnd="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_direction"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_direction"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/glasses_video_direction"
            android:layout_marginStart="8dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:id="@+id/tv_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrowgrey_right"
            android:layout_marginEnd="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_auto_store"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_auto_store"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="14dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_auto_save"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/glasses_auto_save_tip"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <Switch
            android:id="@+id/switch_auto_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/device_notify_switch_thumb"
            android:track="@drawable/device_notify_switch_track"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
