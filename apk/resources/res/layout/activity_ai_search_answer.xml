<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bk_search_history"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_75"
        android:layout_marginStart="@dimen/dp_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_ai_search_history_result"
            android:visibility="visible"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_ai_search_history_result"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/color_0D0D12"
            android:id="@+id/tv_ai_search_result_title"
            android:background="@drawable/shape_ai_search_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="写一份关于艺术品欣赏的分析报告"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_stop_answer_title"
        android:background="@drawable/shape_a6ffffff_r8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:animateLayoutChanges="true"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_7"
        app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_title">
        <androidx.appcompat.widget.AppCompatTextView
            android:background="@drawable/ic_fanshi_ai"
            android:layout_width="@dimen/dp_78"
            android:layout_height="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_5"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ai_search_stopped_generating_answer"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_ai_search_result_progress"
        android:background="@drawable/shape_a6ffffff_r14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:animateLayoutChanges="true"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:layout_marginBottom="@dimen/dp_11">
                <ImageView
                    android:background="@drawable/ic_fanshi_ai"
                    android:layout_width="@dimen/dp_78"
                    android:layout_height="@dimen/dp_16"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_search_result_analysis"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_6">
                <ImageView
                    android:id="@+id/iv_search_result_analysis_icon"
                    android:background="@drawable/ic_ai_search_result_success"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_search_result_analysis_icon"
                    android:padding="@dimen/dp_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/json_ai_search_result_process"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_search_result_analysis_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_search_question_analyzing_status"
                    android:layout_marginStart="@dimen/dp_2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_search_result_arrange"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_6">
                <ImageView
                    android:id="@+id/iv_search_result_arrange_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_ai_search_result_success"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_search_result_arrange_icon"
                    android:padding="@dimen/dp_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/json_ai_search_result_process"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_search_result_arrange_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在整理答案"
                    android:layout_marginStart="@dimen/dp_2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_ai_search_expand_scope"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12">
                <com.airbnb.lottie.LottieAnimationView
                    android:padding="@dimen/dp_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/json_ai_search_result_process"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_search_result_stop_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_search_scope_expansion_message"
                    android:layout_marginStart="@dimen/dp_2"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/clear_all"
            android:background="@drawable/ai_search_result_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_148"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginEnd="@dimen/dp_13"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_weight="1"
        android:animateLayoutChanges="true">
        <com.wakeup.feature.search.view.CustomScrollView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_ai_search_result"
                android:background="@drawable/shape_ffffff_r14"
                android:padding="@dimen/dp_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:layout_marginHorizontal="@dimen/dp_8">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_ai_search_result_source"
                    android:background="@drawable/shape_f4f6f8_r8"
                    android:paddingTop="8dp"
                    android:paddingBottom="@dimen/dp_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp_8"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_ai_search_result_source_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:background="@drawable/ic_fanshi_ai"
                            android:layout_width="@dimen/dp_78"
                            android:layout_height="@dimen/dp_16"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_333333"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_ai_search_source_num"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:gravity="center_vertical"
                            android:id="@+id/tv_ai_search_show_source_btn"
                            android:background="@drawable/ic_history_particular_more_content"
                            android:layout_width="@dimen/dp_16"
                            android:layout_height="@dimen/dp_16"
                            android:layout_marginEnd="@dimen/dp_8"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView_source"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginBottom="@dimen/dp_4"
                        android:overScrollMode="always"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_ai_search_result_item_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:lineSpacingExtra="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_ai_search_result_item_title"/>
                <LinearLayout
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/ll_ai_search_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_item_content">
                    <com.airbnb.lottie.LottieAnimationView
                        android:padding="@dimen/dp_2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_35"
                        android:layout_marginStart="-25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/ai_search_answer_loading"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_ai_search_success"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_item_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_999999"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_generated_content_model_source_warning"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_tv_ai_search_result_item_content_btn"
                        android:background="@drawable/shape_f4f6f8_r8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_8"
                        android:paddingVertical="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:background="@drawable/ic_copy_history_particular_content"
                            android:layout_width="@dimen/dp_16"
                            android:layout_height="@dimen/dp_16"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/black"
                            android:id="@+id/tv_search_result_copy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_search_copy_text"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.wakeup.feature.search.view.CustomScrollView>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_ai_search_stop_btn"
            android:background="@drawable/shape_ff000000_r24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_9">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_stop_ai_search"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_search_stop_generating_answer"
                android:layout_marginStart="@dimen/dp_8"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_history_particular_search"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_ai_search_result_back"
            android:background="@drawable/ic_history_particular_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_12"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/shape_ffffff_r999_stroke_box2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/sp_14"
                android:gravity="center_vertical"
                android:id="@+id/et_ai_search_edit_text"
                android:background="@null"
                android:paddingBottom="@dimen/dp_25"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_75"
                android:hint="@string/ai_search_text"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionSearch"
                android:layout_marginStart="@dimen/dp_19"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_clear_text"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_ai_search_clear_text"
                android:layout_marginEnd="@dimen/dp_15"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_ai_search_speech_to_text"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
