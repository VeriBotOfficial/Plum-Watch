<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuTextColor="@color/color_4D4D4D"
        app:menuTextSize="16dp"
        app:titleText="@string/publish_video_title"/>
    <RelativeLayout
        android:id="@+id/rlTop"
        android:background="@drawable/shape_white_r12"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="214dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_below="@+id/titleBar">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:textColorHint="@color/color_999999"
            android:gravity="left"
            android:id="@+id/etContent"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:layout_margin="12dp"
            android:hint="@string/publish_video_content_hint"
            android:maxLines="7"
            android:layout_toLeftOf="@+id/rlVideo"
            android:layout_alignParentLeft="true"/>
        <RelativeLayout
            android:id="@+id/rlVideo"
            android:layout_width="wrap_content"
            android:layout_height="185dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true">
            <VideoView
                android:id="@+id/videoView"
                android:visibility="visible"
                android:layout_width="123dp"
                android:layout_height="185dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCoverBg"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="123dp"
                android:layout_height="185dp"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivCover"
                android:visibility="gone"
                android:layout_width="123dp"
                android:layout_height="185dp"
                android:scaleType="fitXY"
                app:shapeAppearance="@style/chamfer8dp"/>
            <Button
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/btnChangeCover"
                android:background="@drawable/shape_ccffffff_r4"
                android:layout_width="103dp"
                android:layout_height="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/publish_video_change_cover"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"/>
        </RelativeLayout>
    </RelativeLayout>
    <include
        android:id="@+id/videoSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_below="@+id/rlTop"
        layout="@layout/video_publish_settings"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnPublishVideo"
        android:layout_centerHorizontal="true">
        <CheckBox
            android:id="@+id/cbProtocal"
            android:background="@drawable/checkbox_style_new_ui"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="4dp"
            android:button="@null"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_333333"
            android:id="@+id/tvProtocal"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/real_name_authentication_i_agree_action"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Button
        android:enabled="false"
        android:textColor="@color/white"
        android:id="@+id/btnPublishVideo"
        android:background="@drawable/select_btn_switch_ffd9b9_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/publish_video_title"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
