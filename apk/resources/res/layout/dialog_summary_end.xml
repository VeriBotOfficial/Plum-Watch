<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/dialog_summary_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jacket_m_summarizing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/m_summary_bk"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:layout_marginTop="@dimen/dp_35"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_summary_content"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/meet_record_summary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/dialog_summary_cancel"
        android:background="@drawable/shape_e3e3e3_r999"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_47"
        android:text="@string/btn_cancel"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_summary_bk"/>
</androidx.constraintlayout.widget.ConstraintLayout>
