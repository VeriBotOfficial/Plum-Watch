<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="30dp">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:padding="5dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:src="@mipmap/icon_healthwarning_becomevip_close"
        android:layout_marginEnd="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_jb_ffecd2_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textColor="#ff483110"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tip_21_0723_02"
                android:layout_marginStart="24dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ff483110"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="43dp"
                android:text="@string/tip_21_0723_03"
                android:layout_marginStart="24dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:numColumns="4"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff483110"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_openVip"
            android:background="@drawable/shape_bg_healthwarning_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="25dp"
            android:text="@string/tip_21_0522_16"/>
    </LinearLayout>
</LinearLayout>
