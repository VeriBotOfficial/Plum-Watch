<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/aim_bg_home_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp"
    android:clipToOutline="true">
    <com.wakeup.feature.aimusic.widget.SquareFrameLayout
        android:id="@+id/coverBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/coverPlaceholder"
            android:background="@drawable/aim_grad_run"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ivCover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/ivPlay"
            android:background="@drawable/aim_bg_play_overlay"
            android:padding="7dp"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="8dp"
            android:src="@drawable/aim_ic_play"
            android:contentDescription="@string/aim_play"/>
    </com.wakeup.feature.aimusic.widget.SquareFrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/titleRow"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingStart="9dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:ellipsize="end"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivSubscribe"
            android:background="@drawable/aim_bg_subscribe_circle"
            android:padding="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/aim_ic_plus"/>
    </LinearLayout>
</LinearLayout>
