<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/shape_comment_choose_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_comment_choose_bar_bg"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_12"/>
    <LinearLayout
        android:textColor="@color/color_333333"
        android:orientation="horizontal"
        android:id="@+id/lv_speed_container"
        android:background="@drawable/shape_comment_choose_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:drawablePadding="@dimen/dp_12"
        android:drawableStart="@drawable/ic_comment_anwser"
        android:paddingStart="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_8">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_ratio_text"
            android:drawablePadding="@dimen/dp_12"
            android:layout_weight="1.5"
            android:drawableStart="@drawable/ic_speed_choose"
            android:paddingVertical="@dimen/dp_17"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_speed_1"
            android:tag="0.75"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/video_ratio_0_75x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_FF3030"
            android:gravity="center"
            android:id="@+id/tv_speed_2"
            android:tag="1.0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/video_ratio_1_0x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_speed_3"
            android:tag="1.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/video_ratio_1_5x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_speed_4"
            android:tag="2.0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/video_ratio_2_0x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_speed_5"
            android:tag="3.0"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/video_ratio_3_0x"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_not_interesting"
        android:background="@drawable/shape_comment_choose_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/content_not_interesting"
        android:drawablePadding="@dimen/dp_12"
        android:drawableStart="@drawable/ic_uninterested"
        android:paddingStart="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_17"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_report"
        android:background="@drawable/shape_comment_choose_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/dialog_long_press_report"
        android:drawablePadding="@dimen/dp_12"
        android:drawableStart="@drawable/ic_comment_mark"
        android:drawableEnd="@drawable/ic_comment_report_arrow"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_17"/>
</LinearLayout>
