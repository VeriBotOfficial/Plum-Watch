<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llAlipay"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="15dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_alipay"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="支付宝支付"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_jiantou_right"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llWeChat"
            android:background="@drawable/bg_shape_stroke_bottom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="15dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_wechatpay"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="微信支付"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_jiantou_right"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llPaypal"
            android:background="@drawable/bg_shape_stroke_bottom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="15dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_paypal"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PayPal"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_jiantou_right"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/dialog_quxiao"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
