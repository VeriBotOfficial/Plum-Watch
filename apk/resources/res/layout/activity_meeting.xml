<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ic_sound_home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/my_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/jacket_m_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/m_record_layout"
        android:background="@drawable/shape_btn_ffd496"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/m_meet_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_title_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_meet_record"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:gravity="end|center_vertical"
            android:background="@drawable/ic_meet_btn"
            android:layout_width="94dp"
            android:layout_height="wrap_content"
            android:minHeight="35dp"
            android:text="@string/jacket_m_record"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:paddingVertical="4dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.wakeup.commonui.view.AiEnergyExpendView
        android:id="@+id/aee_meeting"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/m_record_layout"
        app:layout_constraintTop_toTopOf="@+id/m_record_layout"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/m_meet_layout"
        android:background="@drawable/shape_btn_ffd496"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/m_record_layout"
        app:layout_constraintTop_toBottomOf="@+id/my_title_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_meet_summary"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:background="@drawable/ic_meet_btn"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:minHeight="35dp"
            android:text="@string/jacket_m_l_summary"
            android:layout_marginStart="8dp"
            android:paddingVertical="4dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.wakeup.commonui.view.AiEnergyExpendView
        android:id="@+id/aee_local_file"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/m_meet_layout"
        app:layout_constraintTop_toTopOf="@+id/m_meet_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/m_meet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/jacket_m_file"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_record_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_4F4E4D"
        android:id="@+id/m_meet_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/m_meet_title"
        app:layout_constraintEnd_toStartOf="@+id/m_meet_more_ic"
        app:layout_constraintTop_toTopOf="@+id/m_meet_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_meet_more_ic"
        android:clickable="false"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_more_arrow"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/m_meet_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/m_meet_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/m_meet_empty"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/m_meet_title">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="58dp"
            android:layout_height="69dp"
            android:src="@drawable/icon_meet_empty"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_817F7D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/jacket_m_create"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/m_meet_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_meet_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
