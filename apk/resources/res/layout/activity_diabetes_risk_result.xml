<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/diabetes_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/title_bar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/diabetes_result_title"/>
        <ProgressBar
            android:id="@+id/progress_stream"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/scroll_result"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_thinking"
                    android:background="@drawable/shape_diabetes_thinking_bg"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/diabetes_text_hint"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_thinking_title"/>
                    <com.wakeup.feature.health.bloodGlucose.diabetes.DiabetesMaxHeightScrollView
                        android:id="@+id/scroll_thinking"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fadeScrollbars="false"
                        android:overScrollMode="ifContentScrolls"
                        android:nestedScrollingEnabled="true">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/diabetes_thinking_text"
                            android:id="@+id/tv_thinking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true"/>
                    </com.wakeup.feature.health.bloodGlucose.diabetes.DiabetesMaxHeightScrollView>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:id="@+id/tv_result"
                    android:background="@drawable/shape_white_r12"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="false"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_bottom_bar"
            android:background="@color/white"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/tv_health_advice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/diabetes_health_advice_title"/>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:id="@+id/chip_glucose"
                        android:background="@drawable/shape_diabetes_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_chip_glucose"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:id="@+id/chip_exercise"
                        android:background="@drawable/shape_diabetes_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_chip_exercise"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:id="@+id/chip_diet"
                        android:background="@drawable/shape_diabetes_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_chip_diet"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>
                </LinearLayout>
            </HorizontalScrollView>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/diabetes_purple_primary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_free_tag"
                android:background="@color/diabetes_purple_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/diabetes_ask_ai_free_tag"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_ask_ai"
                android:background="@drawable/shape_diabetes_entry_ai_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/diabetes_ask_ai"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_unlock_overlay"
        android:background="#99f5f5f5"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/shape_diabetes_ai_card"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp">
            <TextView
                android:textSize="32sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="��"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/diabetes_unlock_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/diabetes_accent_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/diabetes_unlock_benefit_1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/diabetes_accent_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/diabetes_unlock_benefit_2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/diabetes_accent_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/diabetes_unlock_benefit_3"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_unlock_overlay"
                android:background="@drawable/shape_diabetes_btn_unlock"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/diabetes_unlock_now"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
