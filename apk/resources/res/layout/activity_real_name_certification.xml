<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/ic_real_name_cert_background"
        android:layout_width="match_parent"
        android:layout_height="525dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.MyTitleBar
        android:textColor="@color/color_333333"
        android:id="@+id/real_name_certification_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_editor_absoluteX="@dimen/dp_0"
        app:titleText="@string/real_name_authentication_process"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ly_flow_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/real_name_certification_title_bar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-15dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/shape_ff7300_r16"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_34"
                android:text="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/real_name_authentication_fill_identity_info_step"/>
        </LinearLayout>
        <View
            android:background="@drawable/shape_dotted_line"
            android:layout_width="@dimen/dp_119"
            android:layout_height="5dp"
            android:layout_marginBottom="@dimen/dp_10"
            android:layerType="software"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-15dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/shape_f2caa9_r16"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_34"
                android:text="2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/real_name_authentication_upload_id_card_image_action"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_ffffff_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_flow_chart">
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_6"
                    android:text="@string/real_name_authentication_use_valid_id_info_request"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_ff0000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* "/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_name_text"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/sp_14"
                    android:gravity="center_vertical"
                    android:id="@+id/et_cert_name"
                    android:background="@drawable/shape_f4f4f4_r8"
                    android:padding="@dimen/dp_14"
                    android:paddingLeft="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="@string/real_name_authentication_enter_real_name_request"
                    android:singleLine="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_ff0000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* "/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_document_type_option"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_select_id_type"
                    android:background="@drawable/shape_f4f4f4_r8"
                    android:padding="@dimen/dp_14"
                    android:paddingLeft="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="@string/real_name_authentication_id_card_type"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_ff0000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* "/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_id_card_number_value"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/sp_14"
                    android:gravity="center_vertical"
                    android:id="@+id/et_id_num"
                    android:background="@drawable/shape_f4f4f4_r8"
                    android:padding="@dimen/dp_14"
                    android:paddingLeft="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="@string/real_name_authentication_enter_valid_id_card_number_request"
                    android:singleLine="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_ff0000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* "/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_phone_number_value"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/shape_f4f4f4_r8"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_8">
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="@dimen/sp_14"
                        android:gravity="center_vertical"
                        android:id="@+id/et_tel_num"
                        android:background="@null"
                        android:padding="@dimen/dp_14"
                        android:paddingLeft="@dimen/dp_2"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_48"
                        android:hint="@string/real_name_authentication_enter_phone_number_request"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:inputType="number"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_999999"
                        android:gravity="center_vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_48"
                        android:text="|"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:enabled="false"
                        android:textColor="@color/color_999999"
                        android:gravity="center"
                        android:id="@+id/btn_send_veri_code"
                        android:background="@null"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:layout_marginRight="@dimen/dp_16"
                        android:text="@string/real_name_authentication_send_verification_code_action"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_ff0000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* "/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_verification_code_value"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/sp_14"
                    android:gravity="center_vertical"
                    android:id="@+id/et_cert_num"
                    android:background="@drawable/shape_f4f4f4_r8"
                    android:padding="@dimen/dp_14"
                    android:paddingLeft="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="@string/real_name_authentication_enter_verification_code_request"
                    android:singleLine="true"
                    android:inputType="number"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_30">
                    <CheckBox
                        android:id="@+id/cb_agree_cert"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp_5"
                        style="@style/video_report_list_check"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_4"
                        android:text="@string/real_name_authentication_i_agree_action"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_0088ff"
                        android:id="@+id/tv_service_agreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_name_authentication_service_agreement_doc"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_real_name_cert_summit"
                    android:background="@drawable/select_btn_switch_ffd9b9_ff7300_r6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginBottom="@dimen/dp_22"
                    android:text="@string/real_name_authentication_next_step_action"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
