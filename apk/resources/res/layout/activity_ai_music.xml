<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ai_music"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/sound_a_m"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20dp"
        android:textColor="@color/color_282828"
        android:id="@+id/music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sound_a_m_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@+id/view_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/create_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@+id/music_title">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14dp"
            android:textColor="@color/color_282828"
            android:textColorHint="@color/color_A3AFBB"
            android:gravity="top|left"
            android:id="@+id/a_m_input_et"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_8"
            android:hint="@string/sound_a_m_input"
            android:maxLength="300"
            app:layout_constraintBottom_toTopOf="@+id/random_tv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_ff7300"
            android:gravity="center"
            android:id="@+id/random_tv"
            android:background="@drawable/shape_ff7300_stroke_s20"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="56dp"
            android:text="@string/tip_21_0427_22"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_A3AFBB"
            android:id="@+id/word_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/300"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/random_tv"
            app:layout_constraintStart_toEndOf="@+id/random_tv"
            app:layout_constraintTop_toTopOf="@+id/random_tv"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ai_create_music"
            android:background="@drawable/shape_create_btn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/random_tv"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_a_m_music"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/color_282828"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_a_m_create"
                android:layout_marginStart="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.wakeup.commonui.view.AiEnergyExpendView
            android:id="@+id/aee_ts"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            app:layout_constraintBottom_toTopOf="@+id/ai_create_music"
            app:layout_constraintEnd_toEndOf="@+id/ai_create_music"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabLayout_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="@+id/create_layout"
        app:layout_constraintTop_toBottomOf="@+id/create_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_696969"
            android:gravity="bottom"
            android:id="@+id/tab_hot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_a_m_hot"
            app:layout_constraintBottom_toTopOf="@+id/line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/line"
            android:background="@drawable/shape_sport_tab_line"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tab_hot"
            app:layout_constraintStart_toStartOf="@+id/tab_hot"
            app:layout_constraintTop_toBottomOf="@+id/tab_hot"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_696969"
            android:id="@+id/tab_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_a_m_create_m"
            android:layout_marginStart="28dp"
            app:layout_constraintBottom_toTopOf="@+id/line2"
            app:layout_constraintStart_toEndOf="@+id/tab_hot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/line2"
            android:background="@drawable/shape_sport_tab_line"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tab_create"
            app:layout_constraintStart_toStartOf="@+id/tab_create"
            app:layout_constraintTop_toBottomOf="@+id/tab_create"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/music_play_layout"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_play_layout"
        android:background="@color/color_78white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/music_play_cv"
            android:layout_width="@dimen/dp_38"
            android:layout_height="@dimen/dp_38"
            android:layout_marginStart="@dimen/dp_16"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="@dimen/dp_0"
            app:cardMaxElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/music_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/icon_head_default"/>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/music_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:lines="1"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/play_state_iv"
            app:layout_constraintStart_toEndOf="@+id/music_play_cv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@+id/play_state_iv"
            app:layout_constraintStart_toEndOf="@+id/music_play_cv"
            app:layout_constraintTop_toBottomOf="@+id/music_name"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="00:00"
            app:layout_constraintStart_toStartOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="00:00"
            app:layout_constraintEnd_toEndOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_state_iv"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_a_m_play"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
