<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/dialog_gain_rewards_iv"
        android:layout_width="@dimen/dp_250"
        android:layout_height="@dimen/dp_220"
        android:src="@drawable/ic_gain_reward"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/dialog_gain_rewards_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_17"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/dialog_gain_rewards_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dialog_know_btn"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="@dimen/dp_146"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_22"
            android:text="确认"
            android:drawablePadding="@dimen/dp_4"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
