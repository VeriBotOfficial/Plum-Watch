<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.aigestudio.wheelpicker.widgets.WheelDatePicker
            android:id="@+id/chat_remind_date_pick"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/chat_remind_hour_picker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_cyclic="false"
            app:wheel_indicator="true"
            app:wheel_item_space="@dimen/dp_40"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/chat_remind_hour_picker"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintEnd_toStartOf="@+id/chat_remind_minute_picker"
            app:layout_constraintStart_toEndOf="@+id/chat_remind_date_pick"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_cyclic="false"
            app:wheel_indicator="true"
            app:wheel_item_space="@dimen/dp_40"
            app:wheel_item_text_color="@color/color_333333"
            app:wheel_item_text_size="@dimen/sp_20"
            app:wheel_selected_item_text_color="@color/color_primary"
            app:wheel_visible_item_count="3"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/chat_remind_minute_picker"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chat_remind_hour_picker"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_cyclic="false"
            app:wheel_indicator="true"
            app:wheel_item_space="@dimen/dp_40"
            app:wheel_item_text_color="@color/color_333333"
            app:wheel_item_text_size="@dimen/sp_20"
            app:wheel_selected_item_text_color="@color/color_primary"
            app:wheel_visible_item_count="3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
