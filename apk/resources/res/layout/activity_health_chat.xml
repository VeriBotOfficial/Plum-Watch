<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/drawable_create_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/qt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/icon_chat_notes"
        app:titleColor="@color/white"
        app:titleText="@string/chat_gpt_health_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qt_title">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/health_chat_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/input_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/health_chat_content_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_22"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_gpt_assistant"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/white"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_22"
                        android:text="@string/chat_gpt_ask"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_template_question"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_18"
                        android:layout_marginEnd="@dimen/dp_18"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_ff7300"
                        android:layout_gravity="end"
                        android:id="@+id/tv_refresh_template"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_22"
                        android:text="@string/chat_gpt_new_topics"
                        android:drawablePadding="@dimen/dp_4"
                        android:layout_marginEnd="@dimen/dp_42"
                        app:drawableStartCompat="@drawable/ic_refresh_subject"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/qt_gpt_rv"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/dp_6"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/input_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_template"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/input_layout"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/chat_gpt_switch"
                android:layout_width="@dimen/dp_54"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_10"
                app:srcCompat="@drawable/ic_gpt_keybord"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/qt_gpt_speak"
                android:background="@drawable/drawable_mic"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_45"
                android:text="@string/chat_gpt_hold_down_speak"
                android:layout_marginEnd="@dimen/dp_12"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16dp"
                android:textColor="@color/white"
                android:textColorHint="#8e8f9c"
                android:id="@+id/qt_gpt_input"
                android:background="@drawable/input_ffffff_r12"
                android:padding="@dimen/dp_10"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_45"
                android:hint="@string/chat_gpt_problem"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/qt_gpt_send"
                android:layout_width="@dimen/dp_54"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_12"
                app:srcCompat="@drawable/icon_chat_send"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/qt_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/img_gpt_audio_bg"/>
    <include
        android:id="@+id/qt_voice_record"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_voice_record"/>
</androidx.constraintlayout.widget.ConstraintLayout>
