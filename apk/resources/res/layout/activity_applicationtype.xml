<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="112dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivApplicationImage"
                    android:layout_width="73dp"
                    android:layout_height="73dp"
                    android:layout_marginLeft="24dp"
                    android:layout_centerVertical="true"
                    app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="17dp"
                    android:layout_marginRight="17dp"
                    android:layout_toLeftOf="@+id/tvInstall"
                    android:layout_toRightOf="@+id/ivApplicationImage"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:id="@+id/tvApplicationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666666"
                        android:id="@+id/tvTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666666"
                        android:id="@+id/tvInstallNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tvInstall"
                    android:background="@drawable/shape_fff2f2f2_r15"
                    android:layout_width="74dp"
                    android:layout_height="30dp"
                    android:text="安装"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="18dp"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_white_r15_r3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="21dp">
                <HorizontalScrollView
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="34dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingLeft="31dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/image1"
                            android:layout_width="78dp"
                            android:layout_height="123dp"/>
                        <ImageView
                            android:id="@+id/image2"
                            android:layout_width="78dp"
                            android:layout_height="123dp"
                            android:layout_marginLeft="74dp"/>
                        <ImageView
                            android:id="@+id/image3"
                            android:layout_width="78dp"
                            android:layout_height="123dp"
                            android:layout_marginLeft="74dp"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="19dp"
                    android:layout_marginTop="50dp"
                    android:text="应用介绍"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff666666"
                    android:id="@+id/tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="18dp"
                    android:lineSpacingMultiplier="1.5"/>
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:id="@+id/tv3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:text="注意事项"
                    android:layout_marginStart="19dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff666666"
                    android:id="@+id/tv4"
                    android:paddingBottom="79dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="18dp"
                    android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
