<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:elevation="2dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/textBlack"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_check_result"
                android:layout_centerInParent="true"/>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ic_pay_result_fail"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="30dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/textBlack"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="22dp"
            android:text="No payment results currently available"
            android:paddingHorizontal="20dp"/>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="16dp"
                android:textColor="#ff3737"
                android:gravity="center"
                android:id="@+id/tv_out"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_21_0202_01"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#8a8a8a"
                android:gravity="center"
                android:id="@+id/tv_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_21_0202_02"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#00bbff"
                android:gravity="center"
                android:id="@+id/tv_restart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_21_0202_03"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
