<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_12"
    android:layout_marginEnd="@dimen/dp_12">
    <androidx.cardview.widget.CardView
        android:id="@+id/local_music_cv"
        android:layout_width="@dimen/dp_46"
        android:layout_height="@dimen/dp_46"
        android:layout_marginTop="@dimen/dp_16"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_music_bottom_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="start"
        android:id="@+id/item_lm_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/item_lm_state"
        app:layout_constraintStart_toEndOf="@+id/local_music_cv"
        app:layout_constraintTop_toTopOf="@+id/local_music_cv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:gravity="start"
        android:id="@+id/item_lm_singer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/item_lm_hot"
        app:layout_constraintEnd_toEndOf="@+id/item_lm_name"
        app:layout_constraintStart_toStartOf="@+id/item_lm_name"
        app:layout_constraintTop_toBottomOf="@+id/item_lm_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:id="@+id/item_lm_hot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:maxLines="1"
        android:drawablePadding="@dimen/dp_3"
        app:drawableStartCompat="@drawable/ic_music_item_play"
        app:layout_constraintStart_toStartOf="@+id/item_lm_name"
        app:layout_constraintTop_toBottomOf="@+id/item_lm_singer"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_lm_state"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/ic_music_b_all_play"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/item_line"
        android:background="@drawable/bg_under_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_lm_name"
        app:layout_constraintTop_toBottomOf="@+id/item_lm_hot"/>
</androidx.constraintlayout.widget.ConstraintLayout>
