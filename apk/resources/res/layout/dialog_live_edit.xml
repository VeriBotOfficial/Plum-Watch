<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="22dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_22"
            android:text="@string/change_name"
            android:maxLines="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/shape_e5e5e5_r8"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginBottom="@dimen/dp_22"
            android:paddingHorizontal="@dimen/dp_9">
            <EditText
                android:textSize="14dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_content"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:maxLength="20"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintEnd_toStartOf="@+id/iv_close_adv"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/iv_close_adv"
                android:visibility="gone"
                android:layout_width="@dimen/dp_15"
                android:layout_height="@dimen/dp_15"
                android:src="@mipmap/adv_close"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_limit"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_9a9a9a"
                android:id="@+id/tv_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_iv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/iv_audio_phone_1"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/iv_audip_phone_2"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/textBlack"
            android:id="@+id/tv_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="20dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/area_quxiao"
                android:layout_weight="1"/>
            <View
                android:id="@+id/space"
                android:layout_width="16dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/area_queding"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
