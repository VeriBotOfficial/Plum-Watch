<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/barrage_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:id="@+id/layout_send"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:paddingHorizontal="@dimen/dp_24"
        android:paddingVertical="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_send"
            android:background="@drawable/select_btn_ff7300_r6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/string_transmit"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_send"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/barrage_cardView"
                android:layout_width="@dimen/dp_140"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:minWidth="@dimen/dp_140"
                android:minHeight="@dimen/dp_168"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="@dimen/dp_30"
                app:cardElevation="@dimen/dp_30">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_15"
                    android:textColor="@color/white"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/barrage_tv"
                    android:background="@color/black"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_168"
                    android:text="@string/string_cheer_up"
                    android:lines="1"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"/>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_top_r12"
                android:paddingBottom="@dimen/dp_30"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_40"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrage_tv">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_333333"
                    android:id="@+id/barrage_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:text="@string/barrage_title_tip"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <EditText
                    android:textSize="@dimen/dp_14"
                    android:textColorHint="@color/color_999999"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/content_edt"
                    android:background="@drawable/shape_f8f9fa_r12"
                    android:padding="@dimen/dp_12"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_110"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/string_cheer_up"
                    android:hint="@string/barrage_hint_tip"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/barrage_title_tv"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_333333"
                    android:id="@+id/font_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:text="@string/font_size"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/content_edt"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:id="@+id/font_layout"
                    android:background="@drawable/shape_f8f9fa_r12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_45"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/font_tv">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/font_small_cardView"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp_4"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp_10"
                        app:cardElevation="@dimen/dp_4">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:enabled="true"
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_282828"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/font_small"
                            android:background="@color/ps_color_white"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/string_small"
                            android:lines="1"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/font_in_cardView"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp_4"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp_10"
                        app:cardElevation="@dimen/dp_0">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:enabled="true"
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_282828"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/font_in"
                            android:background="@color/color_f8f9fa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/string_medium"
                            android:lines="1"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/font_large_cardView"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp_4"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp_10"
                        app:cardElevation="@dimen/dp_0">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:enabled="true"
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_282828"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/font_large"
                            android:background="@color/color_f8f9fa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/string_large"
                            android:lines="1"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/font_very_large_cardView"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp_4"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp_10"
                        app:cardElevation="@dimen/dp_0">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:enabled="true"
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_282828"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/font_very_large"
                            android:background="@color/color_f8f9fa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/string_very_large"
                            android:lines="1"/>
                    </androidx.cardview.widget.CardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_333333"
                    android:id="@+id/font_color_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:text="@string/font_color"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/font_layout"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/font_color_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/font_color_tv"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_333333"
                    android:id="@+id/bg_color_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:text="@string/bg_color"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/font_color_recyclerView"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bg_color_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/bg_color_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
