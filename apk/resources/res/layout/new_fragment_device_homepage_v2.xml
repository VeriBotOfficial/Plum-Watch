                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:cardUseCompatPadding="false">
                                    <ImageView
                                        android:id="@+id/device_adversting"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp_68"
