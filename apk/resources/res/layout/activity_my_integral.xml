<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_score"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/my_integral_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/my_integral_rules"
        app:menuTextColor="@color/white"
        app:titleColor="@color/white"
        app:titleText="@string/my_integral_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/my_integral_nested"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/my_integral_title">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_100">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/my_integral_current_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/my_integral_current_points"
                android:drawableEnd="@drawable/ic_arrowgrey_right"
                android:layout_marginStart="@dimen/dp_12"
                android:drawableTint="@color/white"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_36"
                    android:textColor="@color/white"
                    android:id="@+id/my_integral_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_17"
                    android:layout_height="@dimen/dp_17"
                    android:layout_marginEnd="@dimen/dp_7"
                    app:layout_constraintBottom_toBottomOf="@+id/my_prize_look"
                    app:layout_constraintEnd_toStartOf="@+id/my_prize_look"
                    app:layout_constraintTop_toTopOf="@+id/my_prize_look"
                    app:srcCompat="@drawable/ic_award"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/white"
                    android:id="@+id/my_prize_look"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_integral_my_prize"
                    android:layout_marginEnd="@dimen/dp_22"
                    app:layout_constraintBottom_toBottomOf="@+id/my_integral_current"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/my_integral_current"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textColor="@color/color_333333"
                        android:id="@+id/my_integral_sign_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textColor="@color/color_333333"
                        android:id="@+id/my_integral_sign_in_remind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_integral_sign_remind"
                        android:layout_marginEnd="@dimen/dp_8"
                        app:layout_constraintEnd_toStartOf="@+id/my_integral_remind_switch"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <Switch
                        android:id="@+id/my_integral_remind_switch"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/device_notify_switch_thumb"
                        android:track="@drawable/device_notify_switch_track"
                        android:paddingEnd="@dimen/dp_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/my_integral_sign_in_state_rv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        app:layout_constraintTop_toBottomOf="@+id/my_integral_sign_in"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_integral_welfare_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/my_integral_label_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_ff333333"
                    android:id="@+id/wei_life_label_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_ff333333"
                    android:id="@+id/wei_life_label_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_integral_more"
                    android:drawableEnd="@drawable/ic_arrowgrey_right"
                    android:drawableTint="@color/color_373737"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_integral_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.material.tabs.TabLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/task_data_title"
                android:layout_width="@dimen/dp_220"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                app:tabIndicatorColor="@color/color_ff7300"
                app:tabIndicatorFullWidth="false"
                app:tabMode="fixed"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/black"
                app:tabTextColor="@color/color_666666"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                app:cardBackgroundColor="@color/color_FEF9F3"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/task_data_rv"
                        android:scrollbars="none"
                        android:fadingEdge="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.cardview.widget.CardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
