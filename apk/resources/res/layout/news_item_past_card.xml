<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/itemRoot"
    android:background="@drawable/bg_news_past_card"
    android:padding="10dp"
    android:layout_width="138dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivCardCover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_news_cover"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3b1a6e"
                android:ellipsize="end"
                android:id="@+id/tvCardDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5b2fa0"
                android:ellipsize="end"
                android:id="@+id/tvCardFixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/news_daily_brief_label"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#4b3a5a"
        android:ellipsize="end"
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:lineSpacingExtra="2dp"/>
</LinearLayout>
