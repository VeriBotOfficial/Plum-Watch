<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f4f6f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_600"
        android:src="@drawable/ic_sport_run_normal_bg_new"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/main_yundong"/>
    <com.wakeup.commonui.view.NestedScrollableHost
        android:id="@+id/ns_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tabLayout"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/tabLayout"
            app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    </com.wakeup.commonui.view.NestedScrollableHost>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:background="@drawable/shape_white_r30"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_58"
        android:layout_marginBottom="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/color_333333"
        app:tabTextAppearance="@style/tabLayoutTextStyle"
        app:tabTextColor="@color/color_666666"/>
</androidx.constraintlayout.widget.ConstraintLayout>
