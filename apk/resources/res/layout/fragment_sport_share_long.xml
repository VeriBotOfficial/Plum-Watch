<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="#f5f5f5"
            app:cardCornerRadius="12dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:id="@+id/share_layout"
                android:background="#f5f5f5"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/fl_container"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_map"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_user"
                    android:background="@drawable/shape_write_r20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_user_avatar"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_margin="@dimen/dp_2"
                        android:src="@mipmap/ic_default"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="#333333"
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_10"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-20dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fl_container">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_bottom"
                        android:background="@drawable/shape_white_r12"
                        android:paddingBottom="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="46dp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:id="@+id/tv_km"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:text="0.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#999999"
                            android:id="@+id/tv_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:text="@string/unit_gongli"
                            android:layout_marginStart="6dp"
                            app:layout_constraintStart_toEndOf="@+id/tv_km"
                            app:layout_constraintTop_toTopOf="@+id/tv_km"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/white"
                            android:id="@+id/tv_sport_type"
                            android:background="@drawable/shape_25cd78_r4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:layout_marginStart="6dp"
                            android:paddingHorizontal="@dimen/dp_4"
                            android:paddingVertical="@dimen/dp_2"
                            app:layout_constraintStart_toEndOf="@+id/tv_km"
                            app:layout_constraintTop_toBottomOf="@+id/tv_unit"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_18"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:id="@+id/user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_21"
                            android:maxWidth="@dimen/dp_150"
                            android:lines="1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_trail"
                            android:background="@drawable/shape_ff7300_r20"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="@string/sport_dynamic_trajectory"
                            android:paddingHorizontal="16dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_km"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_km"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#999999"
                            android:gravity="end"
                            android:id="@+id/tv_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_sport_type"
                            app:layout_constraintTop_toBottomOf="@+id/user_name"/>
                        <View
                            android:id="@+id/view_pace_line"
                            android:background="@drawable/shape_line_sport_pace"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#48d95b"
                            android:id="@+id/tv_pace_slowest"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view_pace_line"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#ff0000"
                            android:id="@+id/tv_pace_fastest"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view_pace_line"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/detail_recyclerView"
                            android:background="@drawable/shape_f0fbf5_white_r12"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:paddingHorizontal="@dimen/dp_6"
                            android:paddingVertical="@dimen/dp_6"
                            app:layout_constraintTop_toBottomOf="@+id/tv_pace_slowest"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:id="@+id/ll_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:divider="@drawable/shape_line_divider"
                        app:showDividers="middle"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/pace_layout"
                        android:background="@drawable/shape_white_r12"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="21dp"
                            android:layout_marginStart="@dimen/dp_12"
                            app:cardCornerRadius="@dimen/dp_2"
                            app:cardElevation="@dimen/dp_0"
                            app:cardMaxElevation="@dimen/dp_0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <View
                                android:background="@color/color_ff7300"
                                android:layout_width="@dimen/dp_4"
                                android:layout_height="@dimen/dp_15"/>
                        </androidx.cardview.widget.CardView>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18dp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:id="@+id/tv_pace_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/sport_pace"
                            android:layout_marginStart="26dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#666666"
                            android:id="@+id/tv_pace_type_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sport_km"
                            android:layout_marginStart="6dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_pace_type"
                            app:layout_constraintStart_toEndOf="@+id/tv_pace_type"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/tv_pace_avg_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_15"
                            app:layout_constraintEnd_toStartOf="@+id/tv_pace_max_layout"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_pace_type">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/tv_pace_avg_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sport_pingjunpeisu"
                                app:layout_constraintEnd_toStartOf="@+id/guideline"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_5">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="26dp"
                                    android:textStyle="bold"
                                    android:textColor="#333333"
                                    android:id="@+id/tv_pace_avg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_pace_avg_title"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="14dp"
                                    android:textColor="#999999"
                                    android:id="@+id/tv_pace_avg_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sport_gongli"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_pace_avg"
                                    app:layout_constraintStart_toEndOf="@+id/tv_pace_avg"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/tv_pace_max_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_15"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/tv_pace_avg_layout"
                            app:layout_constraintTop_toBottomOf="@+id/tv_pace_type">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/tv_pace_max_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sport_fastest_pace_km"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/guideline"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_5">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="26dp"
                                    android:textStyle="bold"
                                    android:textColor="#333333"
                                    android:id="@+id/tv_pace_max"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/guideline"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_pace_max_title"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="14dp"
                                    android:textColor="#999999"
                                    android:id="@+id/tv_pace_max_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sport_gongli"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_pace_max"
                                    app:layout_constraintStart_toEndOf="@+id/tv_pace_max"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#999999"
                            android:id="@+id/tv_pace_flag"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:text="@string/unit_gongli"
                            android:layout_marginHorizontal="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_pace_avg_layout"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_pace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginHorizontal="12dp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_pace_flag"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_logo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/ll_container">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:background="@drawable/ic_sport_share_logo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wearfit"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
