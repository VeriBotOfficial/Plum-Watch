<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_38">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_time_type"
        android:layout_width="@dimen/dp_38"
        android:layout_height="@dimen/dp_38"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_time_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="@+id/img_time_type"
        app:layout_constraintStart_toStartOf="@+id/img_time_type"
        app:layout_constraintTop_toBottomOf="@+id/img_time_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
