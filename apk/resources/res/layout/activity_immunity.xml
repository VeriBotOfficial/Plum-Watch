<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_jb_00cccc_00dddd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.wakeup.commonui.MyTitleBar
                android:id="@+id/mTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backImage="@drawable/ic_back_white"
                app:background="@color/transp"
                app:menuExpandImage="@drawable/ic_info"
                app:menuImage="@drawable/ic_share_white"
                app:titleColor="@color/white"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="@dimen/dp_0"
                app:tabMode="fixed"
                app:tabPaddingEnd="@dimen/dp_5"
                app:tabPaddingStart="@dimen/dp_5"
                app:tabSelectedTextColor="@color/color_00dddd"
                app:tabTextColor="@color/textBlack"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="25dp"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:gravity="center_vertical"
            android:id="@+id/tv6"
            android:background="@color/color_fafafa"
            android:paddingLeft="25dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/banner"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/color_fafafa"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
