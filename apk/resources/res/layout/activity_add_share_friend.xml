<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f4f4f4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/top_bar_add_share_friend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:background="@color/transp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_add_share_new_friend_group"
        android:background="@drawable/rect_add_share_new_friend_user_bg"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_add_share_friend"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_add_share_new_friend_user_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@color/grey"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_add_share_new_friend_group"
        app:layout_constraintStart_toStartOf="@+id/view_add_share_new_friend_group"
        app:layout_constraintTop_toTopOf="@+id/view_add_share_new_friend_group"
        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/textBlack"
        android:ellipsize="end"
        android:id="@+id/tv_add_share_new_friend_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="@+id/view_add_share_new_friend_group"
        app:layout_constraintStart_toEndOf="@+id/iv_add_share_new_friend_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_add_share_new_friend_user_avatar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/textBlack"
        android:ellipsize="end"
        android:id="@+id/tv_add_share_new_friend_user_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/tv_add_share_new_friend_user_name"
        app:layout_constraintStart_toStartOf="@+id/tv_add_share_new_friend_user_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_share_new_friend_user_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_btn_add_share_friend"
        android:background="@drawable/rect_invite_new_share_user"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
