<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_member_free_download"
    android:background="@drawable/bg_dial_member_free_btn"
    android:visibility="gone"
    android:layout_width="@dimen/dp_128"
    android:layout_height="@dimen/dp_48">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_dial_member_free_crown"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#8a3a0a"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dial_member_free_download"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:background="@drawable/bg_dial_member_free_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dial_member_entry_pill"
            android:lines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"/>
    </LinearLayout>
</FrameLayout>
