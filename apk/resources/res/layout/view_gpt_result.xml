<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="#393d6c"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_30"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_12">
        <View
            android:id="@+id/view"
            android:background="@drawable/drawable_pink_8"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#ccffffff"
            android:id="@+id/tv_collect_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gpt_create_get_result"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/add_remind_layout"
            android:background="@drawable/wk_gpt_normal_bg_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_result_copy"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_ff7300"
                android:gravity="end"
                android:id="@+id/tv_add_remind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_gpt_add"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_gpt_note"
                android:layout_marginStart="@dimen/dp_6"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_ff7300"
            android:gravity="end"
            android:id="@+id/tv_result_copy"
            android:background="@drawable/wk_gpt_normal_bg_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_gpt_copy_res"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/tv_result"
        android:background="@drawable/wk_gpt_normal_bg_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_39"
        android:lineSpacingExtra="2dp"
        android:layout_marginHorizontal="@dimen/dp_12"/>
</androidx.appcompat.widget.LinearLayoutCompat>
