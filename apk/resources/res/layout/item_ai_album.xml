<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/item_ai_cv"
            android:layout_width="@dimen/dp_170"
            android:layout_height="@dimen/dp_302"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="0dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_ai_aidl_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_ai_album_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_170"
            android:layout_height="@dimen/dp_302"
            android:src="@drawable/shape_border_white_r12"
            android:scaleType="fitXY"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/item_ai_album_check"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/ic_album_normal"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/item_ai_aidl_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"/>
</androidx.appcompat.widget.LinearLayoutCompat>
