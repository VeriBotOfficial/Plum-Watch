<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:titleText="@string/menstrual_set"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_12"
        android:paddingHorizontal="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:id="@+id/tv_remind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menstrual_reminder_settings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <Switch
                android:id="@+id/menstrual_cycle_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/menstrual_reminder_settings_instructions"
                app:layout_constraintLeft_toLeftOf="@+id/tv_remind"
                app:layout_constraintTop_toBottomOf="@+id/tv_remind"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_period_starts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menstrual_period_starts"
                app:layout_constraintBottom_toBottomOf="@+id/swich"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/menstrual_period_starts_instructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_period_starts"/>
            <Switch
                android:id="@+id/swich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="@color/color_EFEFEF"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_end_of_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menstrual_end_of_period"
                app:layout_constraintBottom_toBottomOf="@+id/end_swich"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/menstrual_end_of_period_instructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_end_of_period"/>
            <Switch
                android:id="@+id/end_swich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="@color/color_EFEFEF"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_fertile_period_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menstrual_fertile_period_start"
                app:layout_constraintBottom_toBottomOf="@+id/fertile_period_start_swich"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/menstrual_fertile_period_start_instructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_fertile_period_start"/>
            <Switch
                android:id="@+id/fertile_period_start_swich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="@color/color_EFEFEF"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_fertile_period_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menstrual_fertile_period_end"
                app:layout_constraintBottom_toBottomOf="@+id/fertile_period_end_swich"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/menstrual_fertile_period_end_instructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_fertile_period_end"/>
            <Switch
                android:id="@+id/fertile_period_end_swich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
