<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/my_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/language_translate"
        app:titleText=""/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/m_r_original"
        android:background="@drawable/shape_fef6f0_r12"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_ff7300"
            android:background="@drawable/shape_ffdabf_r4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/jacket_m_original"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"/>
        <ScrollView
            android:id="@+id/m_r_old_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/black"
                android:id="@+id/m_r_old_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="8dp"/>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/m_r_translate"
        android:background="@drawable/shape_f1f7ff_r12"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_1B5DFF"
            android:background="@drawable/shape_cbe0ff_r4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/jacket_m_translation_"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"/>
        <ScrollView
            android:id="@+id/m_r_translate_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/black"
                android:id="@+id/m_r_translate_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="8dp"/>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:elevation="2dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/m_r_voice"
            android:background="@drawable/ic_m_voice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/m_r_voice_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jacket_m_recording"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/m_r_voice"
            app:layout_constraintTop_toTopOf="@+id/m_r_voice"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_817F7D"
            android:id="@+id/m_r_voice_time_tvaaa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/m_r_voice"
            app:layout_constraintStart_toEndOf="@+id/m_r_voice"/>
        <Chronometer
            android:textSize="12dp"
            android:textColor="@color/color_817F7D"
            android:id="@+id/m_r_voice_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="00:%s"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/m_r_voice"
            app:layout_constraintStart_toEndOf="@+id/m_r_voice"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/m_r_voice_end"
            android:background="@drawable/ic_m_voice_end"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/m_r_voice_stop"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/m_r_voice_stop"
            android:background="@drawable/ic_m_voice_stop"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
