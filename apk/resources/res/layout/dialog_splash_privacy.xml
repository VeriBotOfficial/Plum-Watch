<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_24">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:paddingTop="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_title_new"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/privacy_scroll"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:fillViewport="true"
            android:fadeScrollbars="false"
            android:overScrollMode="ifContentScrolls">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:text="@string/btn_cancel"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_agree"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:text="@string/privacy_tip6"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
