<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/breath_rate_reference_value"
        android:layout_marginStart="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_round_ff3333"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_FA2A2D"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_round_00cc00"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_41BA41"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_round_ffbb00"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_FF961E"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_6A6A6A"
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
</LinearLayout>
