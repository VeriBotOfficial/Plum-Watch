<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_left"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tvDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="@color/textBlack"
                android:id="@+id/tvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/textBlack"
                android:id="@+id/tvUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qinyou_cifenzhong"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvValue"
                app:layout_constraintStart_toEndOf="@+id/tvValue"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date"
            android:background="@color/white"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_heart_arrow_down"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.wakeup.commonui.chart.IndicatorLineChart
            android:id="@+id/chartView"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp">
        <include
            android:id="@+id/card_breathe_range"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            layout="@layout/item_health_page_card"/>
        <include
            android:id="@+id/card_breathe_rate"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            layout="@layout/item_health_page_card"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
