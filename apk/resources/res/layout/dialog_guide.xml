<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/second_step_1"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:background="@drawable/icon_new_device"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_148"
                android:layout_marginTop="@dimen/dp_62"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/vw_guide"
        android:background="#50000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/first_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_guide_image"
            android:background="@drawable/icon_new_add"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_14"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_8"/>
        <ImageView
            android:background="@drawable/icon_new_device"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_148"
            android:layout_marginTop="@dimen/dp_8"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_8"/>
        <ImageView
            android:id="@+id/iv_guide_first"
            android:background="@drawable/icon_new_wire"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_12"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_153"/>
        <ImageView
            android:id="@+id/iv_guide_image_text"
            android:background="@drawable/icon_new_page_text_1"
            android:layout_width="@dimen/dp_271"
            android:layout_height="@dimen/dp_43"
            android:layout_marginTop="@dimen/dp_5"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_63"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/second_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:background="@drawable/icon_new_device_manager"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_54"
            android:layout_marginTop="@dimen/dp_150"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_8"/>
        <ImageView
            android:id="@+id/iv_guide_second"
            android:background="@drawable/icon_new_wire"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_12"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_marginEnd="@dimen/dp_153"/>
        <ImageView
            android:background="@drawable/icon_new_device_manager_text"
            android:layout_width="@dimen/dp_227"
            android:layout_height="@dimen/dp_23"
            android:layout_marginTop="@dimen/dp_12"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/dp_84"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/third_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <ImageView
            android:background="@drawable/icon_new_device_watch"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_102"
            android:layout_marginTop="@dimen/dp_72"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_guide_third"
            android:background="@drawable/icon_new_wire"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_17"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_marginEnd="@dimen/dp_145"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/icon_new_device_watch_text"
            android:layout_width="@dimen/dp_306"
            android:layout_height="@dimen/dp_39"
            android:layout_marginTop="@dimen/dp_6"
            android:contentDescription="@null"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/fourth_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <ImageView
            android:background="@drawable/icon_new_meirihuodong"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_138"
            android:layout_marginTop="@dimen/dp_60"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_guide_fourth"
            android:background="@drawable/icon_new_wire"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_5"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_80"/>
        <ImageView
            android:background="@drawable/iv_guide_image_custom_1"
            android:layout_width="@dimen/dp_189"
            android:layout_height="@dimen/dp_61"
            android:layout_marginTop="@dimen/dp_10"
            android:contentDescription="@null"/>
        <ImageView
            android:background="@drawable/iv_guide_image_custom"
            android:layout_width="@dimen/dp_327"
            android:layout_height="@dimen/dp_43"
            android:layout_marginTop="@dimen/dp_12"
            android:contentDescription="@null"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/fifth_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:background="@drawable/icon_page_add_text"
            android:layout_width="@dimen/dp_278"
            android:layout_height="@dimen/dp_43"
            android:layout_marginBottom="@dimen/dp_12"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_guide_fifth"
            android:background="@drawable/icon_new_wire"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginBottom="@dimen/dp_12"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_30"/>
        <ImageView
            android:background="@drawable/icon_new_ai"
            android:layout_width="@dimen/dp_51"
            android:layout_height="@dimen/dp_51"
            android:contentDescription="@null"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sixth_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:background="@drawable/icon_tab_new_find_text"
            android:layout_width="@dimen/dp_271"
            android:layout_height="@dimen/dp_43"
            android:layout_marginBottom="@dimen/dp_12"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_guide_sixth"
            android:background="@drawable/icon_new_wire_fan"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginBottom="@dimen/dp_12"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_30"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@drawable/bg_white_15dp"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:layout_marginStart="@dimen/dp_80">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/icon_tab_new_find"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/seventh_step"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/home_title_search_container"
            android:background="@drawable/shape_white_r18"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_56">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_fff76814_r12"
                android:paddingTop="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_6"
                android:layout_width="@dimen/dp_41"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_video_search_start"
                android:paddingStart="@dimen/dp_9"
                android:paddingEnd="@dimen/dp_9"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_search_guide_red"
                android:layout_marginStart="@dimen/dp_12"/>
            <ImageView
                android:id="@+id/icon_guide_seventh_text_tip_oversize"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_search_guide_tip_text_oversize"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_guide_seventh_text_tip_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_guide_tip"
                android:singleLine="true"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_guide_seventh"
            android:background="@drawable/icon_search_guide"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_11"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_115"/>
        <ImageView
            android:id="@+id/iv_guide_seventh_text_interest_content"
            android:layout_width="@dimen/dp_226"
            android:layout_height="@dimen/dp_45"
            android:layout_marginTop="@dimen/dp_15"
            android:src="@drawable/icon_search_guide_text_oversize"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dp_98"/>
    </LinearLayout>
</RelativeLayout>
