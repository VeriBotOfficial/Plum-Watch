<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/string_one_trans"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/translate_layout"
        android:background="@drawable/shape_white_r14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.AppCompatTextView
            android:scrollbarStyle="outsideOverlay"
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_9a9a9a"
            android:textColorHint="@color/color_6A6A6A"
            android:id="@+id/tv_ts_content"
            android:focusable="true"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_150"
            android:hint="@string/sound_tran_tip"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_speak_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_ts_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/speak_layout"
                android:background="@drawable/ic_speak_bg"
                android:visibility="visible"
                android:layout_width="@dimen/dp_156"
                android:layout_height="@dimen/dp_44"
                android:paddingHorizontal="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_translation_nor"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_282828"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_tran_btn"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/dp_5"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/record_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <View
                    android:id="@+id/record_bg_view"
                    android:background="@drawable/shape_record_btn"
                    android:layout_width="@dimen/dp_156"
                    android:layout_height="@dimen/dp_44"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_translation_fill"
                    app:layout_constraintBottom_toBottomOf="@+id/record_bg_view"
                    app:layout_constraintEnd_toEndOf="@+id/record_bg_view"
                    app:layout_constraintStart_toStartOf="@+id/record_bg_view"
                    app:layout_constraintTop_toTopOf="@+id/record_bg_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.wakeup.commonui.view.AiEnergyExpendView
            android:id="@+id/aee_ts"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            app:layout_constraintBottom_toTopOf="@+id/container_speak_layout"
            app:layout_constraintEnd_toEndOf="@+id/container_speak_layout"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/record_animate_layout"
            android:background="@drawable/shape_ff7300_r12"
            android:visibility="gone"
            android:layout_width="@dimen/dp_166"
            android:layout_height="@dimen/dp_50"
            android:layout_marginBottom="@dimen/dp_6"
            android:paddingHorizontal="@dimen/dp_10"
            app:layout_constraintBottom_toTopOf="@+id/container_speak_layout"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/tv_record_timing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0s"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/input_speak_anim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/chat_translate_load"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_voice"
            app:layout_constraintBottom_toBottomOf="@+id/container_speak_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/container_speak_layout"/>
        <View
            android:id="@+id/line"
            android:background="@color/color_BABABA"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_12"
            android:alpha="0.5"
            app:layout_constraintTop_toBottomOf="@+id/container_speak_layout"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_sound_swap"
            android:padding="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_swap"
            app:layout_constraintBottom_toBottomOf="@+id/tv_first_lan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_first_lan"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_282828"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_first_lan"
            android:background="@drawable/shape_f9e5cf_r8"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/headphone_chinese_language"
            android:maxLines="2"
            android:drawableEnd="@drawable/ic_sound_arrow_down"
            android:layout_marginEnd="@dimen/dp_9"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintEnd_toStartOf="@+id/iv_sound_swap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_282828"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_second_lan"
            android:background="@drawable/shape_f9e5cf_r8"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/headphone_english_language"
            android:maxLines="2"
            android:drawableEnd="@drawable/ic_sound_arrow_down"
            android:layout_marginStart="@dimen/dp_9"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_sound_swap"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
