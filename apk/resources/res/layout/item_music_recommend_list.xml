<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/item_list_cv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.wakeup.commonui.view.SquareImageView
            android:id="@+id/iv_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="@drawable/shape_transparent_r16"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_17"
            android:layout_marginBottom="@dimen/dp_6"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_6">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/dp_7"
                android:layout_height="@dimen/dp_9"
                app:srcCompat="@drawable/icon_white_smart_play"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/white"
                android:id="@+id/item_music_hot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_282828"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:minHeight="@dimen/dp_40"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/item_list_cv"
        app:layout_constraintStart_toStartOf="@+id/item_list_cv"
        app:layout_constraintTop_toBottomOf="@+id/item_list_cv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
