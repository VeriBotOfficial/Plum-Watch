<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r12_topleft_topright"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="16dp"
            android:text="@string/publish_video_video_permission_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBack"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back_black"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvData"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatButton
        android:enabled="false"
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnConfirm"
        android:background="@drawable/select_btn_switch_ffd9b9_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="30dp"
        android:text="@string/material_report_submit_action"/>
</androidx.appcompat.widget.LinearLayoutCompat>
