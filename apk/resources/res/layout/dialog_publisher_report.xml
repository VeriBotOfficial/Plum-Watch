<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dialog_publisher_report"
            android:background="@drawable/ic_publisher_report"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            app:layout_constraintEnd_toStartOf="@+id/dialog_voice_end"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_publisher_report_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_micro_life_report"
            app:layout_constraintEnd_toStartOf="@+id/dialog_voice_end"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_blacklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_28"
        app:layout_constraintStart_toEndOf="@+id/ll_report"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dialog_voice_end"
            android:background="@drawable/ic_publisher_blacklist"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_publisher_blacklist_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_micro_life_blacklist"
            app:layout_constraintEnd_toStartOf="@+id/dialog_voice_end"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
