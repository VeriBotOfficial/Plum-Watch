<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuImage="@drawable/home_more"
        app:titleText="@string/rainbow_title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_layout"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_left"
                    android:padding="5dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@mipmap/ic_jiantou"
                    android:layout_marginStart="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#333333"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableEnd="0x7f0807bf"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_right"
                    android:padding="5dp"
                    android:visibility="invisible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@mipmap/ic_jiantou"
                    android:rotation="180"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.haibin.calendarview.CalendarLayout
                android:orientation="vertical"
                android:id="@+id/calendar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                app:calendar_show_mode="only_week_view"
                app:default_status="expand"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_layout">
                <com.haibin.calendarview.CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:calendar_height="60dp"
                    app:current_day_text_color="@color/color_333333"
                    app:current_month_text_color="@color/color_333333"
                    app:day_text_size="10dp"
                    app:selected_text_color="@color/color_333333"
                    app:selected_theme_color="@color/color_ff7300"
                    app:week_background="@color/transparent"
                    app:week_bar_height="40dp"
                    app:week_start_with="mon"
                    app:week_text_color="@color/color_333333"
                    app:week_text_size="10dp"
                    app:week_view="com.wakeup.commonui.dialog.calendar.RainbowWeekView"
                    app:week_view_scrollable="true"/>
            </com.haibin.calendarview.CalendarLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_rainbow_big"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/calendar_layout">
                <com.wakeup.commonui.view.MotionChartView
                    android:id="@+id/rainbow_view"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:viewMSize="max"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ll_datas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_30"
                    android:layout_marginHorizontal="@dimen/dp_19"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rainbow_view">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/active_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/strength_layout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_kcal"
                            android:layout_width="@dimen/dp_18"
                            android:layout_height="@dimen/dp_18"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_kcal_des"
                            app:layout_constraintEnd_toStartOf="@+id/tv_kcal_des"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_kcal_des"
                            app:srcCompat="@drawable/ic_home_kcal"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_kcal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginStart="@dimen/dp_10"
                            app:layout_constraintEnd_toStartOf="@+id/tv_kcal_unit"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_kcal_des"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:id="@+id/tv_kcal_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_qianka"
                            android:layout_marginStart="6dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_kcal_value"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_kcal_value"
                            app:layout_constraintTop_toTopOf="@+id/tv_kcal_value"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_kcal_des"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rainbow_active_heat"
                            android:layout_marginStart="@dimen/dp_7"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_kcal"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/strength_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/step_layout"
                        app:layout_constraintStart_toEndOf="@+id/active_layout"
                        app:layout_constraintTop_toTopOf="@+id/active_layout">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_duration"
                            android:layout_width="@dimen/dp_18"
                            android:layout_height="@dimen/dp_18"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_duration_des"
                            app:layout_constraintEnd_toStartOf="@+id/tv_duration_des"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_duration_des"
                            app:srcCompat="@drawable/ic_home_duration"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_duration_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginStart="@dimen/dp_10"
                            app:layout_constraintEnd_toStartOf="@+id/tv_duration_unit"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_duration_des"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:id="@+id/tv_duration_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_fenzhong"
                            android:layout_marginStart="6dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_duration_value"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_duration_value"
                            app:layout_constraintTop_toTopOf="@+id/tv_duration_value"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_duration_des"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/user_exercise_duration"
                            android:layout_marginStart="@dimen/dp_7"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_duration"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/step_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/strength_layout"
                        app:layout_constraintTop_toTopOf="@+id/active_layout">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_active"
                            android:layout_width="@dimen/dp_18"
                            android:layout_height="@dimen/dp_18"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_active_des"
                            app:layout_constraintEnd_toStartOf="@+id/tv_active_des"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_active_des"
                            app:srcCompat="@drawable/ic_home_active"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_active_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginStart="@dimen/dp_10"
                            app:layout_constraintEnd_toStartOf="@+id/tv_active_unit"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_active_des"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:id="@+id/tv_active_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hour"
                            android:layout_marginStart="6dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_active_value"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_active_value"
                            app:layout_constraintTop_toTopOf="@+id/tv_active_value"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="#4d4d4d"
                            android:id="@+id/tv_active_des"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rainbow_active_time"
                            android:layout_marginStart="@dimen/dp_7"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_active"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/space_view"
                    android:background="@color/color_e6e6e6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/ll_datas"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_horizontal_data"
                    android:paddingBottom="@dimen/dp_13"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/space_view">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_step"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toStartOf="@+id/ll_distance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_21_0113_2"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginHorizontal="5dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ke_21_8_18_10"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_distance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toStartOf="@+id/ll_altitude"
                        app:layout_constraintStart_toEndOf="@+id/ll_step"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_distance"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginHorizontal="5dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unit_gongli"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_altitude"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ll_distance"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_yundong"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_sport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginHorizontal="5dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ke_21_8_18_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_proposal"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_rainbow_big">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/proposal_icon"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_64"
                    android:src="@drawable/ic_rainbow_duration_icon"
                    android:layout_marginStart="@dimen/dp_2"
                    android:layout_marginVertical="@dimen/dp_14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:id="@+id/proposal_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_13"
                    app:layout_constraintEnd_toStartOf="@+id/proposal_start"
                    app:layout_constraintStart_toEndOf="@+id/proposal_icon"
                    app:layout_constraintTop_toTopOf="@+id/proposal_icon"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textStyle="bold"
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/proposal_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:maxLines="2"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_13"
                    app:layout_constraintEnd_toStartOf="@+id/proposal_start"
                    app:layout_constraintStart_toEndOf="@+id/proposal_icon"
                    app:layout_constraintTop_toBottomOf="@+id/proposal_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_ff7300"
                    android:id="@+id/proposal_start"
                    android:background="@drawable/shape_f6f6f6_r14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_100"
                    android:text="@string/sport_tip"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_11"
                    android:paddingVertical="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/ll_step_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_proposal"
                layout="@layout/layout_rainbow_space"/>
            <include
                android:id="@+id/ll_strength_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_step_space"
                layout="@layout/layout_rainbow_space"/>
            <include
                android:id="@+id/ll_active_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_strength_space"
                layout="@layout/layout_rainbow_space"/>
            <fragment
                android:id="@+id/rainbow_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/ll_active_space"
                class="com.wakeup.feature.health.rainbow.RainBowAdFragment"/>
            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_active_space"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
