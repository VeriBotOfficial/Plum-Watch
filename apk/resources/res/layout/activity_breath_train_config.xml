<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:src="@drawable/ic_back_white"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toStartOf="@+id/btnMark"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/btnBack"/>
    <ImageView
        android:id="@+id/btnMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_mark"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="130dp"
        android:src="@drawable/ic_breath_train_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/ivCover2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:src="@color/transparent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="@+id/imageView"
        app:layout_constraintStart_toStartOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:roundPercent="1"/>
    <com.aigestudio.wheelpicker.WheelPicker
        android:id="@+id/wheelPicker"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover2"
        app:layout_constraintEnd_toEndOf="@+id/ivCover2"
        app:layout_constraintStart_toStartOf="@+id/ivCover2"
        app:layout_constraintTop_toTopOf="@+id/ivCover2"
        app:wheel_item_text_color="@color/white"
        app:wheel_item_text_size="16sp"
        app:wheel_selected_item_position="4"
        app:wheel_visible_item_count="3"/>
    <ImageView
        android:layout_width="115dp"
        android:layout_height="47dp"
        android:src="@drawable/bg_item_wheel_picker_curtain"
        app:layout_constraintBottom_toBottomOf="@+id/wheelPicker"
        app:layout_constraintEnd_toEndOf="@+id/wheelPicker"
        app:layout_constraintStart_toStartOf="@+id/wheelPicker"
        app:layout_constraintTop_toTopOf="@+id/wheelPicker"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:gravity="start"
        android:id="@+id/tvTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCover2"/>
    <Button
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:id="@+id/btnStart"
        android:background="@drawable/bg_shape_66ffffff_r23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/fatigue_tip_07"
        android:paddingHorizontal="80dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTip"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tvVipTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fatigue_tip_08"
        app:layout_constraintBottom_toBottomOf="@+id/tvOpenVip"
        app:layout_constraintEnd_toStartOf="@+id/tvOpenVip"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvOpenVip"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffaf6800"
        android:gravity="center"
        android:id="@+id/tvOpenVip"
        android:background="@drawable/bg_breath_open_vip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/fatigue_tip_09"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvVipTip"
        app:layout_constraintTop_toBottomOf="@+id/btnStart"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:id="@+id/tvMusicName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:src="@drawable/ic_breath_music"
        app:layout_constraintBottom_toTopOf="@+id/tvMusicName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
