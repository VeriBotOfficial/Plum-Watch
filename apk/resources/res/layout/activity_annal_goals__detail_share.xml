<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuImage="@drawable/ic_share_gray_black"
        app:titleText="@string/share_yulan"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_share_contain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_22">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bg_ll"
            android:background="@drawable/ic_goal_run_share_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_327"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_18">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_share_header"
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:layout_marginTop="@dimen/dp_3"
                android:src="@drawable/img_avatarboy_s"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/circleStyle"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_share_header"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_share_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="冬天里的雪儿"
                    app:layout_constraintStart_toEndOf="@+id/iv_share_header"
                    app:layout_constraintTop_toTopOf="@+id/iv_share_header"/>
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/white"
                    android:id="@+id/tv_share_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="与 0 人一起坚持"
                    app:layout_constraintStart_toEndOf="@+id/iv_share_header"
                    app:layout_constraintTop_toBottomOf="@+id/tv_share_title"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:id="@+id/line"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_finish_goals_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_44"
                android:text="@string/finish_goals"
                android:lines="1"
                android:layout_marginEnd="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/line"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_24"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_finish_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:text="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_finish_goals_title"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:layout_marginHorizontal="@dimen/dp_5"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_finish_goals"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_finish_goals"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_goals_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_44"
                android:lines="1"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/line"/>
            <TextView
                android:textSize="@dimen/sp_24"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_goals_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:text="12"
                app:layout_constraintStart_toStartOf="@+id/tv_goals_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_goals_title"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/white"
                android:id="@+id/tv_goals_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_23"
                android:text="%"
                android:layout_marginHorizontal="@dimen/dp_5"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_goals_value"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_goals_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_62"
            android:layout_marginHorizontal="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:drawablePadding="@dimen/dp_6"
                android:paddingHorizontal="@dimen/dp_16"
                app:drawableStartCompat="@drawable/ic_sport_share_logo"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
