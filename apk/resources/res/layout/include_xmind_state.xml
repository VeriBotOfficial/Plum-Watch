<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_state_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="93dp"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_generate_state"
        android:layout_width="58dp"
        android:layout_height="69dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_xmind_generate"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_generate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/xmind_genarating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_generate_state"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tv_again"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="120dp"
        android:layout_height="41dp"
        android:layout_marginTop="18dp"
        android:text="@string/chat_gpt_regeneration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_generate"/>
</androidx.constraintlayout.widget.ConstraintLayout>
