<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_collect_nor"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_315"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_30"
        app:cardCornerRadius="@dimen/dp_30"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_139"
        android:layout_marginBottom="-15dp"
        android:src="@drawable/img_shadow"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/tvMusicName"/>
    <TextView
        android:textSize="@dimen/dp_18"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMusicName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_666666"
        android:gravity="center"
        android:id="@+id/tvType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/tvMusicName"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_14"
        android:layout_marginStart="@dimen/dp_30"
        app:layout_constraintBottom_toTopOf="@+id/segmentProgressBar"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/ivDot"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/ic_breath_music_clock"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivDot"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <SeekBar
        android:id="@+id/segmentProgressBar"
        android:paddingTop="@dimen/dp_0"
        android:paddingBottom="@dimen/dp_0"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:maxHeight="@dimen/dp_4"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_style_ff7300"
        android:minHeight="@dimen/dp_4"
        android:thumb="@drawable/seek_bar_thumb_ff7300"
        android:thumbOffset="@dimen/dp_0"
        android:paddingStart="@dimen/dp_0"
        android:paddingEnd="@dimen/dp_0"
        android:splitTrack="false"
        android:layout_marginHorizontal="@dimen/dp_30"
        app:layout_constraintBottom_toTopOf="@+id/start_time"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_333333"
        android:id="@+id/start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_22"
        android:text="00:00"
        android:layout_marginStart="@dimen/dp_30"
        app:layout_constraintBottom_toTopOf="@+id/ivPlay"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_333333"
        android:id="@+id/end_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_22"
        android:text="00:00"
        android:layout_marginEnd="@dimen/dp_30"
        app:layout_constraintBottom_toTopOf="@+id/ivPlay"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPlay"
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_76"
        android:layout_marginBottom="@dimen/dp_30"
        android:src="@drawable/ic_item_breath_music_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPrevious"
        android:visibility="gone"
        android:layout_width="@dimen/dp_25"
        android:layout_height="@dimen/dp_29"
        android:src="@drawable/ic_breath_music_play_previous"
        android:layout_marginEnd="@dimen/dp_38"
        app:layout_constraintBottom_toBottomOf="@+id/ivPlay"
        app:layout_constraintEnd_toStartOf="@+id/ivPlay"
        app:layout_constraintTop_toTopOf="@+id/ivPlay"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNext"
        android:visibility="gone"
        android:layout_width="@dimen/dp_25"
        android:layout_height="@dimen/dp_29"
        android:src="@drawable/ic_breath_music_play_next"
        android:layout_marginStart="@dimen/dp_38"
        app:layout_constraintBottom_toBottomOf="@+id/ivPlay"
        app:layout_constraintStart_toEndOf="@+id/ivPlay"
        app:layout_constraintTop_toTopOf="@+id/ivPlay"/>
</androidx.constraintlayout.widget.ConstraintLayout>
