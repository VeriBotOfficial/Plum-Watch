<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/headset_scan_tip3"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="16dp">
                <ImageView
                    android:background="@drawable/ic_headset_tip_index1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headset_scan_tip4"
                    android:layout_marginStart="6dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_tip1"
                android:background="@drawable/ic_headset_tip_1"
                android:layout_width="307dp"
                android:layout_height="244dp"
                android:layout_marginTop="12dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_open_bt"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="140dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:text="@string/headset_scan_tip5"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="16dp">
                <ImageView
                    android:layout_gravity="top"
                    android:background="@drawable/ic_headset_tip_index2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headset_scan_tip6"
                    android:layout_marginStart="6dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_tip2"
                android:background="@drawable/ic_headset_tip_2"
                android:layout_width="343dp"
                android:layout_height="95dp"
                android:layout_marginTop="12dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_find"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="140dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:text="@string/headphone_find_a_device"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
