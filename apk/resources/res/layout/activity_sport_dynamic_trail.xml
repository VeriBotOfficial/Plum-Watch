<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/status_bar_layout"
        layout="@layout/status_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_masks_top"
        android:background="@drawable/shape_trail_masks_top"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_masks_bottom"
        android:background="@drawable/shape_trail_masks_bottom"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:background="@drawable/ic_sport_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_commit"
        android:background="@drawable/ic_sport_finish"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_user"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back">
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round="40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_logo"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:orientation="horizontal"
        android:id="@+id/ll_play"
        android:layout_width="@dimen/dp_185"
        android:layout_height="@dimen/dp_55"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_28"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_sport_dynamic_trail_play"
                android:layout_marginStart="@dimen/dp_2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/color_ff7300"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_preview_share_videos"
                android:maxLines="2"
                android:layout_marginHorizontal="@dimen/dp_13"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_info_white"
        android:background="@drawable/shape_trail_detail_bg"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_km_layout"
            android:background="@drawable/shape_white_r8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="46dp"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_km_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fugazone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_km_unit_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="公里"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_km_white"
                app:layout_constraintStart_toEndOf="@+id/tv_km_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_type_white"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_trail_type_riding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_km_layout">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_time_white"
                android:background="@drawable/shape_white_r8"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_55"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_18"
                    android:textColor="@color/color_080808"
                    android:id="@+id/tv_time_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fugazone"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_080808"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/sport_yongshi"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/cl_pace_white"
                android:background="@drawable/shape_white_r8"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_55"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_18"
                    android:textColor="@color/color_080808"
                    android:id="@+id/tv_pace_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fugazone"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_080808"
                    android:id="@+id/tv_pace_unit_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="/公里"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/cl_kcal_white"
                android:background="@drawable/shape_white_r8"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_55"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_18"
                    android:textColor="@color/color_080808"
                    android:id="@+id/tv_kcal_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fugazone"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_080808"
                    android:id="@+id/tv_kcal_unit_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="千卡"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="130dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="46dp"
            android:textColor="@color/white"
            android:id="@+id/tv_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fugazone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_km_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="公里"
            android:layout_marginStart="4dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_km"
            app:layout_constraintStart_toEndOf="@+id/tv_km"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_type"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_km_unit"
            app:layout_constraintStart_toEndOf="@+id/tv_km"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_km">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="26dp"
                android:textColor="@color/white"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fugazone"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="26dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_pace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fugazone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_pace_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/公里"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_pace"
                    app:layout_constraintStart_toEndOf="@+id/tv_pace"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="26dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fugazone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_kcal_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="千卡"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_kcal"
                    app:layout_constraintStart_toEndOf="@+id/tv_kcal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.wakeup.commonui.chart.SportTrailChart
        android:id="@+id/chart_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/tv_chart_describe"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="速度曲线"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/chart_view"
        app:layout_constraintStart_toStartOf="@+id/chart_view"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cl_info"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_label_speed"
            android:background="@drawable/ic_trail_label_bg"
            android:visibility="gone"
            android:layout_width="125dp"
            android:layout_height="34dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_trail_label_speed"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fugazone"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_gonglixiaoshi"
                android:layout_marginStart="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_label_step"
            android:background="@drawable/ic_trail_label_bg"
            android:visibility="gone"
            android:layout_width="125dp"
            android:layout_height="34dp"
            android:layout_marginTop="10dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_trail_label_step"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fugazone"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_step_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_bufenzhong"
                android:layout_marginStart="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_label_heart"
            android:background="@drawable/ic_trail_label_bg"
            android:visibility="gone"
            android:layout_width="125dp"
            android:layout_height="34dp"
            android:layout_marginTop="10dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_trail_label_heart"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fugazone"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/tv_label_heart_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qinyou_cifenzhong"
                android:layout_marginStart="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_ff7300"
        android:gravity="center"
        android:id="@+id/tv_custom"
        android:background="@drawable/shape_white_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginBottom="@dimen/dp_25"
        android:text="@string/sport_personalise"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_bottom"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="#666666"
            android:id="@+id/tv_map_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/sport_map_style"
            android:layout_marginHorizontal="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_map_style"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="#666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/sport_track_style"
            android:layout_marginHorizontal="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trail_style"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="#666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/sport_music"
            android:layout_marginHorizontal="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_music"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.wakeup.feature.sport.view.MaskView
        android:id="@+id/mask_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mask_view2"
        android:background="@color/gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
