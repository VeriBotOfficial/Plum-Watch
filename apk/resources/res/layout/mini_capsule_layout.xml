<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capsule_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_title_bar_height">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/capsule"
        android:layout_width="88dp"
        android:layout_height="32dp"
        android:layout_marginRight="8dp">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_mini_capsule_bg"
            android:padding="1px"
            android:layout_width="88dp"
            android:layout_height="32dp">
            <View
                android:id="@+id/center"
                android:background="#33000000"
                android:layout_width="1px"
                android:layout_height="18dp"
                android:layout_centerInParent="true"/>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/more"
                android:background="@drawable/ic_mini_capsule_l_bg"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/center">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mini_capsule_more"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/close"
                android:background="@drawable/ic_mini_capsule_r_bg"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/center">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mini_capsule_close"/>
            </RelativeLayout>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
