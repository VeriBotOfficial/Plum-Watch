<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/integration_bg"
                    android:layout_width="match_parent"
                    android:layout_height="256.5dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="100dp"
                        android:text="@string/tip_21_0519_01"
                        android:layout_marginStart="38dp"/>
                    <TextView
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:id="@+id/tvIntegral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7.5dp"
                        android:layout_marginStart="38dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="38dp">
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:id="@+id/tvIntegrationRecord"
                            android:padding="3dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_21_0519_02"
                            android:drawablePadding="7dp"
                            app:drawableEndCompat="@mipmap/ic_pull"/>
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:id="@+id/tvIntegrationExchange"
                            android:padding="3dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_21_0519_03"
                            android:drawablePadding="7dp"
                            android:layout_marginStart="20dp"
                            app:drawableEndCompat="@mipmap/ic_pull"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r12"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="200dp"
                    android:layout_marginHorizontal="16dp">
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:layout_gravity="start"
                        android:id="@+id/tvSignCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.5dp"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff333333"
                        android:layout_gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.5dp"
                        android:text="@string/tip_21_0519_06"
                        android:layout_marginStart="10dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="17dp"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tvIntegral1"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral2"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral3"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral4"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral5"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral6"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:gravity="center"
                            android:id="@+id/tv_integral7"
                            android:layout_width="27.5dp"
                            android:layout_height="27.5dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/tvIntegralSgin"
                        android:background="@drawable/shape_bg_1890ff"
                        android:layout_width="130dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/tip_21_0527_liu_1"/>
                </LinearLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/imLottery"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="17dp"
                android:src="@mipmap/ic_tolottery"
                android:layout_marginHorizontal="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llNewUserTask"
                android:background="@drawable/shape_white_r12"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:layout_marginHorizontal="16dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tip_21_0519_07"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tip_21_0519_13"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mRecyclerView2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tip_21_0519_21"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mRecyclerView3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/tip_21_0519_29"
        app:titleText="@string/tip_21_0517_04"/>
</androidx.constraintlayout.widget.ConstraintLayout>
