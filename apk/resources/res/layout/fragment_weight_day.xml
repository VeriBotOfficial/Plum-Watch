<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/share_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="25dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/iv_left"
            android:padding="8dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_jiantou"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/tv_title_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_right"
            android:padding="8dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_jiantou"
            android:rotation="180"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32dp"
            android:textStyle="bold"
            android:textColor="@color/textBlack"
            android:id="@+id/tvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/textBlack"
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tizhong_gongjin"
            android:layout_marginStart="4dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvValue"
            app:layout_constraintStart_toEndOf="@+id/tvValue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_date"
        android:background="@color/white"
        android:paddingTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_666666"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_666666"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_heart_arrow_down"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.wakeup.commonui.chart.IndicatorLineChart
        android:id="@+id/chartView"
        android:layout_width="match_parent"
        android:layout_height="220dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="22dp"
        android:layout_marginHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/color_999999"
            android:id="@+id/tv_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_weight"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_current"
            app:layout_constraintStart_toEndOf="@+id/tv_current"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_gongjin"
            android:layout_marginStart="2dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_weight"
            app:layout_constraintStart_toEndOf="@+id/tv_weight"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
