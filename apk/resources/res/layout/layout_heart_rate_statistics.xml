<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayout2"
        android:background="@drawable/shape_white_r10"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_margin="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_24"
                android:textColor="#ff666666"
                android:id="@+id/tv_up_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_maximum_heart_rate"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ff666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/heart_num_minute"/>
        </LinearLayout>
        <View
            android:background="#f1f2f7"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_24"
                android:textColor="#ff666666"
                android:id="@+id/tv_low_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_minimum_heart_rate"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ff666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/heart_num_minute"/>
        </LinearLayout>
        <View
            android:background="#f1f2f7"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_24"
                android:textColor="#ff666666"
                android:id="@+id/tv_average_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_average_heart_rate"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ff666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/heart_num_minute"/>
        </LinearLayout>
        <View
            android:background="#f1f2f7"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
