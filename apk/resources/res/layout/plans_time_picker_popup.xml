<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/timePickerWheel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/plans_wheel_viewport_height">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/selectionHighlight"
            android:background="@drawable/bg_plans_time_picker_selection"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/plans_wheel_row_height"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/timePickerColumns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lvHour"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lvMinute"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btnWheelConfirm"
        android:background="@drawable/bg_plans_header_create_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/plans_wheel_confirm"
        android:paddingVertical="10dp"/>
</LinearLayout>
