<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/shape_e3e3e3_r6"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/btn_cancel"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sure"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/sure"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/btn_confirm"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cancel"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/sport_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/shape_f6f6f6_r6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            app:layout_constraintBottom_toBottomOf="@+id/wheelPicker1"
            app:layout_constraintTop_toTopOf="@+id/wheelPicker1"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheelPicker1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_150"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/cancel"
            app:layout_constraintEnd_toStartOf="@+id/wheelPicker2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:wheel_cyclic="false"
            app:wheel_item_text_color="@color/color_999999"
            app:wheel_item_text_size="@dimen/dp_18"
            app:wheel_selected_item_text_color="@color/color_ff7300"
            app:wheel_visible_item_count="3"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheelPicker2"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_150"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/cancel"
            app:layout_constraintEnd_toStartOf="@+id/wheelPicker3"
            app:layout_constraintStart_toEndOf="@+id/wheelPicker1"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:wheel_cyclic="false"
            app:wheel_item_text_color="@color/color_999999"
            app:wheel_item_text_size="@dimen/dp_18"
            app:wheel_selected_item_text_color="@color/color_ff7300"
            app:wheel_visible_item_count="3"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheelPicker3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_150"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/wheelPicker2"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:wheel_cyclic="false"
            app:wheel_item_text_color="@color/color_999999"
            app:wheel_item_text_size="@dimen/dp_18"
            app:wheel_selected_item_text_color="@color/color_ff7300"
            app:wheel_visible_item_count="3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
