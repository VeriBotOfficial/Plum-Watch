<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <ImageView
                    android:id="@+id/iv_last"
                    android:padding="8dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/ic_jiantou"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_666666"
                    android:gravity="center"
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_right"
                    android:padding="8dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/ic_jiantou"
                    android:rotation="180"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_select_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/dp_32"
                    android:textColor="@color/textBlack"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_selectHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/textBlack"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hour"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="@dimen/dp_32"
                    android:textColor="@color/textBlack"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_selectMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/textBlack"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/min"
                    android:layout_marginStart="4dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_666666"
                    android:layout_gravity="center"
                    android:id="@+id/sleep_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_date"
                android:background="@color/white"
                android:paddingTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_666666"
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_666666"
                    android:id="@+id/tv_select_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_heart_arrow_down"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/dp_10">
                <com.wakeup.commonui.chart.IndicatorBarChart
                    android:id="@+id/mSleepBarNormalChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.wakeup.commonui.chart.SleepChart
                    android:id="@+id/mSleepBarDayChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_15"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/no_data"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_tip6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/sleep_color_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_30"
        android:layout_marginEnd="@dimen/dp_30">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.google.android.material.imageview.ShapeableImageView
                android:background="@color/color_sleep_deep"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                app:shapeAppearanceOverlay="@style/circleImageStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/deep_sleep"
                android:layout_marginStart="@dimen/dp_3"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.google.android.material.imageview.ShapeableImageView
                android:background="@color/color_sleep_shallow"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                app:shapeAppearanceOverlay="@style/circleImageStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/light_sleep"
                android:layout_marginStart="@dimen/dp_3"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.google.android.material.imageview.ShapeableImageView
                android:background="@color/color_sleep_wake"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                app:shapeAppearanceOverlay="@style/circleImageStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wake"
                android:layout_marginStart="@dimen/dp_3"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/sleep_detail_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_12">
        <include
            android:id="@+id/sleep_detail_list"
            android:visibility="visible"
            layout="@layout/layout_sleep_detail_list"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
