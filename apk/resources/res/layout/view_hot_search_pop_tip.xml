<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="@dimen/dp_125"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/search_guide_top"
        android:layout_width="16dp"
        android:layout_height="10dp"
        android:src="@drawable/ic_search_guide_top"
        android:layout_marginStart="61dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/shape_ffffff_r18"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_guide_top">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search_guide_red"
            android:layout_marginStart="4dp"/>
        <FrameLayout
            android:layout_width="@dimen/dp_93"
            android:layout_height="@dimen/dp_20">
            <com.wakeup.commonui.view.CustomTextBannerView
                android:id="@+id/hot_search_text_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:setTextColor="@color/color_333333"
                app:setTextSize="@dimen/dp_14"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
