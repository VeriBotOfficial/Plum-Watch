<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_994f4e4d_r12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_166"
    android:layout_marginHorizontal="@dimen/dp_12">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/ic_window_close"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/color_282828"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_trans"
        android:background="@drawable/shape_one_trans_window_btn"
        android:layout_width="@dimen/dp_100"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/language_translate"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/color_282828"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_source"
        android:background="@drawable/sel_source_window_btn"
        android:layout_width="@dimen/dp_100"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/string_display_original"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_trans"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_voice"
        android:layout_width="@dimen/dp_25"
        android:layout_height="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_12"
        android:src="@drawable/ic_ja_voice"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_trans"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/chat_translate_load"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_one_tran_window_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="4"
        android:minLines="2"
        android:layout_marginVertical="@dimen/dp_5"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tv_trans"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"/>
</androidx.constraintlayout.widget.ConstraintLayout>
