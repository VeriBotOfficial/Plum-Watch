<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/hs_s_e_settings"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_260"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/y_layout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_marginStart="@dimen/dp_7"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/x_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+7db"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0db"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-8db"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/x_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/y_layout">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="31"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="62"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="125"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="250"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="500"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1k"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2k"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="4k"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="8k"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="16k"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_6"
            app:layout_constraintBottom_toTopOf="@+id/x_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/y_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="15"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save_eq"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:text="@string/hs_save_setting"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
