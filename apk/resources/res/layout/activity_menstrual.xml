<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuImage="@drawable/home_more"
        app:titleText="@string/menstrual"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/top_layout"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_left"
                        android:padding="10dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/ic_jiantou"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="#666666"
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2022年7月"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_right"
                        android:padding="10dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/ic_jiantou"
                        android:rotation="180"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.haibin.calendarview.CalendarLayout
                    android:orientation="vertical"
                    android:id="@+id/calendar_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:calendar_show_mode="both_month_week_view"
                    app:default_status="expand"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/top_layout">
                    <com.haibin.calendarview.CalendarView
                        android:id="@+id/calendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:calendar_height="55dp"
                        app:current_day_text_color="@color/color_333333"
                        app:day_text_size="16dp"
                        app:month_view="com.wakeup.feature.health.menstrual.view.MenstrualMonthView"
                        app:month_view_show_mode="mode_only_current"
                        app:week_bar_height="40dp"
                        app:week_bar_view="com.wakeup.feature.health.menstrual.view.MenstrualWeekBar"
                        app:week_start_with="sun"
                        app:week_text_color="@color/color_333333"
                        app:week_text_size="12dp"/>
                </com.haibin.calendarview.CalendarLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/calendar_layout">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:background="@drawable/ic_flag_menstrual"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10dp"
                            android:textColor="#999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menstrual_title"
                            android:layout_marginStart="6dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="40dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:background="@drawable/ic_flag_forecast"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10dp"
                            android:textColor="#999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menstrual_forecast"
                            android:layout_marginStart="6dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_pregnancy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:background="@drawable/ic_flag_pregnancy"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10dp"
                            android:textColor="#999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menstrual_pregnancy"
                            android:layout_marginStart="6dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_period"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:background="@drawable/shape_ececec_r999"
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="@dimen/dp_8"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10dp"
                            android:textColor="#999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/assistant_anquanqi"
                            android:layout_marginStart="6dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_reset"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/menstrual_reset"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="22dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_menstrual_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menstrual_title"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#333333"
                    android:id="@+id/tv_tag_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menstrual_tag_1"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_menstrual_value"
                    app:layout_constraintEnd_toStartOf="@+id/tv_menstrual_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/tv_menstrual_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_menstrual_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0519_05"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_menstrual_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_menstrual_value"/>
                <View
                    android:orientation="vertical"
                    android:id="@+id/guideline"
                    android:background="#e6e6e6"
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_cycle_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menstrual_cycle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#333333"
                    android:id="@+id/tv_tag_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menstrual_tag_2"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_cycle_value"
                    app:layout_constraintEnd_toStartOf="@+id/tv_cycle_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/tv_cycle_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="28"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/tv_cycle_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0519_05"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_cycle_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_cycle_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/menstrual_tips1"
                    android:layout_marginStart="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_cycle_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_17"
                android:textStyle="bold"
                android:textColor="@color/color_282828"
                android:id="@+id/tv_adv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/menstrual_des_adb_title"
                android:layout_marginHorizontal="@dimen/dp_24"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_adv"
                android:background="@drawable/shape_white_r12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="12dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
