<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bk_search_history"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_history_particular_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_74"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-10-03"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="共包含3个问答"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/ll_history_particular_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_history_particular_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_history_particular_search"
        android:background="@color/color_f4f6f8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_history_particular_search_back"
            android:background="@drawable/ic_history_particular_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_20"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/shape_ffffff_r24"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/sp_14"
                android:gravity="center_vertical"
                android:background="@null"
                android:paddingBottom="@dimen/dp_25"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_75"
                android:layout_marginLeft="@dimen/dp_19"
                android:hint="继续提问"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_ai_search_speech_to_text"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
