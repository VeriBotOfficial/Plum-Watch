<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_memorandum"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="“Wearft Pro”需要使用麦克风权限"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:id="@+id/tv_tip1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="用于添加支持语音功能的穿戴设备，以及使用语音指令、语音通话和音频传输等功能。若拒绝授权，相关功能将无法使用，但不会影响其他功能。"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_08c261"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:text="允许"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_08c261"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="拒绝"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
