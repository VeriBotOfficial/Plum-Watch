<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/aim_bg_page"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBack"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/aim_ic_back"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/coverBox"
        android:background="@drawable/aim_grad_a"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/aim_ic_music_note"/>
        <ImageView
            android:id="@+id/ivCover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/aim_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:maxLines="1"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coverBox"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/aim_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLrc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/tvCurrent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvArtist"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/aim_text_muted"
        android:id="@+id/tvNoLyrics"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aim_no_lyrics"
        app:layout_constraintBottom_toBottomOf="@+id/rvLrc"
        app:layout_constraintEnd_toEndOf="@+id/rvLrc"
        app:layout_constraintStart_toStartOf="@+id/rvLrc"
        app:layout_constraintTop_toTopOf="@+id/rvLrc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aim_text_muted"
        android:id="@+id/tvCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:fontFamily="monospace"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/seekBar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aim_text_muted"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:fontFamily="monospace"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/seekBar"/>
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:max="1000"
        android:progressDrawable="@drawable/aim_seek_progress"
        android:thumb="@drawable/aim_seek_thumb"
        android:thumbOffset="0dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:splitTrack="false"
        app:layout_constraintBottom_toTopOf="@+id/controlRow"
        app:layout_constraintEnd_toStartOf="@+id/tvDuration"
        app:layout_constraintStart_toEndOf="@+id/tvCurrent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/controlRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/btnMode"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:src="@drawable/aim_ic_mode_loop"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:src="@drawable/aim_ic_prev"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/btnPlayPause"
                android:background="@drawable/aim_bg_cta"
                android:padding="16dp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/aim_ic_play"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:src="@drawable/aim_ic_next"
            android:layout_weight="1"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
