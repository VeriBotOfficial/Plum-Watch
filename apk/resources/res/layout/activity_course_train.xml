<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/start_layout"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/dp_0">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_256"
                    app:layout_collapseMode="parallax"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toolbar">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/topBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_course_detail_default"
                        android:scaleType="centerCrop"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/course_train_mask_bg"
                        android:scaleType="fitXY"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/calorie_layout"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_80"
                        android:layout_marginTop="@dimen/dp_68"
                        app:layout_constraintEnd_toStartOf="@+id/duration_layout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_reliang"/>
                        <TextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/white"
                            android:id="@+id/tvKacl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvFinishCount"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/duration_layout"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_80"
                        app:layout_constraintEnd_toStartOf="@+id/grade_layout"
                        app:layout_constraintStart_toEndOf="@+id/calorie_layout"
                        app:layout_constraintTop_toTopOf="@+id/calorie_layout">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_shichang"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:id="@+id/tvMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/grade_layout"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_80"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/duration_layout"
                        app:layout_constraintTop_toTopOf="@+id/calorie_layout">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/course_desc_28"/>
                        <TextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/ps_color_white"
                            android:id="@+id/tvGrade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_ccffffff"
                        android:id="@+id/tvFinishCount"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_marginStart="@dimen/space_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/ll_menu"
                        android:background="@drawable/shape_33ffffff_50"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_44"
                        android:layout_marginTop="@dimen/dp_20"
                        android:layout_marginHorizontal="@dimen/space_52"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/calorie_layout">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <com.wakeup.commonui.view.thumbsup.ThumbsUpCountView
                                android:layout_gravity="center"
                                android:id="@+id/tv_praise"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                app:thumbsup_off_drawable="@drawable/ic_zan_off"
                                app:thumbsup_off_text_color="@color/white"
                                app:thumbsup_on_drawable="@drawable/ic_zan_on"
                                app:thumbsup_on_show_circle="false"
                                app:thumbsup_on_show_decoration="false"
                                app:thumbsup_on_text_color="@color/white"
                                app:thumbsup_text_size="@dimen/sp_14"/>
                        </FrameLayout>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@color/white"
                            android:layout_width="@dimen/dp_1"
                            android:layout_height="@dimen/dp_15"
                            android:alpha="0.3"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/comment_layout"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/comment"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/comment_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:layout_marginStart="@dimen/dp_4"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@color/white"
                            android:layout_width="@dimen/dp_1"
                            android:layout_height="@dimen/dp_15"
                            android:alpha="0.3"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/share_layout"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_train_share_white"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/share_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:layout_marginStart="@dimen/dp_4"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/toolbar_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="pin">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/back"
                            android:padding="@dimen/dp_15"
                            android:layout_width="@dimen/dp_48"
                            android:layout_height="@dimen/dp_48"
                            android:src="@drawable/ic_back_white"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:paddingEnd="@dimen/dp_20"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/back">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_18"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@+id/title"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:maxWidth="@dimen/dp_250"
                                android:text="HilT 12分钟暴汗燃脂"
                                android:lines="1"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_10"
                                android:textColor="@color/color_AF6800"
                                android:gravity="center"
                                android:id="@+id/tag"
                                android:background="@drawable/ic_vip_tag"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tip_21_0517_01"
                                android:layout_toRightOf="@+id/title"
                                android:layout_marginStart="@dimen/dp_4"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/title"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/connect_device_layout"
                android:background="@drawable/shape_white_top_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/connect_tip_layout"
                    android:background="@drawable/shape_fff5ed_r16"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/connect_device_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_26"
                        android:src="@drawable/ic_course_device_icon"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/color_ff7300"
                        android:gravity="center_vertical"
                        android:id="@+id/connect_device"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/connect_device_tip"
                        android:paddingEnd="@dimen/dp_16"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_666666"
                        android:ellipsize="marquee"
                        android:gravity="start|center_vertical"
                        android:id="@+id/connect_device_desc"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/connect_device_desc"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:layout_marginHorizontal="@dimen/dp_2"
                        app:layout_constraintEnd_toStartOf="@+id/connect_device"
                        app:layout_constraintStart_toEndOf="@+id/connect_device_iv"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_60"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/color_ff7300"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="1dp"
                    app:tabMaxWidth="@dimen/dp_150"
                    app:tabMinWidth="@dimen/dp_100"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/colorTransparent"
                    app:tabSelectedTextColor="@color/color_ff7300"
                    app:tabTextAppearance="@style/tabLayoutTextStyle"
                    app:tabTextColor="@color/color_333333"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.appbar.AppBarLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/start_layout"
        android:background="@color/white"
        android:paddingBottom="@dimen/dp_19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnStart"
            android:background="@drawable/bg_btn_course_start_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/course_tip_16"
            android:layout_marginHorizontal="@dimen/dp_44"
            android:layout_marginVertical="@dimen/dp_11"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_AF6800"
            android:gravity="center"
            android:id="@+id/btnVip"
            android:background="@drawable/shape_ffd05c_r6"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/fatigue_tip_09"
            android:layout_marginHorizontal="@dimen/dp_44"
            android:layout_marginVertical="@dimen/dp_11"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/downloadProgressLayout"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="@+id/btnStart"
            app:layout_constraintEnd_toEndOf="@+id/btnStart"
            app:layout_constraintStart_toStartOf="@+id/btnStart"
            app:layout_constraintTop_toTopOf="@+id/btnStart">
            <ProgressBar
                android:id="@+id/downloadProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/train_download_progress"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_F96623"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
