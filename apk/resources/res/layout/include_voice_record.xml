<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_record_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:id="@+id/et_voice_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/et_voice_record"
        app:layout_constraintEnd_toEndOf="@+id/et_voice_record"
        app:layout_constraintStart_toStartOf="@+id/et_voice_record"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/dp_16"
        android:textColor="@color/white"
        android:gravity="start|top"
        android:id="@+id/et_voice_record"
        android:background="@drawable/shape_ff7300_r12"
        android:padding="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_67"
        android:maxHeight="@dimen/dp_100"
        android:minHeight="@dimen/dp_100"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintBottom_toTopOf="@+id/voice_record_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voice_record_arrow"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_9"
        app:layout_constraintEnd_toEndOf="@+id/et_voice_record"
        app:layout_constraintStart_toStartOf="@+id/et_voice_record"
        app:layout_constraintTop_toBottomOf="@+id/et_voice_record"
        app:srcCompat="@drawable/ic_arrow_down"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_999999"
        android:id="@+id/voice_record_touch_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/chat_gpt_touch_word"
        app:layout_constraintEnd_toEndOf="@+id/et_voice_record"
        app:layout_constraintStart_toStartOf="@+id/et_voice_record"
        app:layout_constraintTop_toBottomOf="@+id/voice_record_arrow"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/voice_recording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_voice_record"
        app:layout_constraintEnd_toEndOf="@+id/et_voice_record"
        app:layout_constraintStart_toStartOf="@+id/et_voice_record"
        app:layout_constraintTop_toTopOf="@+id/voice_state_tv"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/chat_record_anim"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/white"
        android:id="@+id/voice_state_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_gpt_translating"
        app:layout_constraintBottom_toBottomOf="@+id/voice_recording"
        app:layout_constraintEnd_toEndOf="@+id/et_voice_record"
        app:layout_constraintStart_toStartOf="@+id/et_voice_record"
        app:layout_constraintTop_toTopOf="@+id/et_voice_record"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/voice_record_center_cancel"
        android:background="@drawable/shape_round_393d6c"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_54"
        android:layout_marginBottom="@dimen/dp_26"
        android:text="@string/chat_cancel"
        app:layout_constraintBottom_toTopOf="@+id/voice_record_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/voice_record_cancel"
        android:background="@drawable/shape_round_393d6c"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_54"
        android:text="@string/chat_cancel"
        android:layout_marginStart="@dimen/dp_50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_record_center_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/qt_voice_send"
        android:background="@drawable/shape_round_393d6c"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_54"
        android:text="@string/chat_gpt_send"
        android:layout_marginEnd="@dimen/dp_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_record_center_cancel"/>
    <FrameLayout
        android:id="@+id/voice_record_start"
        android:background="@drawable/drawable_record"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_145"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            app:srcCompat="@drawable/ic_gpt_mic"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
