<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_24"
        android:layout_marginHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navi_choose_model_tip"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_btn_map"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_45"
                android:checked="true"
                android:button="@null"
                android:text="@string/map_mode"
                android:drawableEnd="@drawable/select_schedule_reminder"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_btn_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_45"
                android:button="@null"
                android:text="@string/text_mode"
                android:drawableEnd="@drawable/select_schedule_reminder"/>
        </RadioGroup>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/btn_layout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/radio_group">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/qinyou_quxiao"
                android:layout_weight="1"/>
            <View
                android:id="@+id/space"
                android:layout_width="16dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/qinyou_queding"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
