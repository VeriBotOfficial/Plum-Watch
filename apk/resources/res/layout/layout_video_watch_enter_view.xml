<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_view_watch_enter"
    android:background="@drawable/bg_shape_000000_r8"
    android:layout_width="wrap_content"
    android:layout_height="50dp"
    android:paddingHorizontal="6dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llWatchIcon"
        android:background="@drawable/shape_ffffff_r100"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivWatchIcon"
            android:layout_width="@dimen/dp_37"
            android:layout_height="@dimen/dp_37"
            android:scaleType="fitXY"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_watch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="22dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff3c61"
                android:layout_gravity="center"
                android:id="@+id/tv_watch_price"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#d7d7d7"
                android:layout_gravity="center"
                android:id="@+id/tv_watch_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_buy"
        android:background="@drawable/shape_gradient_ff4502_ff6c11_left_right"
        android:layout_width="72dp"
        android:layout_height="26dp"
        android:text="@string/energy_buy"
        android:singleLine="true"
        android:layout_marginStart="8dp"/>
</LinearLayout>
