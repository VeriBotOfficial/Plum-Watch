<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="94dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp">
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:src="@color/grey"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round="15dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/labelsView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginVertical="3dp"
        app:fastScrollEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffaf6800"
        android:gravity="center"
        android:id="@+id/tvType"
        android:background="@drawable/bg_shape_vip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip_21_0517_01"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:id="@+id/tvNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:drawablePadding="5dp"
        android:layout_marginStart="5dp"
        app:drawableStartCompat="@drawable/ic_earphone"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff333333"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCover"/>
</androidx.constraintlayout.widget.ConstraintLayout>
