<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/glasses_s_low_power"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_set_time"
                android:layout_marginStart="16dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/switch_wakeup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                android:layout_marginEnd="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:id="@+id/line1"
            android:background="#56545456"
            android:layout_width="match_parent"
            android:layout_height="0.4dp"
            android:layout_marginHorizontal="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_start"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_10"
                android:layout_marginStart="16dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/tv_start_time"
                android:background="@drawable/shape_e5e5e5_r8"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="09:00"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:id="@+id/line2"
            android:background="#56545456"
            android:layout_width="match_parent"
            android:layout_height="0.4dp"
            android:layout_marginHorizontal="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_end"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_10"
                android:layout_marginStart="16dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/tv_start_end"
                android:background="@drawable/shape_e5e5e5_r8"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="09:00"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
