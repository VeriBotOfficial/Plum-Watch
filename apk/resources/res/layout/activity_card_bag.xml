<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:background="@color/bg"
        app:menuImage="@drawable/add_card"
        app:titleText="@string/device_feature_card"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_bag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="26.5dp"
        android:layout_marginBottom="30dp"/>
</LinearLayout>
