<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f4f6f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_close"
        app:menuText="@string/set_baocun"
        app:menuTextColor="@color/color_F76814"
        app:titleText="@string/app_data"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_button_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5">
        <Button
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button_text_color"
            android:ellipsize="end"
            android:id="@+id/btn_base"
            android:background="@drawable/button_background"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_36"
            android:text="@string/base_data"
            android:maxLines="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_8"
            app:cornerRadius="@dimen/dp_20"/>
        <Button
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button_text_color"
            android:ellipsize="end"
            android:id="@+id/btn_watch"
            android:background="@drawable/button_background"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_36"
            android:text="@string/watch_data"
            android:maxLines="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_4"
            app:cornerRadius="@dimen/dp_20"/>
        <Button
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button_text_color"
            android:ellipsize="end"
            android:id="@+id/btn_ring"
            android:background="@drawable/button_background"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_36"
            android:text="@string/ring_data"
            android:maxLines="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_4"
            app:cornerRadius="@dimen/dp_20"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_16">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_0"
            android:nestedScrollingEnabled="false"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_watch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_16">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_watch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_0"
            android:nestedScrollingEnabled="false"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_ring"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_16">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_0"
            android:nestedScrollingEnabled="false"/>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
