<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_call_record_language"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_play"
        android:background="@drawable/shape_white_r999"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_player"
            android:background="@drawable/ic_call_record_player"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10dp"
            android:gravity="center"
            android:id="@+id/tv_time_current"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_player"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/sb_player"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:maxHeight="4dp"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="4dp"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:splitTrack="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_time_total"
            app:layout_constraintStart_toEndOf="@+id/tv_time_current"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CustomSeekBar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10dp"
            android:gravity="center"
            android:id="@+id/tv_time_total"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/scrollView"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="22dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_play">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black"
            android:id="@+id/tv_content"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ScrollView>
    <FrameLayout
        android:id="@+id/fl_restart"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="@+id/scrollView"
        app:layout_constraintTop_toTopOf="@+id/scrollView">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_call_record_restart"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
