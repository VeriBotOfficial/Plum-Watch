<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/share_layout"
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24dp">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/fl_container"
                    android:layout_width="match_parent"
                    android:layout_height="332dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_map"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="332dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_user"
                    android:background="@drawable/shape_write_r20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_user_avatar"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_margin="@dimen/dp_2"
                        android:src="@mipmap/ic_default"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="#333333"
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_10"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_bottom"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fl_container">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="46dp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:id="@+id/tv_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="#999999"
                        android:id="@+id/tv_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_gongli"
                        android:layout_marginStart="6dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_km"
                        app:layout_constraintStart_toEndOf="@+id/tv_km"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="18dp"
                        android:textColor="#333333"
                        android:id="@+id/tv_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="10dp"
                        android:textColor="#999999"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_type"/>
                    <View
                        android:id="@+id/view_pace_line"
                        android:background="@drawable/shape_line_sport_pace"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#48d95b"
                        android:id="@+id/tv_pace_slowest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_pace_line"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#ff0000"
                        android:id="@+id/tv_pace_fastest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_pace_line"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/ll_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="@dimen/dp_20"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pace_slowest">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sport_excercise_time"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="18dp"
                                android:textStyle="bold"
                                android:textColor="#333333"
                                android:id="@+id/tv_sport_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/tv_sport_pace_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sport_pingjunpeisu"
                                app:layout_constraintStart_toStartOf="@+id/sport_pace_data_layout"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:gravity="start"
                                android:orientation="horizontal"
                                android:id="@+id/sport_pace_data_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_sport_pace_title">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="18dp"
                                    android:textStyle="bold"
                                    android:textColor="#333333"
                                    android:id="@+id/tv_sport_pace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0′0″"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="12dp"
                                    android:textColor="#999999"
                                    android:gravity="start|bottom"
                                    android:id="@+id/tv_sport_pace_unit"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="@string/sport_gonglixiaoshi"
                                    android:layout_marginStart="@dimen/dp_3"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/tv_sport_kcal_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_reliang"
                                app:layout_constraintStart_toStartOf="@+id/sport_kcal_data_layout"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/sport_kcal_data_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_sport_kcal_title">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="18dp"
                                    android:textStyle="bold"
                                    android:textColor="#333333"
                                    android:id="@+id/tv_sport_kcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="12dp"
                                    android:textColor="#999999"
                                    android:id="@+id/tv_sport_kcal_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_qianka"
                                    android:layout_marginStart="4dp"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_sport_kcal"
                                    app:layout_constraintStart_toEndOf="@+id/tv_sport_kcal"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="#f5f5f5"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:paddingHorizontal="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_data">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:background="@drawable/ic_sport_share_logo"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wearfit"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
