<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_black"
        app:background="@color/transp"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_share_gray_black"
        app:titleColor="@color/color_333333"
        app:titleText="@string/share_yulan"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/nestedScrollView"
        android:background="@color/color_f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@color/color_f6f6f6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/color_f6f6f6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_16"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/shape_f6f6f6_r12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp_16"
                android:elevation="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_250">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_share_sleep_bg"
                        android:scaleType="fitXY"
                        app:shapeAppearanceOverlay="@style/chamferTop12dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:layout_marginTop="@dimen/dp_27"
                        android:src="@mipmap/ic_default"
                        android:layout_marginStart="@dimen/dp_22"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textColor="@color/white"
                        android:id="@+id/userName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="冬天里的雪儿"
                        android:maxLength="8"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintStart_toEndOf="@+id/icon"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textColor="@color/white"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:text="6月29日 周二"
                        android:alpha="0.3"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintStart_toEndOf="@+id/icon"
                        app:layout_constraintTop_toBottomOf="@+id/userName"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/sleep_share_bg_iv"
                        android:layout_width="@dimen/dp_180"
                        android:layout_height="@dimen/dp_100"
                        android:layout_marginBottom="@dimen/dp_50"
                        android:src="@drawable/ic_sleep_share_bg"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/dp_20"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_10"
                        app:layout_constraintEnd_toEndOf="@+id/sleep_share_bg_iv"
                        app:layout_constraintStart_toStartOf="@+id/sleep_share_bg_iv"
                        app:layout_constraintTop_toTopOf="@+id/sleep_share_bg_iv">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_32"
                                android:textStyle="bold"
                                android:textColor="@color/color_42FBFE"
                                android:id="@+id/point"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="86"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_12"
                                android:textStyle="bold"
                                android:textColor="@color/color_42FBFE"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_5"
                                android:text="@string/tip_21_1216_02"
                                android:layout_marginStart="@dimen/dp_3"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <RatingBar
                            android:id="@+id/ratingBar"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_15"
                            android:numStars="5"
                            android:rating="1"
                            android:stepSize="0.1"
                            android:isIndicator="true"
                            style="@style/FiveStarsStyle"/>
                        <TextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/white"
                            android:id="@+id/point_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="超过了 92% 的用户"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.wakeup.commonui.chart.lenovo.LenovoSleepChart
                    android:id="@+id/mSleepBarDayChart"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_200"
                    android:layout_marginTop="@dimen/dp_5"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:id="@+id/sleep_color_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginStart="@dimen/dp_30"
                    android:layout_marginEnd="@dimen/dp_30">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:background="@color/color_sleep_wake"
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="@dimen/dp_8"
                            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/color_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wake"
                            android:layout_marginStart="@dimen/dp_3"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_rem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:background="@color/color_sleep_rem"
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="@dimen/dp_8"
                            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/color_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_rem"
                            android:layout_marginStart="@dimen/dp_3"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:background="@color/color_sleep_shallow"
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="@dimen/dp_8"
                            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/color_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/light_sleep"
                            android:layout_marginStart="@dimen/dp_3"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:background="@color/color_sleep_deep"
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="@dimen/dp_8"
                            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_10"
                            android:textColor="@color/color_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/deep_sleep"
                            android:layout_marginStart="@dimen/dp_3"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/sleep_list_layout"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">
                    <include
                        android:id="@+id/sleep_detail_list"
                        android:visibility="visible"
                        layout="@layout/lenovo_layout_sleep_detail_list"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:background="@drawable/shape_f5f5f5_bottom_r12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:src="@mipmap/ic_launcher"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:layout_marginStart="@dimen/dp_10"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
