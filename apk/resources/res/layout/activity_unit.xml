<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/unit_danwei"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_motor_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textGray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lrh_21_1028_01"
            android:layout_marginStart="20dp"
            android:layout_marginVertical="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llItem1"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_gongzhi"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textGray"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_tip1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivItem1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_select_hide"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llItem2"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_yingzhi"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textGray"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_tip2"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivItem2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_select_hide"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_energy_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textGray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lrh_21_1028_02"
            android:layout_marginStart="20dp"
            android:layout_marginVertical="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llItem5"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lrh_21_1027_33"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textGray"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivItem3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_select_hide"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llItem6"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textBlack"
                    android:id="@+id/tv6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_qianka"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textGray"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivItem4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_select_hide"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llItem7"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lrh_21_1027_34"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textGray"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivItem5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_select_hide"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
</LinearLayout>
