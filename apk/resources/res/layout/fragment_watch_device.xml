<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_F4F6F8"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false">
        <androidx.core.widget.NestedScrollView
            android:background="@color/transp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp">
                <com.wakeup.howear.view.device.view.DeviceInfoView
                    android:id="@+id/view_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <com.wakeup.commonui.view.CommonNotifyView
                    android:id="@+id/notify_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <com.wakeup.commonui.view.CommonNotifyView
                    android:id="@+id/audio_notify_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>
                <FrameLayout
                    android:id="@+id/ll_health_dashboard"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="12dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_dashboard_new"
                        android:background="@drawable/bg_health_dashboard_new"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp">
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/tv_dashboard_tag"
                            android:background="@drawable/bg_health_dashboard_new_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="NEW"
                            android:paddingHorizontal="12dp"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/tv_dashboard_new_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="发现适合你的健康模式"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#ccffffff"
                            android:id="@+id/tv_dashboard_new_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="健康数据围绕生活目标，获得 AI个性化洞察"
                            android:maxLines="2"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#6c5ce7"
                            android:gravity="center"
                            android:id="@+id/tv_dashboard_new_cta"
                            android:background="@drawable/bg_health_dashboard_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="12dp"
                            android:text="探索我的模式  →"
                            android:paddingHorizontal="18dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_dashboard_active"
                        android:background="@drawable/bg_health_dashboard_active"
                        android:paddingBottom="6dp"
                        android:visibility="visible"
                        android:clipChildren="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:background="@drawable/bg_health_dashboard_top_bar"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginHorizontal="16dp"/>
                        <RelativeLayout
                            android:paddingBottom="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:paddingHorizontal="18dp">
                            <FrameLayout
                                android:id="@+id/fl_dashboard_icon"
                                android:background="@drawable/bg_health_dashboard_icon_bg"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_centerVertical="true"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:textSize="22sp"
                                    android:gravity="center"
                                    android:id="@+id/tv_dashboard_scene_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="��"/>
                            </FrameLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@+id/fl_dashboard_icon">
                                <TextView
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#1a1d27"
                                    android:id="@+id/tv_dashboard_scene_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="11sp"
                                    android:textColor="#9ca3af"
                                    android:id="@+id/tv_dashboard_scene_days"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#6c5ce7"
                                android:gravity="center"
                                android:id="@+id/tv_dashboard_detail_badge"
                                android:background="@drawable/bg_health_dashboard_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:text="查看详情 ›"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                android:paddingHorizontal="10dp"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="18dp">
                            <com.wakeup.howear.view.device.view.HealthScoreCircleView
                                android:id="@+id/view_dashboard_score_circle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#6c5ce7"
                                    android:id="@+id/tv_dashboard_ai_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✨ AI 洞察"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textColor="#6b7280"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_dashboard_ai_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="点击查看今日健康洞察和个性化行动建议"
                                    android:maxLines="2"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
                <com.wakeup.commonui.ad.ScenarioBannerView
                    android:id="@+id/view_scenario_banner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="12dp"
                    app:bannerCornerRadius="@dimen/space_12"
                    app:cardElevation="1dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/llUserData"
                    android:background="@drawable/shape_white_r12"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="77dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="12dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvStep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_21_0113_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View
                        android:background="@color/line"
                        android:layout_width="0.5dp"
                        android:layout_height="26dp"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvKcal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_qianka"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View
                        android:background="@color/line"
                        android:layout_width="0.5dp"
                        android:layout_height="26dp"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_juli"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.wakeup.feature.device.dial.view.DialNudgeBar
                    android:id="@+id/view_dial_nudge_bar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="7dp"/>
                <com.wakeup.howear.view.device.view.DeviceThemeView
                    android:id="@+id/view_device_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ai_watchface_entry"
                    android:background="@drawable/bg_ai_watchface_entry"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:layout_marginHorizontal="12dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:id="@+id/iv_ai_wf_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ai_watchface"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="#4a3d8f"
                        android:id="@+id/tv_ai_wf_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 表盘玩法"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/iv_ai_wf_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_ai_wf_icon"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="11dp"
                        android:textColor="#8a80b8"
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="赛博朋克 · 照片风格化 · 智能配色 · 表情表盘"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_ai_wf_go"
                        app:layout_constraintStart_toStartOf="@+id/tv_ai_wf_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ai_wf_title"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#7b61ff"
                        android:id="@+id/tv_ai_wf_go"
                        android:background="@drawable/bg_ai_watchface_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="去体验"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_4D4D4D"
                    android:id="@+id/tv_activity"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/devices_activity_zone"
                    android:layout_marginStart="24dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_activity"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="14dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ll_blind_box_entry"
                    android:background="@drawable/bg_blind_box_entry"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="14dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="11sp"
                        android:textColor="@color/color_999999"
                        android:id="@+id/tv_blind_box_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# 表盘 Blind Box"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:id="@+id/tv_blind_box_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="抽表盘盲盒"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_blind_box_tag"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_ec7445"
                        android:id="@+id/tv_blind_box_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="限时活动"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_blind_box_title"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_999999"
                        android:id="@+id/tv_blind_box_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="最热门的表盘都在这～"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_blind_box_subtitle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_blind_box_go"
                        android:background="@drawable/bg_blind_box_go_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="GO"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.wakeup.howear.view.device.view.DeviceFeatureView
                    android:id="@+id/view_device_feature"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.wakeup.howear.view.device.view.DeviceHelpView
                    android:id="@+id/view_device_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.wakeup.howear.view.device.view.DeviceOtherView
                    android:id="@+id/view_device_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="#282828"
                    android:gravity="center"
                    android:id="@+id/tv_delete_device"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/tip_21_0114_3"
                    android:layout_marginHorizontal="12dp"/>
                <TextView
                    android:textSize="@dimen/dp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_282828"
                    android:id="@+id/tv_record"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/tip_21_1129_14"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_wonderful"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_record"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
