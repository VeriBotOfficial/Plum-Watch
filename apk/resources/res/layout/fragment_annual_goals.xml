<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/annual_year_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <TextView
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/annual_total_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5.31"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_ff0000"
        android:gravity="center"
        android:id="@+id/goal_to_low_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:text="@string/annual_goal_to_low"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/goal_achievement_desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/annual1_layout"
        android:background="@drawable/shape_f5f5f5_r6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_35">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_666666"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annual1_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_weight"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <EditText
            android:gravity="center"
            android:id="@+id/annual1_edt"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:maxLength="8"
            android:layout_weight="1"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_999999"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annual1_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_gongli"
            android:layout_marginHorizontal="@dimen/dp_12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/annual2_layout"
        android:background="@drawable/shape_f5f5f5_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_35">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_666666"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annual2_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_mubiao"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <EditText
            android:gravity="center"
            android:id="@+id/annual2_edt"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:maxLength="8"
            android:layout_weight="1"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_999999"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annual2_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_gongli"
            android:layout_marginHorizontal="@dimen/dp_12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/sp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save_annual"
        android:background="@drawable/select_btn_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/save_goal"
        android:layout_marginHorizontal="@dimen/dp_35"
        android:layout_marginVertical="@dimen/dp_12"/>
</androidx.appcompat.widget.LinearLayoutCompat>
