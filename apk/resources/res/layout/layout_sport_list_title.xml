<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/all_type_data_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_128"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_4D4D4D"
            android:id="@+id/all_type_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="总运动"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_26"
            android:textStyle="bold"
            android:textColor="@color/color_4D4D4D"
            android:id="@+id/all_type_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="125"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/all_type_tv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_999999"
            android:id="@+id/all_type_data_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_5"
            android:text="@string/hour"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/all_type_data"
            app:layout_constraintStart_toEndOf="@+id/all_type_data"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/all_type_data">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/all_type_data_1_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/all_type_data_1_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_999999"
                    android:id="@+id/all_type_data_1_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="次"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/all_type_data_2_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/all_type_data_2_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_999999"
                    android:id="@+id/all_type_data_2_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="次"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/all_type_data_3_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_333333"
                    android:id="@+id/all_type_data_3_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_999999"
                    android:id="@+id/all_type_data_3_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="次"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
