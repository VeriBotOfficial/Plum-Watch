<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/qr_jiaru"
        app:titleText="@string/registered_shurumima"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:background="@drawable/shape_white_r8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_glasses_wifi"
                android:layout_marginStart="16dp"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:gravity="center_vertical"
                android:id="@+id/et_ssid"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/glasses_wifi_name"
                android:lines="1"
                android:inputType="text"
                android:textCursorDrawable="@drawable/custom_cursor"
                android:layout_marginHorizontal="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_mima"
                android:layout_marginStart="16dp"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:gravity="center_vertical"
                android:id="@+id/et_pwd"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/glasses_wifi_psd"
                android:lines="1"
                android:inputType="textVisiblePassword"
                android:textCursorDrawable="@drawable/custom_cursor"
                android:layout_marginHorizontal="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="#ff3b30"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/glasses2_set_wifi_tip"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
