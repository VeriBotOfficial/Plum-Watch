<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_main_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/headset_box_ai_video_subtitles"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lan_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_swap"
            android:padding="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tran_swap"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/ll_before"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_swap"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/tv_before_lan"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_zh"
                android:singleLine="true"
                android:drawablePadding="@dimen/dp_7"
                android:marqueeRepeatLimit="marquee_forever"
                android:drawableEnd="@drawable/ic_jiantou_bottom"
                android:layout_marginHorizontal="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/ll_after"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_swap">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/tv_after_lan"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_en"
                android:singleLine="true"
                android:drawablePadding="@dimen/dp_7"
                android:marqueeRepeatLimit="marquee_forever"
                android:drawableEnd="@drawable/ic_jiantou_bottom"
                android:layout_marginHorizontal="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="#cccccc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/lan_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="#999999"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/subtitle_start_record"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lan_layout"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lan_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_start"
        android:background="@drawable/ic_ai_subtitles_s"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
