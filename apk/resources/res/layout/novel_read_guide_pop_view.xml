<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/shape_ffffff_r6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="61dp">
        <FrameLayout
            android:id="@+id/fl_novel_cover"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_61"
            android:layout_marginLeft="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_novel_cover"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_53"
                android:layout_marginLeft="4dp"
                android:src="@drawable/icon_novel_cover"
                android:scaleType="centerCrop"/>
            <ImageView
                android:id="@+id/iv_recommend_novel"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_34"
                android:src="@drawable/icon_novel_recommed"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="师娘，我真不想下山啊！"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:id="@+id/tv_introduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="12万人正在阅读"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_F76814"
            android:gravity="center"
            android:id="@+id/tv_btn"
            android:background="@drawable/shape_ffede3_r40"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_28"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/string_read_novel2"/>
    </LinearLayout>
</FrameLayout>
