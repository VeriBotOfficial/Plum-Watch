<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/view_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:menuExpandImage="@drawable/ic_share_gray_black"
            app:menuImage="@drawable/home_more"
            app:titleText="@string/run_annual_goal_title"/>
        <com.wakeup.commonui.progress.CircleProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/progressBar"
            android:visibility="visible"
            android:layout_width="@dimen/dp_210"
            android:layout_height="@dimen/dp_210"
            android:layout_marginTop="@dimen/dp_20"
            app:circleBgColor="#e9ebed"
            app:circleProgressAColor="@color/color_ff7300"
            app:circleProgressBColor="@color/transparent"
            app:circleWidth="@dimen/dp_15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_title_bar"
            app:openAngle="0"
            app:showSmallPoint="false"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_layout"
            android:layout_width="@dimen/dp_210"
            android:layout_height="@dimen/dp_210"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_title_bar">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/annual_icon"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_40"
                android:src="@drawable/iv_annualrun"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_32"
                android:textStyle="bold"
                android:textColor="@color/color_4D4D4D"
                android:id="@+id/annual_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="0%"
                android:layout_marginHorizontal="@dimen/dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/annual_icon"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/annual_percent_iv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_annual_goal_weight_up"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/annual_percent"
                app:layout_constraintStart_toEndOf="@+id/annual_percent"
                app:layout_constraintTop_toTopOf="@+id/annual_percent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_666666"
                android:id="@+id/annual_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:text="0 / 0公里"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/annual_percent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/completed_iv"
            android:visibility="gone"
            android:layout_width="@dimen/dp_210"
            android:layout_height="@dimen/dp_210"
            android:layout_marginTop="@dimen/dp_20"
            android:src="@drawable/iv_gloal_finish"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_title_bar"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_4D4D4D"
            android:layout_gravity="center"
            android:id="@+id/tv_annual_detail_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="2023/01/01-2023/01/01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_666666"
            android:layout_gravity="center"
            android:id="@+id/tv_annual_detail_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_annual_detail_data"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_accumulate_and_continuous"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginHorizontal="@dimen/dp_14"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_annual_detail_desc">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_accumulate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_continuous"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tv_accumulate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/accumulate_clock_in"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_accumulate_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintStart_toStartOf="@+id/tv_accumulate"
                    app:layout_constraintTop_toBottomOf="@+id/tv_accumulate"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0519_05"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_accumulate_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_accumulate_value"
                    app:layout_constraintTop_toBottomOf="@+id/tv_accumulate"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/dp_41"
                android:layout_marginVertical="@dimen/dp_17"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_continuous"
                app:layout_constraintStart_toEndOf="@+id/cl_accumulate"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_continuous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/cl_accumulate"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tv_continuous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/continuous_clock_in"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_continuous_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintStart_toStartOf="@+id/tv_continuous"
                    app:layout_constraintTop_toBottomOf="@+id/tv_continuous"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0519_05"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_continuous_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_continuous_value"
                    app:layout_constraintTop_toBottomOf="@+id/tv_continuous"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/calendar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_peekHeight="@dimen/dp_220"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/layout_clock_in_calendar"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
