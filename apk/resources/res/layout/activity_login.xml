<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivLogo"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@mipmap/ic_logo_small"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/login_zhanghaodenglu"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginHorizontal="@dimen/dp_30">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:id="@+id/etPhone"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:singleLine="true"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/dp_30"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llPasswordRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginHorizontal="@dimen/dp_30">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:id="@+id/etPassword"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:hint="@string/login_hint_pwd"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textPassword"/>
            <ImageView
                android:id="@+id/ivShowHidePw"
                android:tag="false"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_pwd_hide"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llCodeRow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginHorizontal="@dimen/dp_30">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:textColorHint="@color/textGray"
                android:id="@+id/etCode"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/login_hint_code"
                android:singleLine="true"
                android:maxLength="6"
                android:layout_weight="1"
                android:inputType="number"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_F96623"
                android:gravity="center"
                android:id="@+id/tvGetCode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/registered_fasongyanzhengma"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/dp_30"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_30">
            <TextView
                android:textSize="12sp"
                android:textColor="#f96623"
                android:id="@+id/tvForgetPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_wangjimima"
                android:paddingVertical="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#f96623"
                android:id="@+id/tvSwitchLoginMode"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_sms_login"
                android:layout_marginStart="16dp"
                android:paddingVertical="@dimen/dp_16"
                app:layout_constraintStart_toEndOf="@+id/tvForgetPassword"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff999999"
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llAgreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="30dp">
            <FrameLayout
                android:id="@+id/layout_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="5dp"
                android:paddingVertical="10dp">
                <CheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/agreeCheckBox"
                    android:background="@drawable/select_switch_login"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:button="@null"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/textBlack"
                android:id="@+id/tvTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button
            android:enabled="false"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/btnLogin"
            android:background="@drawable/bg_btn_login_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="20dp"
            android:text="@string/login_denglu"
            android:layout_marginHorizontal="@dimen/dp_30"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp">
            <ImageView
                android:id="@+id/ivOperator"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:src="@drawable/ic_dianxin"/>
            <ImageView
                android:id="@+id/ivWechat"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:src="@drawable/ic_wechat"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"/>
            <ImageView
                android:id="@+id/ivQQ"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:src="@drawable/ic_qq"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
