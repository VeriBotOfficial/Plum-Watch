<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/anim_layout"
    android:background="@color/mini_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.phancy.mini.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="#0f000000"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#888b98"
                        android:id="@+id/auth_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/mini_setting_auth_title"
                        android:maxLines="1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/ic_mini_setting_list_white_bg"
                        android:paddingLeft="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/scope_location"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="150dp"
                                android:text="@string/mini_setting_scope_location"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#888b98"
                                android:gravity="center_vertical"
                                android:id="@+id/scope_location_more"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:maxWidth="150dp"
                                android:text="@string/mini_setting_accept"
                                android:drawableRight="@drawable/ic_mini_setting_list_more"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                            <View
                                android:id="@+id/scope_location_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_bluetooth"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="150dp"
                                android:text="@string/mini_setting_scope_bluetooth"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#888b98"
                                android:gravity="center_vertical"
                                android:id="@+id/scope_bluetooth_more"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:maxWidth="150dp"
                                android:text="@string/mini_setting_accept"
                                android:drawableRight="@drawable/ic_mini_setting_list_more"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                            <View
                                android:id="@+id/scope_bluetooth_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_camera"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_camera"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_camera_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:switch_status="true"/>
                            <View
                                android:id="@+id/scope_camera_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_record"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_record"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_record_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:switch_status="false"/>
                            <View
                                android:id="@+id/scope_record_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_werun"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_werun"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_werun_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                            <View
                                android:id="@+id/scope_werun_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_contact"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_contact"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_contact_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:switch_status="true"/>
                            <View
                                android:id="@+id/scope_contact_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_calendar"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_calendar"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_calendar_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:switch_status="true"/>
                            <View
                                android:id="@+id/scope_calendar_line"
                                android:background="#ddd"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/scope_album"
                            android:layout_width="match_parent"
                            android:layout_height="44dp">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#040919"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mini_setting_scope_album"
                                android:layout_centerVertical="true"/>
                            <com.phancy.mini.widget.SwitchButton
                                android:id="@+id/scope_album_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                android:src="@drawable/ic_mini_switch_button"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/empty_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14dp"
                android:textColor="#888b98"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="208dp"
                android:text="@string/mini_setting_panel_empty"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
