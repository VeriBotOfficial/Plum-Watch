<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivLogo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@mipmap/ic_logo_small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/registered_zhanghaozhuce"/>
    <RelativeLayout
        android:id="@+id/rlRegion"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_30"
        android:contentDescription="海外版需要显示"
        android:layout_marginHorizontal="@dimen/dp_30">
        <TextView
            android:textSize="16sp"
            android:textColor="#999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_tip_01"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#999999"
            android:gravity="center_vertical"
            android:id="@+id/tvCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:drawableEndCompat="@drawable/ic_jiantou_right"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPhone"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/reg_phone_hint"
            android:singleLine="true"
            android:inputType="phone"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/login_hint_code"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_F96623"
            android:gravity="center"
            android:id="@+id/tv_code"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/registered_fasongyanzhengma"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff999999"
        android:layout_gravity="end"
        android:id="@+id/btnLogin"
        android:padding="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_15"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llAgreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginHorizontal="@dimen/dp_30">
        <CheckBox
            android:textColor="@color/textBlack"
            android:id="@+id/cbOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/select_switch_login"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/textBlack"
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
    <Button
        android:enabled="false"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/btnNext"
        android:background="@drawable/bg_btn_login_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="20dp"
        android:text="@string/registered_xiayibu"
        android:layout_marginHorizontal="@dimen/dp_30"/>
</LinearLayout>
