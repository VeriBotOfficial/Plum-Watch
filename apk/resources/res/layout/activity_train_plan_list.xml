<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/course_tip_05"/>
    <com.flyco.tablayout.SlidingTabLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/mSlidingTabLayout"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"
        app:tl_indicator_color="@color/color_ff7300"
        app:tl_indicator_corner_radius="1.5dp"
        app:tl_indicator_height="2dp"
        app:tl_indicator_margin_bottom="10dp"
        app:tl_indicator_width="20dp"
        app:tl_tab_padding="8dp"
        app:tl_tab_space_equal="true"
        app:tl_textSelectColor="@color/color_ff7300"
        app:tl_textUnselectColor="@color/color_666666"
        app:tl_textsize="@dimen/dp_16"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/mViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mSlidingTabLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
