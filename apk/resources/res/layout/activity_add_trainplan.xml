<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/course_tip_48"/>
    <RelativeLayout
        android:id="@+id/progressLayout"
        android:layout_width="@dimen/dp_170"
        android:layout_height="@dimen/dp_170"
        android:layout_marginTop="@dimen/dp_150"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <com.wakeup.commonui.progress.CircleProgressBar
            android:id="@+id/circleProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            app:circleBgColor="#1a707070"
            app:circleProgressAColor="@color/color_fa9632"
            app:circleProgressBColor="@color/transparent"
            app:circleWidth="10dp"
            app:openAngle="0"
            app:showSmallPoint="false"/>
        <View
            android:background="@drawable/shape_fff3ed_round_bg"
            android:layout_width="@dimen/dp_90"
            android:layout_height="@dimen/dp_90"
            android:layout_centerInParent="true"/>
        <View
            android:background="@drawable/shape_ffe2d4_round_bg"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_70"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:src="@mipmap/ic_logo_small"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/space_25"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="0%"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressLayout"/>
    <TextView
        android:textSize="@dimen/space_20"
        android:textColor="@color/color_333333"
        android:id="@+id/tvTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/course_tip_49"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProgress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
