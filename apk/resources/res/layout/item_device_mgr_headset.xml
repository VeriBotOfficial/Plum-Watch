<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_device_type"
        android:background="@drawable/shape_ffffff_r12"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="102dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_device_type"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/black"
            android:id="@+id/tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="设备名称"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_device_type"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_device_type">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_battery_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:background="@drawable/ic_headset_right_black"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_battery_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_battery_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:layout_constraintEnd_toStartOf="@+id/ll_battery_right"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:background="@drawable/ic_headset_left_black"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_battery_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_battery_head"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:layout_constraintEnd_toStartOf="@+id/ll_battery_right"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:background="@drawable/ic_headset_head_black"
                    android:layout_width="22dp"
                    android:layout_height="20dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_battery_head"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_connect"
            android:background="@drawable/shape_fff76814_r8"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_24"
            android:text="连接"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_connecting"
            android:background="@drawable/shape_ff7300_r999"
            android:padding="@dimen/dp_2"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/json_device_connecting"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
