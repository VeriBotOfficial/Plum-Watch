<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/my_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/jacket_m_standard_recording"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/m_d_control"
        android:background="@drawable/shape_white_r999"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/my_title_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/m_d_play"
            android:background="@drawable/ic_m_voice_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/m_d_crrent_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:layout_marginHorizontal="22.5dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/m_d_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:25:23"
            android:layout_marginEnd="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <HorizontalScrollView
        android:id="@+id/hsv_tag_layout"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/m_d_translate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_d_control">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="@color/color_817F7D"
                android:id="@+id/m_d_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_intelligent_summary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@color/color_cccccc"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_d_summary"
                app:layout_constraintStart_toEndOf="@+id/m_d_summary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="@color/color_817F7D"
                android:id="@+id/m_d_xmind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/xmind_title"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_d_summary"
                app:layout_constraintStart_toEndOf="@+id/m_d_summary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@color/color_cccccc"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_d_xmind"
                app:layout_constraintStart_toEndOf="@+id/m_d_xmind"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textColor="@color/color_817F7D"
                android:ellipsize="end"
                android:id="@+id/m_d_old"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_original"
                android:maxLines="1"
                android:layout_marginStart="25dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_d_summary"
                app:layout_constraintStart_toEndOf="@+id/m_d_xmind"
                app:layout_constraintTop_toTopOf="@+id/m_d_summary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_d_translate"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_m_d_trans"
        android:layout_marginEnd="15dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/hsv_tag_layout"
        app:layout_constraintEnd_toStartOf="@+id/m_d_download"
        app:layout_constraintTop_toTopOf="@+id/hsv_tag_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_d_download"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_m_d_download"
        android:layout_marginEnd="20dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/hsv_tag_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hsv_tag_layout"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hsv_tag_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
