<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_main"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_134"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_assets"
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_110"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/roundedCornerStyle"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_assets_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="表盘（1元档）"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_assets"
            app:layout_constraintTop_toTopOf="@+id/iv_assets"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_assets_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="适用1元表盘"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_assets"
            app:layout_constraintTop_toBottomOf="@+id/tv_assets_name"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textStyle="normal"
            android:textColor="@color/color_999999"
            android:id="@+id/tv_assets_validity_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="有效期至2020.06.02"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintStart_toEndOf="@+id/iv_assets"
            app:layout_constraintTop_toBottomOf="@+id/tv_assets_des"/>
        <Button
            android:textSize="@dimen/sp_11"
            android:textColor="@color/white"
            android:id="@+id/btn_status"
            android:background="@drawable/bg_btn_assets_sate_selector"
            android:layout_width="@dimen/dp_89"
            android:layout_height="@dimen/dp_28"
            android:text=""
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_assets"
            app:layout_constraintStart_toEndOf="@+id/iv_assets"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
