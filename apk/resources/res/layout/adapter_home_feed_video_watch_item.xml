<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cl_dial_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_dial_info"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#714807"
                android:gravity="center"
                android:id="@+id/tv_home_feed_dial_tip"
                android:background="@drawable/shape_ffe189_ffe1ae_r12"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="11dp"
                android:text="@string/feed_recommend_dial"
                android:paddingStart="3dp"
                android:paddingEnd="7dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/rl_dial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_home_feed_dial_tip">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_dial_border"
                    android:layout_width="130dp"
                    android:layout_height="134dp"
                    android:src="0x7f080d64"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:layout_centerInParent="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_dial"
                    android:layout_width="99dp"
                    android:layout_height="121dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_dial_name"
                android:background="0x7f08037a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:maxLines="1"
                android:paddingVertical="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rl_dial"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/rl_guide_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_text"
                android:layout_width="match_parent"
                android:layout_height="85dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_714807"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feed_dial_watch_guide_title"
                    android:paddingHorizontal="6dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/color_714807"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/feed_dial_watch_guide"
                    android:paddingHorizontal="6dp"
                    android:lineHeight="15dp"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
