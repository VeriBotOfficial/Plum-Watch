<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingVertical="6dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/aim_text_muted"
        android:gravity="center"
        android:id="@+id/tvIndex"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"/>
    <FrameLayout
        android:id="@+id/coverBox"
        android:background="@drawable/aim_grad_b"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/aim_text"
            android:gravity="center"
            android:id="@+id/tvCoverInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ivCover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/aim_text"
            android:ellipsize="end"
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/aim_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:padding="4dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/aim_ic_play_small"
        android:layout_marginStart="8dp"/>
</LinearLayout>
