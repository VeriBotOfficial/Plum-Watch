<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="图片模板"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="205dp"
        android:layout_height="240dp"
        android:layout_marginTop="120dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_module"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="32dp"
                android:textColor="@color/white"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="07:30"
                app:layout_constraintStart_toStartOf="@+id/fl_bigModel"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 周五"
                app:layout_constraintStart_toStartOf="@+id/tv_time"
                app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
            <FrameLayout
                android:id="@+id/fl_bigModel"
                android:background="@drawable/shape_dail_module_frame"
                android:layout_width="152dp"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bigModel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_model1"
                android:background="@drawable/shape_dail_module_frame"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="@+id/fl_bigModel"
                app:layout_constraintTop_toBottomOf="@+id/fl_bigModel">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_model1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_model2"
                android:background="@drawable/shape_dail_module_frame"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/fl_model1"
                app:layout_constraintTop_toBottomOf="@+id/fl_bigModel">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_model2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_model3"
                android:background="@drawable/shape_dail_module_frame"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/fl_model2"
                app:layout_constraintTop_toBottomOf="@+id/fl_bigModel">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_model3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="center"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="#999999"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="可以点击虚线框选的部分进行编辑"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_install"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/tip56"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
