<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/mTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menuExpandImage="@drawable/ic_calendar_black"
            app:menuImage="@drawable/home_more"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="48dp">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_sport_title"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_mode_selector"
                android:background="@drawable/shape_eef0ff_r8"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#6c63ff"
                    android:id="@+id/tv_current_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/insight_mode_general"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_down_purple"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_layout"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_left"
            android:padding="3dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_zuo_jiantou"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:src="0x7f0807bf"
                android:layout_marginStart="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <ImageView
            android:id="@+id/iv_right"
            android:padding="3dp"
            android:visibility="invisible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_zuo_jiantou"
            android:rotation="180"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_ai_insight"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_playing_bar"
                    android:background="#6c63ff"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_speaker"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_volume_white"/>
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播报中"
                        android:layout_marginStart="6dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_persona_name"
                        android:background="@drawable/shape_33ffffff_r6"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="【湾湾小荷】"
                        android:drawableEnd="@drawable/ic_chevron_down_white"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#e0ddff"
                        android:ellipsize="end"
                        android:id="@+id/tv_playing_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="正在为你播报健康状况"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"/>
                    <ImageView
                        android:id="@+id/iv_stop_audio"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_zap"
                        android:alpha="0.8"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_tabs"
                    android:paddingTop="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_playing_bar">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/tab_insight"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/icon_tab_insight"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_brain_tab"/>
                            <TextView
                                android:textSize="13dp"
                                android:textStyle="bold"
                                android:textColor="#6c63ff"
                                android:id="@+id/tv_tab_insight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/insight_tab_insight"
                                android:layout_marginStart="5dp"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/indicator_insight"
                            android:background="@drawable/shape_tab_indicator_purple"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/tab_actions"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/icon_tab_actions"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_zap"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="#9ca3af"
                                android:id="@+id/tv_tab_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/insight_tab_actions"
                                android:layout_marginStart="5dp"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/indicator_actions"
                            android:background="@drawable/shape_tab_indicator_purple"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/iv_speaker_muted"
                        android:padding="12dp"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_volume_off_purple"/>
                </LinearLayout>
                <View
                    android:background="#f1f3f5"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_tabs"/>
                <FrameLayout
                    android:id="@+id/fl_insight_content"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_tabs">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/ll_insight_loading"
                        android:padding="16dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminateTint="#6c63ff"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#9ca3af"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/insight_loading"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#9ca3af"
                        android:gravity="center"
                        android:id="@+id/tv_insight_error"
                        android:padding="16dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/insight_error_retry"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#333333"
                        android:id="@+id/tv_insight_text"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.6"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_actions_content"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="12dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.wakeup.commonui.view.ArcProcessView
                        android:id="@+id/arc_progress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="22dp"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:id="@+id/tv_step_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="@color/color_333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_21_0113_2"
                        app:layout_constraintBottom_toTopOf="@+id/tv_step_value"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="@color/color_333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ke_21_8_18_10"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_step_value"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_kcal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_duration_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_kcal_flag"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_target_kcal_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_kcal_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_kcal_value"
                    app:layout_constraintTop_toTopOf="@+id/tv_kcal_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="4dp"
                    android:layout_marginVertical="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_count_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_duration_flag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_kcal_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_target_duration_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_duration_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_duration_value"
                    app:layout_constraintTop_toTopOf="@+id/tv_duration_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_count_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_count_flag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_duration_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_target_count_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_count_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_count_value"
                    app:layout_constraintTop_toTopOf="@+id/tv_count_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_kcal_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="60dp"
                    android:text="@string/tip_21_0625_liu_2"
                    android:maxLines="2"
                    android:layout_marginStart="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_kcal_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_kcal_value"/>
                <View
                    android:background="@drawable/shape_line_kcal"
                    android:layout_width="21dp"
                    android:layout_height="3dp"
                    app:layout_constraintStart_toStartOf="@+id/tv_kcal_flag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_kcal_flag"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_duration_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="60dp"
                    android:text="@string/user_exercise_duration"
                    android:maxLines="2"
                    android:layout_marginStart="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_duration_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_duration_value"/>
                <View
                    android:background="@drawable/shape_line_duration"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    app:layout_constraintStart_toStartOf="@+id/tv_duration_flag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_duration_flag"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_count_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="60dp"
                    android:text="@string/home_sport_count"
                    android:maxLines="2"
                    android:layout_marginStart="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_count_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_count_value"/>
                <View
                    android:background="@drawable/shape_line_count"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    app:layout_constraintStart_toStartOf="@+id/tv_count_flag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_count_flag"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="12dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:background="#8793ff"
                    android:layout_width="4dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/roundImageStyle_2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tip_21_0113_2"
                    android:layout_marginStart="34dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_current_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:text="--"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_666666"
                    android:id="@+id/tv_target_step_chart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_current_step"
                    app:layout_constraintStart_toEndOf="@+id/tv_current_step"/>
                <com.wakeup.commonui.chart.DailyBarChart
                    android:id="@+id/chart_view_step"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_step_max"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_current_step"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="@color/color_999999"
                    android:id="@+id/tv_step_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/chart_view_step"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="@color/color_999999"
                    android:id="@+id/tv_step_mid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/chart_view_step"
                    app:layout_constraintStart_toStartOf="@+id/tv_step_max"
                    app:layout_constraintTop_toTopOf="@+id/chart_view_step"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="12dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:background="#ff7300"
                    android:layout_width="4dp"
                    android:layout_height="15dp"
