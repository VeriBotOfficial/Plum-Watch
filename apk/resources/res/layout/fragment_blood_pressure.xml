<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_left"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tv_title_date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/single_value_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/textBlack"
                android:id="@+id/tv_bp_type"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_xueya"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_bp_value"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="@color/textBlack"
                android:id="@+id/tv_bp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/tv_bp_type"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/textBlack"
                android:id="@+id/tv_bp_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mmHg"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_bp_value"
                app:layout_constraintStart_toEndOf="@+id/tv_bp_value"/>
            <View
                android:id="@+id/view_value_divider"
                android:background="#d3d3d3"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_bp_unit"
                app:layout_constraintStart_toEndOf="@+id/tv_bp_unit"
                app:layout_constraintTop_toTopOf="@+id/tv_bp_unit"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/textBlack"
                android:id="@+id/tv_bp_value_type"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_bp_unit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/view_value_divider"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/layout_pulse"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bp_value">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/textBlack"
                    android:id="@+id/tv_pulse_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bp_pulse"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_pulse_value"
                    app:layout_constraintEnd_toStartOf="@+id/tv_pulse_value"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="32dp"
                    android:textStyle="bold"
                    android:textColor="@color/textBlack"
                    android:id="@+id/tv_pulse_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_pulse_unit"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/tv_pulse_type"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/textBlack"
                    android:id="@+id/tv_pulse_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_num_minute"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_pulse_value"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_pulse_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date"
            android:background="@color/white"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_heart_arrow_down"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.wakeup.commonui.chart.IndicatorLineChart
            android:id="@+id/chartView"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="12dp">
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/color_bp_high"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bp_value_type_high"
                android:layout_marginHorizontal="20dp"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            app:cardBackgroundColor="@color/color_bp_low"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bp_value_type_low"
                android:layout_marginHorizontal="20dp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp">
        <include
            android:id="@+id/card_bg_range"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            layout="@layout/item_health_page_card"/>
        <include
            android:id="@+id/card_bg_avg"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            layout="@layout/item_health_page_card"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
