<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_F4F6F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false">
        <androidx.core.widget.NestedScrollView
            android:background="@color/transp"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp">
                <com.wakeup.howear.view.device.view.DeviceInfoView
                    android:id="@+id/view_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <com.wakeup.commonui.view.CommonNotifyView
                    android:id="@+id/notify_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/translate_layout"
                    android:background="@drawable/shape_white_r14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingVertical="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:scrollbarStyle="outsideOverlay"
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_9a9a9a"
                        android:textColorHint="@color/color_6A6A6A"
                        android:id="@+id/tv_ts_content"
                        android:focusable="true"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_150"
                        android:hint="@string/sound_tran_tip"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/container_speak_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ts_content">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/speak_layout"
                            android:background="@drawable/ic_speak_bg"
                            android:visibility="visible"
                            android:layout_width="@dimen/dp_156"
                            android:layout_height="@dimen/dp_44"
                            android:paddingHorizontal="@dimen/dp_10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_translation_nor"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_14"
                                android:textStyle="bold"
                                android:textColor="@color/color_282828"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sound_tran_btn"
                                android:maxLines="1"
                                android:layout_marginStart="@dimen/dp_5"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/record_layout"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <View
                                android:id="@+id/record_bg_view"
                                android:background="@drawable/shape_record_btn"
                                android:layout_width="@dimen/dp_156"
                                android:layout_height="@dimen/dp_44"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_translation_fill"
                                app:layout_constraintBottom_toBottomOf="@+id/record_bg_view"
                                app:layout_constraintEnd_toEndOf="@+id/record_bg_view"
                                app:layout_constraintStart_toStartOf="@+id/record_bg_view"
                                app:layout_constraintTop_toTopOf="@+id/record_bg_view"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.wakeup.commonui.view.AiEnergyExpendView
                        android:id="@+id/aee_ts"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="-10dp"
                        app:layout_constraintBottom_toTopOf="@+id/container_speak_layout"
                        app:layout_constraintEnd_toEndOf="@+id/container_speak_layout"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/record_animate_layout"
                        android:background="@drawable/shape_ff7300_r12"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_166"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginBottom="@dimen/dp_6"
                        android:paddingHorizontal="@dimen/dp_10"
                        app:layout_constraintBottom_toTopOf="@+id/container_speak_layout"
                        app:layout_constraintEnd_toEndOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_record_timing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0s"/>
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/input_speak_anim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_10"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/chat_translate_load"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_voice"
                        app:layout_constraintBottom_toBottomOf="@+id/container_speak_layout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/container_speak_layout"/>
                    <View
                        android:id="@+id/line"
                        android:background="@color/color_BABABA"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginTop="@dimen/dp_12"
                        android:alpha="0.5"
                        app:layout_constraintTop_toBottomOf="@+id/container_speak_layout"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_sound_swap"
                        android:padding="@dimen/dp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_swap"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_first_lan"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_first_lan"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_282828"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_first_lan"
                        android:background="@drawable/shape_f9e5cf_r8"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginTop="@dimen/dp_12"
                        android:text="@string/headphone_chinese_language"
                        android:maxLines="2"
                        android:drawableEnd="@drawable/ic_sound_arrow_down"
                        android:layout_marginEnd="@dimen/dp_9"
                        android:paddingHorizontal="@dimen/dp_16"
                        app:layout_constraintEnd_toStartOf="@+id/iv_sound_swap"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_282828"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_second_lan"
                        android:background="@drawable/shape_f9e5cf_r8"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginTop="@dimen/dp_12"
                        android:text="@string/headphone_english_language"
                        android:maxLines="2"
                        android:drawableEnd="@drawable/ic_sound_arrow_down"
                        android:layout_marginStart="@dimen/dp_9"
                        android:paddingHorizontal="@dimen/dp_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_sound_swap"
                        app:layout_constraintTop_toBottomOf="@+id/line"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_sim_inter"
                        android:background="@drawable/ic_interpert_bg"
                        android:padding="@dimen/dp_16"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_894B18"
                            android:ellipsize="end"
                            android:id="@+id/tv_sim_inter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_sim_inter"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_894B18"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/sound_sim_desc"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_sim_inter"
                            app:layout_constraintTop_toBottomOf="@+id/tv_sim_inter"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_FF8701"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_sim_inter"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/sound_start_tran"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_white_noise"
                        android:background="@drawable/ic_ai_write_noice_bg"
                        android:padding="@dimen/dp_16"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_5A4AA5"
                            android:ellipsize="end"
                            android:id="@+id/tv_white_noise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fatigue_tip_32"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_5A4AA5"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/string_write_noise_tip"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_white_noise"
                            app:layout_constraintTop_toBottomOf="@+id/tv_white_noise"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_644BD7"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_white_noise"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/string_write_noise_btn"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ai_create_music"
                        android:background="@drawable/ic_ai_music_bg"
                        android:padding="@dimen/dp_16"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_863B3B"
                            android:ellipsize="end"
                            android:id="@+id/tv_create_music"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_music_name"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_863B3B"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/ai_music_desc"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_create_music"
                            app:layout_constraintTop_toBottomOf="@+id/tv_create_music"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_FD8181"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_create_music"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/ai_music_btn"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_ai_robot"
                        android:background="@drawable/ic_ai_robot_bg"
                        android:padding="@dimen/dp_16"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_4651B2"
                            android:ellipsize="end"
                            android:id="@+id/tv_ai_robot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name_ai"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_4651B2"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/ai_robot_desc"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_ai_robot"
                            app:layout_constraintTop_toBottomOf="@+id/tv_ai_robot"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_8A96FF"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_ai_robot"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/ai_robot_btn"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.wakeup.howear.view.device.view.DeviceThemeView
                    android:id="@+id/view_device_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"/>
                <com.wakeup.howear.view.device.view.DeviceFeatureView
                    android:id="@+id/view_device_feature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.wakeup.howear.view.device.view.DeviceHelpView
                    android:id="@+id/view_device_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.wakeup.howear.view.device.view.DeviceOtherView
                    android:id="@+id/view_device_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="#282828"
                    android:gravity="center"
                    android:id="@+id/tv_delete_device"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/tip_21_0114_3"
                    android:layout_marginHorizontal="12dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
