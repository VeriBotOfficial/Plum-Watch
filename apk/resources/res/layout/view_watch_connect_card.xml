<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_watch_face"
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_marginTop="@dimen/dp_12"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/connect_layout"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/device_reconnect"
            android:background="@drawable/shape_gradient_ff6a00_ff8c41_left_right"
            android:visibility="gone"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26"
            android:text="@string/device_chongxinlianjie"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_connecting"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:visibility="gone"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26">
            <View
                android:id="@+id/connecting_image"
                android:background="@drawable/shape_ring_gradient_fa7d22_ffffff"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_26"
                android:text="@string/device_connecting"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_connected"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:visibility="gone"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26">
            <View
                android:background="@drawable/layer_list_circle_r5_circl5_r2"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:id="@+id/tv_connected"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_26"
                android:text="@string/device_yilianjie"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
    <Space
        android:id="@+id/space_dial_tag"
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toEndOf="@+id/iv_watch_face"
        app:layout_constraintTop_toTopOf="@+id/iv_watch_face"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_device_name_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_watch_face"
        app:layout_constraintTop_toBottomOf="@+id/space_dial_tag">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:id="@+id/tv_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_battery"
            android:layout_width="24dp"
            android:layout_height="13dp"
            android:scaleType="fitXY"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@android:color/black"
            android:id="@+id/tv_battery"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@android:color/black"
        android:id="@+id/tv_dial_slogan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/watch_connect_dial_slogan"
        android:alpha="0.6"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_dial_market"
        app:layout_constraintStart_toEndOf="@+id/iv_watch_face"
        app:layout_constraintTop_toBottomOf="@+id/ll_device_name_row"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_dial_market"
        android:background="@drawable/bg_watch_connect_dial_market"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="@string/watch_connect_go_dial_market"
        android:includeFontPadding="false"
        android:paddingStart="9dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dial_slogan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_dial_slogan"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_metrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_watch_face">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_daily_sport"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <include
                android:id="@+id/row_step"
                layout="@layout/view_watch_connect_metric_row"/>
            <include
                android:id="@+id/row_kcal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                layout="@layout/view_watch_connect_metric_row"/>
            <include
                android:id="@+id/row_sport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                layout="@layout/view_watch_connect_metric_row"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/ll_recovery_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="67dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_home_v2_recovery_flame"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#4b2306"
                    android:gravity="center"
                    android:id="@+id/tv_recovery_score"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:includeFontPadding="false"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@android:color/black"
                android:id="@+id/tv_recovery_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/watch_connect_recovery_score"
                android:includeFontPadding="false"
                android:alpha="0.6"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
