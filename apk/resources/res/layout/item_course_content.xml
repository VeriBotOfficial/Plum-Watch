<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_160"
    android:layout_marginBottom="@dimen/dp_12">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f080716"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffffff"
        android:id="@+id/tvKcal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvPraise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="0"
        app:drawableStartCompat="@drawable/ic_course_praise"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvName"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tvComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginStart="@dimen/dp_12"
        app:drawableStartCompat="@drawable/ic_course_comment"
        app:layout_constraintBottom_toBottomOf="@+id/tvPraise"
        app:layout_constraintStart_toEndOf="@+id/tvPraise"
        app:layout_constraintTop_toTopOf="@+id/tvPraise"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tvShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginStart="@dimen/dp_12"
        app:drawableStartCompat="@drawable/ic_course_share"
        app:layout_constraintBottom_toBottomOf="@+id/tvPraise"
        app:layout_constraintStart_toEndOf="@+id/tvComment"
        app:layout_constraintTop_toTopOf="@+id/tvPraise"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/freeIv"
        android:background="@drawable/ic_train_label_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/freeTv"
        app:layout_constraintEnd_toEndOf="@+id/freeTv"
        app:layout_constraintStart_toStartOf="@+id/freeTv"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/color_AF6800"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/freeTv"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_55"
        android:text="vip"
        android:lines="1"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
