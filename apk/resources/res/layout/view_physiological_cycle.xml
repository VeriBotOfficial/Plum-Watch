<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_data"
        android:background="@drawable/bg_white_8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_heart_rate"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_physiological_cycle_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_11"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/ll_physiological_cycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ff000000"
                        android:id="@+id/tv_physiological_text_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_view_physiological_cycle_text_1"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:id="@+id/tv_physiological_value_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ff000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_view_physiological_cycle_text_2"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ff000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_view_physiological_cycle_text_3"
                        android:singleLine="false"
                        android:layout_marginStart="@dimen/dp_24"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ff000000"
                        android:id="@+id/tv_physiological_text_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_view_physiological_cycle_text_4"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:id="@+id/tv_physiological_value_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ff000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_view_physiological_cycle_text_2"
                        android:singleLine="false"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#999999"
                    android:id="@+id/tv_physiological_cycle_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_23"
                    android:text="2024/10/9"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_physiological_tag"
                android:background="@drawable/ic_physiological_blue"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_56"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_empty"
        android:background="@drawable/bg_white_8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_heart_rate"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_physiological_cycle_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_11"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/none_data"
                    android:singleLine="false"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_23"
                    android:text="-"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_physiological_empty"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_56"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_add"
        android:background="@drawable/ic_home_increase"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_del"
        android:background="@drawable/ic_home_reduce"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
</FrameLayout>
