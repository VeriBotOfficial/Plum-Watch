<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@mipmap/ic_logo_small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/registered_shezhidenglumima"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="24dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/login_hint_pwd"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="textPassword"/>
        <ImageView
            android:id="@+id/ivShowHidePw"
            android:tag="0"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_pwd_hide"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="24dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="24dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPassword2"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/login_hint_pwd_again"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="textPassword"/>
        <ImageView
            android:id="@+id/ivShowHidePw2"
            android:tag="0"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_pwd_hide"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="24dp"/>
    <Button
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/btnOk"
        android:background="@drawable/bg_btn_login_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/qinyou_queding"
        android:layout_marginHorizontal="24dp"/>
</LinearLayout>
