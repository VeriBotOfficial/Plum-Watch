<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/diabetes_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleColor="#111111"
        app:titleText="@string/diabetes_risk_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/diabetes_text_hint"
        android:id="@+id/tv_lifestyle_subtitle"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diabetes_lifestyle_subtitle"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_progress"
        android:background="@color/white"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp">
                <View
                    android:id="@+id/bar_step_1"
                    android:background="@drawable/shape_diabetes_progress_active"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/diabetes_purple_primary"
                    android:gravity="center"
                    android:id="@+id/tv_step_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diabetes_step_blood_lipid"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp">
                <View
                    android:id="@+id/bar_step_2"
                    android:background="@drawable/shape_diabetes_progress_inactive"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/diabetes_progress_label_inactive"
                    android:gravity="center"
                    android:id="@+id/tv_step_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diabetes_step_liver"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_step_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp">
                <View
                    android:id="@+id/bar_step_3"
                    android:background="@drawable/shape_diabetes_progress_inactive"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/diabetes_progress_label_inactive"
                    android:gravity="center"
                    android:id="@+id/tv_step_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diabetes_step_lifestyle"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/scroll_lifestyle"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lifestyle_fields_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <ScrollView
            android:id="@+id/scroll_mode_select"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/diabetes_text_hint"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diabetes_select_mode"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_upload_mode"
                    android:background="@drawable/shape_diabetes_ai_card"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:foreground="?android:attr/selectableItemBackground">
                    <FrameLayout
                        android:background="@drawable/shape_diabetes_mode_icon_bg"
                        android:layout_width="52dp"
                        android:layout_height="52dp">
                        <TextView
                            android:textSize="22sp"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="��"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diabetes_risk_upload"/>
                            <TextView
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/diabetes_accent_soft"
                                android:background="@color/diabetes_accent_tag_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diabetes_upload_ai_tag"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/diabetes_accent_muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/diabetes_upload_desc"
                            android:lineSpacingExtra="2dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/diabetes_accent_soft"
                                android:background="@drawable/shape_diabetes_tag_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diabetes_tag_pdf"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/diabetes_accent_soft"
                                android:background="@drawable/shape_diabetes_tag_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diabetes_tag_report"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_manual_mode"
                    android:background="@drawable/shape_diabetes_card_outline"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:foreground="?android:attr/selectableItemBackground">
                    <FrameLayout
                        android:background="#f5f5f5"
                        android:layout_width="52dp"
                        android:layout_height="52dp">
                        <TextView
                            android:textSize="22sp"
                            android:textColor="#555555"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✎"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diabetes_risk_manual"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/diabetes_text_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/diabetes_manual_desc"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/shape_diabetes_feature_tip_bg"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="��"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/diabetes_purple_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_ai_model_tip"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/scroll_upload"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/upload_empty_zone"
                    android:background="@drawable/shape_diabetes_upload_zone_bg"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:background="@drawable/shape_diabetes_icon_circle"
                            android:layout_width="64dp"
                            android:layout_height="64dp">
                            <TextView
                                android:textSize="28sp"
                                android:textColor="@color/white"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⬆"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/diabetes_purple_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/diabetes_upload_pick"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/diabetes_text_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/diabetes_upload_pdf_only"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/diabetes_purple_primary"
                            android:background="@drawable/shape_diabetes_tag_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/diabetes_upload_select_pdf"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/upload_file_card"
                    android:background="@drawable/shape_diabetes_card_outline"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/upload_files_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#22c55e"
                        android:id="@+id/tv_file_ready"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/diabetes_file_ready"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/diabetes_text_hint"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/diabetes_reupload_hint"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/diabetes_purple_primary"
                        android:background="@color/diabetes_purple_light"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/diabetes_upload_ai_hint"/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/btn_start_parse"
                        android:background="@drawable/shape_diabetes_btn_primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/diabetes_upload_start"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/diabetes_text_hint"
                        android:gravity="center"
                        android:id="@+id/btn_reselect_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/diabetes_reselect_file"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/diabetes_text_hint"
                    android:background="#f9f9f9"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_upload_local_hint"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:gravity="center"
                    android:id="@+id/btn_upload_manual"
                    android:background="@drawable/shape_diabetes_card_outline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_risk_manual"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_processing"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/diabetes_processing_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/diabetes_purple_primary"
                android:id="@+id/tv_processing_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/diabetes_processing_status_1"/>
            <ProgressBar
                android:id="@+id/progress_parse"
                android:layout_width="240dp"
                android:layout_height="6dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="0"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/diabetes_accent_soft"
                android:id="@+id/tv_processing_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0%"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_upload_failed"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/shape_diabetes_parse_fail_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="✕"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/diabetes_parse_failed_title"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_parse_failed_reason"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#c2410c"
                    android:background="#fff8f0"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_parse_failed_suggest"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_failed_reupload"
                    android:background="@drawable/shape_diabetes_btn_primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/diabetes_reupload"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:gravity="center"
                    android:id="@+id/btn_failed_manual"
                    android:background="@drawable/shape_diabetes_card_outline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_manual_fill"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/scroll_upload_review"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_diabetes_ai_card"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/tv_parse_success_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/diabetes_accent_muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/diabetes_parse_success_hint"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_diabetes_card_outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/diabetes_parse_preview_title"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/parse_preview_container"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/diabetes_purple_primary"
                    android:background="@color/diabetes_purple_light"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diabetes_parse_lifestyle_hint"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/scroll_manual"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manual_fields_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:background="@color/white"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_next"
            android:background="@drawable/shape_diabetes_btn_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/diabetes_next"/>
    </LinearLayout>
</LinearLayout>
