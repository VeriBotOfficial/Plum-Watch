<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_chat_item"
    android:paddingTop="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_chat_qt_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_chat_user_head"
            android:layout_width="@dimen/dp_41"
            android:layout_height="@dimen/dp_41"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_chat_user_content_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_61"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/item_chat_user_head"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/item_chat_user_head">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/item_chat_user_content"
                android:background="@drawable/shape_ff7300_r12"
                android:padding="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dp_21"
                android:minHeight="@dimen/dp_41"
                android:textIsSelectable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/item_chat_user_again_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="#393d6c"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:layout_constraintStart_toStartOf="@+id/item_chat_user_content"
                app:layout_constraintTop_toBottomOf="@+id/item_chat_user_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11dp"
                    android:textColor="#ff7300"
                    android:gravity="center_vertical"
                    android:id="@+id/item_chat_user_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_gpt_re_ask"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="3dp"/>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_chat_an_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/item_chat_qt_layout">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_chat_gpt_head"
            android:layout_width="@dimen/dp_41"
            android:layout_height="@dimen/dp_41"
            android:scaleType="fitXY"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_chat_gpt"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_chat_gpt_content_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_41"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_chat_gpt_head"
            app:layout_constraintTop_toTopOf="@+id/item_chat_gpt_head">
            <androidx.appcompat.widget.AppCompatEditText
                android:enabled="false"
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:gravity="center_vertical"
                android:id="@+id/item_chat_gpt_content"
                android:background="@drawable/shape_ffffff_r12"
                android:padding="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_240"
                android:layout_marginEnd="61dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11dp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/item_chat_gpt_remind"
                android:background="@drawable/shape_ffffff_r12"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:minWidth="@dimen/dp_94"
                android:minHeight="@dimen/dp_26"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_chat_gpt_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11dp"
                android:textColor="@color/color_666666"
                android:gravity="center_vertical"
                android:id="@+id/item_chat_gpt_share"
                android:background="@drawable/shape_ffffff_r12"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:minWidth="@dimen/dp_59"
                android:minHeight="@dimen/dp_26"
                android:text="@string/fenxiang"
                android:drawablePadding="@dimen/dp_4"
                android:drawableStart="@drawable/icon_chat_gpt_share"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/item_chat_gpt_remind"
                app:layout_constraintTop_toBottomOf="@+id/item_chat_gpt_content"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_chat_gpt_play"
                android:background="@drawable/ic_chat_gpt_play"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@+id/item_chat_gpt_content"
                app:layout_constraintTop_toTopOf="@+id/item_chat_gpt_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_chat_gpt_loading_layout"
            android:background="@drawable/shape_ffffff_r12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_94"
            android:minHeight="@dimen/dp_41"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintStart_toEndOf="@+id/item_chat_gpt_head"
            app:layout_constraintTop_toTopOf="@+id/item_chat_gpt_head">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_chat_gpt_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
