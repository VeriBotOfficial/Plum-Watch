<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/status_bar_layout"
        layout="@layout/status_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/agree_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_88"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/space_layout"
            android:background="@drawable/shape_line_space"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_5"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/space"
            android:layout_width="0.1dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvKnow"
            android:background="@drawable/shape_ff7300_r6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/tip38"
            android:layout_marginStart="@dimen/dp_33"
            android:layout_marginEnd="@dimen/dp_33"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_layout"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/shape_e3e3e3_r6"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_50"
            android:text="@string/btn_cancel"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/space"
            app:layout_constraintTop_toBottomOf="@+id/space_layout"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ps_color_white"
            android:gravity="center"
            android:id="@+id/agree"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_50"
            android:text="@string/privacy_tip6"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/space"
            app:layout_constraintTop_toBottomOf="@+id/space_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivLogo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/dp_80"
        android:src="@mipmap/ic_logo_small"
        android:layout_below="@+id/status_bar_layout"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_34"
        android:text="@string/privacy_title_new"
        android:layout_below="@+id/ivLogo"
        android:layout_centerHorizontal="true"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/privacy_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_above="@+id/agree_layout"
        android:layout_below="@+id/tvTitle"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black"
                android:id="@+id/privacy_content"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/privacy_desc_new"
                android:lineSpacingExtra="9dp"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:id="@+id/agree_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_999999"
                android:id="@+id/person_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_999999"
                android:id="@+id/sport_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_999999"
                android:id="@+id/health_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_999999"
                android:id="@+id/conventional_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/permission_scrollview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_above="@+id/agree_layout"
        android:layout_below="@+id/tvTitle"
        android:layout_marginStart="@dimen/dp_33"
        android:layout_marginEnd="@dimen/dp_33">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_permission_title"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_camera"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_camera_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_storage"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_storage_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_location"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_location_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_mike"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_mike_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_phone"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_phone_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_contacts"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_contacts_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_record"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_record_desc"/>
                <View
                    android:background="#efefef"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_15"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_permission_sms"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/privacy_permission_sms_desc"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
