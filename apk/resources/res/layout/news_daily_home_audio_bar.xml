<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/news_daily_audio_bar"
    android:background="@drawable/bg_news_audio_bar"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:elevation="2dp">
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">
        <View
            android:background="@drawable/bg_news_vinyl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/news_daily_bar_cover"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textColor="#9ca3af"
                android:id="@+id/news_daily_bar_recent_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/news_daily_just_listened"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f97316"
                android:ellipsize="end"
                android:id="@+id/news_daily_bar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#9ca3af"
                android:id="@+id/news_daily_bar_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#374151"
            android:ellipsize="end"
            android:id="@+id/news_daily_bar_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/bg_news_play_circle"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_news_play"
            android:contentDescription="@null"/>
    </FrameLayout>
</LinearLayout>
