<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:paddingBottom="50dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17dp"
            android:textColor="@color/color_282828"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/tip_21_0127_05"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_buys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17dp"
            android:textColor="@color/color_282828"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/tip_21_0127_06"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/redeem_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="@color/color_282828"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_redeemed_now"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textColor="@color/color_ff7300"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_redeem_now_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/video_redeemed_more"
                android:layout_weight="1"
                android:paddingEnd="@dimen/dp_6"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_12"
                app:srcCompat="@drawable/ic_arrow_ff7300"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_redeem_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
