<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:elevation="2dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择支付方式"
                android:layout_marginStart="22dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_close"
                android:padding="4dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close_grey"
                android:layout_marginEnd="12dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_alipay"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="22dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_alipay"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tv1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/tip_21_0127_07"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_selected_ali"
                android:background="@drawable/ai_energy_pay_selector"
                android:clickable="false"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:checked="true"
                android:button="@null"/>
        </LinearLayout>
        <View
            android:id="@+id/line1"
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_wechat"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="22dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_wechatpay"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tv2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/tip_21_0127_08"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_selected_wx"
                android:background="@drawable/ai_energy_pay_selector"
                android:clickable="false"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:button="@null"/>
        </LinearLayout>
        <View
            android:id="@+id/line2"
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_stripe"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="22dp">
            <ImageView
                android:background="@drawable/ic_stripe_pay"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="聚合支付"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_selected_stripe"
                android:background="@drawable/ai_energy_pay_selector"
                android:clickable="false"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:button="@null"/>
        </LinearLayout>
        <View
            android:id="@+id/line3"
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_submit"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="16dp"
            android:text="去支付"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</LinearLayout>
