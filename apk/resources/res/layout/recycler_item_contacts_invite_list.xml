<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/item_bg"
    android:layout_width="match_parent"
    android:layout_height="90dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_contacts_invite_item_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_contacts_invite_item_link_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_contacts_invite_item_action"
        app:layout_constraintStart_toEndOf="@+id/iv_contacts_invite_item_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_contacts_invite_item_avatar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="@color/color_80888f"
        android:ellipsize="end"
        android:id="@+id/tv_contacts_invite_register_item_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/iv_contacts_invite_item_avatar"
        app:layout_constraintEnd_toEndOf="@+id/tv_contacts_invite_item_link_name"
        app:layout_constraintStart_toStartOf="@+id/tv_contacts_invite_item_link_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_btn_contacts_invite_item_action"
        android:background="@drawable/rect_focus_each_other_btn_bg"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_31"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
