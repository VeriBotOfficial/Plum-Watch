<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/plans_text"
            android:textColorHint="@color/plans_text_secondary"
            android:id="@+id/etCitySearch"
            android:background="@drawable/bg_plans_search_field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/plans_city_search_hint"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/btnCitySearchConfirm"
            android:background="@drawable/bg_plans_header_create_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plans_city_search_confirm"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/plans_text_secondary"
        android:id="@+id/tvCitySearchHint"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/cityPickerWheel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/plans_wheel_viewport_height"
        android:layout_marginTop="8dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/selectionHighlight"
            android:background="@drawable/bg_plans_time_picker_selection"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/plans_wheel_row_height"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cityPickerColumns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lvRegion"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lvCity"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btnWheelConfirm"
        android:background="@drawable/bg_plans_header_create_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/plans_wheel_confirm"
        android:paddingVertical="10dp"/>
</LinearLayout>
