<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_36"
    app:cardBackgroundColor="@color/color_393d6c"
    app:cardCornerRadius="@dimen/dp_18">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:layout_gravity="center_vertical"
        android:id="@+id/item_first_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp_10"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:drawableStartCompat="@drawable/ic_round"/>
</androidx.cardview.widget.CardView>
