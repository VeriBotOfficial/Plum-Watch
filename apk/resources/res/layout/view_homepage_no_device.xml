<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_ffffff_r12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/background_homepage_no_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/color_000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/title_homepage_no_device_welcome"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_18"
            android:text="@string/title_homepage_no_device_introduce"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp_16"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_add_layout"
            android:background="@drawable/shape_gradient_f76814_ff3d2f_left_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_homepage_no_device_add_device"
                android:layout_marginStart="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_ffffff"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/device_tianjiashebei"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
