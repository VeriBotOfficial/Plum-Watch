<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/home_more"
        app:titleText="@string/run_course"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/titleTv"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_62"
        android:layout_marginTop="@dimen/dp_10"
        android:lines="1"
        android:maxLength="30"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/topBar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_666666"
        android:id="@+id/describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/course_tip_34"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/edit_btn"
        android:background="@drawable/select_btn_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_25"
        android:text="@string/sport_tip"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/edit_btn"
        app:layout_constraintTop_toBottomOf="@+id/describe"/>
</androidx.constraintlayout.widget.ConstraintLayout>
