<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_e6e6e6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/tip_21_0127_04"
        app:titleText="@string/string_schedule_detail"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title_tv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_68"
            android:singleLine="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/title_line"
            android:background="@color/color_e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detail_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_103"
            app:layout_constraintBottom_toTopOf="@+id/from_layout"
            app:layout_constraintTop_toBottomOf="@+id/title_line">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:id="@+id/detail_start_time_layout"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/detail_end_time_layout"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_666666"
                    android:id="@+id/detail_start_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10月21日"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textColor="@color/color_333333"
                    android:id="@+id/detail_start_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="周五"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="end|center_vertical"
                android:orientation="vertical"
                android:id="@+id/detail_end_time_layout"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/detail_start_time_layout">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_666666"
                    android:id="@+id/detail_end_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10月21日"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textColor="@color/color_333333"
                    android:id="@+id/detail_end_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="周五"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/detail_all_day_tag_layout"
                android:layout_width="@dimen/dp_92"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:background="@color/color_F0F1F3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_666666"
                    android:gravity="center"
                    android:id="@+id/detail_all_day_tag"
                    android:background="@drawable/shape_f0f1f3_r12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_day"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/from_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:id="@+id/bottom_line"
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_B4B4B4"
                android:gravity="center_vertical"
                android:id="@+id/text_time_from"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/from_system_calendar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/reminder_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_96"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/title_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reminder"
            android:layout_marginStart="@dimen/dp_16"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_666666"
            android:id="@+id/reminder_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="开始前15分钟"
            android:layout_marginStart="@dimen/dp_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/reminder_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:id="@+id/content_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_666666"
            android:id="@+id/content_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/delete_schedule"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/delete_schedule"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
