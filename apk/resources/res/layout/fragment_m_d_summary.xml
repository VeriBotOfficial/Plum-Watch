<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/m_s_scroll"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/m_s_des_layout"
            android:background="@drawable/shape_eeedec_r12"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/m_s_time_iv"
                    android:background="@drawable/ic_time_iv"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_4F4E4D"
                    android:id="@+id/m_s_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_9"
                    android:text="@string/jacket_m_s_s_time"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/black"
                    android:id="@+id/m_s_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear_address"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_17"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linear_time">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/m_s_address_iv"
                    android:background="@drawable/ic_address_iv"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_4F4E4D"
                    android:id="@+id/m_s_address_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_9"
                    android:text="@string/jacket_m_s_add"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/black"
                    android:id="@+id/m_s_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear_person"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_17"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linear_address">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/m_s_person_iv"
                    android:background="@drawable/ic_person_iv"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_4F4E4D"
                    android:id="@+id/m_s_person_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_9"
                    android:text="@string/jacket_m_s_person"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/black"
                    android:id="@+id/m_s_person"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear_duration"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_17"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linear_person">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/m_s_duration_iv"
                    android:background="@drawable/ic_duration_iv"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_4F4E4D"
                    android:id="@+id/m_s_duration_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_9"
                    android:text="@string/jacket_m_s_time"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/black"
                    android:id="@+id/m_s_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jacket_m_s_time"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_white_r12"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/m_s_des_layout">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_summary_iv"
                android:background="@drawable/ic_m_summary"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_d_s_title"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_summary_iv"
                app:layout_constraintStart_toEndOf="@+id/m_s_summary_iv"
                app:layout_constraintTop_toTopOf="@+id/m_s_summary_iv"/>
            <View
                android:id="@+id/m_s_line"
                android:background="@color/color_F0F0F0"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/m_s_summary_iv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_summary_again"
                android:background="@drawable/ic_summary_fail"
                android:layout_width="58dp"
                android:layout_height="69dp"
                android:layout_marginTop="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_line"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/m_s_summary_again_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/jacket_m_d_s_fail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_summary_again"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="clip_vertical"
                android:orientation="horizontal"
                android:id="@+id/m_s_summary_again_layout"
                android:background="@drawable/shape_ff7300_r16"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_summary_again_tv">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/m_s_again_progress"
                    android:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/meet_export_anim"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_gpt_regeneration"
                    android:layout_marginHorizontal="6dp"
                    android:paddingVertical="6dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <ScrollView
                android:id="@+id/m_r_old_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxHeight="220dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_line">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/black"
                    android:id="@+id/m_s_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </ScrollView>
            <View
                android:id="@+id/black_line"
                android:background="#fff0f0f0"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginTop="@dimen/dp_22"
                android:layout_marginBottom="@dimen/dp_22"
                app:layout_constraintTop_toBottomOf="@+id/m_r_old_rv"/>
            <ScrollView
                android:id="@+id/m_trans_rv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxHeight="220dp"
                app:layout_constraintTop_toBottomOf="@+id/black_line">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/black"
                    android:id="@+id/m_trans_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingVertical="8dp"/>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
