<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_30">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_hs_chat_qt_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_chat_user"
            android:layout_width="@dimen/dp_41"
            android:layout_height="@dimen/dp_41"
            android:src="@drawable/ic_chat_user"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/item_hs_chat_user_content_layout"
            android:background="@drawable/shape_question_bg"
            android:padding="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_240"
            android:layout_marginStart="@dimen/dp_61"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/iv_chat_user"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:gravity="start|center_vertical"
                android:id="@+id/item_hs_chat_user_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_240"
                android:textIsSelectable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/item_qs_chat_loading"
                android:visibility="gone"
                android:layout_width="@dimen/dp_60"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/chat_loading_white"/>
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30"
            app:layout_constraintTop_toBottomOf="@+id/item_hs_chat_user_content_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_hs_chat_an_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/item_hs_chat_qt_layout">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_robot"
            android:layout_width="@dimen/dp_41"
            android:layout_height="@dimen/dp_41"
            android:src="@drawable/ic_chat_robot"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_41"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_robot"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_hs_chat_gpt_content_layout"
                android:background="@drawable/shape_answer_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_240"
                android:minWidth="@dimen/dp_220"
                android:layout_marginEnd="@dimen/dp_61"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:enabled="false"
                    android:textSize="14dp"
                    android:textColor="@color/color_282828"
                    android:gravity="center_vertical"
                    android:id="@+id/item_hs_chat_gpt_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/space_view"
                    android:background="@color/color_9a9a9a"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_10"
                    android:alpha="0.2"
                    app:layout_constraintEnd_toEndOf="@+id/item_hs_chat_gpt_content"
                    app:layout_constraintStart_toStartOf="@+id/item_hs_chat_gpt_content"
                    app:layout_constraintTop_toBottomOf="@+id/item_hs_chat_gpt_content"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/item_hs_chat_copy"
                    android:background="@drawable/ic_chat_copy"
                    android:layout_width="@dimen/dp_31"
                    android:layout_height="@dimen/dp_31"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toStartOf="@+id/item_hs_chat_reset"
                    app:layout_constraintTop_toBottomOf="@+id/space_view"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/item_hs_chat_reset"
                    android:background="@drawable/ic_chat_refresh"
                    android:layout_width="@dimen/dp_31"
                    android:layout_height="@dimen/dp_31"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/space_view"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/item_hs_chat_voice"
                    android:background="@drawable/ic_chat_voice_play_mute"
                    android:layout_width="@dimen/dp_31"
                    android:layout_height="@dimen/dp_31"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toStartOf="@+id/item_hs_chat_copy"
                    app:layout_constraintTop_toBottomOf="@+id/space_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/item_hs_chat_loading"
            android:background="@drawable/shape_answer_bg"
            android:padding="@dimen/dp_5"
            android:visibility="visible"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_40"
            android:minWidth="@dimen/dp_94"
            android:minHeight="@dimen/dp_41"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:layout_constraintStart_toEndOf="@+id/iv_robot"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/chat_loading"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
