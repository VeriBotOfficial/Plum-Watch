<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuExpandImage="@drawable/ic_calendar"
        app:menuImage="@drawable/home_more"
        app:titleText="@string/weight_management"/>
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/drawable_20_eb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_24">
            <com.flyco.tablayout.SlidingTabLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_36"
                app:tl_indicator_color="@color/white"
                app:tl_indicator_corner_radius="@dimen/dp_8"
                app:tl_indicator_margin_bottom="@dimen/dp_2"
                app:tl_indicator_margin_left="@dimen/dp_2"
                app:tl_indicator_margin_right="@dimen/dp_2"
                app:tl_indicator_margin_top="@dimen/dp_2"
                app:tl_indicator_style="BLOCK"
                app:tl_tab_space_equal="true"
                app:tl_textBold="BOTH"
                app:tl_textSelectColor="@color/color_333333"
                app:tl_textUnselectColor="@color/color_666666"
                app:tl_textsize="@dimen/sp_16"/>
        </FrameLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.wakeup.commonui.expand.NoScrollViewPager
                    android:id="@+id/viewPage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_17"
                    android:textStyle="bold"
                    android:textColor="@color/color_282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="@string/weight_step_go"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r12"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_666666"
                            android:id="@+id/kcal_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:text="@string/consume"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_kcal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginHorizontal="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/kcal_title"
                            app:layout_constraintStart_toEndOf="@+id/kcal_title"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textStyle="bold"
                            android:textColor="@color/color_666666"
                            android:id="@+id/kcal_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_3"
                            android:text="@string/home_qianka"
                            android:layout_marginStart="@dimen/dp_5"
                            app:layout_constraintBaseline_toBaselineOf="@+id/kcal_title"
                            app:layout_constraintStart_toEndOf="@+id/tv_kcal"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/step_go"
                            android:background="@drawable/shape_ff7300_r16"
                            android:paddingTop="@dimen/dp_6"
                            android:paddingBottom="@dimen/dp_6"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/string_walk_now"
                            android:paddingHorizontal="@dimen/dp_16"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_22"
                        android:layout_marginTop="24dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/drawable_weight_step_progress"
                        app:layout_constraintTop_toBottomOf="@+id/total_step"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_666666"
                            android:id="@+id/tv_day_step_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_jinribushu"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_day_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_day_step_title"/>
                        <androidx.constraintlayout.widget.Guideline
                            android:orientation="vertical"
                            android:id="@+id/guideline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintGuide_percent="0.5"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12dp"
                            android:textColor="@color/color_666666"
                            android:id="@+id/tv_target_step_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qinyou_mubiaobushu"
                            app:layout_constraintStart_toStartOf="@+id/guideline"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_target_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            app:layout_constraintStart_toStartOf="@+id/guideline"
                            app:layout_constraintTop_toBottomOf="@+id/tv_day_step_title"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <fragment
                    android:id="@+id/homeCourseFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    class="com.wakeup.commponent.module.course.HomeCourseFragment"/>
                <TextView
                    android:textSize="@dimen/sp_17"
                    android:textStyle="bold"
                    android:textColor="@color/color_282828"
                    android:id="@+id/tv_adv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="@string/tip_21_0622_liu_4"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_adv"
                    android:background="@drawable/shape_white_r12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="12dp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_add"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:text="@string/health_btn_input"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="12dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
