<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/coinRewardBg"
        android:background="@drawable/bg_coin_reward_circle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.wakeup.commonui.progress.CircleProgressBar
        android:id="@+id/coinRewardRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:circleBgColor="#33ffffff"
        app:circleProgressAColor="#f9d576"
        app:circleProgressBColor="#00000000"
        app:circleWidth="2dp"
        app:openAngle="0"
        app:showSmallPoint="false"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/coinRewardPiggy"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_reward_envelope"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/coinRewardCount"
        android:background="@drawable/bg_coin_reward_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:minWidth="22dp"
        android:text="0"
        android:paddingHorizontal="5dp"
        android:paddingVertical="0dp"/>
</merge>
