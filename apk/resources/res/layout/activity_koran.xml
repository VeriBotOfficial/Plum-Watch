<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/religion_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/koran_title"
        android:background="@color/color_248B63"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:titleColor="@color/white"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/koran_rv"
        android:background="@color/color_e6fae7"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@color/color_238862"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/koran_play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_4"
            android:splitTrack="false"
            app:layout_constraintBottom_toBottomOf="@+id/koran_play_current_time"
            app:layout_constraintEnd_toStartOf="@+id/koran_play_duration_time"
            app:layout_constraintStart_toEndOf="@+id/koran_play_current_time"
            app:layout_constraintTop_toTopOf="@+id/koran_play_current_time"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/white"
            android:id="@+id/koran_play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/white"
            android:id="@+id/koran_play_duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/koran_play_left"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_22"
            android:layout_marginEnd="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="@+id/koran_play_state"
            app:layout_constraintEnd_toStartOf="@+id/koran_play_state"
            app:layout_constraintTop_toTopOf="@+id/koran_play_state"
            app:srcCompat="@drawable/ic_play_left"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/koran_play_state"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_19"
            android:layout_marginBottom="@dimen/dp_8"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dp_30"
            app:cardElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/koran_play_seek_bar">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/koran_play_state_iv"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:scaleType="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_bottom_play"/>
                <ProgressBar
                    android:id="@+id/koran_play_progress"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:indeterminateTint="@color/color_ff31a67a"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/koran_play_right_layout"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_44"
            android:layout_marginStart="@dimen/dp_26"
            app:layout_constraintBottom_toBottomOf="@+id/koran_play_state"
            app:layout_constraintStart_toEndOf="@+id/koran_play_state"
            app:layout_constraintTop_toTopOf="@+id/koran_play_state">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/koran_play_right"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_22"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_play_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/koran_play_model"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/koran_play_state"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/koran_play_state"
            app:srcCompat="@drawable/ic_loop_play_singe"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
