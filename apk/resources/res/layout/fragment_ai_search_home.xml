<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_ai_search_home"
    android:background="@drawable/ic_ai_search_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_ai_search_welcome_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_70"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_18"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:text="��"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ai_search_welcome_text"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_4"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ll_search_history"
            android:background="@drawable/ic_ai_search_history"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"/>
    </LinearLayout>
    <View
        android:id="@+id/view_block"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_text_ai_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_history">
        <androidx.appcompat.widget.AppCompatImageView
            android:visibility="visible"
            android:layout_width="@dimen/dp_115"
            android:layout_height="@dimen/dp_38"
            android:src="@drawable/ic_ai_search_icon"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_ai_search_box_1"
            android:background="@drawable/shape_ffffff_r999_shadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_64"
            android:elevation="@dimen/dp_2"
            android:layout_marginHorizontal="@dimen/dp_8">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_magnifier"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:gravity="start"
                android:id="@+id/et_ai_search"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/ai_search_text"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionSearch"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_19"
                android:textColor="@color/color_999999"
                android:gravity="center_vertical"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_48"
                android:text="|"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ai_search_home_record"
                android:background="@drawable/ic_ai_search_speech_to_text"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_20"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_block"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_ai_search_tool"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_ai_search_box">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_dialogue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_dialogue"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI对话"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_write"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_write"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI写作"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_ppt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_ppt"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI PPT"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_paint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_paint"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI绘画"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_all_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_all_tools"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部工具"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_ai_search_new_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_8">
        <com.wakeup.feature.search.view.CustomSmartRefreshLayout
            android:id="@+id/smartrefresh_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srlEnableLoadMore="false"
            app:srlEnableOverScrollBounce="true"
            app:srlEnableOverScrollDrag="true"
            app:srlEnableRefresh="false">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="always"/>
        </com.wakeup.feature.search.view.CustomSmartRefreshLayout>
        <ScrollView
            android:id="@+id/ai_search_scroll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_ai_search_new_one"
                    android:background="@drawable/shape_ffffff_r16"
                    android:padding="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_hot_info_img"
                        android:background="@drawable/ai_search_loading_icon"
                        android:layout_width="@dimen/dp_64"
                        android:layout_height="@dimen/dp_64"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:shapeAppearanceOverlay="@style/chamfer8dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_hot_info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="等针叶林和混交林地带中，单身至群生。野…"
                            android:maxLines="2"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:visibility="gone"
                                android:layout_width="@dimen/dp_16"
                                android:layout_height="@dimen/dp_16"
                                android:src="@drawable/ic_hot_info_baidu_min"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_12"
                                android:textColor="@color/color_666666"
                                android:id="@+id/tv_hot_info_source"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="百度新闻客户端"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/color_999999"
                                android:id="@+id/tv_hot_info_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_search_time_hours_ago"
                                android:layout_marginStart="@dimen/dp_12"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_ai_search_new_two"
                    android:background="@drawable/shape_ffffff_r16"
                    android:padding="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:elevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_hot_info_img_two"
                        android:background="@drawable/ai_search_loading_icon"
                        android:layout_width="@dimen/dp_64"
                        android:layout_height="@dimen/dp_64"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:shapeAppearanceOverlay="@style/chamfer8dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_hot_info_title_two"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="等针叶林和混交林地带中，单身至群生。野…"
                            android:maxLines="2"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:visibility="gone"
                                android:layout_width="@dimen/dp_16"
                                android:layout_height="@dimen/dp_16"
                                android:src="@drawable/ic_hot_info_baidu_min"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_12"
                                android:textColor="@color/color_666666"
                                android:id="@+id/tv_hot_info_source_two"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="百度新闻客户端"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/color_999999"
                                android:id="@+id/tv_hot_info_time_two"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_search_time_hours_ago"
                                android:layout_marginStart="@dimen/dp_12"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_ai_search_new_three"
                    android:background="@drawable/shape_ffffff_r16"
                    android:padding="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_hot_info_img_three"
                        android:background="@drawable/ai_search_loading_icon"
                        android:layout_width="@dimen/dp_64"
                        android:layout_height="@dimen/dp_64"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:shapeAppearanceOverlay="@style/chamfer8dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_hot_info_title_three"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="等针叶林和混交林地带中，单身至群生。野…"
                            android:maxLines="2"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:visibility="gone"
                                android:layout_width="@dimen/dp_16"
                                android:layout_height="@dimen/dp_16"
                                android:src="@drawable/ic_hot_info_baidu_min"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_12"
                                android:textColor="@color/color_666666"
                                android:id="@+id/tv_hot_info_source_three"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="百度新闻客户端"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/color_999999"
                                android:id="@+id/tv_hot_info_time_three"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_search_time_hours_ago"
                                android:layout_marginStart="@dimen/dp_12"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_ai_search_information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_search_hot_news_section"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_ai_search_more_news"
                android:layout_width="@dimen/dp_12"
                android:layout_height="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_4"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_block_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_ai_search_box_2"
        android:background="@color/white"
        android:paddingTop="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_ai_search_back"
            android:background="@drawable/ic_ai_search_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/shape_ffffff_r999_stroke_box2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_15"
            android:paddingStart="@dimen/dp_19"
            android:layout_marginStart="@dimen/dp_8">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_666666"
                android:gravity="center_vertical"
                android:id="@+id/et_ai_search_bottom"
                android:background="@null"
                android:paddingBottom="@dimen/dp_25"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_75"
                android:hint="@string/ai_search_text"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionSearch"
                android:layout_marginStart="@dimen/dp_8"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_clear_text"
                android:visibility="gone"
                android:layout_width="23dp"
                android:layout_height="@dimen/dp_23"
                android:src="@drawable/ic_ai_search_clear_text"
                android:layout_marginEnd="@dimen/dp_15"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_19"
                android:textColor="@color/color_999999"
                android:layout_gravity="center"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:singleLine="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_ai_search_record_2"
                android:background="@drawable/ic_ai_search_speech_to_text"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_20"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
