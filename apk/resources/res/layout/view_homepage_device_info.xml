<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/background_layout"
            android:background="@drawable/shape_ffffff_right_top_r4_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_72"/>
        <View
            android:background="@color/color_ffffff"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_60"/>
        <View
            android:background="@drawable/shape_ffffff_right_top_r4_bottom_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/icon_device"
        android:layout_width="@dimen/dp_63"
        android:layout_height="@dimen/dp_58"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:src="@drawable/image_device_headset"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_000000"
        android:ellipsize="end"
        android:id="@+id/device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:maxWidth="@dimen/dp_200"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_75"
        app:layout_constraintStart_toEndOf="@+id/icon_device"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_000000"
        android:ellipsize="end"
        android:id="@+id/device_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:maxWidth="@dimen/dp_123"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toEndOf="@+id/icon_device"
        app:layout_constraintTop_toBottomOf="@+id/device_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_wifi_state"
        android:background="@drawable/ic_g_wifi_close"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toEndOf="@+id/device_desc"
        app:layout_constraintTop_toBottomOf="@+id/device_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_share_network_state"
        android:background="@drawable/ic_g_share_network_open"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toEndOf="@+id/device_desc"
        app:layout_constraintTop_toBottomOf="@+id/device_name"/>
    <FrameLayout
        android:id="@+id/battery_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toEndOf="@+id/device_desc"
        app:layout_constraintTop_toBottomOf="@+id/device_name">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2">
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_flag1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/device_battery_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080ce5"
                android:layout_marginEnd="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_flag2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/device_battery_image2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080ce5"
                android:layout_marginEnd="@dimen/dp_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/earphone_battery"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1">
            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/icon_homepage_device_list_earphone_right"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/earphone_battery_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/dp_4"/>
            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/icon_homepage_device_list_earphone_left"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/earphone_battery_right_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_broadcast_btn"
        android:background="@drawable/shape_fff4ec_r999"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/device_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/device_desc">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_volume_orange"
            android:layout_marginEnd="4dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="#ff7300"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播报"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/overseas_connect_layout"
        android:background="@drawable/shape_f1f3f5_left_bottom_r10"
        android:paddingBottom="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/device_overseas_reconnect"
            android:background="@drawable/shape_gradient_ff6a00_ff8c41_left_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:maxWidth="@dimen/dp_113"
            android:minWidth="@dimen/dp_68"
            android:text="@string/device_chongxinlianjie"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp_9"
            android:paddingEnd="@dimen/dp_9"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_overseas_connecting"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:minWidth="@dimen/dp_68">
            <View
                android:id="@+id/connecting_overseas_image"
                android:background="@drawable/shape_ring_gradient_fa7d22_ffffff"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_25"
                android:maxWidth="@dimen/dp_91"
                android:text="@string/device_management_connecting"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/dp_9"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_overseas_connected"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:minWidth="@dimen/dp_68">
            <View
                android:background="@drawable/layer_list_circle_r5_circl5_r2"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:id="@+id/tv_connected_over"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_25"
                android:maxWidth="@dimen/dp_91"
                android:text="@string/device_yilianjie"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/dp_9"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/connect_layout"
        android:background="@drawable/shape_f1f3f5_left_bottom_r10"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/device_reconnect"
            android:background="@drawable/shape_gradient_ff6a00_ff8c41_left_right"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26"
            android:text="@string/device_chongxinlianjie"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_connecting"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26">
            <View
                android:id="@+id/connecting_image"
                android:background="@drawable/shape_ring_gradient_fa7d22_ffffff"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_26"
                android:text="@string/device_connecting"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_connected"
            android:background="@drawable/shape_ffffff_r10_r4"
            android:visibility="gone"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_26">
            <View
                android:background="@drawable/layer_list_circle_r5_circl5_r2"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:gravity="center"
                android:id="@+id/tv_connected"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_26"
                android:text="@string/device_yilianjie"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
