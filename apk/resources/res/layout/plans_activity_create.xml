<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/plans_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/plans_header"
        android:background="@color/plans_card"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_plans_close"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/plans_text"
            android:gravity="center"
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/plans_create_title"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/btnCreate"
            android:background="@drawable/bg_plans_header_create_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plans_submit_create_short"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:id="@+id/spTemplate"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/plans_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_label_title"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/plans_text"
                android:textColorHint="@color/plans_text_secondary"
                android:id="@+id/etTitle"
                android:background="@drawable/bg_plans_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/plans_error"
                android:id="@+id/tvTitleError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/plans_title_max_length"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/plans_text_secondary"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/plans_label_summary"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/plans_text"
                android:id="@+id/tvTemplateSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/plans_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/plans_label_time"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rowTime"
                android:background="@drawable/bg_plans_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_plans_field_clock"
                    android:contentDescription="@null"
                    app:tint="@color/plans_icon_field"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/timeValueArea"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:gravity="center_vertical"
                        android:id="@+id/tvTime"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="monospace"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/ivTimeDropdown"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_plans_chevron_down"
                    android:contentDescription="@null"
                    app:tint="@color/plans_icon_field"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/plans_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/plans_label_frequency"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rowFrequency"
                android:background="@drawable/bg_plans_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_plans_field_repeat"
                    android:contentDescription="@null"
                    app:tint="@color/plans_icon_field"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/plans_text"
                    android:id="@+id/tvFrequency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_plans_chevron_down"
                    android:contentDescription="@null"
                    app:tint="@color/plans_icon_field"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rowCategorySection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/plans_label_category"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowCategory"
                    android:background="@drawable/bg_plans_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_field_book"
                        android:contentDescription="@null"
                        app:tint="@color/plans_icon_field"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_chevron_down"
                        android:contentDescription="@null"
                        app:tint="@color/plans_icon_field"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rowCitySection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/plans_label_city"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowCity"
                    android:background="@drawable/bg_plans_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_field_location"
                        android:contentDescription="@null"
                        app:tint="@color/plans_icon_field"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:textColorHint="@color/plans_text_secondary"
                        android:id="@+id/tvCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/plans_city_hint"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_chevron_down"
                        android:contentDescription="@null"
                        app:tint="@color/plans_icon_field"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_error"
                    android:id="@+id/tvCityError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/plans_city_required"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rowPromptSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_text_secondary"
                    android:id="@+id/tvPromptLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/plans_label_personal_pref"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/bg_plans_field"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_plans_field_sparkles"
                        android:contentDescription="@null"
                        app:tint="@color/plans_icon_field"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:textColorHint="@color/plans_text_secondary"
                        android:gravity="top"
                        android:id="@+id/etPrompt"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:minLines="2"
                        android:layout_weight="1"
                        android:lineSpacingExtra="4dp"
                        android:inputType="textMultiLine"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_error"
                    android:id="@+id/tvPromptError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/plans_personal_pref_max_length"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
