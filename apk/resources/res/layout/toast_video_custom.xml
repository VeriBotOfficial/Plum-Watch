<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/shape_white_r8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="14dp"
    android:layout_marginRight="12dp">
    <RelativeLayout
        android:id="@+id/rl_root"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_icon"
            android:background="@drawable/ic_video_upload_success"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/tv_content"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/color_ff7300"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/publish_video_success"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
