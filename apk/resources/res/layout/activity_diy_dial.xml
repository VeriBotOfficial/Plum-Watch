<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="DIY表盘"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center_horizontal"
                android:id="@+id/card_diy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                app:cardBackgroundColor="#000000"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_bar">
                <com.wakeup.commonui.view.RectangleCheckView
                    android:layout_gravity="center"
                    android:id="@+id/check_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_dial_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/img_diy_bg_def"/>
                    <com.wakeup.commonui.view.TouchMoveView
                        android:layout_gravity="center"
                        android:id="@+id/iv_dial_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <com.wakeup.commonui.view.TouchMoveView
                        android:layout_gravity="center"
                        android:id="@+id/iv_dial_func"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_dial_pointer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.wakeup.commonui.view.RectangleCheckView>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#666666"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时间、文字等元素可自由移动，快试试吧！"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/shape_white_r20"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/shape_f6f6f6_r999"
                    android:layout_width="match_parent"
                    android:layout_height="39dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="12dp"
                    android:paddingHorizontal="4dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16dp"
                        android:textColor="#ff7300"
                        android:gravity="center"
                        android:id="@+id/tv_diy_num"
                        android:background="@drawable/shape_white_r999"
                        android:layout_width="wrap_content"
                        android:layout_height="31dp"
                        android:text="数字表盘"
                        android:layout_weight="1"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16dp"
                        android:textColor="#333333"
                        android:gravity="center"
                        android:id="@+id/tv_diy_pointer"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="31dp"
                        android:text="指针表盘"
                        android:layout_weight="1"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <include
                    android:id="@+id/select_img_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    layout="@layout/layout_customize_bitmap"/>
                <include
                    android:id="@+id/select_color_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/layout_customize_color"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#ff333333"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="图片亮度"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/sb_alpha"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_marginTop="12dp"
                    android:maxHeight="10dp"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/seekbar_style2_ff7300"
                    android:minHeight="10dp"
                    android:thumb="@drawable/bg_seek_bar_thumb_size2"
                    android:thumbOffset="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="20dp"
                    android:splitTrack="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_play"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textColor="#ff333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="字体"
                        android:layout_marginHorizontal="@dimen/dp_24"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_font"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        android:layout_marginVertical="@dimen/dp_12"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_func"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textColor="#ff333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="表盘数据"
                        android:layout_marginHorizontal="@dimen/dp_24"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_func"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        android:layout_marginVertical="@dimen/dp_12"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_pointer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textColor="#ff333333"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="样式"
                        android:layout_marginHorizontal="@dimen/dp_24"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_pointer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        android:layout_marginVertical="@dimen/dp_12"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="1dp"
                    android:layout_height="74dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="12dp">
            <ProgressBar
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/layer_list_progress_drawable_2"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/btn_install"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_centerInParent="true"
                android:elevation="2dp"/>
        </RelativeLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
