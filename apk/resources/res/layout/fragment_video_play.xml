<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_play_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.feature.wkvideo.view.CustomVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:transitionName="@string/full_screen_transition"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_first_frame"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/click_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_info"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_play"
        android:background="@drawable/ic_video_play"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/color_DADADA"
        android:id="@+id/tv_full_screen"
        android:background="@drawable/shape_2e2e2e_r60"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:text="@string/micro_video_full_screen"
        android:drawablePadding="@dimen/dp_4"
        android:drawableStart="@drawable/ic_video_fullscreen"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoView"/>
    <ImageView
        android:id="@+id/iv_loading2"
        android:layout_width="62dp"
        android:layout_height="53dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pusher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_info"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar_bg"
            android:background="@color/white"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_bg"
            app:layout_constraintEnd_toEndOf="@+id/iv_avatar_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_avatar_bg"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar_bg"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_follow"
            android:background="@drawable/ic_follow_un"
            android:layout_width="28dp"
            android:layout_height="14dp"
            android:layout_marginTop="-8dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_avatar_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_avatar_bg"
            app:layout_constraintTop_toBottomOf="@+id/iv_avatar_bg"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_like"
            android:background="@drawable/ic_like_un"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_follow"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/tv_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/iv_like"
            app:layout_constraintStart_toStartOf="@+id/iv_like"
            app:layout_constraintTop_toBottomOf="@+id/iv_like"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_comment"
            android:background="@drawable/ic_comment_un"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_like_count"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_11"
            android:textColor="@color/white"
            android:id="@+id/tv_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/iv_comment"
            app:layout_constraintStart_toStartOf="@+id/iv_comment"
            app:layout_constraintTop_toBottomOf="@+id/iv_comment"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_collect"
            android:background="@drawable/ic_collect_un"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_comment_count"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/tv_collect_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/iv_collect"
            app:layout_constraintStart_toStartOf="@+id/iv_collect"
            app:layout_constraintTop_toBottomOf="@+id/iv_collect"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dislike"
            android:background="@drawable/ic_dislike"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_collect_count"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_share"
            android:background="@drawable/ic_video_detail_share"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_collect_count"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/tv_share_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/iv_share"
            app:layout_constraintStart_toStartOf="@+id/iv_share"
            app:layout_constraintTop_toBottomOf="@+id/iv_share"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_collection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_self_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_video_self_desc"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="4dp"
                android:backgroundTint="#a3ffffff"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#a3ffffff"
                android:id="@+id/tv_self_desc"
                android:layout_width="wrap_content"
                android:layout_height="17dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#ccffffff"
            android:id="@+id/tv_describe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_collection"
        android:background="@drawable/shape_d5ffffff_r4"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="@dimen/dp_12"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/seek_bar_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_collect_icon"
            android:background="@drawable/icon_collect"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_collect_right"
            android:background="@drawable/ic_video_arrow"
            android:layout_width="6dp"
            android:layout_height="11dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_collect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginHorizontal="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_collect_right"
            app:layout_constraintStart_toEndOf="@+id/iv_collect_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_black_mengceng"
        android:background="@drawable/ic_video_black_mengceng"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.wakeup.commonui.view.NotTouchFrameLayout
        android:id="@+id/seek_bar_layout"
        android:background="@color/transp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seek_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_2"
            android:progress="0"
            android:progressDrawable="@drawable/shape_video_seekbar_bg"
            android:thumb="@null"
            android:layoutDirection="ltr"
            android:paddingStart="0.5dp"
            android:paddingEnd="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seek_bar2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_12"
            android:progress="0"
            android:progressDrawable="@drawable/shape_video_seekbar_bg2"
            android:thumb="@drawable/shape_video_seekbar_thumb2"
            android:layoutDirection="ltr"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
            app:layout_constraintStart_toStartOf="@+id/tv_desc"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/liaodingvideo"/>
    </com.wakeup.commonui.view.NotTouchFrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18dp"
        android:textColor="@color/white"
        android:id="@+id/tv_seek_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="86dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_ffffff"
        android:id="@+id/tv_tip_hint"
        android:background="@drawable/shape_bg_white_r20"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:text="2X"
        android:drawablePadding="@dimen/dp_6"
        android:drawableStart="@drawable/ic_video_speed"
        android:backgroundTint="@color/color_33000000"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.feature.wkvideo.view.CustomFrameLayout
        android:id="@+id/fl_seek_touch"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_like_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_anim_heart"
        android:alpha="0"/>
    <com.wakeup.commonui.view.SaveVideoProgressLayout
        android:id="@+id/layout_save_video_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.view.VideoShareThumbnailLayout
        android:id="@+id/layout_video_share_thumbnail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
