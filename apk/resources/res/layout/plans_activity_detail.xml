<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/plans_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@color/plans_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/ivBack"
                android:background="@drawable/bg_plans_icon_circle_gray"
                android:padding="8dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_plans_back_arrow"
                android:contentDescription="@null"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/plans_text"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvPausedBadge"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/plans_primary"
                    android:id="@+id/tvPausedBadge"
                    android:background="@drawable/bg_plans_paused_badge"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plans_status_paused"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvTitle"
                    app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/ivMore"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_plans_more_horiz"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardTaskInfo"
                android:background="@drawable/bg_plans_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:id="@+id/rowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_plans_field_file"
                        android:contentDescription="@null"
                        app:tint="@color/plans_primary"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowCategory"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_field_book"
                        android:contentDescription="@null"
                        app:tint="@color/plans_primary"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_field_clock"
                        android:contentDescription="@null"
                        app:tint="@color/plans_primary"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvSchedule"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowCity"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_plans_field_location"
                        android:contentDescription="@null"
                        app:tint="@color/plans_primary"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:id="@+id/rowPrompt"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_plans_field_sparkles"
                        android:contentDescription="@null"
                        app:tint="@color/plans_primary"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/plans_text"
                        android:id="@+id/tvPrompt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/plans_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/plans_history_title"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/plans_text_secondary"
                    android:id="@+id/tvHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/plans_text_secondary"
                android:gravity="center"
                android:id="@+id/tvHistoryEmpty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_history_empty"
                android:paddingVertical="48dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/plans_card"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:textColor="@color/plans_text_secondary"
            android:id="@+id/btnEdit"
            android:background="@drawable/bg_plans_btn_edit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/plans_edit_task"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@null"
            android:paddingHorizontal="12dp"
            app:backgroundTint="@null"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_plans_btn_edit"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/plans_text_secondary"
            app:rippleColor="#1a000000"
            app:strokeWidth="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/btnTest"
            android:background="@drawable/bg_plans_btn_test_gradient"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/plans_test_now"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:paddingHorizontal="12dp"
            app:backgroundTint="@null"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_plans_btn_test"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:rippleColor="#33ffffff"
            app:strokeWidth="0dp"/>
    </LinearLayout>
</LinearLayout>
