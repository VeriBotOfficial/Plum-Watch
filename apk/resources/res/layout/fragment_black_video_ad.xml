<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_black_video_ad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_black_video_ad_container"
        android:background="@color/color_333333"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/layout_black_video_ad_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/transparent"
            android:id="@+id/tv_black_video_ad_cta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/layout_black_video_ad_icon"
            android:padding="18dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#888888"
            android:id="@+id/tv_black_video_ad_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad from: xxx"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_black_video_ad_domain"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#aaaaaa"
            android:id="@+id/tv_black_video_ad_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="www.example.com"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_black_video_ad_warning"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff0000"
            android:id="@+id/tv_black_video_ad_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sponsored"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/iv_black_video_ad_sign"
                android:visibility="gone"
                android:layout_width="@dimen/dp_37"
                android:layout_height="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_6"
                android:src="0x7f080ce0"
                android:contentDescription="@string/empty"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageView
                android:id="@+id/iv_black_video_ad_sign_baidu"
                android:visibility="gone"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_18"
                android:layout_marginBottom="@dimen/dp_6"
                android:src="@drawable/icon_home_page_feed_video_ad_sign_baidu"
                android:contentDescription="@string/empty"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageView
                android:id="@+id/iv_black_video_ad_sign_csj"
                android:visibility="gone"
                android:layout_width="@dimen/dp_52"
                android:layout_height="@dimen/dp_18"
                android:src="@drawable/icon_home_page_feed_video_ad_sign_csj"
                android:contentDescription="@string/empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
