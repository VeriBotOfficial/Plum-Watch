<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/drawable_create_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/gpt_create_manager"
        app:menuTextColor="@color/white"
        app:menuTextSize="5dp"
        app:titleColor="@color/white"
        app:titleText="@string/chat_gpt_menu"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_collect"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/ll_collect_bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_collect_bottom_menu"
        android:background="@color/color_393d6c"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_77"
        android:paddingHorizontal="@dimen/dp_25"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_collect">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_collect_all"
            android:background="@drawable/drawable_4c5190_12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:text="@string/select_all"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_7"/>
        <TextView
            android:textColor="@color/color_ff7300"
            android:gravity="center"
            android:id="@+id/tv_collect_del"
            android:background="@drawable/drawable_4c5190_12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:text="@string/clock_shanchu"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_7"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
