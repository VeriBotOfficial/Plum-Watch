<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginHorizontal="12dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/btn_diabetes_manual"
        android:background="@drawable/shape_diabetes_entry_manual_btn"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#555555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✎"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/diabetes_entry_record_glucose"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/btn_diabetes_ai"
        android:background="@drawable/shape_diabetes_entry_ai_btn"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/diabetes_accent_muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diabetes_entry_ai_title"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/diabetes_accent_soft"
                android:background="@color/diabetes_accent_tag_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diabetes_risk_ai_tag"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"/>
        </LinearLayout>
        <TextView
            android:textSize="10.5sp"
            android:textColor="@color/diabetes_accent_muted"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/diabetes_entry_ai_subtitle"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>
</LinearLayout>
