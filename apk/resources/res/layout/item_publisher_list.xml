<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_62"
    android:layout_height="@dimen/dp_62"
    android:layout_marginEnd="@dimen/dp_4">
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/lottie_item_publisher_list_bg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_62"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_publisher_list_item_avatar_bg"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_item_publisher_list_avatar"
        android:background="@color/white"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_item_publisher_list_count"
        android:background="@drawable/shape_publisher_list_item_count_oval"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:minWidth="@dimen/dp_14"
        android:paddingHorizontal="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_F76814"
        android:ellipsize="end"
        android:id="@+id/tv_item_publisher_list_status"
        android:background="@drawable/bg_publisher_list_item_label_follow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:maxWidth="@dimen/dp_60"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingHorizontal="@dimen/dp_4"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
