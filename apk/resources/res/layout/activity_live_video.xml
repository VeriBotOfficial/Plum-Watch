<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ic_live_history_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_switch_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_live_video_switch_camera_white"
                android:layout_marginStart="@dimen/dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_live_video_share_white"
                android:layout_marginEnd="@dimen/dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_swap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_swap_black"
                android:paddingHorizontal="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_source_lan_desc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="我：简体中文"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/iv_swap"
                app:layout_constraintStart_toEndOf="@+id/iv_switch_camera"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_trans_lan_desc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="对方：英文"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/iv_share"
                app:layout_constraintStart_toEndOf="@+id/iv_swap"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/white"
        android:id="@+id/tv_join_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/string_wait_people_join"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_countdown"
        app:layout_constraintTop_toBottomOf="@+id/local_video_cardView"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/local_video_cardView"
        android:background="@drawable/shape_live_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_190"
        app:cardCornerRadius="@dimen/dp_0"
        app:cardElevation="@dimen/dp_5"
        app:cardMaxElevation="@dimen/dp_5"
        app:layout_constraintEnd_toStartOf="@+id/user_video_view_cardView"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_layout">
        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:background="@drawable/shape_live_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/user_video_view_cardView"
        android:background="@drawable/shape_live_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_190"
        app:cardCornerRadius="@dimen/dp_0"
        app:cardElevation="@dimen/dp_5"
        app:cardMaxElevation="@dimen/dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/local_video_cardView"
        app:layout_constraintTop_toBottomOf="@+id/top_layout">
        <FrameLayout
            android:id="@+id/user_video_view_container"
            android:background="@drawable/shape_live_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_hang_up"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginBottom="@dimen/dp_26"
        android:src="@drawable/ic_live_video_hang_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_microphone"
        android:visibility="gone"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:src="@drawable/ic_live_video_microphone_on"
        app:layout_constraintBottom_toBottomOf="@+id/iv_hang_up"
        app:layout_constraintEnd_toStartOf="@+id/iv_hang_up"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_hang_up"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_voice"
        android:visibility="gone"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:src="@drawable/ic_live_video_voice_on"
        app:layout_constraintBottom_toBottomOf="@+id/iv_hang_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_hang_up"
        app:layout_constraintTop_toTopOf="@+id/iv_hang_up"/>
    <Chronometer
        android:textSize="@dimen/dp_16"
        android:textColor="@color/white"
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:format="%s"
        app:layout_constraintBottom_toTopOf="@+id/iv_hang_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
