<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26dp"
        android:layout_marginHorizontal="18dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:id="@+id/tv_hr_war_remind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_tip_06"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="22dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#ff333333"
                android:gravity="center"
                android:id="@+id/btnCancel"
                android:background="@drawable/bg_shape_common_btn_grey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dialog_quxiao"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/btnOk"
                android:background="@drawable/bg_shape_common_btn_yellow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dialog_queding"
                android:layout_weight="1"
                android:layout_marginStart="7dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
