<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginHorizontal="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_music_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/item_a_m_cv"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_a_m_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/color_282828"
            android:id="@+id/item_a_m_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/item_a_m_singer"
            app:layout_constraintStart_toEndOf="@+id/item_a_m_cv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_999999"
            android:id="@+id/item_a_m_singer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/item_a_m_name"
            app:layout_constraintTop_toBottomOf="@+id/item_a_m_name"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/item_am_state"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/item_a_m_name"
            app:layout_constraintStart_toEndOf="@+id/item_a_m_name"
            app:layout_constraintTop_toTopOf="@+id/item_a_m_name"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/music_playing"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_a_m_play_state"
            android:background="@drawable/ic_play_p"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
