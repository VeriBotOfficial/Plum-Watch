<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_16"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/color_0D0D12"
        android:id="@+id/tv_ai_search_result_item_question"
        android:background="@drawable/shape_ai_search_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="写一份关于艺术品欣赏的分析报告"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_ffffff_r14"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_ai_search_result_source"
            android:background="@drawable/shape_f4f6f8_r8"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_ai_search_result_source_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:background="@drawable/ic_fanshi_ai"
                    android:layout_width="@dimen/dp_78"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_5"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_333333"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_ai_search_source_num"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center_vertical"
                    android:background="@drawable/ic_history_particular_more_content"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_source"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_4"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_ai_search_result_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:lineSpacingMultiplier="1.3"
            app:layout_constraintTop_toBottomOf="@+id/ll_ai_search_result_item_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_ai_search_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_item_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/shape_fff76814_r8"
                android:layout_width="@dimen/dp_6"
                android:layout_height="@dimen/dp_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/shape_fff76814_r8"
                android:layout_width="@dimen/dp_6"
                android:layout_height="@dimen/dp_6"
                android:layout_marginLeft="@dimen/dp_3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/shape_fff76814_r8"
                android:layout_width="@dimen/dp_6"
                android:layout_height="@dimen/dp_6"
                android:layout_marginLeft="@dimen/dp_3"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_ai_search_success"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            app:layout_constraintTop_toBottomOf="@+id/tv_ai_search_result_item_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_999999"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/ai_generated_content_model_source_warning"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_tv_ai_search_result_item_content_btn"
                android:background="@drawable/shape_f4f6f8_r8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatTextView
                    android:background="@drawable/ic_copy_history_particular_content"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/black"
                    android:id="@+id/tv_search_result_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_search_copy_text"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
