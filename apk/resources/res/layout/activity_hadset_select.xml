<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_select_type"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/d_smart_headset"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20dp"
        android:textColor="#333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/g_a_type"
        android:layout_marginStart="25dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_type1"
        android:background="@drawable/shape_white_r18"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="60dp"
        android:layout_marginHorizontal="20dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_flag1"
            android:background="@drawable/ic_headset_type1"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#333333"
            android:id="@+id/tv_type_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="@string/photo_headset"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@+id/iv_flag1"
            app:layout_constraintTop_toTopOf="@+id/iv_flag1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#666666"
            android:id="@+id/tv_type_desc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_headset_tip"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@+id/iv_flag1"
            app:layout_constraintTop_toBottomOf="@+id/tv_type_title1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_type2"
        android:background="@drawable/shape_white_r18"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="29dp"
        android:layout_marginHorizontal="20dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_flag2"
            android:background="@drawable/ic_headset_type2"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#333333"
            android:id="@+id/tv_type_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="@string/audio_headset"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@+id/iv_flag2"
            app:layout_constraintTop_toTopOf="@+id/iv_flag2"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#666666"
            android:id="@+id/tv_type_desc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_headset_tip"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@+id/iv_flag2"
            app:layout_constraintTop_toBottomOf="@+id/tv_type_title2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
