<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llPlansFloatBody"
        android:background="@drawable/bg_plans_float_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_plans_float_calendar_clock"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plans_float_label"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/tvPlansFloatBadge"
        android:background="@drawable/bg_plans_float_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="-6dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="-6dp"
        android:translationZ="12dp"
        android:elevation="12dp"
        android:paddingHorizontal="4dp"/>
</merge>
