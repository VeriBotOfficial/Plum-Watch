<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_black"
        app:background="@color/white"
        app:menuImage="@drawable/share"
        app:titleColor="@color/color_333333"
        app:titleText="@string/fenxiang"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/share_layout"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/ic_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/circleStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_0"
            android:lines="2"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toStartOf="@+id/logo_icon"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_333333"
            android:id="@+id/logo_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wearfit"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo_icon"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:src="@mipmap/ic_logo_small"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toStartOf="@+id/logo_name"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_250"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/ic_sport_record_share_bg"
            android:scaleType="fitXY"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/shape_e2e2e2_r6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_12"
            android:paddingHorizontal="@dimen/dp_6"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintStart_toStartOf="@+id/bg"
            app:layout_constraintTop_toTopOf="@+id/bg">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_333333"
                android:id="@+id/sport_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/outdoor_run"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_333333"
                android:id="@+id/sport_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09/24"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_48"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/sport_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.99"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toEndOf="@+id/bg"
            app:layout_constraintStart_toStartOf="@+id/bg"
            app:layout_constraintTop_toTopOf="@+id/bg"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/sport_data_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/unit_gongli"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/sport_data"
            app:layout_constraintStart_toEndOf="@+id/sport_data"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toEndOf="@+id/bg"
            app:layout_constraintStart_toStartOf="@+id/bg"
            app:layout_constraintTop_toBottomOf="@+id/sport_data">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/sport_record_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/congratulation_record"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:text="NEW RECORD"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
