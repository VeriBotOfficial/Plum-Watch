<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r012"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:elevation="2dp">
        <ImageView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:src="@drawable/icon_juxing"/>
        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:src="@drawable/icon_exclamation"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@string/tip144"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:id="@+id/tv_tips2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_20"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRecyclerView"
            android:background="@drawable/shape_fff5ef_r6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_10"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_pair"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_55"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_20">
            <android.widget.Button
                android:textSize="@dimen/sp_14"
                android:id="@+id/bt_go_check_data"
                android:background="@drawable/shape_grey_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/health_report_check_data"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_6"/>
            <android.widget.Button
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:id="@+id/bt_go_generate_report"
                android:background="@drawable/shape_orange_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/health_report_generate_report"
                android:layout_weight="1"
                android:drawableEnd="@drawable/icon_next_right"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"
                android:layout_marginStart="@dimen/dp_6"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
