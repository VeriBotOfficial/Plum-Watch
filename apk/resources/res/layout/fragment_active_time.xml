<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f1f3f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_last"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tvDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/textBlack"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.wakeup.commonui.chart.IndicatorBarChart
        android:id="@+id/mNormalBarChart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_220"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/all_avg_layout"
        android:background="@drawable/shape_white_r12"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="@dimen/dp_12">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/total_active_time_layout"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_time_total_daily_hour"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/total_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_333330"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hour"
                    android:layout_marginStart="@dimen/dp_4"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/space_view"
            android:background="@color/color_e6e6e6"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp_40"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/avg_active_time_layout"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_time_avg_daily_hour"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/avg__active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_333330"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hour"
                    android:layout_marginStart="@dimen/dp_4"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/target_progress_layout"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_12">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333330"
            android:id="@+id/target_progress_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/target_Progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/goal_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/active_time_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_goals"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_active_time_edit"
                android:layout_marginStart="@dimen/dp_6"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:id="@+id/line"
            android:background="@color/color_e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/target_progress_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_22"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/target_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/progress"
            app:layout_constraintEnd_toStartOf="@+id/target_progress_unit"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/progress"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:gravity="start"
            android:id="@+id/target_progress_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_3"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/target_progress"
            app:layout_constraintEnd_toEndOf="@+id/progress"
            app:layout_constraintStart_toEndOf="@+id/target_progress"/>
        <com.wakeup.commonui.view.ArcHalfProcessView
            android:id="@+id/progress"
            android:layout_width="@dimen/dp_202"
            android:layout_height="@dimen/dp_122"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <View
            android:id="@+id/line2"
            android:background="@color/color_e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/progress"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/target_progress_desc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            android:maxLines="3"
            app:layout_constraintBottom_toBottomOf="@+id/target_progress_start"
            app:layout_constraintEnd_toStartOf="@+id/target_progress_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_ff7300"
            android:ellipsize="end"
            android:id="@+id/target_progress_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:maxWidth="@dimen/dp_100"
            android:text="@string/stand_immediately"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/dp_14"
            android:paddingVertical="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
