<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/ic_sound_home_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_160"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_camera_history"
        app:titleText="@string/real_time_communication"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_live_comm"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_86"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_live_comm"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_70"
            android:src="@drawable/iv_live_comm_icon"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_282828"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/string_real_time_call"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintEnd_toStartOf="@+id/iv_live_comm_choose"
            app:layout_constraintStart_toEndOf="@+id/iv_live_comm"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_live_comm_choose"
            android:layout_width="@dimen/dp_21"
            android:layout_height="@dimen/dp_21"
            android:src="@drawable/ic_circleoptions_s"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_voice_comm"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_86"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/layout_live_comm">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_voice_comm"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_70"
            android:src="@drawable/iv_voice_comm_icon"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_282828"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/string_voice_call"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintEnd_toStartOf="@+id/iv_voice_comm_choose"
            app:layout_constraintStart_toEndOf="@+id/iv_voice_comm"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_voice_comm_choose"
            android:layout_width="@dimen/dp_21"
            android:layout_height="@dimen/dp_21"
            android:src="@drawable/radiobutton_off"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_source_lan_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/string_my_language"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_22"
        app:layout_constraintEnd_toStartOf="@+id/tv_trans_lan_desc"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_voice_comm"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_trans_lan_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/string_other_language"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_22"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_source_lan_desc"
        app:layout_constraintTop_toBottomOf="@+id/layout_voice_comm"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_swap"
        android:padding="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tran_swap"
        app:layout_constraintBottom_toBottomOf="@+id/cl_source_lan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_source_lan"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_source_lan"
        android:background="@drawable/shape_white_r6"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/iv_swap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_source_lan_desc">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_source_lan"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/language_zh"
            android:maxLines="2"
            android:drawablePadding="@dimen/dp_7"
            android:drawableEnd="@drawable/ic_jiantou_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_trans_lan"
        android:background="@drawable/shape_white_r6"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_swap"
        app:layout_constraintTop_toBottomOf="@+id/tv_source_lan_desc">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_trans_lan"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/language_en"
            android:maxLines="2"
            android:drawablePadding="@dimen/dp_7"
            android:drawableEnd="@drawable/ic_jiantou_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_start"
        android:background="@drawable/shape_ff7300_r24"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_25"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/string_invite_call"
            android:maxLines="2"
            android:drawablePadding="@dimen/dp_4"
            android:drawableStart="@drawable/iv_start_call"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.wakeup.commonui.view.AiEnergyExpendView
        android:id="@+id/aee_ts1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        app:layout_constraintEnd_toEndOf="@+id/btn_start"
        app:layout_constraintTop_toTopOf="@+id/btn_start"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/ai_vip_icon"
        app:layout_constraintBottom_toTopOf="@+id/btn_start"
        app:layout_constraintEnd_toEndOf="@+id/btn_start"
        app:layout_constraintTop_toTopOf="@+id/btn_start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
