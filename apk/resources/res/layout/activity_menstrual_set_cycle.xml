<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/menstrual"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/img_menstrual"
        android:layout_width="169dp"
        android:layout_height="201dp"
        android:layout_marginTop="16dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/menstrual_set_cycle_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginVertical="40dp">
        <View
            android:background="@drawable/shape_f6f6f6_r6"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheel_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menstrual_set_cycle_tip"
        android:layout_marginHorizontal="24dp"/>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_next"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="46dp"
        android:text="@string/menstrual_generate"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
