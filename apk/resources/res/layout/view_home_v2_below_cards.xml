<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_sleep"
            android:background="@drawable/bg_home_v2_sleep_card"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp">
            <ImageView
                android:id="@+id/iv_sleep_moon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="-6dp"
                android:src="@drawable/ic_home_v2_sleep_moon"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:layout_marginStart="-4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="#281868"
                android:id="@+id/tv_sleep_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_sleep_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tv_sleep_input"
                android:background="@drawable/bg_home_v2_sleep_input_btn"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="#2d1b6f"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_v2_sleep_input"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_home_v2_sleep_input_plus"
                    android:contentDescription="@null"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/ll_sleep_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="#281868"
                    android:id="@+id/tv_sleep_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#281868"
                    android:id="@+id/tv_sleep_hour_unit"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="h"
                    android:includeFontPadding="false"
                    android:layout_marginStart="1dp"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="#281868"
                    android:id="@+id/tv_sleep_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#281868"
                    android:id="@+id/tv_sleep_minute_unit"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="m"
                    android:includeFontPadding="false"
                    android:layout_marginStart="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_sleep_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/ll_sleep_value"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ll_sleep_value">
                <ImageView
                    android:id="@+id/iv_sleep_delta"
                    android:layout_width="8dp"
                    android:layout_height="6dp"
                    android:src="@drawable/ic_home_v2_sleep_delta"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="#ed4315"
                    android:id="@+id/tv_sleep_delta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_diet"
            android:background="@drawable/bg_home_v2_diet_card"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/iv_diet_flame"
                android:layout_width="44dp"
                android:layout_height="52dp"
                android:layout_marginTop="-4dp"
                android:src="@drawable/ic_home_v2_diet_flame"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:layout_marginStart="-2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="#63300b"
                android:id="@+id/tv_diet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_diet_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/fl_diet_arc"
                android:layout_width="72dp"
                android:layout_height="40dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_diet_intake_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_diet_title">
                <com.wakeup.howear.view.home.device.view.HomeV2DietArcView
                    android:id="@+id/v_diet_arc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        android:textColor="#63300b"
                        android:id="@+id/tv_diet_remain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#9963300b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_v2_diet_remain_unit"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#9963300b"
                android:id="@+id/tv_diet_intake_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_diet_intake"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#9963300b"
                android:id="@+id/tv_diet_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_health_board"
        android:background="@drawable/bg_home_v2_board_card"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_board_switch"
                android:background="@drawable/bg_home_v2_board_switch"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp">
                <ImageView
                    android:id="@+id/iv_board_health"
                    android:background="@drawable/bg_home_v2_board_switch_on"
                    android:padding="4dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home_v2_board_health"
                    android:contentDescription="@string/home_v2_health_board"/>
                <ImageView
                    android:id="@+id/iv_board_function"
                    android:padding="4dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home_v2_board_function"
                    android:contentDescription="@string/home_v2_function_board"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tv_board_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_health_board"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#909090"
                android:id="@+id/tv_health_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#909090"
                android:gravity="end"
                android:id="@+id/tv_health_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_click_view"/>
        </LinearLayout>
        <HorizontalScrollView
            android:id="@+id/hsv_health_metrics"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_health_metrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <FrameLayout
            android:id="@+id/fl_combined_function_items"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_combined_function_empty"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home_v2_function_empty_add"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_function_board_empty"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_function_board"
        android:background="@drawable/bg_home_v2_board_card"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_function_board"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#909090"
                android:id="@+id/tv_function_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_v2_all_functions"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_function_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_function_empty"
        android:background="@drawable/bg_home_v2_function_empty"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_marginTop="@dimen/dp_8"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home_v2_function_empty_add"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_v2_function_board_empty"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:layout_width="92dp"
            android:layout_height="78dp"
            android:src="@drawable/ic_home_v2_function_empty_art"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
