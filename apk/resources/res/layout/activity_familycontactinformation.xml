<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:src="@drawable/icon_healthwanring1"/>
    <EditText
        android:textSize="15sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/ed_contact"
        android:background="@drawable/shape_white_r25"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="20dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_ok"
        android:background="@drawable/shape_1890ff_r25"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="20dp"
        android:text="完成"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ff666666"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="23dp"
        android:lineSpacingMultiplier="1.5"/>
</LinearLayout>
