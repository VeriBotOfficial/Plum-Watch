<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/status_bar_layout"
            layout="@layout/status_bar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_21_0113_1"
                android:layout_marginStart="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/shape_sport_tab_line"
                android:layout_width="48dp"
                android:layout_height="4dp"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_menu"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/home_more"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.wakeup.commonui.view.CommonNotifyView
                    android:id="@+id/notify_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>
                <com.wakeup.commonui.view.CommonNotifyView
                    android:id="@+id/audio_notify_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="12dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/llUserData"
                    android:background="@drawable/shape_white_r12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="77dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="12dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvStep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_21_0113_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View
                        android:background="@color/line"
                        android:layout_width="0.5dp"
                        android:layout_height="26dp"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvKcal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_qianka"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View
                        android:background="@color/line"
                        android:layout_width="0.5dp"
                        android:layout_height="26dp"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="----"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_juli"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ai_watchface_entry"
                    android:background="@drawable/bg_ai_watchface_entry"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:layout_marginHorizontal="12dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:id="@+id/iv_ai_wf_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ai_watchface"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="#4a3d8f"
                        android:id="@+id/tv_ai_watchface_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 表盘玩法"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/iv_ai_wf_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_ai_wf_icon"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="11dp"
                        android:textColor="#8a80b8"
                        android:ellipsize="end"
                        android:id="@+id/tv_ai_watchface_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="赛博朋克 · 照片风格化 · 智能配色 · 表情表盘"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_ai_watchface_go"
                        app:layout_constraintStart_toStartOf="@+id/tv_ai_watchface_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ai_watchface_title"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#7b61ff"
                        android:id="@+id/tv_ai_watchface_go"
                        android:background="@drawable/bg_ai_watchface_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="去体验"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/device_function_zone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/dial_title_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp">
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_market"
                            android:layout_marginStart="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:orientation="horizontal"
                            android:id="@+id/total_dial_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/color_primary"
                                android:id="@+id/tv_total_dial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tip_21_0702_liu_18"
                                android:layout_marginEnd="4dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/icon_jiantou_orange"
                                android:scaleType="centerCrop"
                                app:layout_constraintBottom_toBottomOf="@+id/tv_total_dial"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/tv_total_dial"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dial"
                        android:background="@drawable/shape_white_r12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="12dp"
                        android:paddingVertical="20dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/color_4D4D4D"
                        android:id="@+id/tv_activity_zone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/devices_activity_zone"
                        android:layout_marginStart="24dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_activity_zone"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="@dimen/dp_12"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/headset_extra_features"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="12dp">
                        <RelativeLayout
                            android:id="@+id/mini_music_feature"
                            android:background="@drawable/shape_white_r10"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="17sp"
                                android:textColor="@color/black"
                                android:id="@+id/mini_music_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/sub_view_mini_music_title"
                                android:layout_marginHorizontal="12dp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/color_80000000"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/sub_view_mini_music_desc"
                                android:layout_below="@+id/mini_music_title"
                                android:layout_marginHorizontal="13dp"/>
                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/icon_mini_music_headset"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="12dp"/>
                        </RelativeLayout>
                        <View
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>
                        <RelativeLayout
                            android:id="@+id/mini_audio_book_feature"
                            android:background="@drawable/shape_white_r10"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="17sp"
                                android:textColor="@color/black"
                                android:id="@+id/mini_audio_book_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/sub_view_mini_audio_book_title"
                                android:layout_marginHorizontal="12dp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/color_80000000"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/sub_view_mini_audio_book_desc"
                                android:layout_below="@+id/mini_audio_book_title"
                                android:layout_marginHorizontal="13dp"/>
                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/icon_mini_audio_book_headset"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="12dp"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_features"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/device_features"
                        android:layout_marginStart="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/rv_features"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_help_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/device_help_title"
                        android:layout_marginStart="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_help_guide"
                        android:background="@drawable/shape_white_r12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/device_keep_alive_layout"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginHorizontal="12dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/device_keep_alive_icon"
                                android:background="@drawable/ic_device_keep_alive"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="14dp"
                                android:textColor="@color/color_333333"
                                android:id="@+id/device_keep_alive_tip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="@string/keep_alive_setting_title"
                                android:layout_marginStart="12dp"
                                app:layout_constraintBottom_toTopOf="@+id/device_keep_alive_tip_desc"
                                app:layout_constraintStart_toEndOf="@+id/device_keep_alive_icon"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12dp"
                                android:textColor="@color/color_text_secondary"
                                android:id="@+id/device_keep_alive_tip_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/keep_alive_setting_desc"
                                android:layout_marginStart="12dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/device_keep_alive_icon"
                                app:layout_constraintTop_toBottomOf="@+id/device_keep_alive_tip"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_right_small"
                                android:layout_marginStart="12dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_video_guide"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginHorizontal="12dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_video_guide"
                                android:background="@drawable/ic_tutorial_video"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="14dp"
                                android:textColor="@color/color_333333"
                                android:id="@+id/tv_video_guide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_quick_video"
                                android:layout_marginStart="12dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/iv_video_guide"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_right_small"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_img_guide"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginHorizontal="12dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_img_guide"
                                android:background="@drawable/ic_tutorial_image"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="14dp"
                                android:textColor="@color/color_333333"
                                android:id="@+id/tv_img_guide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_quick_image"
                                android:layout_marginStart="12dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/iv_img_guide"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_right_small"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/device_other_title"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/network_share_layout"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingHorizontal="12dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/network_share_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_network_share"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Switch
                            android:id="@+id/network_share_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:thumb="@drawable/device_notify_switch_thumb"
                            android:track="@drawable/device_notify_switch_track"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <View
                            android:background="@color/color_item_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/device_update_layout"
