<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_f4f6f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16">
    <androidx.core.widget.NestedScrollView
        android:background="@color/transp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.wakeup.howear.view.device.view.ShareSoundInfoView
                android:id="@+id/info_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="12dp"/>
            <com.wakeup.commonui.view.CommonNotifyView
                android:id="@+id/notify_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <com.wakeup.howear.view.device.view.ShareSoundFeatureView
                android:id="@+id/featureView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.wakeup.howear.view.device.view.DeviceOtherView
                android:id="@+id/view_device_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#282828"
                android:gravity="center"
                android:id="@+id/tv_delete_device"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="22dp"
                android:text="@string/tip_21_0114_3"
                android:layout_marginHorizontal="12dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
