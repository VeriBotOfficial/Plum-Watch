<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="14dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_news_cover"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:id="@+id/tvDateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tvTodayBadge"
                    android:background="@drawable/bg_news_btn_orange"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/news_daily_today_badge"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/news_daily_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#9ca3af"
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/btnPlay"
        android:background="@drawable/bg_news_play_circle_outline"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="8dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivPlay"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_news_play_orange"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/wave"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp">
            <View
                android:id="@+id/wave0"
                android:background="@drawable/bg_news_wave_bar"
                android:layout_width="2dp"
                android:layout_height="8dp"/>
            <View
                android:id="@+id/wave1"
                android:background="@drawable/bg_news_wave_bar"
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/wave2"
                android:background="@drawable/bg_news_wave_bar"
                android:layout_width="2dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
