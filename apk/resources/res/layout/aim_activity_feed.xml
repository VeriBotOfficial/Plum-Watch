<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/aim_feed_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/aim_ic_back"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnMode"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:paddingVertical="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/aim_ic_menu"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/aim_text"
                android:ellipsize="end"
                android:id="@+id/tvMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aim_mode_select"
                android:maxLines="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/playlistHeader"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="2dp">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/aim_text_muted"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tvPlayingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aim_playing_label"
                android:maxLines="1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/aim_text"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tvPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivMine"
            android:background="@drawable/aim_bg_header_icon"
            android:padding="7dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/aim_ic_mine"
            android:contentDescription="@string/aim_mine"/>
        <View
            android:id="@+id/headerEndBalance"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/aim_text_secondary"
        android:layout_gravity="center"
        android:id="@+id/tvEmpty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aim_feed_empty"/>
</FrameLayout>
