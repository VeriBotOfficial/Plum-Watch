<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/drawable_create_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_white"
        app:titleColor="@color/white"
        app:titleText="@string/gpt_create_sport_plan"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/create_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dp_12">
            <include
                android:id="@+id/view_sport_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/view_title_edit_layout"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_22">
                <View
                    android:background="@drawable/drawable_pink_8"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"/>
                <TextView
                    android:textColor="#ccffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gpt_create_sport_days"
                    android:layout_marginStart="@dimen/dp_6"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:layout_marginTop="@dimen/dp_8">
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/white"
                    android:textColorHint="#8e8f9c"
                    android:id="@+id/et_days"
                    android:background="@drawable/drawable_sport_days"
                    android:padding="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:hint="@string/gpt_create_input_sport_days"
                    android:maxLines="1"
                    android:maxLength="6"
                    android:inputType="number"
                    android:textCursorDrawable="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/color_ffffffff"
                    android:id="@+id/et_days_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gpt_create_clear"
                    android:paddingHorizontal="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/view_flow_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_22"
                layout="@layout/view_flow_layout"/>
            <include
                android:id="@+id/view_flow_sport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_22"
                layout="@layout/view_flow_layout"/>
            <include
                android:id="@+id/view_gpt_result"
                layout="@layout/view_gpt_result"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        layout="@layout/view_ai_layout"/>
</androidx.appcompat.widget.LinearLayoutCompat>
