<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="梅脱（单位：MET-min）"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_666666"
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="MET(Metabolic Equivalent of Energy）指能量代谢当量，音译为梅脱，是以安静、坐位时的能量消耗为基础，表达各种活动时相对能量代谢水平的常用指标。当活动强度达到中高等，且持续活动10分钟以上，则认为该次活动是有效活动，对人体健康更有益。"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="梅脱指数"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_00A5FE"
            android:id="@+id/tv4"
            android:background="@drawable/shape_00bbff_r12_line"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
