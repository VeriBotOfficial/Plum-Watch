<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_right_ff7300"
        app:titleText="@string/crop"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_666666"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/descTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/crop_ring_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <com.wakeup.feature.device.dial.ring.view.WaveformView
        android:id="@+id/waveFormView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@+id/descTv"/>
    <com.wakeup.feature.device.dial.ring.view.RingMarkerView
        android:id="@+id/startMarker"
        android:visibility="gone"
        android:nextFocusDown="@+id/endMarker"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_110"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintStart_toStartOf="@+id/waveFormView"
        app:layout_constraintTop_toTopOf="@+id/waveFormView"/>
    <com.wakeup.feature.device.dial.ring.view.RingMarkerView
        android:id="@+id/endMarker"
        android:visibility="gone"
        android:nextFocusDown="@+id/startMarker"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_110"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintStart_toStartOf="@+id/waveFormView"
        app:layout_constraintTop_toTopOf="@+id/waveFormView"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/startContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="00:00.0"
        android:layout_marginStart="@dimen/dp_23"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waveFormView"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/endContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="00:00.0"
        android:layout_marginEnd="@dimen/dp_23"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waveFormView"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/play_state_iv"
        android:padding="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/ic_crop_music_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waveFormView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
