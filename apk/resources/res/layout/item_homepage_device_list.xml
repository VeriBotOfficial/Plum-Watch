<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_f3f5f7_r4"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <ImageView
        android:id="@+id/device_image"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/color_000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_13"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_59"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/device_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/device_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:maxWidth="@dimen/dp_70"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_11"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintStart_toEndOf="@+id/device_image"
        app:layout_constraintTop_toBottomOf="@+id/device_name"/>
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/color_ff5b00"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/device_connect_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="@string/device_chongxinlianjie"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_11"
        app:layout_constraintStart_toEndOf="@+id/device_image"
        app:layout_constraintTop_toBottomOf="@+id/device_name"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/device_connecting"
        android:background="@drawable/shape_ffffff_r10_r4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginStart="@dimen/dp_11"
        app:layout_constraintStart_toEndOf="@+id/device_image"
        app:layout_constraintTop_toBottomOf="@+id/device_name">
        <View
            android:id="@+id/connecting_image"
            android:background="@drawable/shape_ring_gradient_fa7d22_ffffff"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_4"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/color_ff5b00"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_connecting"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/battery_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="@dimen/dp_13"
        app:layout_constraintStart_toEndOf="@+id/device_model"
        app:layout_constraintTop_toBottomOf="@+id/device_name">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_flag1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R"
                android:singleLine="true"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/device_battery_image"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_10"
                android:src="@drawable/icon_homepage_device_list_battery"
                android:layout_marginEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/dp_8"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/device_battery_flag2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:singleLine="true"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/device_battery_image2"
                android:visibility="gone"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_10"
                android:src="@drawable/icon_homepage_device_list_battery"
                android:layout_marginEnd="@dimen/dp_3"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/earphone_battery"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:src="@drawable/icon_homepage_device_list_earphone_right"/>
            <TextView
                android:textSize="@dimen/dp_8"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/earphone_battery_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/dp_3"/>
            <ImageView
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:src="@drawable/icon_homepage_device_list_earphone_left"/>
            <TextView
                android:textSize="@dimen/dp_8"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/earphone_battery_right_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_4g_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.imageview.ShapeableImageView
                android:background="#6fdc6a"
                android:layout_width="6dp"
                android:layout_height="6dp"
                app:shapeAppearanceOverlay="@style/circleStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#4d4d4d"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dataadmin_yibangding"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
