<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_bs_instructions_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_dot_bg_low"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_bg_low"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_dot_bg_nor"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_bg_nor"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/step_item_high"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:src="@drawable/shape_dot_bg_high"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_bg_high"
            android:gravity="right"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
