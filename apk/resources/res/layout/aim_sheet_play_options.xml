<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/aim_bg_play_options_sheet"
    android:paddingTop="24dp"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aim_play_mode"
        android:paddingStart="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/aim_bg_play_options_card"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/optOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/optOrderIconBox"
                android:background="@drawable/aim_bg_mode_icon_selected"
                android:layout_width="68dp"
                android:layout_height="68dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivOptOrder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/aim_ic_mode_list_arrows_tintable"/>
            </FrameLayout>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#3d6f9a"
                android:id="@+id/tvOptOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/aim_mode_order"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/optSingle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/optSingleIconBox"
                android:background="@drawable/aim_bg_mode_icon_normal"
                android:layout_width="68dp"
                android:layout_height="68dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivOptSingle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/aim_ic_mode_single_circle_tintable"/>
            </FrameLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="#b0bac8"
                android:id="@+id/tvOptSingle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/aim_mode_single"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/aim_sleep_timer"
        android:paddingStart="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aim_bg_play_options_card"
        android:paddingTop="16dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aim_sleep_pick_time"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#bbbbbb"
                    android:id="@+id/tvLastTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/switchTimer"
                android:background="@drawable/aim_bg_timer_switch_off"
                android:layout_width="46dp"
                android:layout_height="26dp">
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/switchThumb"
                    android:background="@drawable/aim_bg_timer_switch_thumb"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="3dp"
                    android:elevation="2dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llTimerChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>
