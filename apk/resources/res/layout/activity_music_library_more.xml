<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_more"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_bottom_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_58">
        <androidx.cardview.widget.CardView
            android:id="@+id/music_play_cv"
            android:layout_width="@dimen/dp_38"
            android:layout_height="@dimen/dp_38"
            android:layout_marginStart="@dimen/dp_16"
            app:cardElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/play_head_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/icon_head_default"/>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/play_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_14"
            app:layout_constraintEnd_toStartOf="@+id/play_state_iv"
            app:layout_constraintStart_toEndOf="@+id/music_play_cv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_12"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="20"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginStart="@dimen/dp_9"
            android:layout_marginEnd="@dimen/dp_15"
            android:splitTrack="false"
            app:layout_constraintEnd_toStartOf="@+id/play_state_iv"
            app:layout_constraintStart_toEndOf="@+id/music_play_cv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            app:layout_constraintStart_toStartOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            app:layout_constraintEnd_toEndOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_state_iv"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
