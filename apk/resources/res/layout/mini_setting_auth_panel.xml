<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/mini_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.phancy.mini.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="#0f000000"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#888b98"
                    android:id="@+id/auth_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/mini_auth_panel_desc"
                    android:maxLines="1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/ic_mini_setting_list_white_bg"
                    android:paddingLeft="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/reject_button"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="44dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#040919"
                            android:gravity="center_vertical"
                            android:id="@+id/reject_text"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginRight="8dp"
                            android:text="@string/mini_auth_panel_reject"
                            android:drawableRight="@drawable/ic_mini_auth_tick"
                            android:layout_centerVertical="true"/>
                        <View
                            android:background="#ddd"
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/accept_button"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="44dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#040919"
                            android:gravity="center_vertical"
                            android:id="@+id/accept_text"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginRight="8dp"
                            android:text="@string/mini_auth_panel_accept"
                            android:drawableRight="@drawable/ic_mini_auth_tick"
                            android:layout_centerVertical="true"/>
                        <View
                            android:id="@+id/scope_bluetooth_line"
                            android:background="#ddd"
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/accept_background_button"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="44dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#040919"
                            android:gravity="center_vertical"
                            android:id="@+id/accept_background_text"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginRight="8dp"
                            android:text="@string/mini_auth_panel_accept_bg"
                            android:drawableRight="@drawable/ic_mini_auth_tick"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
