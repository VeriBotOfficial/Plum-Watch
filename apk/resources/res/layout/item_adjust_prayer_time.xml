<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_adjust_prayer_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_36">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_adjust_prayer_weather_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/white"
        android:id="@+id/item_adjust_prayer_weather_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="@+id/item_adjust_prayer_weather_iv"
        app:layout_constraintStart_toEndOf="@+id/item_adjust_prayer_weather_iv"
        app:layout_constraintTop_toTopOf="@+id/item_adjust_prayer_weather_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/white"
        android:id="@+id/item_adjust_prayer_minute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/item_adjust_prayer_weather_tv"
        app:layout_constraintEnd_toStartOf="@+id/item_adjust_prayer_add"
        app:layout_constraintStart_toEndOf="@+id/item_adjust_prayer_weather_tv"
        app:layout_constraintTop_toTopOf="@+id/item_adjust_prayer_weather_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_adjust_prayer_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_iqibla_add"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_adjust_prayer_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_adjust_prayer_add"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_iqibla_sub"/>
</androidx.constraintlayout.widget.ConstraintLayout>
