<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_ffffff_r12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_68"
    android:layout_marginTop="@dimen/dp_4"
    android:layout_marginBottom="@dimen/dp_8"
    android:layout_marginStart="@dimen/dp_12"
    android:layout_marginEnd="@dimen/dp_12">
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_000000"
        android:id="@+id/tv_component_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/title_page_all_function_component"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_component_subtitile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:maxWidth="@dimen/dp_280"
        android:text="@string/function_component_subtitle"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_component_name"/>
    <ImageView
        android:id="@+id/iv_component_icon"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/icon_my_function_component"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
