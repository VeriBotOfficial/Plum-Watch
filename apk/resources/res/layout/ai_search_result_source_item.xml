<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_ai_search_web_source"
    android:background="@drawable/shape_ffffff_r14"
    android:padding="@dimen/dp_8"
    android:layout_width="@dimen/dp_120"
    android:layout_height="@dimen/dp_91"
    android:layout_marginRight="@dimen/dp_12">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_source_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="百度热搜"
            android:singleLine="true"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_9"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_ai_search_source_item_num"
                android:background="@drawable/shape_e3e3e3_r2"
                android:layout_width="@dimen/dp_13"
                android:layout_height="@dimen/dp_13"
                android:minWidth="@dimen/dp_13"
                android:text="1"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_source_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="等针叶林和混交林地带，单身至群生。野…"
        android:maxLines="3"/>
</LinearLayout>
