<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:textColorHint="@color/color_999999"
        android:id="@+id/ed_exchange_code"
        android:background="@drawable/shape_white_r8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_16"
        android:hint="@string/exchange_hint_content"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/app_edit_text_cursor_bg"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    <Button
        android:enabled="false"
        android:textSize="@dimen/sp_16"
        android:textColor="@color/white"
        android:id="@+id/btnSure"
        android:background="@drawable/bg_btn_dial_ex_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/qinyou_queding"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintTop_toBottomOf="@+id/ed_exchange_code"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/exchange_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/btnSure"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_rule_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:lineHeight="@dimen/dp_18"
        app:layout_constraintTop_toBottomOf="@+id/exchange_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_exchange_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/tv_rule_content"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_channel_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:lineHeight="@dimen/dp_18"
        app:layout_constraintTop_toBottomOf="@+id/tv_exchange_channel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
