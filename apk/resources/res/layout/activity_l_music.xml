<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_l_music"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/w_n_l_m"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/color_ff5b00"
        android:gravity="center"
        android:id="@+id/tv_record_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_record_entry"
        android:drawablePadding="2dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:id="@+id/tv_occupy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/w_n_l_m_occupy"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_occupy_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_occupy"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/asb_progress"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="12dp"
        android:maxHeight="12dp"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_style_ff5b00"
        android:minHeight="12dp"
        android:thumb="@null"
        android:thumbOffset="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:splitTrack="false"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_occupy_des"
        style="@style/CustomSeekBar"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_used"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="24dp"
        app:cardBackgroundColor="@color/color_ff5b00"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_used"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_used"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_used"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/w_n_l_m_used"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/cv_used"
        app:layout_constraintTop_toBottomOf="@+id/asb_progress"/>
    <androidx.cardview.widget.CardView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="@color/color_d9d9d9"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_available"
        app:layout_constraintEnd_toStartOf="@+id/tv_available"
        app:layout_constraintTop_toTopOf="@+id/tv_available"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_available"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/w_n_l_m_available"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/asb_progress"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_layout"
        android:background="@drawable/shape_bg_white_top_r24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_down"
        app:layout_constraintTop_toBottomOf="@+id/tv_available">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_play_all"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_l_music_p"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:id="@+id/tv_play_all"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_n_l_m_play_all"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_play_all"
            app:layout_constraintStart_toEndOf="@+id/iv_play_all"
            app:layout_constraintTop_toTopOf="@+id/iv_play_all"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_l_music"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_play_all"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llc_empty_layout"
        android:background="@drawable/shape_bg_white_top_r24"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_available">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="124dp"
            app:srcCompat="@drawable/ic_l_m_empty"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/w_n_l_m_empty"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_down"
        android:background="@drawable/shape_black_r999"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="11dp"
        android:text="@string/w_n_l_m_down"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
