<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ai_music_d2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/sound_a_m"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_ai_music_d"
        android:background="@drawable/bg_ai_music_d3"
        android:layout_width="194dp"
        android:layout_height="194dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_ai_music_d"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-100dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/play_control_layout"
        app:layout_constraintTop_toBottomOf="@+id/iv_ai_music_d">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/color_282828"
            android:id="@+id/name_ai_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_9a9a9a"
            android:gravity="center"
            android:id="@+id/des_ai_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/name_ai_music"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/des_ai_music">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ai_music_lyric"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="36dp"/>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="51dp"
        app:cardCornerRadius="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_ai_music_d">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_ai_music_head"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/play_control_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:layout_marginTop="26dp"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:layout_marginHorizontal="22.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="00:00"
            app:layout_constraintStart_toStartOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="00:00"
            app:layout_constraintEnd_toEndOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_module_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_play_m_radom"
            app:layout_constraintEnd_toStartOf="@+id/play_left_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/play_current_time"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_left_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_play_m_l"
            app:layout_constraintEnd_toStartOf="@+id/play_control_iv"
            app:layout_constraintStart_toEndOf="@+id/play_module_iv"
            app:layout_constraintTop_toTopOf="@+id/play_module_iv"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_control_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_play_d_p"
            app:layout_constraintEnd_toStartOf="@+id/play_right_iv"
            app:layout_constraintStart_toEndOf="@+id/play_left_iv"
            app:layout_constraintTop_toTopOf="@+id/play_module_iv"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_right_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_play_m_r"
            app:layout_constraintEnd_toEndOf="@+id/play_seek_bar"
            app:layout_constraintStart_toEndOf="@+id/play_control_iv"
            app:layout_constraintTop_toTopOf="@+id/play_module_iv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
