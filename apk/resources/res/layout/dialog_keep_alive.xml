<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <View
            android:background="@drawable/shape_d8d8d8_4"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_6"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/textBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/keep_alive_setting_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_f6f6f6_r6"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/keep_alive_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_notify_tip_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/keep_alive_img_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/img_keep_alive_dialog_1"
                app:layout_constraintEnd_toStartOf="@+id/keep_alive_img_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/keep_alive_tip"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/keep_alive_img_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/img_keep_alive_dialog_2"
                app:layout_constraintEnd_toStartOf="@+id/keep_alive_img_3"
                app:layout_constraintStart_toEndOf="@+id/keep_alive_img_1"
                app:layout_constraintTop_toBottomOf="@+id/keep_alive_tip"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/keep_alive_img_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/img_keep_alive_dialog_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/keep_alive_img_2"
                app:layout_constraintTop_toBottomOf="@+id/keep_alive_tip"
                app:layout_constraintVertical_chainStyle="packed"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_setting"
            android:textAllCaps="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/shape_e3e3e3_r6"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/tip40"
            android:textAllCaps="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
