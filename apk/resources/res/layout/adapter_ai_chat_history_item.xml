<?xml version="1.0" encoding="utf-8"?>
<com.wakeup.commonui.view.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_84"
    android:layout_marginTop="@dimen/dp_12"
    android:layout_marginHorizontal="@dimen/dp_12"
    app:ios="true"
    app:leftSwipe="true"
    app:swipeEnable="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="你好 中英文的对吧"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line"
            android:background="@color/ps_color_E4E4E4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="parent">
        <View
            android:layout_width="@dimen/dp_12"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/dp_75"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="@dimen/dp_0"
            app:cardMaxElevation="@dimen/dp_0">
            <View
                android:background="@color/color_ff3b30"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sound_del"/>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.wakeup.commonui.view.SwipeMenuLayout>
