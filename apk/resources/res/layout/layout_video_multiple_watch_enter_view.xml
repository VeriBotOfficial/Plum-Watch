<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_view_watch_enter"
    android:background="@drawable/bg_shape_000000_r8"
    android:layout_width="wrap_content"
    android:layout_height="45dp"
    android:paddingHorizontal="8dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_watch_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_watch_name"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff4142"
            android:ellipsize="end"
            android:id="@+id/tv_watch_desc"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_buy"
        android:background="@drawable/shape_gradient_ff4502_ff6c11_left_right"
        android:layout_width="52dp"
        android:layout_height="26dp"
        android:text="@string/energy_buy"
        android:singleLine="true"
        android:layout_marginStart="10dp"/>
</LinearLayout>
