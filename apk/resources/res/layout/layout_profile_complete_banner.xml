<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shape_ffffff_r12"
    android:padding="12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:ellipsize="end"
            android:id="@+id/profile_guide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_guide_banner_title"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:id="@+id/profile_guide_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/profile_guide_banner_tip_new"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/profile_guide_close"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_profile_guide_close"
        android:scaleType="centerInside"
        android:contentDescription="@string/btn_cancel"/>
</LinearLayout>
