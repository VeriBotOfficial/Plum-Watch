<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_fffbf5_r10_r0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/shape_df99f37_r10_r0"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="#ff333333"
                android:id="@+id/tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart_info_type"
                android:drawableLeft="@mipmap/icon_bloodoxygen_type"
                android:drawablePadding="8dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart_info_Offline_value"
                android:drawableLeft="@mipmap/icon_bloodoxygen_value"
                android:drawablePadding="8dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart_info_upper_limit_value"
                android:drawableLeft="@mipmap/icon_bloodoxygen_value"
                android:drawablePadding="8dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#fffbf5"
            android:paddingLeft="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv9"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_info_ideal_heart_rate"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv11"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_normal_rate"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv13"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_speed_heart_rate"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff999999"
                    android:id="@+id/tv15"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_info_slow_heartbeat"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingRight="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_55_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_60_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_100_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_45_times_minute"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:id="@+id/tv10"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_70_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_100_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:id="@+id/tv14"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_160_times_minute"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff333333"
                    android:layout_gravity="left"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_60_times_minute"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#e8e8e8"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_16"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/heart_info_tips"/>
    </LinearLayout>
</RelativeLayout>
