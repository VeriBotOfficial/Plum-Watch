<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/religion_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/religion_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:backImage="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_close_religion"
        app:titleText="@string/religion_title"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/religion_content_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/religion_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/religion_bottom_navigate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/religion_bottom_one"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/religion_bottom_two"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_table_pray_normal"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/religion_bottom_two"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/religion_bottom_three"
            app:layout_constraintStart_toEndOf="@+id/religion_bottom_one"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_table_data_normal"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/religion_bottom_three"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/religion_bottom_two"
            app:layout_constraintStart_toEndOf="@+id/religion_bottom_four"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_table_scene_n"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/religion_bottom_four"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/religion_bottom_five"
            app:layout_constraintStart_toEndOf="@+id/religion_bottom_three"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_table_setting_normal"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/religion_bottom_five"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/religion_bottom_four"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_table_setting_normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
