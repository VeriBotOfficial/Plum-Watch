<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/dialog_download_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jacket_m_export"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_4F4E4D"
        android:id="@+id/dialog_download_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/jacket_m_s_export"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_download_title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radioGroup_download_content"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_download_content">
        <RadioButton
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ff000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/rb_download_original_text"
            android:background="@drawable/select_check_box"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:text="@string/jacket_m_original"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rb_download_video"/>
        <RadioButton
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ff000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/rb_download_video"
            android:background="@drawable/select_check_box"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_7"
            android:button="@null"
            android:text="@string/jacket_m_s_audio"
            android:maxLines="2"
            style="@style/MyCheckBox"/>
        <RadioButton
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ff000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/rb_download_summary"
            android:background="@drawable/select_check_box"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_7"
            android:button="@null"
            android:text="@string/jacket_m_intelligent_summary"
            android:maxLines="2"
            android:layout_weight="1"
            style="@style/MyCheckBox"/>
    </RadioGroup>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/dialog_ll_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup_download_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_4F4E4D"
            android:id="@+id/dialog_download_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/string_file_name"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radioGroup_download_content"/>
        <EditText
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:gravity="center_vertical"
            android:id="@+id/dialog_download_edit_file_name"
            android:background="@drawable/shape_f4f6f8_r8"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_12"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/dialog_download_file_name"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_4F4E4D"
        android:id="@+id/dialog_download_file_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/jacket_m_s_file_format"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_ll_file_name"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radioGroup_download_format"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_download_file_style">
        <RadioButton
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ff000000"
            android:gravity="center"
            android:id="@+id/rb_docx_format"
            android:background="@drawable/select_check_box"
            android:clickable="false"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_33"
            android:checked="true"
            android:button="@null"
            android:text=".docx"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rb_download_video"/>
    </RadioGroup>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dialog_download_end"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dialog_download_cancel"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup_download_format">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/dialog_download_progress"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/meet_export_anim"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/dialog_download_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:text="@string/jacket_m_export"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginStart="6dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/dialog_download_cancel"
        android:background="@drawable/shape_e3e3e3_r999"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/btn_cancel"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/dialog_download_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup_download_format"/>
</androidx.constraintlayout.widget.ConstraintLayout>
