<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl01"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_400"
                android:layout_margin="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@color/grey"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@style/chamfer12dp"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="#52000000"
                    android:contentDescription="蒙版"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@style/chamfer12dp"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <xyz.doikki.videoplayer.player.VideoView
                        android:id="@+id/videoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:playerBackgroundColor="#e1d8dd"/>
                </androidx.cardview.widget.CardView>
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="@dimen/dp_34"
                    android:layout_height="@dimen/dp_34"
                    android:layout_marginTop="@dimen/dp_16"
                    android:src="@mipmap/ic_logo_small"
                    android:layout_marginStart="@dimen/dp_20"
                    android:elevation="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tvLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wearfit"
                    android:shadowColor="#29000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:layout_marginStart="@dimen/dp_8"
                    android:elevation="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_17"
                    android:elevation="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivLogo"/>
                <TextView
                    android:textSize="@dimen/sp_31"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="start"
                    android:id="@+id/tvSlogan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_189"
                    android:text="@string/course_tip_11"
                    android:shadowColor="#29000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:layout_marginStart="@dimen/dp_47"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_ffffff"
                    android:id="@+id/tvActionName"
                    android:background="@drawable/bg_shape_1f000000_r6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:shadowColor="#54000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_5"
                    app:layout_constraintStart_toStartOf="@+id/tvSlogan"
                    app:layout_constraintTop_toBottomOf="@+id/tvSlogan"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-15dp"
                    android:src="@drawable/ic_slogan_left"
                    android:layout_marginEnd="@dimen/dp_8"
                    app:layout_constraintBottom_toTopOf="@+id/tvSlogan"
                    app:layout_constraintEnd_toStartOf="@+id/tvSlogan"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-15dp"
                    android:src="@drawable/ic_slogan_right"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintStart_toEndOf="@+id/tvSlogan"
                    app:layout_constraintTop_toBottomOf="@+id/tvSlogan"/>
                <ImageView
                    android:id="@+id/btnPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:src="0x7f080728"
                    android:layout_marginEnd="@dimen/dp_20"
                    android:elevation="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f08071a"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/cl01"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHead"
                android:background="@drawable/shape_round_ffffff"
                android:padding="@dimen/dp_7"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="-40dp"
                android:src="@drawable/image_default_avatar"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/dp_27"
                app:layout_constraintStart_toStartOf="@+id/cl01"
                app:layout_constraintTop_toBottomOf="@+id/cl01"
                app:shapeAppearance="@style/circleStyle"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ff666666"
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintStart_toStartOf="@+id/cl01"
                app:layout_constraintTop_toBottomOf="@+id/ivHead"/>
            <ImageView
                android:id="@+id/ivQr"
                android:background="@drawable/shape_transp_line_e6e6e6"
                android:padding="@dimen/dp_8"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/ic_qr_f"
                android:layout_marginEnd="@dimen/dp_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvUserName"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#ff999999"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/course_tip_12"
                app:layout_constraintEnd_toEndOf="@+id/ivQr"
                app:layout_constraintStart_toStartOf="@+id/ivQr"
                app:layout_constraintTop_toBottomOf="@+id/ivQr"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clInfo"
                android:paddingBottom="@dimen/dp_43"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_5"
                app:layout_constraintEnd_toStartOf="@+id/ivQr"
                app:layout_constraintStart_toStartOf="@+id/tvUserName"
                app:layout_constraintTop_toBottomOf="@+id/tvUserName">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvKcal"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff666666"
                    android:gravity="center"
                    android:id="@+id/tipDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/home_shichang"
                    android:drawablePadding="@dimen/dp_2"
                    app:drawableStartCompat="0x7f0807c1"
                    app:layout_constraintStart_toStartOf="@+id/tvDuration"
                    app:layout_constraintTop_toBottomOf="@+id/tvDuration"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:id="@+id/tvKcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_60"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintStart_toEndOf="@+id/tvDuration"
                    app:layout_constraintTop_toTopOf="@+id/tvDuration"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff666666"
                    android:gravity="center"
                    android:id="@+id/tipHeart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/tip_21_0625_liu_2"
                    android:drawablePadding="@dimen/dp_2"
                    app:drawableStartCompat="@drawable/ic_hot_green"
                    app:layout_constraintStart_toStartOf="@+id/tvKcal"
                    app:layout_constraintTop_toBottomOf="@+id/tvKcal"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:ellipsize="end"
                    android:id="@+id/tvHeart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvKcal"
                    app:layout_constraintTop_toTopOf="@+id/tvDuration"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff666666"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/qinyou_xinlv"
                    android:lines="1"
                    app:drawableStartCompat="@drawable/ic_heart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvHeart"
                    app:layout_constraintTop_toBottomOf="@+id/tvHeart"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/llBg"
            android:background="@color/color_F6F6F6"
            android:paddingBottom="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clInfo">
            <TextView
                android:textSize="17sp"
                android:textColor="#ff333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/tip_1021_1"
                android:layout_marginStart="@dimen/dp_12"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/dp_8"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
