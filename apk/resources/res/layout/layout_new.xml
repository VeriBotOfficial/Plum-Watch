<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_sport"
            android:background="@drawable/bg_white_5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationZ="2dp"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_top_heart"
                android:background="@drawable/ic_home_new_sport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="运动记录"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/iv_top_heart"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_top_paobu"
                android:background="@drawable/ic_home_new_bushu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="5dp"
                app:layout_constraintStart_toStartOf="@+id/iv_top_heart"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_heart"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ff000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="跑步"
                android:layout_marginStart="25dp"
                app:layout_constraintStart_toStartOf="@+id/iv_top_paobu"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_heart"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_70_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="77dp"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="30"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_distance"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_paobu"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="323"
                app:layout_constraintEnd_toStartOf="@+id/tv_calories"
                app:layout_constraintStart_toEndOf="@+id/tv_time"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_paobu"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_calories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="5.2"
                app:layout_constraintEnd_toStartOf="@+id/guideline_70_percent"
                app:layout_constraintStart_toEndOf="@+id/tv_distance"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_paobu"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/minute"
                app:layout_constraintStart_toStartOf="@+id/tv_time"
                app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_distance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="千卡"
                app:layout_constraintStart_toStartOf="@+id/tv_distance"
                app:layout_constraintTop_toBottomOf="@+id/tv_distance"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_calories_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="公里"
                app:layout_constraintStart_toStartOf="@+id/tv_calories"
                app:layout_constraintTop_toBottomOf="@+id/tv_calories"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/tv_date_and_time"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2024/09/28 13:30-14:00"
                app:layout_constraintStart_toStartOf="@+id/tv_time"
                app:layout_constraintTop_toBottomOf="@+id/tv_calories_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
