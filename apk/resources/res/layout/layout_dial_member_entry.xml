<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dial_member_entry"
    android:background="@drawable/bg_dial_member_entry"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_13"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_19">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_dial_member_thumb"
        android:background="@drawable/bg_dial_member_thumb_placeholder"
        android:layout_width="@dimen/dp_34"
        android:layout_height="@dimen/dp_34"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dial_member_copy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_9"
        android:layout_marginEnd="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_dial_member_cta"
        app:layout_constraintStart_toEndOf="@+id/iv_dial_member_thumb"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="#1f1f24"
                android:id="@+id/tv_dial_member_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dial_member_entry_title"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="#f5460d"
                android:id="@+id/tv_dial_member_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dial_member_entry_price"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="#9a9aa0"
            android:id="@+id/tv_dial_member_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dial_member_entry_subtitle"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        android:textColor="#5a3a10"
        android:id="@+id/tv_dial_member_cta"
        android:background="@drawable/bg_dial_member_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dial_member_entry_cta"
        android:layout_marginEnd="@dimen/dp_9"
        android:paddingHorizontal="@dimen/dp_14"
        android:paddingVertical="@dimen/dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_dial_member_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_dial_member_close"
        android:padding="1dp"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_close_grey"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#c7c7cc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
