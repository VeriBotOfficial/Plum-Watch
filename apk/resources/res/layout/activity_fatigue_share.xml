<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_black"
        app:background="@color/transp"
        app:menuImage="@drawable/ic_share_gray_black"
        app:titleColor="@color/color_333333"
        app:titleText="@string/share_yulan"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/nestedScrollView"
        android:background="@color/color_f6f6f6"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@color/color_f6f6f6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/color_f6f6f6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_16"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/container"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_26">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/icon"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_marginTop="@dimen/dp_24"
                    app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_666666"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"/>
                <FrameLayout
                    android:id="@+id/share_tabLayout"
                    android:background="@color/white"
                    android:paddingBottom="@dimen/dp_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12">
                    <com.google.android.material.tabs.TabLayout
                        android:layout_gravity="center"
                        android:id="@+id/tabLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/color_69CE87"
                        app:tabIndicatorFullWidth="false"
                        app:tabIndicatorHeight="1dp"
                        app:tabMinWidth="60dp"
                        app:tabMode="fixed"
                        app:tabRippleColor="@color/colorTransparent"
                        app:tabSelectedTextColor="@color/color_69CE87"
                        app:tabTextColor="@color/textBlack"/>
                </FrameLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/share_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:background="#f1f3f5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/pilao_pilaoducankaozhi"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/step_item_high">
                        <androidx.constraintlayout.utils.widget.ImageFilterView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@color/color_pressure_l1"
                            app:round="50dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_tip_1027"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_pressure_l1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pilao_qingsong"/>
                    </LinearLayout>
                    <View
                        android:background="@color/line"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/step_item_high">
                        <androidx.constraintlayout.utils.widget.ImageFilterView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@color/color_pressure_l2"
                            app:round="50dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_tip_1028"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_pressure_l2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_zhengchang"/>
                    </LinearLayout>
                    <View
                        android:background="@color/line"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/step_item_high">
                        <androidx.constraintlayout.utils.widget.ImageFilterView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@color/color_pressure_l3"
                            app:round="50dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_tip_1029"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_pressure_l3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pilao_zhongdeng"/>
                    </LinearLayout>
                    <View
                        android:background="@color/line"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/step_item_high">
                        <androidx.constraintlayout.utils.widget.ImageFilterView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@color/color_pressure_l4"
                            app:round="50dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_tip_1030"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_pressure_l4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mianyili_piangao"/>
                    </LinearLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:background="@drawable/shape_f5f5f5_bottom_r12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:src="@mipmap/share_logo_img"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wearfit"
                        android:layout_marginStart="@dimen/dp_10"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
