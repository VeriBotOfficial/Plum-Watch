<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_20">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_pilaodu"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff666666"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_tip_1026"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_20">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pilao_pilaoducankaozhi"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/step_item_high">
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@color/color_pressure_l1"
                app:round="50dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_1027"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_pressure_l1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pilao_qingsong"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/step_item_high">
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@color/color_pressure_l2"
                app:round="50dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_1028"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_pressure_l2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_zhengchang"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/step_item_high">
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@color/color_pressure_l3"
                app:round="50dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_1029"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_pressure_l3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pilao_zhongdeng"/>
        </LinearLayout>
        <View
            android:background="@color/line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/step_item_high">
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@color/color_pressure_l4"
                app:round="50dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/device_tip_1030"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_pressure_l4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mianyili_piangao"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
