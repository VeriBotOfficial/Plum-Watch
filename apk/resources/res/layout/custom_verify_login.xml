<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_ff7300"
        android:id="@+id/tvBindOrderPhone"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="440dp"
        android:text="绑定其他手机号"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_ff7300"
        android:id="@+id/tvOtherPhone"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="590dp"
        android:text="@string/other_phone_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/textGray"
        android:id="@+id/other_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="选择其他登录方式"
        app:layout_constraintBottom_toTopOf="@+id/ivWechat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivPhone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_password_login"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintEnd_toStartOf="@+id/ivWechat"
        app:layout_constraintTop_toTopOf="@+id/ivWechat"/>
    <ImageView
        android:id="@+id/ivWechat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/dp_40"
        android:src="@drawable/ic_wechat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivQQ"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_qq"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toEndOf="@+id/ivWechat"
        app:layout_constraintTop_toTopOf="@+id/ivWechat"/>
</androidx.constraintlayout.widget.ConstraintLayout>
