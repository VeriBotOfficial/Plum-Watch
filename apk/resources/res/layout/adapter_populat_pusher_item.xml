<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_fdfdfd_r12"
    android:layout_width="@dimen/dp_181"
    android:layout_height="@dimen/dp_283"
    android:layout_marginTop="@dimen/dp_25"
    android:layout_marginBottom="@dimen/dp_8"
    android:layout_marginStart="@dimen/dp_8"
    android:elevation="4dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close"
        android:padding="@dimen/dp_8"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/popular_pusher_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_user"
        android:layout_width="@dimen/dp_69"
        android:layout_height="@dimen/dp_69"
        android:layout_marginTop="@dimen/dp_38"
        android:src="@drawable/icon_head_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageWithBorderStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:text="佳佳"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_user"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_666666"
        android:gravity="center"
        android:id="@+id/tv_user_jianjie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_23"
        android:text="精选剧情达人"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/dp_31"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_follow_btn"
        android:background="@drawable/sel_btn_follow"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_29"
        android:layout_marginBottom="@dimen/dp_15"
        android:text="@string/video_follow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
