<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_ffffff_r14"
    android:padding="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_12">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_history_particular_ai_title"
        android:background="@drawable/shape_f4f6f8_r8"
        android:padding="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:background="@drawable/ic_fanshi_ai"
            android:layout_width="@dimen/dp_78"
            android:layout_height="@dimen/dp_16"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="找到3篇内容生成"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:background="@drawable/ic_history_particular_more_content"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_history_particular_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="选择的艺术品是梵高的《星夜》。这幅作品创作于1889年，是梵高在法国圣雷米疗养院期间创作的。梵高是荷兰后印象派画家，以其独特的画风和强烈的情感表达著称。他的作品常常描绘自然景象，尤其是夜晚的景象，通过大胆的色彩和笔触来表达内心的情感。         ‌\10梵高在创作《星夜》时，正处于精神崩溃的边缘，他在疗养期间通过绘画来缓解痛苦。这幅画作展现了梵高对自然景象的独特感知，尤其是夜晚的星空和村庄。画中的色彩斑斓，蓝色和黄色的对比强烈，表现出梵高内心的挣扎和情感的释放‌。"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintTop_toBottomOf="@+id/ll_history_particular_ai_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_history_particular_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_999999"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/ai_generated_content_model_source_warning"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_history_particular_copy_btn"
            android:background="@drawable/shape_f4f6f8_r8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_6">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/ic_copy_history_particular_content"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_search_copy_text"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
