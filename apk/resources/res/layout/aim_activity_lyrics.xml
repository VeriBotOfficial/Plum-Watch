<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyricsRoot"
    android:background="@color/aim_feed_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBlurBg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/blurScrim"
        android:background="#4d000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ivBack"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/aim_ic_back"
            android:layout_marginStart="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/headerRow"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <ImageView
                android:id="@+id/ivCover"
                android:background="@drawable/aim_grad_a"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="14dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_text"
                    android:ellipsize="end"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/aim_text_muted"
                    android:ellipsize="end"
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btnPlay"
                android:background="@drawable/aim_bg_ctrl_circle"
                android:padding="13dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/aim_ic_play"
                android:contentDescription="@string/aim_mini_open"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLyrics"
            android:paddingTop="8dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svAsmrText"
            android:paddingTop="8dp"
            android:paddingBottom="40dp"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="false"
            android:layout_weight="1"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/aim_text"
                android:id="@+id/tvAsmrBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.55"/>
        </androidx.core.widget.NestedScrollView>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/aim_text_muted"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvNoLyrics"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/aim_no_lyrics"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
