<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_fafafa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="1dp"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPadding="@dimen/dp_0"
        app:tabPaddingEnd="@dimen/dp_15"
        app:tabPaddingStart="@dimen/dp_15"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/color_ff7300"
        app:tabTextAppearance="@style/tabLayoutTextStyle"
        app:tabTextColor="@color/color_666666"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/fragment_energy_v2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.appcompat.widget.LinearLayoutCompat>
