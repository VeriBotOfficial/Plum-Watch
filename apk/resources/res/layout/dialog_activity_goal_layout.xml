<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_19"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/shape_f6f6f6_r14"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/dp_30"
            app:layout_constraintBottom_toTopOf="@+id/ll_que"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_wheelView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_150"
            app:layout_constraintBottom_toTopOf="@+id/ll_que"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <com.contrarywind.view.WheelView
                android:layout_gravity="center_vertical"
                android:id="@+id/options1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_que"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_wheelView">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_333333"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip40"
                android:layout_weight="1"/>
            <View
                android:id="@+id/space"
                android:layout_width="16dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/qinyou_queding"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
