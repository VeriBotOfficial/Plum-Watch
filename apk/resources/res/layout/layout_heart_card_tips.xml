<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_normal_heart_rate"
            android:background="@drawable/shape_white_r4"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_normal_content"
                android:paddingLeft="@dimen/space_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_normal_rate"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/tv_normal_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_6"/>
            <LinearLayout
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_normal_state"
                    android:background="@drawable/shape_red_r8"
                    android:paddingLeft="@dimen/space_6"
                    android:paddingRight="@dimen/space_6"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/space_6"
                    android:text="@string/heart_risk"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_high_heart_rate"
            android:background="@drawable/shape_white_r4"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_high_content"
                android:paddingLeft="@dimen/space_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_high_heart_rate"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/disconnect_red"
                android:gravity="center_vertical"
                android:id="@+id/tv_high_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_4"/>
            <LinearLayout
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_high_state"
                    android:background="@drawable/shape_red_r8"
                    android:paddingLeft="@dimen/space_6"
                    android:paddingRight="@dimen/space_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/space_6"
                    android:text="@string/heart_risk"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_speed_heart_rate"
            android:background="@drawable/shape_white_r4"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_speed_content"
                android:paddingLeft="@dimen/space_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_speed_heart_rate"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/disconnect_red"
                android:gravity="center_vertical"
                android:id="@+id/tv_speed_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_6"/>
            <LinearLayout
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_speed_state"
                    android:background="@drawable/shape_red_r8"
                    android:paddingLeft="@dimen/space_6"
                    android:paddingRight="@dimen/space_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/space_6"
                    android:text="@string/heart_risk"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/shape_white_r4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
