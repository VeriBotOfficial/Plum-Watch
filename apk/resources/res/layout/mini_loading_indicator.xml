<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/mini_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textColor="@android:color/black"
        android:id="@+id/indicator_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textAlignment="center"/>
    <RelativeLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="17dp"
        android:layout_above="@+id/indicator_title"
        android:layout_centerHorizontal="true">
        <ProgressBar
            android:id="@+id/indicator_ring"
            android:padding="2dp"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:indeterminateDrawable="@drawable/ic_mini_app_loading"
            android:layout_centerInParent="true"/>
        <com.phancy.mini.widget.CircleImageView
            android:id="@+id/indicator_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_mini"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
