<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/shape_media_search_home_tilte_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_152"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/status_holder_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_25"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:padding="@dimen/dp_6"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/media_search_back_icon"
        android:layout_marginStart="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/search_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_bg"/>
    <View
        android:id="@+id/search_bg"
        android:background="@drawable/shape_white_r18"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toBottomOf="@+id/status_holder_view"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/search_icon"
        android:background="@drawable/shape_fff76814_r12"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="@dimen/dp_41"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/icon_video_search_start"
        android:paddingStart="@dimen/dp_13"
        android:paddingEnd="@dimen/dp_13"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/search_bg"
        app:layout_constraintEnd_toEndOf="@+id/search_bg"
        app:layout_constraintTop_toTopOf="@+id/search_bg"/>
    <ImageView
        android:id="@+id/input_cancel_iv"
        android:visibility="gone"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginRight="5dp"
        android:src="@drawable/media_search_input_cancel_icon"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/search_bg"
        app:layout_constraintEnd_toStartOf="@+id/search_icon"
        app:layout_constraintTop_toTopOf="@+id/search_bg"/>
    <EditText
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:textColorHint="@color/color_999999"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:id="@+id/input_et"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/media_search_cursor_shape"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_bg"
        app:layout_constraintEnd_toStartOf="@+id/input_cancel_iv"
        app:layout_constraintStart_toStartOf="@+id/search_bg"
        app:layout_constraintTop_toTopOf="@+id/search_bg"/>
    <View
        android:id="@+id/content_bg"
        android:background="@drawable/shape_bg_white_r20_tl_tr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bg"/>
    <FrameLayout
        android:id="@+id/search_result_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bg"/>
    <ScrollView
        android:id="@+id/search_history_and_red_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bg">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <FrameLayout
                android:id="@+id/search_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/hot_search_tab_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_27"
                android:layout_marginBottom="@dimen/dp_6"
                android:text="@string/tab_hot_search"
                android:layout_marginStart="@dimen/dp_12"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/hot_search_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_12"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
