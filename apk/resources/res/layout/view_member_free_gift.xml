<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_member_free_root"
    android:background="#52000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:layout_marginEnd="24dp">
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/iv_member_free_close"
                android:background="@drawable/bg_member_free_close"
                android:padding="@dimen/dp_7"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_close_white"
                android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_member_free_card"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:elevation="6dp"
                android:layout_marginHorizontal="@dimen/dp_44"
                android:paddingHorizontal="@dimen/dp_13">
                <TextView
                    android:textSize="@dimen/sp_19"
                    android:textStyle="bold"
                    android:textColor="#5b3e1c"
                    android:gravity="center"
                    android:id="@+id/tv_member_free_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_member_free_title"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#a0834f"
                    android:gravity="center"
                    android:id="@+id/tv_member_free_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/dial_member_free_subtitle"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_member_free_faces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:paddingHorizontal="@dimen/dp_4">
                    <include
                        android:id="@+id/face_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        layout="@layout/item_member_free_face"/>
                    <include
                        android:id="@+id/face_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        layout="@layout/item_member_free_face"/>
                    <include
                        android:id="@+id/face_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        layout="@layout/item_member_free_face"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:src="@drawable/ic_member_free_bead"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/dp_51"
                android:elevation="10dp"/>
            <ImageView
                android:layout_gravity="end"
                android:layout_width="@dimen/dp_92"
                android:layout_height="@dimen/dp_62"
                android:layout_marginTop="@dimen/dp_24"
                android:src="@drawable/ic_member_free_v_ribbon"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:layout_marginEnd="20dp"
                android:elevation="10dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:layout_marginHorizontal="24dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_member_free_lower_card"
                android:padding="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="6dp">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_19"
                        android:textStyle="bold"
                        android:textColor="#2e2113"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_6"
                        android:text="@string/dial_member_entry_title"/>
                    <TextView
                        android:textSize="@dimen/sp_38"
                        android:textStyle="bold"
                        android:textColor="#2e2113"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dial_member_entry_price"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_6"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        android:textColor="#8a7350"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_7"
                        android:text="@string/dial_member_free_unit"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10">
                    <TextView
                        android:textSize="@dimen/sp_17"
                        android:textStyle="bold"
                        android:textColor="#f5e4c0"
                        android:gravity="center"
                        android:id="@+id/tv_member_free_cta"
                        android:background="@drawable/bg_member_free_cta"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_52"
                        android:layout_marginTop="12dp"
                        android:text="@string/dial_member_entry_cta"/>
                    <TextView
                        android:textSize="@dimen/sp_10"
                        android:textStyle="bold"
                        android:textColor="#6b4a12"
                        android:layout_gravity="end"
                        android:background="@drawable/bg_member_free_ribbon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dial_member_entry_subtitle"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="3dp"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
