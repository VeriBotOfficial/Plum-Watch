<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/menstrual"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/img_menstrual"
        android:layout_width="169dp"
        android:layout_height="201dp"
        android:layout_marginTop="16dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/menstrual_welcome"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="#333333"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/menstrual_welcome_title1"
        android:layout_marginHorizontal="34dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/menstrual_welcome_tip1"
        android:layout_marginHorizontal="34dp"/>
    <View
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="34dp"
        android:layout_marginVertical="12dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="#333333"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menstrual_welcome_title2"
        android:layout_marginHorizontal="34dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/menstrual_welcome_tip2"
        android:layout_marginHorizontal="34dp"/>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_next"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/registered_xiayibu"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
