<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/blood_oxygen_desc_3"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">
        <com.google.android.material.imageview.ShapeableImageView
            android:background="@color/color_blood_o3"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="≥ 90%"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">
        <com.google.android.material.imageview.ShapeableImageView
            android:background="@color/color_blood_o2"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="70% - 89%"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:background="@color/color_f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">
        <com.google.android.material.imageview.ShapeableImageView
            android:background="@color/color_blood_o1"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＜ 70%"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
