<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/iv_annual_bg"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuExpandImage="@drawable/ic_share_gray_black"
        app:menuImage="@drawable/ic_history"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_40"
        android:textStyle="italic|bold"
        android:textColor="@color/color_333333"
        android:id="@+id/title_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/annual_year_target"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_10"
        android:textStyle="italic|bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/date"
        android:background="@drawable/ic_goal_date_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_5"
        android:text="2023"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="@+id/title_desc"
        app:layout_constraintStart_toEndOf="@+id/title_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_24"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/content_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan Your Goals"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_desc"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_annual_goal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_22"
        android:paddingHorizontal="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
