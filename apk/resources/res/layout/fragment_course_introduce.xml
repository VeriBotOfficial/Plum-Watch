<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:padding="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_desc_8"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/introduce_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="·本次课程为风靡欧美健身圈HiIT高强度间歇训练初级课程，让你持续减脂，HIIT是最适 ，合现代人的减脂方式，因为它省时，对于大多数上班族来说，挤不出来时间锻炼是个大问题，但是传统意义上来说，有氧运动需要持续进行40分钟才能达到的减脂效果，HilT在抱着强度的情况下，一天20分钟左右就可以有很好的减脂效果，而且动作简单，随时随地都可以进行。"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/course_desc_9"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/introduce_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="·适合居家锻炼的人群；\10·适合想提高臀部和腿部肌肉耐力的人群。"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/course_desc_10"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/introduce_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="·身体素质较差的隔两天一次，让身体适应一周，\10·正常隔一天练一次，一周三次"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/course_desc_11"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/introduce_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="·本课程为身体健康指导，请在选择或购买课程前咨询医生自身体质是否适合，如不适合请勿购买或练习；\10·在训练过程中，请严格遵照视频讲解和要求进行运动，如身体状况不佳，请停止运动，避免产生损伤和意外；\10·因人群体质不同，我方不对课程效果承担担保责任，且不对因课程可能产生的任何损伤或意外承担任何责任。"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
