<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_mine_vip_expired"
    android:background="@drawable/bg_mine_vip_expired_card"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_vip_expired_head"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/tv_vip_expired_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member"/>
            <View
                android:background="@drawable/bg_mine_vip_expired_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/mine_privilege_arrow"
            android:contentDescription="@null"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_vip_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/member_end"
        android:lines="2"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ll_vip_expired_head"
        app:layout_constraintTop_toBottomOf="@+id/ll_vip_expired_head"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_vip_expired_reminder"
        android:background="@drawable/bg_mine_vip_reminder_bar"
        android:padding="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_desc">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mine_vip_gift"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dial_member_expired_reminder"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#fb6e00"
            android:gravity="center"
            android:id="@+id/tv_vip_expired_cta"
            android:background="@drawable/bg_mine_vip_reminder_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dial_member_entry_cta"
            android:paddingVertical="5dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
