<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_last_horizontal_layout"
    android:layout_width="@dimen/dp_283"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_14"
    app:cardCornerRadius="@dimen/dp_12"
    app:cardElevation="@dimen/dp_0">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/item_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:id="@+id/item_select_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_12"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/item_select_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_12"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="@dimen/dp_0">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_horizontal_last_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/item_horizontal_last_iv"
                        android:layout_width="@dimen/dp_59"
                        android:layout_height="@dimen/dp_59"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_333333"
                        android:id="@+id/item_horizontal_last_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintBottom_toTopOf="@+id/item_horizontal_last_des_tv"
                        app:layout_constraintStart_toEndOf="@+id/item_horizontal_last_iv"
                        app:layout_constraintTop_toTopOf="@+id/item_horizontal_last_iv"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:ellipsize="end"
                        android:id="@+id/item_horizontal_last_des_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="@+id/item_horizontal_last_iv"
                        app:layout_constraintStart_toStartOf="@+id/item_horizontal_last_tv"
                        app:layout_constraintTop_toBottomOf="@+id/item_horizontal_last_tv"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_horizontal_last_line"
                    android:background="@drawable/bg_under_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/item_horizontal_last_layout"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_horizontal_last_layout2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/item_horizontal_last_line">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/item_horizontal_last_iv2"
                        android:layout_width="@dimen/dp_59"
                        android:layout_height="@dimen/dp_59"
                        android:layout_marginTop="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_333333"
                        android:id="@+id/item_horizontal_last_tv2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintBottom_toTopOf="@+id/item_horizontal_last_des_tv2"
                        app:layout_constraintStart_toEndOf="@+id/item_horizontal_last_iv2"
                        app:layout_constraintTop_toTopOf="@+id/item_horizontal_last_iv2"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:ellipsize="end"
                        android:id="@+id/item_horizontal_last_des_tv2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="@+id/item_horizontal_last_iv2"
                        app:layout_constraintStart_toStartOf="@+id/item_horizontal_last_tv2"
                        app:layout_constraintTop_toBottomOf="@+id/item_horizontal_last_tv2"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_ff7300"
                    android:id="@+id/item_horizontal_last_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/w_life_look_more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/item_horizontal_last_layout2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
