<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#ff282828"
        android:id="@+id/tvCollectMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fatigue_tip_01"
        android:drawableEnd="@drawable/ic_jiantou_right"
        android:layout_marginHorizontal="25dp"
        android:paddingVertical="12dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#ff282828"
        android:id="@+id/tvMore02"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/fatigue_tip_31"
        android:drawableEnd="@drawable/ic_jiantou_right"
        android:layout_marginHorizontal="25dp"
        android:paddingVertical="12dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView02"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#ff282828"
        android:id="@+id/tvMore03"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/fatigue_tip_38"
        android:drawableEnd="@drawable/ic_jiantou_right"
        android:layout_marginHorizontal="25dp"
        android:paddingVertical="12dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView03"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</androidx.appcompat.widget.LinearLayoutCompat>
