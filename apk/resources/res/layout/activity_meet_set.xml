<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/my_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/jacket_m_record"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/m_s_start"
        app:layout_constraintTop_toBottomOf="@+id/my_title_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_head"
                android:background="@drawable/bg_record_set"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="25dp"
                android:src="@drawable/ic_m_theme"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_head"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/m_s_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_t"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_icon"
                app:layout_constraintStart_toEndOf="@+id/m_s_icon"
                app:layout_constraintTop_toTopOf="@+id/m_s_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_cccccc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_t_read"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_theme"
                app:layout_constraintStart_toEndOf="@+id/m_s_theme"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14dp"
                android:textColorHint="@color/color_817F7D"
                android:gravity="start|top"
                android:id="@+id/m_s_theme_et"
                android:background="@drawable/shape_white_r12"
                android:layout_width="0dp"
                android:layout_height="138dp"
                android:layout_marginTop="12dp"
                android:hint="@string/jacket_m_s_p_t"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11dp"
                android:textColor="@color/color_cccccc"
                android:id="@+id/m_s_theme_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="0/100"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_theme_et"
                app:layout_constraintEnd_toEndOf="@+id/m_s_theme_et"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_participants_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="22dp"
                android:src="@drawable/ic_m_person"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_theme_et"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/m_s_participants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_person_"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_participants_icon"
                app:layout_constraintStart_toEndOf="@+id/m_s_participants_icon"
                app:layout_constraintTop_toTopOf="@+id/m_s_participants_icon"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14dp"
                android:textColorHint="@color/color_817F7D"
                android:id="@+id/m_s_participants_et"
                android:background="@drawable/shape_white_r12"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:hint="@string/jacket_m_s_p_p_case"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_participants"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_location_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="22dp"
                android:src="@drawable/ic_m_address"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_participants_et"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/m_s_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_a"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_location_icon"
                app:layout_constraintStart_toEndOf="@+id/m_s_location_icon"
                app:layout_constraintTop_toTopOf="@+id/m_s_location_icon"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14dp"
                android:textColorHint="@color/color_817F7D"
                android:id="@+id/m_s_location_et"
                android:background="@drawable/shape_white_r12"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:hint="@string/jacket_m_s_p_a"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_location"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_language_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="22dp"
                android:src="@drawable/ic_m_language"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_location_et"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/m_s_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_s_l"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_language_icon"
                app:layout_constraintStart_toEndOf="@+id/m_s_language_icon"
                app:layout_constraintTop_toTopOf="@+id/m_s_language_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColorHint="@color/color_817F7D"
                android:id="@+id/m_s_language_tv"
                android:background="@drawable/shape_white_r12"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:hint="@string/language_zh"
                android:drawableEnd="@drawable/ic_arrowgrey_right"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_language"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/m_s_translate_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="22dp"
                android:src="@drawable/ic_m_trans"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_language_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/m_s_translate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jacket_m_s_t_l"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_s_translate_icon"
                app:layout_constraintStart_toEndOf="@+id/m_s_translate_icon"
                app:layout_constraintTop_toTopOf="@+id/m_s_translate_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColorHint="@color/color_817F7D"
                android:id="@+id/m_s_translate_tv"
                android:background="@drawable/shape_white_r12"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:hint="@string/string_no_trans"
                android:drawableEnd="@drawable/ic_arrowgrey_right"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_s_translate"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/m_s_start"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/jacket_m_s_t_s"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
