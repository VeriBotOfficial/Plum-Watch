<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_l_music"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/view_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/sleep_record_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:id="@+id/tv_occupy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/w_n_l_m_occupy"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_occupy_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_occupy"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:enabled="false"
        android:id="@+id/asb_progress"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="12dp"
        android:maxHeight="12dp"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_style_ff5b00"
        android:minHeight="12dp"
        android:thumb="@null"
        android:thumbOffset="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:splitTrack="false"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_occupy_des"
        style="@style/CustomSeekBar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_capacity_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/asb_progress"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card"
        android:background="@drawable/shape_bg_white_top_r24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_save"
        app:layout_constraintTop_toBottomOf="@+id/tv_capacity_hint">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_record"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.wakeup.feature.device.white.record.view.RecordWaveView
                android:id="@+id/record_wave"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="28dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="00:00"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/record_wave"
                app:layout_goneMarginTop="40dp"/>
            <FrameLayout
                android:id="@+id/fl_record_btn"
                android:background="@drawable/bg_sleep_record_ring"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_timer">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/v_record_inner"
                    android:background="@drawable/shape_sleep_record_dot"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_record_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sleep_record_tap_to_start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_record_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_history_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/sleep_record_history_title"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_record_hint"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_history_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13dp"
                android:textColor="@color/color_999999"
                android:id="@+id/tv_history_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_record_history_empty"
                app:layout_constraintBottom_toBottomOf="@+id/rv_history"
                app:layout_constraintEnd_toEndOf="@+id/rv_history"
                app:layout_constraintStart_toStartOf="@+id/rv_history"
                app:layout_constraintTop_toTopOf="@+id/rv_history"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_trim"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.wakeup.feature.device.white.record.view.TrimWaveView
                android:id="@+id/trim_wave"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sel_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trim_wave"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_sel_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_sel_duration"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_sel_duration"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#ff3b30"
                android:id="@+id/tv_over_limit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sleep_record_over_limit"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sel_duration"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_over_limit">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="@color/color_ff5b00"
                    android:gravity="center"
                    android:id="@+id/tv_preview"
                    android:background="@drawable/shape_sleep_pill_orange"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="120dp"
                    android:text="@string/sleep_record_preview_selection"
                    android:paddingHorizontal="20dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="@color/color_ff5b00"
                    android:gravity="center"
                    android:id="@+id/tv_rerecord"
                    android:background="@drawable/shape_sleep_pill_orange"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="88dp"
                    android:text="@string/sleep_record_rerecord"
                    android:layout_marginStart="12dp"
                    android:paddingHorizontal="20dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:enabled="false"
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save"
        android:background="@drawable/shape_black_r999"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="11dp"
        android:text="@string/sleep_record_save"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
