<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="动态校验"
        app:titleText="@string/d_w_reply_verify"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:background="@drawable/ic_wechat_verify"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginTop="22dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/color_333333"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="为保证您的信息安全，请输入验证码"/>
    <com.wakeup.commonui.view.VerifyEditText
        android:layout_gravity="center"
        android:id="@+id/et_verify_input"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        app:verify_background_normal="@drawable/shape_verify_edittext_default_bg2"
        app:verify_background_selected="@drawable/shape_verify_edittext_default_bg2_s"
        app:verify_count="6"
        app:verify_inputType="number"
        app:verify_margin="@dimen/dp_15"
        app:verify_textSize="@dimen/sp_25"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="操作说明："
        android:layout_marginHorizontal="24dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1.在输入框完整填写微信验证码;"
        android:layout_marginHorizontal="24dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="2.点击【确认】按钮；"
        android:layout_marginHorizontal="24dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="3.提示“验证成功”，请在手表端稍候片刻；"
        android:layout_marginHorizontal="24dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="4.若提示“验证码错误”，请重新输入或获取新验证码后再次操作。"
        android:layout_marginHorizontal="24dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_03C160"
        android:layout_gravity="center"
        android:id="@+id/tv_look_course"
        android:padding="4dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="查看视频教程"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/ic_wechat_d_arrow"
        android:layout_marginHorizontal="24dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tv_verify"
        android:background="@drawable/shape_03c160_r999"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="32dp"
        android:text="@string/tip_21_0520_08"
        android:layout_marginHorizontal="20dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
