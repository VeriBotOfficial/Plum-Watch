<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/news_daily_face_root"
    android:focusable="false"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/news_daily_toast_face_clip"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <FrameLayout
            android:id="@+id/news_daily_toast_mascot"
            android:background="@drawable/bg_news_peek_face"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp">
            <View
                android:background="@drawable/bg_news_peek_highlight"
                android:layout_width="18dp"
                android:layout_height="8dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="6dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/news_daily_toast_eyes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp">
                <FrameLayout
                    android:id="@+id/news_daily_eye_left"
                    android:background="@drawable/bg_news_eye_white"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:scaleY="0.04"
                    android:layout_marginEnd="2dp">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/news_daily_pupil_left"
                        android:background="@drawable/bg_news_eye_pupil"
                        android:layout_width="8dp"
                        android:layout_height="8dp">
                        <View
                            android:background="@drawable/bg_news_eye_glint"
                            android:layout_width="2.5dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginStart="1dp"/>
                        <View
                            android:layout_gravity="end|bottom"
                            android:background="@drawable/bg_news_eye_glint"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:layout_marginBottom="1.5dp"
                            android:alpha="0.6"
                            android:layout_marginEnd="1.5dp"/>
                    </FrameLayout>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/news_daily_eye_right"
                    android:background="@drawable/bg_news_eye_white"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:scaleY="0.04"
                    android:layout_marginStart="2dp">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/news_daily_pupil_right"
                        android:background="@drawable/bg_news_eye_pupil"
                        android:layout_width="8dp"
                        android:layout_height="8dp">
                        <View
                            android:background="@drawable/bg_news_eye_glint"
                            android:layout_width="2.5dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginStart="1dp"/>
                        <View
                            android:layout_gravity="end|bottom"
                            android:background="@drawable/bg_news_eye_glint"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:layout_marginBottom="1.5dp"
                            android:alpha="0.6"
                            android:layout_marginEnd="1.5dp"/>
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
