<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_wk_au"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_marginTop="122dp"
        android:src="@mipmap/ic_logo_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_wk_au"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/watch_4g_login_tip1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_wk_au"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20dp"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_wk_au_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/watch_4g_login_tip2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_wk_au"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/shape_ff7300_r12"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="36dp"
        android:text="@string/qr_login_confirm"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/shape_f0f1f3_r12"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="128dp"
        android:text="@string/qr_login_cancel"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
