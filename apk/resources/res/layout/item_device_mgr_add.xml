<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="102dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ic_device_management_add_device_bk"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="102dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_add"
            android:background="@drawable/ic_device_management_add_device"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/device_management_add_new_device"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_add"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
