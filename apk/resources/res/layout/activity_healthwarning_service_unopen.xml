<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/icon_healthwanring1"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ff000000"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="55dp"
        android:text="@string/tip_21_0720_08"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ff666666"
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:text="@string/tip_21_0720_09"
        android:lineSpacingMultiplier="1.5"/>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_experience"
        android:background="@drawable/shape_1890ff_r25"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:text="@string/tip_21_0720_10"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff666666"
        android:layout_gravity="center"
        android:id="@+id/tv_openCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="55dp"
        android:text="已有3827035个家庭开通此服务"/>
</LinearLayout>
