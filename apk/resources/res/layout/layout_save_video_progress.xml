<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_save_video_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_save_video"
        android:background="@drawable/bg_save_video_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:layout_marginBottom="@dimen/dp_46"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_14">
        <ProgressBar
            android:id="@+id/pb_save_video"
            android:layout_width="@dimen/dp_24"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/white"
            style="?android:attr/progressBarStyleSmall"/>
        <ImageView
            android:id="@+id/iv_save_video_success"
            android:visibility="gone"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_save_video_success"
            android:contentDescription="@string/empty"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/white"
            android:id="@+id/tv_save_video_progress"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_save_video_progress_saving"
            android:layout_marginStart="@dimen/dp_10"/>
        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#999999"
            android:id="@+id/tv_save_video_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_8"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_save_video_share"
            android:background="@drawable/drawable_wechat_share_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_28"
            android:paddingHorizontal="@dimen/dp_10">
            <ImageView
                android:id="@+id/iv_icon"
                android:background="@drawable/ic_save_video_wechat_share"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_14"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@android:color/white"
                android:id="@+id/tv_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fenxiang"
                android:layout_marginStart="@dimen/dp_6"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
