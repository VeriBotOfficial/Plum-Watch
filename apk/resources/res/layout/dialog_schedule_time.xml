<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="start"
            android:id="@+id/tip_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/course_tip_87"
            android:layout_marginStart="@dimen/dp_20"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <com.aigestudio.wheelpicker.widgets.WheelDatePicker
                android:id="@+id/date_picker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                app:wheel_cyclic="false"
                app:wheel_indicator="true"
                app:wheel_item_space="30dp"
                app:wheel_item_text_color="@color/color_9a9a9a"
                app:wheel_selected_item_text_color="@color/color_333333"
                app:wheel_visible_item_count="6"/>
            <com.aigestudio.wheelpicker.WheelPicker
                android:id="@+id/hour_picker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:wheel_cyclic="false"
                app:wheel_indicator="true"
                app:wheel_item_space="30dp"
                app:wheel_item_text_color="@color/color_9a9a9a"
                app:wheel_selected_item_text_color="@color/color_333333"
                app:wheel_visible_item_count="6"/>
            <com.aigestudio.wheelpicker.WheelPicker
                android:id="@+id/minute_picker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:wheel_cyclic="false"
                app:wheel_indicator="true"
                app:wheel_item_space="30dp"
                app:wheel_item_text_color="@color/color_9a9a9a"
                app:wheel_selected_item_text_color="@color/color_333333"
                app:wheel_visible_item_count="6"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/shape_e3e3e3_r12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_cancel"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_confirm"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
