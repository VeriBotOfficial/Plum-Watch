<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/item_koran_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12">
    <FrameLayout
        android:id="@+id/item_koran_frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/dp_122"
        android:layoutDirection="ltr">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/item_koran_content_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/item_koran_order_number_tv"
            android:background="@drawable/ic_muslim_koran_word"
            android:visibility="gone"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            app:layout_constraintBottom_toBottomOf="@+id/item_koran_content_tv"
            app:layout_constraintEnd_toStartOf="@+id/item_koran_content_tv"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/item_koran_play_state"
        android:visibility="gone"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_30"
        app:srcCompat="@drawable/ic_play_state"/>
</androidx.appcompat.widget.LinearLayoutCompat>
