<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_xmind_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_language"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_xmind_language"
        android:layout_marginEnd="12dp"
        android:translationZ="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.module.jacket.meeting.xmind.XMindView
        android:id="@+id/xmind_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_switch_state"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/dp_12"
        app:cardBackgroundColor="#e7ebee"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_refresh"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:translationZ="3dp"
            app:srcCompat="@drawable/ic_xmind_fold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:translationZ="3dp"
            app:srcCompat="@drawable/ic_xmind_expand2"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/cv_fold"
            android:layout_width="36dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cv_expand"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_xmind_refresh"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_expand"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_xmind_expand"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_refresh"
        app:layout_constraintEnd_toStartOf="@+id/iv_refresh"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_location"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_xmind_location"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_refresh"
        app:layout_constraintEnd_toStartOf="@+id/iv_expand"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_zoom_out"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_xmind_zoom_out"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_refresh"
        app:layout_constraintEnd_toStartOf="@+id/iv_location"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_zoom_in"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_xmind_zoom_in"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_refresh"
        app:layout_constraintEnd_toStartOf="@+id/iv_zoom_out"/>
</androidx.constraintlayout.widget.ConstraintLayout>
