<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@drawable/ic_mine_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_280"
    app:layout_behavior="com.wakeup.howear.widget.HeaderFloatBehavior">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivIconRel"
        android:background="@drawable/shape_oval_s4_write"
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_76">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_2"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_17"
            android:textStyle="bold"
            android:textColor="@color/color_4D4D4D"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_220"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_is_vip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_member_d"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/userName"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_qr_code"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:src="@mipmap/ic_mine_qr"
            android:layout_marginStart="@dimen/sp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_is_vip"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_integral_level"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_80">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_my_integral"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="21sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_integral"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="29"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_696969"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/tip_21_0519_01"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/color_d8d8d8"
            android:layout_width="@dimen/dp_1"
            android:layout_height="50dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_my_grade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="21sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_grade"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="lv1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_696969"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/tip_21_0116_1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
