<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ic_mini_bottom_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.phancy.mini.widget.CircleImageView
                android:id="@+id/app_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mini"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#000"
                android:ellipsize="end"
                android:id="@+id/app_title"
                android:paddingLeft="8dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:maxLines="1"/>
        </LinearLayout>
        <View
            android:background="#0f000000"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/mini_app_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/setting_button"
                            android:background="@drawable/ic_mini_more_menu_button_bg"
                            android:clickable="true"
                            android:layout_width="56dp"
                            android:layout_height="56dp">
                            <ImageView
                                android:id="@+id/setting_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_mini_more_setting"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#888b98"
                            android:ellipsize="end"
                            android:gravity="center_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mini_more_menu_setting"
                            android:maxLines="2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp">
                        <RelativeLayout
                            android:id="@+id/relaunch_button"
                            android:background="@drawable/ic_mini_more_menu_button_bg"
                            android:clickable="true"
                            android:layout_width="56dp"
                            android:layout_height="56dp">
                            <ImageView
                                android:id="@+id/relaunch_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_mini_more_restart"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#888b98"
                            android:ellipsize="end"
                            android:gravity="center_horizontal"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mini_more_menu_relaunch"
                            android:maxLines="2"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            <View
                android:background="#0f000000"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#040919"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/cancel"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
