<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_card"
    android:background="@color/red"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_135"
    android:layout_marginHorizontal="@dimen/dp_12"
    app:cardCornerRadius="@dimen/dp_14">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/white"
            android:id="@+id/tv_course_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_76"
            android:text="腹部初级训练"
            android:layout_marginHorizontal="@dimen/dp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_course_kacl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120Kacl"
            android:layout_marginStart="@dimen/dp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_course_title"/>
        <TextView
            android:id="@+id/tv_course_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45min"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintStart_toEndOf="@+id/tv_course_kacl"
            app:layout_constraintTop_toBottomOf="@+id/tv_course_title"/>
        <TextView
            android:id="@+id/tv_course_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L1"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintStart_toEndOf="@+id/tv_course_min"
            app:layout_constraintTop_toBottomOf="@+id/tv_course_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
