<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_EEF3F6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/mTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:background="@color/transp"
            app:layout_constraintTop_toTopOf="parent"
            app:titleText="@string/tip80"/>
        <ScrollView
            android:id="@+id/scrollView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#c8c8c8"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_detail_tip"
                    android:paddingHorizontal="14dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_333333"
                    android:gravity="center"
                    android:id="@+id/tv_change_watch"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="14dp"
                    android:lineHeight="17sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_top_r12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_19">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:id="@+id/ll_dial_name"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dp_12"
                            app:layout_constraintEnd_toStartOf="@+id/tv_dial_install_num"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/sp_18"
                                android:textColor="@color/color_333333"
                                android:ellipsize="end"
                                android:id="@+id/tv_dial_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_22"
                                android:maxLines="1"
                                android:layout_marginEnd="6dp"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/dp_8"
                                android:textColor="@color/white"
                                android:id="@+id/tv_vip_tag"
                                android:background="@drawable/shape_dial_vip_tag"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="会员免费"
                                android:layout_marginStart="@dimen/dp_3"
                                android:paddingHorizontal="@dimen/dp_3"
                                android:paddingVertical="@dimen/dp_2"
                                app:layout_constraintStart_toEndOf="@+id/tv_dial_name"
                                app:layout_constraintTop_toTopOf="@+id/tv_dial_name"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_ff0000"
                            android:id="@+id/tv_dial_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            app:layout_constraintStart_toStartOf="@+id/ll_dial_name"
                            app:layout_constraintTop_toBottomOf="@+id/ll_dial_name"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_999999"
                            android:id="@+id/tv_dial_sizes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_14"
                            app:layout_constraintStart_toEndOf="@+id/tv_dial_price"
                            app:layout_constraintTop_toTopOf="@+id/tv_dial_price"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_dial_install_num"
                            android:background="@drawable/shape_f1f1f1_r12"
                            android:paddingTop="@dimen/dp_6"
                            android:paddingBottom="@dimen/dp_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_33"
                            android:layout_marginEnd="@dimen/dp_22"
                            android:paddingHorizontal="@dimen/dp_12"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_attention"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_22"
                            android:text="@string/dial_new_install_tip_title"
                            app:layout_constraintStart_toStartOf="@+id/tv_dial_price"
                            app:layout_constraintTop_toBottomOf="@+id/tv_dial_sizes"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_999999"
                            android:id="@+id/tv_attention_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/dial_new_install_tip_desc"
                            android:layout_marginHorizontal="@dimen/dp_12"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_attention"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.wakeup.commonui.ad.ScenarioBannerView
                        android:id="@+id/view_scenario_banner"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        app:bannerCornerRadius="@dimen/space_6"
                        app:cardElevation="1dp"/>
                    <TextView
                        android:textSize="@dimen/sp_17"
                        android:textColor="@color/color_282828"
                        android:id="@+id/tv_guess_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_22"
                        android:text="@string/dial_new_install_recommend"
                        android:layout_marginHorizontal="@dimen/dp_12"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dial"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"
                        android:paddingVertical="@dimen/dp_12"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_promo_bar"
        android:background="@drawable/shape_dial_promo_bar_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_38"
        android:paddingHorizontal="@dimen/dp_12">
        <ImageView
            android:id="@+id/iv_promo_icon"
            android:layout_width="@dimen/dp_15"
            android:layout_height="@dimen/dp_15"
            android:src="@drawable/ic_dial_promo_ticket"/>
        <TextView
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            android:textColor="@color/color_fc7a0a"
            android:ellipsize="end"
            android:id="@+id/tv_promo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_150"
            android:text="@string/dial_promo_tiered_title"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_6"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_promo_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/iv_promo_arrow"
            android:layout_width="@dimen/dp_12"
            android:layout_height="@dimen/dp_12"
            android:src="@drawable/ic_dial_promo_arrow"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_promo_keep"
        android:background="@drawable/shape_dial_promo_bar_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_38"
        android:paddingHorizontal="@dimen/dp_12">
        <ImageView
            android:layout_width="@dimen/dp_15"
            android:layout_height="@dimen/dp_15"
            android:src="@drawable/ic_dial_promo_ticket"/>
        <TextView
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            android:textColor="@color/color_fc7a0a"
            android:ellipsize="end"
            android:id="@+id/tv_keep_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_6"/>
        <TextView
            android:textSize="@dimen/sp_9"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_keep_continue"
            android:background="@drawable/shape_dial_promo_tag_r3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dial_promo_keep_continue"
            android:layout_marginStart="@dimen/dp_6"
            android:paddingHorizontal="@dimen/dp_5"
            android:paddingVertical="@dimen/dp_1"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_bbbbbb"
            android:id="@+id/iv_keep_close"
            android:padding="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_vip_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/fl_buy_vip_slot"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_AF6800"
                    android:gravity="center"
                    android:id="@+id/tv_buy_vip"
                    android:background="@drawable/shape_ffd05c_r6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/dial_new_install_vip"/>
                <include
                    android:id="@+id/view_member_free_download"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/layout_dial_member_free_download"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/btn_install"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginHorizontal="12dp"
                android:paddingHorizontal="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/fl_buy_vip_slot">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_install_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_new_install_buy"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_install_sub"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/goWatchMarket"
                android:background="@drawable/shape_ff7300_r6"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dial_detail_go_market"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/fl_buy_vip_slot"/>
            <ProgressBar
                android:id="@+id/progress_bar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/layer_list_progress_drawable_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/btn_install"
                app:layout_constraintStart_toStartOf="@+id/btn_install"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_progress"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar"
                app:layout_constraintStart_toStartOf="@+id/progress_bar"
                app:layout_constraintTop_toTopOf="@+id/progress_bar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_new_vip_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_ff7300"
                android:gravity="center"
                android:id="@+id/tv_new_buy"
                android:background="@drawable/shape_f3f3f3_r6"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_48"
                android:text="¥12.00购买"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_install"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_install"
                android:background="@drawable/shape_bug_vip_bg"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_48"
                android:paddingStart="@dimen/dp_19"
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_first_vip_combo"
                    android:background="@drawable/shape_vip_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="首月 ¥9.0"
                    android:paddingHorizontal="@dimen/dp_3"
                    android:paddingVertical="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_first_vip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="会员免费下载"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/ic_new_vip"
                    android:layout_marginEnd="@dimen/dp_4"
                    app:layout_constraintEnd_toStartOf="@+id/tv_first_vip_combo"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="全部表盘无限下载,永久使用"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintStart_toStartOf="@+id/tv_first_vip_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_first_vip_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
