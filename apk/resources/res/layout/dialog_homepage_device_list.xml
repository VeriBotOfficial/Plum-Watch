<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        android:id="@+id/materialCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:cardBackgroundColor="@color/color_ffffff"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/device_list_layout"
            android:layout_width="@dimen/dp_232"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/dp_278">
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_000000"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/title_homepage_device_list"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_12"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_666666"
                android:gravity="center_vertical"
                android:id="@+id/subtitle_device_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_12"
                android:text="@string/title_homepage_device_connecting_list"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_12"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/device_recycler_list"
                android:focusable="false"
                android:layout_width="@dimen/dp_210"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/view_click"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/dp_232"
        android:layout_height="@dimen/dp_50"/>
</FrameLayout>
