<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivLogo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@mipmap/ic_logo_small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPhone"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/reg_phone_hint"
            android:singleLine="true"
            android:inputType="phone"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/login_hint_code"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_F96623"
            android:id="@+id/tvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registered_fasongyanzhengma"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <Button
        android:enabled="false"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/btnNext"
        android:background="@drawable/bg_btn_login_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_44"
        android:text="@string/registered_xiayibu"
        android:layout_marginHorizontal="@dimen/dp_30"/>
</LinearLayout>
