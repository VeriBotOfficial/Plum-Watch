<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rlVideoCategory"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCategoryIcon"
            android:background="@drawable/ic_publish_video_category"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/color_282828"
            android:id="@+id/tvCategoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/publish_video_video_category_title"
            android:maxLines="2"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:id="@+id/tvCategoryContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginLeft="10dp"
            android:maxWidth="100dp"
            android:minWidth="50dp"
            android:text=""
            android:maxLines="1"
            android:layout_toLeftOf="@+id/ivArrow1"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivArrow1"
            android:background="@mipmap/ic_right_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    <View
        android:id="@+id/categoryLine"
        android:background="@color/color_EFEFEF"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="14dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rlVideoPermission"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPermissionIcon"
            android:background="@drawable/ic_publish_video_permission"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/color_282828"
            android:id="@+id/tvPermissionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/publish_video_video_permission_title"
            android:maxLines="2"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:id="@+id/tvPermissionContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginLeft="10dp"
            android:maxWidth="100dp"
            android:minWidth="50dp"
            android:text=""
            android:singleLine="true"
            android:layout_toLeftOf="@+id/ivArrow2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivArrow2"
            android:background="@mipmap/ic_right_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    <View
        android:background="@color/color_EFEFEF"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="14dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rlVideoDesc"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDescIcon"
            android:background="@drawable/ic_publish_video_category"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/color_282828"
            android:id="@+id/tvDescTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/publish_video_video_desc_title"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/ivDescIcon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:gravity="right"
            android:id="@+id/tvDescContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginLeft="10dp"
            android:maxWidth="100dp"
            android:minWidth="50dp"
            android:text=""
            android:singleLine="true"
            android:layout_toLeftOf="@+id/ivArrow3"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivArrow3"
            android:background="@mipmap/ic_right_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
