<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_main"
        android:background="@drawable/ic_none_watch_bg"
        android:layout_width="match_parent"
        android:layout_height="146dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_none_watch_icon"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_ff7300"
            android:gravity="center_vertical"
            android:id="@+id/tv_add"
            android:background="@drawable/shape_ff7300_stroke_s20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_tianjiashebei"
            android:maxLines="1"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="25dp"
            android:paddingHorizontal="36dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_add_tip"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_666666"
            android:gravity="center_vertical"
            android:id="@+id/tv_add_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_add_device_tip"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_add"
            app:layout_constraintEnd_toEndOf="@+id/tv_add"
            app:layout_constraintStart_toStartOf="@+id/tv_add"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
