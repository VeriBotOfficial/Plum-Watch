<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:background="@color/transp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp">
            <com.wakeup.howear.view.device.view.GlassesInfoView
                android:id="@+id/view_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_bt_tip"
                android:background="@drawable/shape_white_r8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_bt_tip_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses2_bt_tip_title"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_bt_tip_desc"
                    app:layout_constraintEnd_toStartOf="@+id/tv_bt_connect"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_bt_tip_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses2_bt_tip_desc"
                    android:maxLines="2"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_bt_connect"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bt_tip_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_bt_connect"
                    android:background="@drawable/shape_ff7300_r999"
                    android:visibility="visible"
                    android:layout_width="78dp"
                    android:layout_height="28dp"
                    android:text="@string/headphone_connect"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/layout_glasses_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_glasses_file"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_vp_features"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_features"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"/>
                <com.zhpan.indicator.IndicatorView
                    android:id="@+id/indicatorView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:vpi_slider_checked_color="#999999"
                    app:vpi_slider_normal_color="#cbcbcb"
                    app:vpi_slider_radius="3dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_features"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="8dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/color_999999"
                android:layout_gravity="center"
                android:id="@+id/tv_edit_features"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tip_21_1129_15"
                android:paddingHorizontal="8dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_g_use_skills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses2_faq_title"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_g_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_g_use_skills"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_g_use_skills">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13dp"
                        android:textColor="@color/color_666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_21_0116_7"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:background="@drawable/ic_g_log_arrow"
                        android:layout_width="6dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="8dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_g_use_skills">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_keep_alive"
                        android:layout_width="match_parent"
                        android:layout_height="62dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="@color/color_333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/keep_alive_setting_title"
                            android:layout_marginStart="12dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:background="@drawable/ic_g_log_arrow"
                            android:layout_width="6dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="12dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/color_4D4D4D"
                android:id="@+id/tv_activity"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/devices_activity_zone"
                android:layout_marginStart="24dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_activity"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="14dp"/>
            <View
                android:id="@+id/view_placeholder"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="96dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <com.zj.easyfloat.floatingview.FloatingMagnetView
        android:id="@+id/fl_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_glasses_float"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </com.zj.easyfloat.floatingview.FloatingMagnetView>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_record"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_touch_up"
            android:background="@drawable/shape_ff7300_r12"
            android:visibility="gone"
            android:layout_width="178dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="12dp">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/chat_talk_loading"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_record"
            android:background="@drawable/ic_g_record_s"
            android:layout_width="48dp"
            android:layout_height="54dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
