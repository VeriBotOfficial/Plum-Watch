<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/restRoot"
    android:background="#ad000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="休息弹窗">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_40"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/trainResetTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生命无止境\10运动无极限"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/train_reset_progress_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30">
            <com.wakeup.commonui.progress.CircleProgressBar
                android:id="@+id/train_reset_circle_progress"
                android:layout_width="@dimen/dp_130"
                android:layout_height="@dimen/dp_130"
                android:layout_centerInParent="true"
                app:circleBgColor="#8cffffff"
                app:circleProgressAColor="@color/color_fa9632"
                app:circleProgressBColor="@color/transp"
                app:circleWidth="@dimen/dp_14"
                app:openAngle="0"
                app:showSmallPoint="false"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_50"
                android:textColor="@color/white"
                android:id="@+id/train_reset_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_15"
            android:textColor="@color/color_F96623"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/trainResetBtn"
            android:background="@drawable/shape_c2ffffff_r4"
            android:layout_width="@dimen/dp_110"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/course_tip_101"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
