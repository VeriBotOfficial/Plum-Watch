<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f4f7fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/title_page_all_function_component"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/topBar"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/function_component_edit"
            android:background="@drawable/icon_function_component_edit"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_24"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/function_component_save_cancel_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/function_component_cancel"
                android:background="@drawable/icon_function_component_cancel"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_12"/>
            <TextView
                android:id="@+id/function_component_save"
                android:background="@drawable/icon_function_component_save"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_24"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_data_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <androidx.appcompat.widget.AppCompatTextView
            android:background="@drawable/ic_non_search_history"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/ai_search_none_data_text"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/function_list_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/component_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/homepage_config_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/function_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_25"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
