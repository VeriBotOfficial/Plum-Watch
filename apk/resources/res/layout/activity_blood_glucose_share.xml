<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_black"
        app:background="@color/transp"
        app:menuImage="@drawable/ic_share_gray_black"
        app:titleColor="@color/color_333333"
        app:titleText="@string/share_yulan"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/nestedScrollView"
        android:background="@color/color_f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@color/color_f6f6f6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/color_f6f6f6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_16"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/container"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_26">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/icon"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_marginTop="@dimen/dp_24"
                    app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_666666"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="冬天里的雪儿"/>
                <FrameLayout
                    android:id="@+id/share_tabLayout"
                    android:background="@color/white"
                    android:paddingBottom="@dimen/dp_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.tabs.TabLayout
                        android:layout_gravity="center"
                        android:id="@+id/tabLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/color_ff7300"
                        app:tabIndicatorFullWidth="false"
                        app:tabIndicatorHeight="1dp"
                        app:tabMinWidth="60dp"
                        app:tabMode="fixed"
                        app:tabRippleColor="@color/colorTransparent"
                        app:tabSelectedTextColor="@color/color_ff7300"
                        app:tabTextColor="@color/textBlack"/>
                </FrameLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/share_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_vertical"
                    android:background="#f1f3f5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_type_low"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ll_type_normal"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:layout_gravity="center"
                            android:background="@drawable/shape_dot_bg_low"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/color_999999"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiwen_piandi"
                            android:layout_marginStart="3dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_type_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="44dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ll_type_high"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/ll_type_low"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:layout_gravity="center"
                            android:background="@drawable/shape_dot_bg_nor"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/color_999999"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiwen_zhengchang"
                            android:layout_marginStart="3dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_type_high"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/ll_type_normal"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:layout_gravity="center"
                            android:background="@drawable/shape_dot_bg_high"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/color_999999"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mianyili_piangao"
                            android:layout_marginStart="3dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/ll_bs_reference"
                    layout="@layout/item_blood_sugar_reference_layout"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:background="@drawable/shape_f5f5f5_bottom_r12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:src="@mipmap/share_logo_img"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wearfit"
                        android:layout_marginStart="@dimen/dp_10"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
