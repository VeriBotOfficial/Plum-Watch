<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fragment_mine_info_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_account_content"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_17"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/dp_65"
            android:layout_height="@dimen/dp_65"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toStartOf="@+id/layout_account_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_account_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:ellipsize="end"
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16620803245"
                android:maxLines="1"
                android:maxLength="12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_is_vip"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:src="@mipmap/ic_member_d"
                android:scaleType="fitCenter"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/userName"
                app:layout_constraintStart_toEndOf="@+id/userName"
                app:layout_constraintTop_toTopOf="@+id/userName"/>
            <ImageView
                android:id="@+id/iv_qr_code"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@mipmap/ic_mine_qr"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/ll_grade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="45dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_qr_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userName">
                <com.wakeup.commonui.progress.SeekBarView
                    android:id="@+id/seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxHeight="2dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_accout"
                    android:minHeight="2dp"
                    android:thumb="@drawable/seekbar_thumb"
                    android:thumbOffset="@dimen/dp_0"
                    android:splitTrack="false"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_grade_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:text="成长值 100/200"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_account_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_grade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/tv_grade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv1"
                app:layout_constraintBottom_toTopOf="@+id/tv_grade_flag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_grade_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_21_0116_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_grade"
                app:layout_constraintStart_toStartOf="@+id/tv_grade"
                app:layout_constraintTop_toBottomOf="@+id/tv_grade"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_integral"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/tv_integral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                app:layout_constraintBottom_toTopOf="@+id/tv_score_des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_score_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_21_0603_liu_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_integral"
                app:layout_constraintStart_toStartOf="@+id/tv_integral"
                app:layout_constraintTop_toBottomOf="@+id/tv_integral"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="9dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_sign_in"
                android:background="@drawable/shape_red_r8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_sign"
                android:paddingHorizontal="4dp"
                app:layout_constraintStart_toEndOf="@+id/tv_integral"
                app:layout_constraintTop_toTopOf="@+id/tv_integral"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_ai_balance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/tv_ai_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                app:layout_constraintBottom_toTopOf="@+id/tv_ai_balance_flag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_ai_balance_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/energy_recharge"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_ai_balance"
                app:layout_constraintStart_toStartOf="@+id/tv_ai_balance"
                app:layout_constraintTop_toBottomOf="@+id/tv_ai_balance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_ai_receive_balance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/tv_ai_receive_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                app:layout_constraintBottom_toTopOf="@+id/tv_ai_receive_balance_flag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_ai_receive_balance_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/energy_give"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_ai_receive_balance"
                app:layout_constraintStart_toStartOf="@+id/tv_ai_receive_balance"
                app:layout_constraintTop_toBottomOf="@+id/tv_ai_receive_balance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
