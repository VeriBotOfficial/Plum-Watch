<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/schedule_reminder"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_12">
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_1"
                android:background="@drawable/shape_white_top_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/at_the_begin"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_2"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_5_minute"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_3"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_15_minute"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_4"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_30_minute"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_5"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_1_hour"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_6"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_2_hour"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:id="@+id/view_6"
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_7"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_1_day"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:id="@+id/view_7"
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_8"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/before_2_day"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <View
                android:id="@+id/view_8"
                android:background="@color/color_e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"
                android:layout_marginHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_9"
                android:background="@drawable/shape_white_bottom_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:button="@null"
                android:text="@string/no_reminder"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
            <RadioButton
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/radio_10"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_20"
                android:button="@null"
                android:text="@string/custom_time"
                android:drawableEnd="@drawable/select_schedule_reminder"
                android:paddingHorizontal="@dimen/dp_16"/>
        </RadioGroup>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
