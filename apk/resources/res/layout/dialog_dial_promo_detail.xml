<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dial_promo_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_20">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/dp_17"
            android:layout_height="@dimen/dp_17"
            android:src="@drawable/ic_dial_promo_ticket"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_promo_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dial_promo_tiered_title"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_888888"
        android:gravity="center"
        android:id="@+id/tv_promo_dialog_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:layout_marginBottom="@dimen/dp_12"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_promo_ladder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_888888"
        android:gravity="center"
        android:id="@+id/tv_promo_dialog_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_12"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_promo_dialog_close"
        android:background="@drawable/shape_dial_promo_close_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:text="@string/dialog_wozhidaole"/>
</LinearLayout>
