<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/total_distance_layout"
            android:background="@drawable/shape_white_gradient_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_92"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintEnd_toStartOf="@+id/total_duration_layout"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="marquee"
                android:id="@+id/total_distance_title"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxWidth="85dp"
                android:text="@string/total_run_volume"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="@dimen/dp_3"
                android:marqueeRepeatLimit="marquee_forever"
                android:drawableEnd="@drawable/ic_jiantou_right"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_18"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/total_distance_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_11"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/total_duration_layout"
            android:background="@drawable/shape_white_gradient_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_92"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_6"
            app:layout_constraintEnd_toStartOf="@+id/this_distance_layout"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/total_distance_layout"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="marquee"
                android:id="@+id/total_duration_title"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/active_strength_total_duration"
                android:maxLines="1"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_18"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:id="@+id/total_duration_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/dp_11"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/this_distance_layout"
            android:background="@drawable/shape_white_gradient_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_92"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/total_duration_layout"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="marquee"
                android:id="@+id/this_distance_title"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/this_month_run_volume"
                android:maxLines="1"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_18"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/this_distance_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_11"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_118"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_set_sport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sport_setting"
                app:layout_constraintBottom_toBottomOf="@+id/ivGO"
                app:layout_constraintEnd_toStartOf="@+id/ivGO"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivGO"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/ivGO"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"
                android:src="@drawable/ic_sport_go"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_sport_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sport_music_entrance"
                app:layout_constraintBottom_toBottomOf="@+id/ivGO"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivGO"
                app:layout_constraintTop_toTopOf="@+id/ivGO"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/course_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintTop_toBottomOf="@+id/total_distance_layout">
            <TextView
                android:textSize="@dimen/sp_17"
                android:textStyle="bold"
                android:textColor="#282828"
                android:id="@+id/tvTip01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_21_0426_12"
                android:layout_marginStart="@dimen/dp_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/course_recyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_12"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toStartOf="@+id/course_right"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTip01"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/course_right"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_0"
                android:src="@drawable/ic_arrow_right_with_yellow"
                app:layout_constraintBottom_toBottomOf="@+id/course_recyclerView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/course_recyclerView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/top_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/gap_view_1"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.wakeup.commonui.view.CommonNotifyView
                android:id="@+id/sport_notify_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gap_view_1"/>
            <View
                android:id="@+id/gap_view_2"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_notify_view"/>
            <FrameLayout
                android:id="@+id/fl_top_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gap_view_2"/>
            <View
                android:id="@+id/gap_view_3"
                android:layout_width="1dp"
                android:layout_height="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_top_ad"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sport_type"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="@dimen/dp_0"
            app:cardMaxElevation="@dimen/dp_0"
            app:layout_constraintTop_toBottomOf="@+id/top_layout">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_sport_type"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_427"
                    app:layout_constraintTop_toBottomOf="@+id/gap_view_3">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/sport_type_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_sport_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="46dp"
                            android:textStyle="bold"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tvValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_20"
                            android:layout_marginStart="@dimen/dp_16"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_16">
                            <TextView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="@color/color_333333"
                                android:id="@+id/tv_total_tip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:background="@drawable/ic_sport_arrow_r"
                                android:layout_width="8dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="1.5dp"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/recommend_plan_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/card_sport_type">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_17"
                android:textStyle="bold"
                android:textColor="@color/color_282828"
                android:id="@+id/recommend_plan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_plan_title"
                android:layout_marginStart="@dimen/dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ff7300"
                android:gravity="center"
                android:id="@+id/recommend_plan_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_gengduo"
                app:drawableEndCompat="@drawable/ic_arrow_right_with_yellow"
                app:layout_constraintBottom_toBottomOf="@+id/recommend_plan_title"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/recommend_plan_cardView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_150"
                android:layout_marginTop="@dimen/dp_12"
                app:cardCornerRadius="@dimen/dp_14"
                app:cardElevation="@dimen/dp_0"
                app:cardMaxElevation="@dimen/dp_0"
                app:layout_constraintTop_toBottomOf="@+id/recommend_plan_title">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/recommend_plan_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_default_placeholder"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/ps_color_white"
                android:ellipsize="end"
                android:id="@+id/recommend_plan_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:maxLines="2"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="@+id/recommend_plan_cardView"
                app:layout_constraintTop_toTopOf="@+id/recommend_plan_cardView"
                app:layout_constraintWidth_percent="0.5"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/ps_color_white"
                android:ellipsize="end"
                android:id="@+id/recommend_plan_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:maxLines="2"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="@+id/recommend_plan_cardView"
                app:layout_constraintTop_toBottomOf="@+id/recommend_plan_content"
                app:layout_constraintWidth_percent="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/sp_17"
            android:textStyle="bold"
            android:textColor="@color/color_282828"
            android:id="@+id/tv_record"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/tip_21_1129_14"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recommend_plan_layout"/>
        <FrameLayout
            android:id="@+id/fl_bottom_ad"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_record"/>
        <TextView
            android:textSize="@dimen/sp_17"
            android:textStyle="bold"
            android:textColor="@color/color_282828"
            android:id="@+id/tvAdv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="科学跑步"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_bottom_ad"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_adv"
            android:background="@drawable/shape_white_r12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="@dimen/dp_22"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAdv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
