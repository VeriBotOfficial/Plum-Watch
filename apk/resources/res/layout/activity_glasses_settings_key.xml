<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/glasses_operation_guidance"
        app:menuTextColor="@color/color_333333"
        app:titleText="@string/glasses_s_key_define"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_key_define"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/glasses_key_gestures"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_arrowgrey_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_touchpad_gestures"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/glasses_touchpad_gestures"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_arrowgrey_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
