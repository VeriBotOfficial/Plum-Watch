<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivHead"
        android:layout_width="@dimen/dp_37"
        android:layout_height="@dimen/dp_37"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/image_default_avatar"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/chamfer12dp"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_comment_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivHead"
        app:layout_constraintTop_toTopOf="@+id/ivHead"/>
    <TextView
        android:textColor="#ff666666"
        android:id="@+id/tv_comment_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivHead"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_title"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#333333"
        android:gravity="center"
        android:id="@+id/tv_comment_praise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_16"
        app:drawableEndCompat="@drawable/ic_zan_on"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_content"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#ff333333"
        android:id="@+id/tv_comment_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toEndOf="@+id/ivHead"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_content"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_e6e6e6"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="@+id/tv_comment_praise"
        app:layout_constraintStart_toStartOf="@+id/tv_comment_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_date"/>
</androidx.constraintlayout.widget.ConstraintLayout>
