<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp">
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@color/grey"
        android:scaleType="centerCrop"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round="15dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/labelsView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="@+id/ivCover"
        app:layout_constraintTop_toTopOf="@+id/ivCover"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/vip_cardView"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_18"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:cardBackgroundColor="#ffc944"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_breath_music_lock"
            android:layout_marginVertical="@dimen/dp_3"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:id="@+id/tvNum"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/ic_earphone"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="@+id/ivCover"/>
    <ImageView
        android:id="@+id/ivPlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_item_breath_play"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff333333"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="@+id/ivCover"
        app:layout_constraintTop_toBottomOf="@+id/ivCover"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/tvDuration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="@+id/ivCover"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
