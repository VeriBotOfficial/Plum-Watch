<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_right"
        app:titleText="@string/headphone_eq_set"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_260"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/y_layout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_marginStart="@dimen/dp_7"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/x_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+12db"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0db"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:id="@+id/y_tv_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-12db"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/x_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/y_layout">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:id="@+id/x_tv_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="30"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:id="@+id/x_tv_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="85"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:id="@+id/x_tv_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="500"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:id="@+id/x_tv_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="4k"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:id="@+id/x_tv_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="18k"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_6"
            app:layout_constraintBottom_toTopOf="@+id/x_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/y_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="24"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="24"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="24"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="24"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.wakeup.commonui.view.VerticalSeekBar
                android:id="@+id/seekbar_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bar_maxValue="24"
                app:bar_minValue="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
