<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuImage="@drawable/ic_sport_share"
        app:titleText="@string/fenxiang"/>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tab_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/color_ff7300"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabMinWidth="80dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/colorTransparent"
        app:tabSelectedTextColor="@color/color_ff7300"
        app:tabTextColor="@color/textBlack"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_page"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"/>
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.appcompat.widget.LinearLayoutCompat>
