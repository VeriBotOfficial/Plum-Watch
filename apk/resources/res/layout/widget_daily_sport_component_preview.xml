<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/widget_2x2_side"
    android:minHeight="@dimen/widget_2x2_side">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/widget_daily_sport_bg"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/widget_brand_pill_bg"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_3"
                android:paddingEnd="@dimen/dp_8">
                <FrameLayout
                    android:background="@drawable/widget_brand_dot_bg"
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="@dimen/dp_12"
                        android:src="@drawable/widget_bg_foot_small"
                        android:tint="#ff6a2c"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_burn_brand"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_5"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/sp_9"
                android:textStyle="bold"
                android:textColor="#b3ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_run_label"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:letterSpacing="0.15"/>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:baselineAligned="true">
                <TextView
                    android:textSize="@dimen/sp_28"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6,820"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    android:textColor="#ccffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_3"
                    android:text="@string/widget_step_unit_zh"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_3"/>
            </LinearLayout>
            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="@dimen/dp_4"
                android:max="100"
                android:progress="85"
                android:progressDrawable="@drawable/widget_progress_track"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="@dimen/sp_9"
                android:textColor="#b3ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:text="目标 8,000  ·  85%"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4">
            <ImageView
                android:layout_width="@dimen/dp_11"
                android:layout_height="@dimen/dp_11"
                android:src="@drawable/widget_ic_flame"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                android:textColor="@color/color_ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="312"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_9"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_kcal_unit_zh"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_2"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/dp_11"
                android:layout_height="@dimen/dp_11"
                android:src="@drawable/widget_ic_timer"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                android:textColor="@color/color_ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_9"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_minute_unit_zh"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp_2"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
