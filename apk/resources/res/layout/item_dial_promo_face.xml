<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_face"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp_10"
    app:cardElevation="@dimen/dp_1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_90">
            <ImageView
                android:id="@+id/iv_face_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/iv_face_check"
                android:background="@drawable/shape_dial_promo_num_circle"
                android:padding="@dimen/dp_3"
                android:visibility="gone"
                android:layout_width="@dimen/dp_15"
                android:layout_height="@dimen/dp_15"
                android:layout_margin="@dimen/dp_5"
                android:src="@drawable/ic_dial_promo_check"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_5"
            android:paddingVertical="@dimen/dp_4">
            <TextView
                android:textSize="@dimen/sp_9"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:id="@+id/tv_face_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1">
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:textColor="@color/color_f5460d"
                    android:id="@+id/tv_face_new_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_8"
                    android:textColor="@color/color_bbbbbb"
                    android:id="@+id/tv_face_old_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
