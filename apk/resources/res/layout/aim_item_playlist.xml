<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="7dp">
    <FrameLayout
        android:id="@+id/coverBox"
        android:background="@drawable/aim_grad_b"
        android:layout_width="42dp"
        android:layout_height="42dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/aim_text"
            android:gravity="center"
            android:id="@+id/tvCoverInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ivCover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/aim_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/aim_text_muted"
            android:ellipsize="end"
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/wave"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="8dp">
        <View
            android:id="@+id/wave0"
            android:background="@color/aim_accent"
            android:layout_width="3dp"
            android:layout_height="16dp"/>
        <View
            android:id="@+id/wave1"
            android:background="@color/aim_accent"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginStart="3dp"/>
        <View
            android:id="@+id/wave2"
            android:background="@color/aim_accent"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
</LinearLayout>
