<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:elevation="2dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_ai_energy"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/energy_insufficient"
                android:layout_marginStart="6dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="22dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:text="@string/dialog_quxiao"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_submit"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:text="@string/energy_recharge"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</LinearLayout>
