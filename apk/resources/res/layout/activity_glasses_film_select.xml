<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/glasses2_film_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_select_video"
            android:background="@drawable/wk_g_tag_checked_bg"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="84dp"
            android:text="@string/glasses_album_video"
            android:layout_marginStart="15dp"
            android:paddingHorizontal="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/tv_select_image"
            android:background="@drawable/wk_g_tag_normal_bg"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="84dp"
            android:text="@string/glasses_album_picture"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/cl_bottom"
        app:layout_constraintTop_toBottomOf="@+id/ll_type"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#d4d4d4"
            android:gravity="center"
            android:id="@+id/tv_add"
            android:background="@drawable/shape_999999_r6"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="80dp"
            android:text="@string/chat_add"
            android:layout_marginEnd="15dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
