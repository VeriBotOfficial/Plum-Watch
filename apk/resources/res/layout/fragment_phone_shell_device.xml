<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_F4F6F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false">
        <androidx.core.widget.NestedScrollView
            android:background="@color/transp"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp">
                <com.wakeup.howear.view.device.view.DeviceInfoView
                    android:id="@+id/view_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_one_key_translate"
                    android:background="@drawable/img_one_key_bg"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <FrameLayout
                        android:id="@+id/iv_one_key_translate_title_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="@dimen/dp_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_one_key_translate_title"
                            android:layout_width="wrap_content"
                            android:layout_height="37dp"
                            android:src="@drawable/ic_one_translation_zh"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#272f7f"
                        android:ellipsize="end"
                        android:id="@+id/tv_one_key_translate_desc"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/jacket_one_trans_tip"
                        android:maxLines="3"
                        android:layout_marginVertical="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_one_key_translate_btn"
                        app:layout_constraintStart_toStartOf="@+id/iv_one_key_translate_title_layout"
                        app:layout_constraintTop_toBottomOf="@+id/iv_one_key_translate_title_layout"
                        app:layout_constraintWidth_percent="0.5"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="#5564ff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_one_key_translate_btn"
                        android:background="@drawable/shape_white_50"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:maxWidth="@dimen/dp_150"
                        android:text="@string/start_trans"
                        android:maxLines="1"
                        android:layout_marginStart="24dp"
                        android:paddingHorizontal="@dimen/dp_17"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_si"
                    android:background="@drawable/img_si_bg"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <FrameLayout
                        android:id="@+id/iv_si_title_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="@dimen/dp_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_si_title"
                            android:layout_width="wrap_content"
                            android:layout_height="37dp"
                            android:src="@drawable/ic_si_zh"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#4d4d4d"
                        android:ellipsize="end"
                        android:id="@+id/tv_si_desc"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/jackt_sim_inter_tip"
                        android:maxLines="3"
                        android:layout_marginVertical="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_si_btn"
                        app:layout_constraintStart_toStartOf="@+id/iv_si_title_layout"
                        app:layout_constraintTop_toBottomOf="@+id/iv_si_title_layout"
                        app:layout_constraintWidth_percent="0.5"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="#ff8701"
                        android:gravity="center"
                        android:id="@+id/tv_si_btn"
                        android:background="@drawable/shape_white_50"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:maxWidth="@dimen/dp_150"
                        android:text="@string/sound_start_tran"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/dp_24"
                        android:paddingHorizontal="@dimen/dp_17"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="12dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_meeting"
                        android:background="@drawable/img_meeting_bg"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="24dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:ellipsize="end"
                            android:id="@+id/tv_meeting_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/string_conference_artifact"
                            android:maxLines="1"
                            android:layout_marginHorizontal="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:id="@+id/tv_meeting_desc"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="@string/string_conference_artifact_tip"
                            android:maxLines="2"
                            android:layout_marginEnd="15dp"
                            android:layout_marginVertical="4dp"
                            app:layout_constraintBottom_toTopOf="@+id/tv_meeting_btn"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_meeting_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_meeting_title"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#fd8181"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_meeting_btn"
                            android:background="@drawable/shape_white_50"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginBottom="12dp"
                            android:maxWidth="@dimen/dp_120"
                            android:text="@string/start_meeting"
                            android:maxLines="1"
                            android:layout_marginStart="@dimen/dp_12"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_ocr"
                        android:background="@drawable/img_ocr_bg"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="24dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:ellipsize="end"
                            android:id="@+id/tv_ocr_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/string_photo_recognition"
                            android:maxLines="1"
                            android:layout_marginHorizontal="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:id="@+id/tv_ocr_desc"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="@string/string_photo_recognition_tip"
                            android:maxLines="2"
                            android:layout_marginEnd="17dp"
                            android:layout_marginVertical="4dp"
                            app:layout_constraintBottom_toTopOf="@+id/tv_ocr_btn"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_ocr_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_ocr_title"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#8690fd"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_ocr_btn"
                            android:background="@drawable/shape_white_50"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:maxWidth="@dimen/dp_120"
                            android:text="@string/start_recognition"
                            android:maxLines="1"
                            android:layout_marginStart="@dimen/dp_12"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_p2p"
                    android:background="@drawable/img_p2p_bg"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_24"
                        android:textStyle="bold"
                        android:textColor="@color/color_2e2e2e"
                        android:ellipsize="end"
                        android:id="@+id/iv_p2p_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:text="@string/string_face_trans"
                        android:maxLines="1"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#4d4d4d"
                        android:ellipsize="end"
                        android:id="@+id/tv_p2p_desc"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/string_face_trans_tip"
                        android:maxLines="3"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        android:layout_marginVertical="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_p2p_btn"
                        app:layout_constraintStart_toStartOf="@+id/iv_p2p_title"
                        app:layout_constraintTop_toBottomOf="@+id/iv_p2p_title"
                        app:layout_constraintWidth_percent="0.5"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="#ff8701"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_p2p_btn"
                        android:background="@drawable/shape_white_50"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:maxWidth="@dimen/dp_150"
                        android:text="@string/start_communicating"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/dp_12"
                        android:paddingHorizontal="@dimen/dp_17"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_comm"
                    android:background="@drawable/img_comm_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_24"
                        android:textStyle="bold"
                        android:textColor="@color/color_2e2e2e"
                        android:ellipsize="end"
                        android:id="@+id/iv_comm_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:text="@string/real_time_communication"
                        android:maxLines="1"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="#4d4d4d"
                        android:ellipsize="end"
                        android:id="@+id/tv_comm_desc"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/real_time_communication_desc"
                        android:maxLines="3"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        android:layout_marginVertical="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_comm_btn"
                        app:layout_constraintStart_toStartOf="@+id/iv_comm_title"
                        app:layout_constraintTop_toBottomOf="@+id/iv_comm_title"
                        app:layout_constraintWidth_percent="0.5"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="#fd8181"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_comm_btn"
                        android:background="@drawable/shape_white_50"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:maxWidth="@dimen/dp_150"
                        android:text="@string/ai_robot_btn"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/dp_12"
                        android:paddingHorizontal="@dimen/dp_17"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_ai_robot"
                    android:background="@drawable/ic_ai_robot_bg"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_170"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_22"
                        android:textStyle="bold"
                        android:textColor="@color/color_4651B2"
                        android:ellipsize="end"
                        android:id="@+id/tv_ai_robot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_ai"
                        android:maxLines="1"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_4651B2"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/ai_robot_desc"
                        android:maxLines="2"
                        android:layout_marginVertical="@dimen/dp_5"
                        app:layout_constraintBottom_toTopOf="@+id/btn_ai_robot"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ai_robot"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_8A96FF"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_ai_robot"
                        android:background="@drawable/shape_white_r16"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_32"
                        android:text="@string/ai_robot_btn"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/dp_17"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.wakeup.howear.view.device.view.DeviceOtherView
                    android:id="@+id/view_device_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="#282828"
                    android:gravity="center"
                    android:id="@+id/tv_delete_device"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/tip_21_0114_3"
                    android:layout_marginHorizontal="12dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
