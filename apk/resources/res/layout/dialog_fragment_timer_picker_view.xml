<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/course_tip_88"
        android:layout_marginStart="@dimen/dp_12"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_50">
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheelPicker2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:wheel_cyclic="false"
            app:wheel_indicator="true"
            app:wheel_indicator_color="@color/line"
            app:wheel_indicator_size="@dimen/dp_1"
            app:wheel_item_space="@dimen/dp_20"
            app:wheel_item_text_color="@color/black"
            app:wheel_selected_item_text_color="@color/color_ec7445"
            app:wheel_visible_item_count="5"/>
        <com.aigestudio.wheelpicker.WheelPicker
            android:id="@+id/wheelPicker3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:wheel_cyclic="false"
            app:wheel_indicator="true"
            app:wheel_indicator_color="@color/line"
            app:wheel_indicator_size="@dimen/dp_1"
            app:wheel_item_space="@dimen/dp_20"
            app:wheel_item_text_color="@color/black"
            app:wheel_selected_item_text_color="@color/color_ec7445"
            app:wheel_visible_item_count="5"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">
        <View
            android:orientation="vertical"
            android:id="@+id/guideLine"
            android:background="@color/line"
            android:layout_width="@dimen/dp_1"
            android:layout_height="match_parent"
            android:layout_marginVertical="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/color_fa9632"
            android:gravity="center"
            android:id="@+id/tvCancel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/tip40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/color_fa9632"
            android:gravity="center"
            android:id="@+id/tvOk"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/qinyou_queding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideLine"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
