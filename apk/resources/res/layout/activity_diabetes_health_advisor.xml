<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/diabetes_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/diabetes_advisor_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/diabetes_text_hint"
            android:id="@+id/tv_advisor_subtitle"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diabetes_advisor_subtitle"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_advisor_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scroll_messages"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="#222222"
            android:id="@+id/et_input"
            android:background="@drawable/shape_diabetes_input_bg"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:hint="@string/diabetes_advisor_input_hint"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_send"
            android:background="@drawable/shape_diabetes_btn_primary"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="➤"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
