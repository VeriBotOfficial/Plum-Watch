<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/device_enter_simulation_access_card"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_ff000000"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35.5dp"
        android:text="@string/device_tip_1006"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="17.5dp"
        android:paddingVertical="13dp">
        <TextView
            android:gravity="center"
            android:id="@+id/text1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_tip_1007"
            android:drawablePadding="@dimen/dp_12"
            app:drawableTopCompat="@drawable/control_card1"
            app:layout_constraintEnd_toStartOf="@+id/text2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_tip_1008"
            android:drawablePadding="@dimen/dp_12"
            app:drawableTopCompat="@drawable/control_card2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text1"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_FF666666"
        android:id="@+id/tvNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.5dp"
        android:text="@string/device_tip_1009"
        android:layout_marginHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llAgreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_120"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="30dp">
        <FrameLayout
            android:id="@+id/layout_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"
            android:paddingVertical="10dp">
            <CheckBox
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cbOk"
                android:background="@drawable/ic_common_check_selector"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:button="@null"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/textBlack"
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_protocol_tip"/>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btnGenerate"
        android:background="@drawable/shape_00bbff_r13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.5dp"
        android:text="@string/device_tip_1011"
        android:paddingHorizontal="50dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
