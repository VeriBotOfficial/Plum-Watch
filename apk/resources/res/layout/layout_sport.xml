<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_sport"
            android:background="@drawable/ic_home_sport_bg"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:translationZ="2dp"
            android:elevation="2dp"
            app:layout_constraintEnd_toStartOf="@+id/cl_step"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_card_arrow"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_strength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="22dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_kcal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_kcal_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/200千卡"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_kcal_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_kcal_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0625_liu_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_kcal_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_strength">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="22dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_duration_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/50分钟"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_duration_value"
                    app:layout_constraintStart_toEndOf="@+id/tv_duration_value"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_exercise_duration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_duration_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_sport_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_duration">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="22dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_sport_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_sport_count_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/3次"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_sport_count"
                    app:layout_constraintStart_toEndOf="@+id/tv_sport_count"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_sport_count"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sport_count"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_step"
            android:background="@drawable/ic_home_step_bg"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginStart="12dp"
            android:translationZ="2dp"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cl_sport"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_top_step"
                android:background="@drawable/ic_home_top_card_step"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_jinribushu"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/iv_top_step"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_card_arrow"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="22dp"
                android:textColor="@color/white"
                android:id="@+id/tv_step_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_step"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/tv_step_value_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_step_value"
                app:layout_constraintStart_toEndOf="@+id/tv_step_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_heart"
            android:background="@drawable/ic_home_heart_bg"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:translationZ="2dp"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cl_sport"
            app:layout_constraintTop_toBottomOf="@+id/cl_step">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_top_heart"
                android:background="@drawable/ic_home_top_card_heart"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_xinlv"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/iv_top_heart"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_card_arrow"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_heart_flag"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginBottom="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="22dp"
                android:textColor="@color/white"
                android:id="@+id/tv_heart_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="--"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_top_heart"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/tv_heart_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_unit"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_heart_value"
                app:layout_constraintStart_toEndOf="@+id/tv_heart_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
