<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_F4F6F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false">
        <androidx.core.widget.NestedScrollView
            android:background="@color/transp"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp">
                <com.wakeup.howear.view.device.view.DeviceInfoView
                    android:id="@+id/view_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="@dimen/dp_12">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_sim_inter"
                        android:background="@drawable/ic_interpert_bg"
                        android:padding="@dimen/dp_16"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_894B18"
                            android:ellipsize="end"
                            android:id="@+id/tv_sim_inter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/w_n_l_m"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_894B18"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/w_n_l_m_d"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_sim_inter"
                            app:layout_constraintTop_toBottomOf="@+id/tv_sim_inter"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_FF8701"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_sim_inter"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/w_n_l_m_into"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_white_noise"
                        android:background="@drawable/ic_ai_write_noice_bg"
                        android:padding="@dimen/dp_16"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_170"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_5A4AA5"
                            android:ellipsize="end"
                            android:id="@+id/tv_white_noise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fatigue_tip_32"
                            android:maxLines="1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_5A4AA5"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/string_write_noise_tip"
                            android:maxLines="2"
                            android:layout_marginVertical="@dimen/dp_5"
                            app:layout_constraintBottom_toTopOf="@+id/btn_white_noise"
                            app:layout_constraintTop_toBottomOf="@+id/tv_white_noise"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_644BD7"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/btn_white_noise"
                            android:background="@drawable/shape_white_r16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="@string/string_write_noise_btn"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/dp_17"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.wakeup.howear.view.device.view.DeviceHelpView
                    android:id="@+id/view_device_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.wakeup.howear.view.device.view.DeviceOtherView
                    android:id="@+id/view_device_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="#282828"
                    android:gravity="center"
                    android:id="@+id/tv_delete_device"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/tip_21_0114_3"
                    android:layout_marginHorizontal="12dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>
