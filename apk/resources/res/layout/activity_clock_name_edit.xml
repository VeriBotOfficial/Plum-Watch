<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuText="@string/set_baocun"
        app:titleText="@string/device_tip_1045"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/textBlack"
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/ke_21_8_25_9"
        android:maxLength="8"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="20dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
