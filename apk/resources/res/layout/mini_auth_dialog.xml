<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ic_mini_bottom_dialog_bg"
        android:paddingLeft="28dp"
        android:paddingTop="8dp"
        android:paddingRight="28dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <com.phancy.mini.widget.CircleImageView
                android:id="@+id/app_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mini"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/warn_icon"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mini_warn"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#000"
                android:ellipsize="end"
                android:id="@+id/app_title"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:maxLines="1"
                android:layout_toRightOf="@+id/app_icon"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#000"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_auth_dialog_apply"
                android:maxLines="1"
                android:layout_toRightOf="@+id/app_title"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="17dp"
                android:textColor="#000"
                android:ellipsize="end"
                android:id="@+id/scope_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_name"
                android:maxLines="2"/>
            <View
                android:background="#f3f3f3"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="16dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#040919"
                android:gravity="center"
                android:id="@+id/reject_button"
                android:background="@drawable/ic_mini_dialog_reject_button"
                android:clickable="true"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_marginRight="16dp"
                android:text="@string/mini_auth_dialog_reject"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/accept_button"
                android:background="@drawable/ic_mini_dialog_accept_button"
                android:clickable="true"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="@string/mini_auth_dialog_allow"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
