<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content"
    android:background="@drawable/shape_white_top_r24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_retract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_glasses_chat_retract"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="30dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="14dp"
        android:textColor="#333333"
        android:gravity="start|top"
        android:id="@+id/et_input"
        android:background="@null"
        android:fitsSystemWindows="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minHeight="450dp"
        android:textCursorDrawable="@drawable/custom_cursor"
        android:layout_marginStart="28dp"
        android:lineHeight="16dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_send"
        app:layout_constraintEnd_toStartOf="@+id/fl_retract"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_retract"/>
    <FrameLayout
        android:id="@+id/fl_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_send"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="26dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
