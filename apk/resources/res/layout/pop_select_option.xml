<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r16"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llc_pop_share"
        android:layout_width="240dp"
        android:layout_height="47dp"
        android:paddingHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/share"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fenxiang"
            android:layout_marginStart="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:background="@color/color_F2F2F2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llc_pop_delete"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:paddingHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_glasses_guide_del"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#ff3b30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_shanchu"
            android:layout_marginStart="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
