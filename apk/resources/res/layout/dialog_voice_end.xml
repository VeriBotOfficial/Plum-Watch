<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:id="@+id/dialog_common_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/dialog_voice_end"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/jacket_m_end_record"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dialog_voice_cancel"
        app:layout_constraintTop_toBottomOf="@+id/dialog_common_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/dialog_voice_cancel"
        android:background="@drawable/shape_e3e3e3_r999"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/jacket_m_think"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/dialog_voice_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_common_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
