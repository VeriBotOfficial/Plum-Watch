<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_120">
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_annual_goal_title"
        android:paddingTop="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跑步"
        android:paddingStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_9a9a9a"
        android:ellipsize="end"
        android:id="@+id/tv_annual_goal_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="297，647人坚持"
        android:maxLines="2"
        android:paddingStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_annual_goal_title"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_annual_goal_icon_bottom"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ff7300"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annual_goal_Illuminate"
            android:background="@drawable/shape_ff7300_r14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/annual_goal_tip_1"
            android:maxLines="2"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_annual_goal_icon_bottom"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
