<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_data"
        android:background="@drawable/bg_white_8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_sleep_time"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_sleep_time_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.wakeup.howear.view.newui.view.BarChartView
            android:id="@+id/sleep_time_chart"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_15"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_sleep_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="#ff000000"
                android:id="@+id/tv_sleep_time_text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_14"
                android:layout_marginTop="@dimen/dp_3"
                android:text="@string/sub_view_sleep_time_text"
                android:layout_marginStart="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_sleep_time_min_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80"
                android:layout_marginStart="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="#ff000000"
                android:id="@+id/tv_sleep_time_min_text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_14"
                android:layout_marginTop="@dimen/dp_3"
                android:text="@string/shuimian_fenzhong"
                android:layout_marginStart="@dimen/dp_4"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_empty"
        android:background="@drawable/bg_white_8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_sleep_time"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_sleep_time_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_not_data_cu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_15"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/none_data"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_add"
        android:background="@drawable/ic_home_increase"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_del"
        android:background="@drawable/ic_home_reduce"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
</FrameLayout>
