<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_20">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_333333"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_22"
            android:text="@string/phone_system_dialog_tips"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dp_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/bt_setting"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:text="@string/phone_system_to_configure"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_6"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/bt_complete_setting"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:text="@string/phone_system_configured"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_6"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
