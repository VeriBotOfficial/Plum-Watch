<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_17"
        android:textStyle="bold"
        android:textColor="#282828"
        android:id="@+id/tvTip01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip_21_0426_12"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#ff7300"
        android:id="@+id/btnAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip_21_0426_11"
        android:layout_marginEnd="@dimen/dp_12"
        app:drawableEndCompat="@drawable/ic_arrow_right_with_yellow"
        app:layout_constraintBottom_toBottomOf="@+id/tvTip01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTip01"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tvTip01"/>
</androidx.constraintlayout.widget.ConstraintLayout>
