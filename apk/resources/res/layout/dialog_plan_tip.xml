<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r12"
    android:paddingBottom="@dimen/dp_30"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivTip"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@drawable/ic_dialog_plan_tip"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:minHeight="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_24"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_24">
        <TextView
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/tvCancel"
            android:background="@drawable/shape_e5e5e5_r4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/dialog_quxiao"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSure"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"/>
        <TextView
            android:textColor="@color/ps_color_white"
            android:gravity="center"
            android:id="@+id/tvSure"
            android:background="@drawable/shape_f96623_r4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/dialog_queding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvCancel"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
