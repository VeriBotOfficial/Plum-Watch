<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_84"
    android:paddingHorizontal="@dimen/dp_12">
    <ImageView
        android:id="@+id/iv_annual_goal_type_icon"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/ic_sport_jogging"
        app:layout_constraintEnd_toStartOf="@+id/tv_annual_goal_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_282828"
        android:id="@+id/tv_annual_goal_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/walk"
        android:layout_marginHorizontal="@dimen/dp_6"
        app:layout_constraintStart_toEndOf="@+id/iv_annual_goal_type_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_annual_goal_type_icon"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textStyle="bold"
        android:textColor="@color/color_4D4D4D"
        android:id="@+id/tv_annual_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="10.68"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_annual_goal_type_icon"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_annual_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unit_gongli"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_annual_data"
        app:layout_constraintStart_toEndOf="@+id/tv_annual_data"/>
    <RelativeLayout
        android:id="@+id/train_reset_progress_layout"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/tv_annual_data"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_annual_goal_type_icon">
        <com.wakeup.commonui.progress.CircleProgressBar
            android:id="@+id/view_circle_progress"
            android:layout_width="@dimen/dp_130"
            android:layout_height="@dimen/dp_130"
            android:layout_centerInParent="true"
            app:circleBgColor="@color/color_f6f6f6"
            app:circleProgressAColor="@color/color_fa9632"
            app:circleProgressBColor="@color/transp"
            app:circleWidth="@dimen/dp_6"
            app:openAngle="0"
            app:showSmallPoint="false"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/view_annual_progress_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
