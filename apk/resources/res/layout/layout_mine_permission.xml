<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_ff000000"
        android:id="@+id/my_other_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_mine_permission"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_myOtherContent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sport_permission"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_77"
        android:layout_marginTop="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_sport_permission"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mine_sport_permission"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_ff000000"
            android:id="@+id/iv_sport_permission_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sport_mine_permission_title"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/iv_sport_permission_content"
            app:layout_constraintEnd_toStartOf="@+id/iv_sport_permission_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_sport_permission"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_999999"
            android:id="@+id/iv_sport_permission_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/sport_mine_permission_content"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_sport_permission_arrow"
            app:layout_constraintStart_toEndOf="@+id/iv_sport_permission"
            app:layout_constraintTop_toBottomOf="@+id/iv_sport_permission_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_sport_permission_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_right_small"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_windows_permission"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_77"
        android:layout_marginTop="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_windows_permission"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_windows_permission"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_ff000000"
            android:ellipsize="marquee"
            android:id="@+id/iv_windows_permission_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/glasses2_windows_permission_title"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toTopOf="@+id/iv_windows_permission_content"
            app:layout_constraintEnd_toStartOf="@+id/switch_windows"
            app:layout_constraintStart_toEndOf="@+id/iv_windows_permission"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_999999"
            android:ellipsize="marquee"
            android:id="@+id/iv_windows_permission_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/glasses2_windows_permission_desc"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/switch_windows"
            app:layout_constraintStart_toEndOf="@+id/iv_windows_permission"
            app:layout_constraintTop_toBottomOf="@+id/iv_windows_permission_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/switch_windows"
            android:background="@drawable/ic_windows_permission_close"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
