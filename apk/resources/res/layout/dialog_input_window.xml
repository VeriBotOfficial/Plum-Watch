<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_4"
    android:paddingHorizontal="@dimen/dp_12"
    android:paddingVertical="@dimen/dp_8">
    <EditText
        android:textSize="@dimen/sp_14"
        android:gravity="center_vertical"
        android:id="@+id/et_input"
        android:background="@drawable/shape_input_window_edit_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_40"
        android:hint="@string/input_window_edit_hint"
        android:maxLines="5"
        android:maxLength="300"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_show_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintStart_toStartOf="@+id/et_input"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_send"
        android:background="@drawable/shape_comment_un_send_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_send"
        android:layout_marginStart="@dimen/dp_14"
        android:layout_marginEnd="@dimen/dp_3"
        android:layout_marginVertical="@dimen/dp_3"
        android:paddingHorizontal="@dimen/dp_13"
        android:paddingVertical="@dimen/dp_7"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="@+id/et_input"/>
</androidx.constraintlayout.widget.ConstraintLayout>
