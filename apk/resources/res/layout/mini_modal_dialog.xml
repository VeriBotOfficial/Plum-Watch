<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/ic_mini_modal_dialog_bg"
        android:padding="20dp"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/mini_title_bar_height">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#040919"
            android:ellipsize="end"
            android:id="@+id/dlg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"/>
        <ScrollView
            android:id="@+id/dlg_msg_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="26dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/dlg_btn_view"
            app:layout_constraintTop_toBottomOf="@+id/dlg_title">
            <TextView
                android:textSize="14dp"
                android:textColor="#040919"
                android:id="@+id/dlg_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"/>
        </ScrollView>
        <RelativeLayout
            android:id="@+id/dlg_btn_view"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dlg_msg_scroll">
            <View
                android:id="@+id/line_v"
                android:layout_width="20px"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#040919"
                android:gravity="center"
                android:id="@+id/dlg_left_btn"
                android:background="@drawable/ic_mini_dialog_reject_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_toLeftOf="@+id/line_v"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/dlg_right_btn"
                android:background="@drawable/ic_mini_dialog_accept_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_toRightOf="@+id/line_v"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
