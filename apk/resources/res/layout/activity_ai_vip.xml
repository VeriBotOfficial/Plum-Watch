<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_F4F7FA"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_black"
        app:titleColor="@color/color_ff000000"
        app:titleText="@string/ai_vip_member_title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:paddingBottom="80dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_12">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_ai_vip_info_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_105">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:src="@drawable/ic_ai_vip_shape_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="@dimen/dp_65"
                    android:layout_height="@dimen/dp_65"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:src="@drawable/image_default_avatar"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                <ImageView
                    android:id="@+id/ivVip"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/icon_isvip_hide"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
                    app:layout_constraintEnd_toEndOf="@+id/ivAvatar"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffffff"
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintBottom_toTopOf="@+id/lv_info"
                    app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                    app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lv_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_E1B488"
                        android:id="@+id/tvTip1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/shape_bg_ffeddd_e1b488"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="-8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lv_info">
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="#855712"
                    android:gravity="center"
                    android:background="@drawable/ic_membership_tip_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_21_0517_01"
                    android:paddingStart="@dimen/dp_4"/>
                <TextView
                    android:textColor="@color/color_ff000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_vip_membership_text"
                    android:layout_marginStart="@dimen/dp_8"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridView"
                android:background="@drawable/shape_white_r12"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:numColumns="4"
                android:nestedScrollingEnabled="false"
                android:paddingVertical="@dimen/dp_4"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="4"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_12">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/tip_21_0522_06"
                    android:layout_marginStart="@dimen/dp_12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginVertical="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_4"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_12">
                    <ImageView
                        android:id="@+id/ivSelected"
                        android:padding="@dimen/dp_5"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/ic_vip_protocol_selector"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/textBlack"
                        android:id="@+id/tvTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/ll_renew_tip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_15"
                    android:paddingHorizontal="12dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/textBlack"
                        android:id="@+id/des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/iv_renew"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_renew"
                        android:background="@drawable/ic_renew"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/ll_membership_interests"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/vip_exclusive_interests"
                        android:layout_marginStart="17dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff333333"
                        android:gravity="right"
                        android:id="@+id/tv_click_more"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/target_learn_more"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_16"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridView_two"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:numColumns="4"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="4"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/more_services"
                android:layout_marginStart="@dimen/dp_12"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_ff000000"
                android:gravity="center_vertical"
                android:id="@+id/tvUseMembershipCode"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_54"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/use_membership_code"
                android:paddingHorizontal="@dimen/dp_16"
                app:drawableEndCompat="@drawable/ic_ai_vip_tab_arrow"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_ff000000"
                android:gravity="center_vertical"
                android:id="@+id/tvMembershipCancel"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_54"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/membership_cancel"
                android:paddingHorizontal="@dimen/dp_16"
                app:drawableEndCompat="@drawable/ic_ai_vip_tab_arrow"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvExperience"
            android:background="@drawable/shape_bg_f76814_r40"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="@string/ai_vip_play_now"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginVertical="@dimen/dp_12"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvRenewPay"
            android:background="@drawable/shape_bg_f76814_r40"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="@string/ai_vip_renew_now"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginVertical="@dimen/dp_12"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvPay"
            android:background="@drawable/shape_bg_f76814_r40"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="@string/ai_vip_activate_now"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginVertical="@dimen/dp_12"/>
    </LinearLayout>
</LinearLayout>
