<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_container"
        android:background="@drawable/shape_white_top_r12"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="500dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_comment_count"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:background="@drawable/ic_video_close"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:layout_marginEnd="12.88dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_comment_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_comment_count"/>
        <com.wakeup.feature.wkvideo.view.CustomExpandableListView
            android:id="@+id/lv_comment"
            android:background="@color/color_ffffff"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_comment_count"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/lv_not_comment"
            android:background="@color/white"
            android:paddingBottom="@dimen/dp_40"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/lv_edit_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lv_comment">
            <ImageView
                android:layout_width="@dimen/dp_166"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_24"
                android:src="@drawable/ic_not_comment"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comment_not_replay"/>
            <TextView
                android:textColor="@color/color_333333"
                android:id="@+id/tv_go_comment"
                android:background="@drawable/shape_00bbff_r30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_35"
                android:layout_marginBottom="@dimen/dp_30"
                android:text="@string/comment_go_replay"
                android:backgroundTint="@color/color_f5f5f5"
                android:paddingHorizontal="@dimen/dp_30"
                android:paddingVertical="@dimen/dp_8"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lv_edit_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:gravity="center_vertical"
                android:background="@drawable/shape_input_window_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_40"
                android:hint="@string/input_window_edit_hint"
                android:paddingHorizontal="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_8"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
