<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f1f3f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_last"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tvDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/textBlack"
                android:id="@+id/tvStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/textBlack"
                android:id="@+id/tv7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.wakeup.commonui.chart.IndicatorBarChart
        android:id="@+id/mNormalBarChart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_220"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/step_day_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_24"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/total_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:text="2345"
                app:layout_constraintEnd_toStartOf="@+id/total_step_unit"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/progress"
                app:layout_constraintTop_toTopOf="@+id/progress"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_333330"
                android:gravity="start"
                android:id="@+id/total_step_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_3"
                android:text="@string/set_bu"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="@+id/total_step"
                app:layout_constraintEnd_toEndOf="@+id/progress"
                app:layout_constraintStart_toEndOf="@+id/total_step"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/step_goal_edit"
                android:layout_width="@dimen/dp_12"
                android:layout_height="@dimen/dp_12"
                android:src="@drawable/ic_stepgoal_edit"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/step_goal"
                app:layout_constraintStart_toEndOf="@+id/step_goal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/step_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="目标:10000步"
                android:layout_marginEnd="@dimen/dp_13"
                app:layout_constraintEnd_toEndOf="@+id/progress"
                app:layout_constraintStart_toStartOf="@+id/progress"
                app:layout_constraintTop_toBottomOf="@+id/total_step_unit"/>
            <com.wakeup.commonui.view.ArcHalfProcessView
                android:id="@+id/progress"
                android:layout_width="@dimen/dp_202"
                android:layout_height="@dimen/dp_122"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/color_333333"
                android:id="@+id/step_goal_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="差9334步就达成目标了！"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/step_go"
                android:background="@drawable/shape_1883f3_r16"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/string_walk_now"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/step_normal_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qinyou_zongbushu"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_24"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:id="@+id/normal_total_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333330"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_3"
                        android:text="@string/set_bu"
                        android:layout_marginStart="@dimen/dp_5"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/color_e6e6e6"
                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/dp_40"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/avg_step"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_24"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:id="@+id/avg_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333330"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_3"
                        android:text="@string/set_bu"
                        android:layout_marginStart="@dimen/dp_5"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:id="@+id/step_line_view"
            android:background="@color/color_e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintTop_toBottomOf="@+id/step_go"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/kcal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/consume"
                app:layout_constraintEnd_toStartOf="@+id/kcal_line_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_20"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/kcal_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                app:layout_constraintEnd_toStartOf="@+id/kcal_unit"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/kcal_title"
                app:layout_constraintTop_toBottomOf="@+id/kcal_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/kcal_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_3"
                android:text="@string/home_qianka"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="@+id/kcal_tv"
                app:layout_constraintEnd_toEndOf="@+id/kcal_title"
                app:layout_constraintStart_toEndOf="@+id/kcal_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/kcal_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="2"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_2"
                app:layout_constraintEnd_toEndOf="@+id/kcal_line_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/kcal_unit"/>
            <View
                android:id="@+id/kcal_line_view"
                android:background="@color/color_e6e6e6"
                android:layout_width="@dimen/dp_1"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/distance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/string_distance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/kcal_line_view"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_20"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/distance_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.43"
                app:layout_constraintEnd_toStartOf="@+id/distance_unit"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/distance_title"
                app:layout_constraintTop_toBottomOf="@+id/distance_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/distance_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_3"
                android:text="@string/unit_gongli"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="@+id/distance_tv"
                app:layout_constraintEnd_toEndOf="@+id/distance_title"
                app:layout_constraintStart_toEndOf="@+id/distance_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/distance_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="2"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/kcal_line_view"
                app:layout_constraintTop_toBottomOf="@+id/distance_unit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_999999"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/step_calculation_desc"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_17"
        android:textColor="@color/color_282828"
        android:id="@+id/step_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/step_source"
        android:layout_marginStart="@dimen/dp_24"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_14"/>
</LinearLayout>
