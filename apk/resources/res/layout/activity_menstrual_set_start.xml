<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/menstrual"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/img_menstrual"
        android:layout_width="169dp"
        android:layout_height="201dp"
        android:layout_marginTop="16dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/menstrual_set_start_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r12"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/fl_left"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_date"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_left"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@mipmap/ic_jiantou"/>
            </FrameLayout>
            <TextView
                android:textColor="#666666"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2022年7月"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/fl_right"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_date"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_right"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@mipmap/ic_jiantou"
                    android:rotation="180"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.haibin.calendarview.CalendarLayout
            android:orientation="vertical"
            android:id="@+id/calendar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:calendar_show_mode="both_month_week_view"
            app:default_status="expand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_layout">
            <com.haibin.calendarview.CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:calendar_height="30dp"
                app:current_day_text_color="@color/color_333333"
                app:day_text_size="16dp"
                app:month_view="com.wakeup.feature.health.menstrual.view.MenstrualSetMonthView"
                app:month_view_show_mode="mode_only_current"
                app:week_bar_height="0dp"
                app:week_start_with="sun"/>
        </com.haibin.calendarview.CalendarLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_next"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="46dp"
        android:text="@string/registered_xiayibu"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
