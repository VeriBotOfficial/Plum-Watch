<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/hs_s_e_style"/>
    <GridLayout
        android:id="@+id/gl_eq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:rowCount="3"
        android:columnCount="2"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_1"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:text="@string/hs_s_e_balance"
            android:layout_marginEnd="12dp"
            android:layout_columnWeight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_2"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:text="@string/headphone_Popularity"
            android:layout_columnWeight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_3"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:text="@string/headphone_rock"
            android:layout_marginEnd="12dp"
            android:layout_columnWeight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_4"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:text="@string/hs_s_e_electronic"
            android:layout_columnWeight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_5"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:text="@string/hs_s_e_hip_hop"
            android:layout_marginEnd="12dp"
            android:layout_columnWeight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@drawable/selector_headset_eq_txt"
            android:gravity="center"
            android:id="@+id/tv_eq_6"
            android:background="@drawable/selector_headset_eq"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:text="@string/hs_s_e_dance"
            android:layout_columnWeight="1"/>
    </GridLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_eq_custom"
        android:background="@drawable/selector_headset_eq"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_eq">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_flag"
            android:background="@drawable/ic_headset_custom_eq"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:id="@+id/tv_headset_custom_eq_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hs_s_e_custom"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_headset_custom_eq_desc"
            app:layout_constraintStart_toEndOf="@+id/iv_flag"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="#666666"
            android:id="@+id/tv_headset_custom_eq_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hs_s_e_custom_playback"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_flag"
            app:layout_constraintTop_toBottomOf="@+id/tv_headset_custom_eq_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_arrowgrey_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
