<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#50000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/first_step"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/my_component_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/component_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/my_component_full"
                    android:background="@drawable/shape_ffffff_r12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_68"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8">
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_000000"
                        android:id="@+id/tv_component_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        android:text="@string/title_page_all_function_component"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:text="@string/function_component_subtitle"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_14"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_component_name"/>
                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/icon_my_function_component"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/my_component_left_right_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/left_component"
                        android:background="@drawable/shape_ffffff_r12"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_68"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_8">
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_page_all_function_component"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp_16"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/icon_my_function_component"
                            android:layout_marginEnd="@dimen/dp_14"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/right_component"
                        android:background="@drawable/shape_ffffff_r12"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_68"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_8">
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_page_all_function_component"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp_16"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:src="@drawable/icon_my_function_component"
                            android:layout_marginEnd="@dimen/dp_14"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <ImageView
                android:id="@+id/function_component_guide"
                android:layout_width="@dimen/dp_190"
                android:layout_height="@dimen/dp_66"
                android:layout_marginTop="@dimen/dp_12"
                android:src="@drawable/img_guide_function_component"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/component_container"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/function_overseas_component_guide"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_18"
                android:layout_marginEnd="@dimen/dp_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/component_container">
                <ImageView
                    android:id="@+id/guide_left_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_guide_overseas_left"
                    android:layout_marginEnd="@dimen/dp_6"
                    app:layout_constraintEnd_toStartOf="@+id/guide_first_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_ffffff"
                    android:id="@+id/guide_first_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_guide_homepage_new_launch"
                    android:layout_marginEnd="@dimen/dp_6"
                    app:layout_constraintEnd_toStartOf="@+id/guide_right_image"
                    app:layout_constraintStart_toEndOf="@+id/guide_left_image"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp_13"
                    android:textColor="@color/color_ffffff"
                    android:id="@+id/guide_second_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/title_guide_homepage_function_customize"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/guide_first_title"/>
                <ImageView
                    android:id="@+id/guide_right_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_guide_overseas_right"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guide_first_title"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/second_step"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/titlebar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/function_component_edit"
            android:background="@drawable/icon_function_component_edit"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_12"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/titlebar"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView
            android:id="@+id/function_component_edit_direct"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_28"
            android:src="@drawable/img_guide_direct_function_component_edit"
            android:layout_marginEnd="@dimen/dp_32"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/function_component_edit"/>
        <ImageView
            android:id="@+id/image_function_edit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_54"
            android:src="@drawable/img_guide_function_component_edit"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/function_component_edit_direct"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/image_overseas_function_edit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/function_component_edit_direct">
            <ImageView
                android:id="@+id/guide_function_left_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_guide_overseas_left"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintEnd_toStartOf="@+id/guide_function_first_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_18"
                android:textColor="@color/color_ffffff"
                android:id="@+id/guide_function_first_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_guide_function_edit"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintEnd_toStartOf="@+id/guide_function_right_image"
                app:layout_constraintStart_toEndOf="@+id/guide_function_left_image"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_13"
                android:textColor="@color/color_ffffff"
                android:id="@+id/guide_function_second_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/title_guide_function_introduce"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guide_function_first_title"/>
            <ImageView
                android:id="@+id/guide_function_right_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_guide_overseas_right"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guide_function_first_title"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
