<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_12">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/month_layout"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_86"
            android:paddingVertical="@dimen/dp_20"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:id="@+id/time_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_jiantou_bottom"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/time_month">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:id="@+id/all_type_data_distance_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:id="@+id/all_type_data_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_999999"
                        android:id="@+id/all_type_data_distance_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:id="@+id/all_type_data_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_999999"
                        android:id="@+id/all_type_data_hour_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:id="@+id/all_type_data_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_999999"
                        android:id="@+id/all_type_data_count_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_333333"
                        android:id="@+id/all_type_data_calorie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/color_999999"
                        android:id="@+id/all_type_data_calorie_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/all_type_data"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/total_recyclerView"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/fold_layout"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_666666"
                android:id="@+id/fold_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/put_away"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fold_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_jiantou_top"
                android:layout_marginStart="@dimen/dp_7"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detail_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
