<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_sheet_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_d8d8d8_4"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_12"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_back"
        android:padding="14dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_back_black"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4">
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/iv_album_cover"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_100"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/dp_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round="12dp"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_album_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintStart_toEndOf="@+id/iv_album_cover"
            app:layout_constraintTop_toTopOf="@+id/iv_album_cover"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_999999"
            android:id="@+id/tv_online_songs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintStart_toEndOf="@+id/iv_album_cover"
            app:layout_constraintTop_toBottomOf="@+id/tv_album_name"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/ps_color_white"
            android:gravity="center"
            android:id="@+id/tv_sate"
            android:background="@drawable/shape_ff7300_r16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_60"
            android:minHeight="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_album_cover"
            app:layout_constraintStart_toEndOf="@+id/iv_album_cover"/>
        <View
            android:background="@color/color_e6e6e6"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sate"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_song_list"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"/>
</LinearLayout>
