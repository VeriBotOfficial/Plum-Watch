<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_video_share_thumbnail_blur"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/empty"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_video_share_thumbnail"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_66"
        android:layout_marginHorizontal="@dimen/dp_33"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_video_share_thumbnail_cover"
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_400"
            android:scaleType="centerCrop"
            android:contentDescription="@string/empty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_video_share_thumbnail_play"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:src="@drawable/icon_video_share_image_play"
            android:contentDescription="@string/empty"
            app:layout_constraintBottom_toBottomOf="@+id/iv_video_share_thumbnail_cover"
            app:layout_constraintEnd_toEndOf="@+id/iv_video_share_thumbnail_cover"
            app:layout_constraintStart_toStartOf="@+id/iv_video_share_thumbnail_cover"
            app:layout_constraintTop_toTopOf="@+id/iv_video_share_thumbnail_cover"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_video_share_thumbnail_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="-13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_video_share_thumbnail_cover"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_video_share_thumbnail_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_3"
            android:layout_marginStart="@dimen/dp_1"
            app:layout_constraintStart_toEndOf="@+id/iv_video_share_thumbnail_avatar"
            app:layout_constraintTop_toBottomOf="@+id/iv_video_share_thumbnail_cover"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:id="@+id/tv_video_share_thumbnail_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_video_share_thumbnail_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.wakeup.commonui.view.SquareImageView
        android:id="@+id/iv_video_share_thumbnail_qr"
        android:layout_width="@dimen/dp_70"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_video_share_thumbnail"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_video_share_thumbnail_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/string_video_share_thumbnail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_video_share_thumbnail_qr"/>
    <ImageView
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_38"
        android:layout_marginTop="@dimen/dp_51"
        android:src="@drawable/img_share_video_thumbnail_arrow"
        android:contentDescription="@string/empty"
        app:layout_constraintEnd_toStartOf="@+id/tv_video_share_thumbnail_tips"
        app:layout_constraintTop_toTopOf="@+id/iv_video_share_thumbnail_qr"/>
</androidx.constraintlayout.widget.ConstraintLayout>
