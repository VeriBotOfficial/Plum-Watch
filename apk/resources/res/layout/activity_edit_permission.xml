<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mNestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/mTopBar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:menuText="完成"
            app:titleText="TA可以看到的数据"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/ivAvatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:src="@color/red"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:layout_gravity="center"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="BOSS"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_white_r15"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="23dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="21dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="全部开启"
                    android:layout_weight="1"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingStart="20dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/mydata_step"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ff000000"
                        android:id="@+id/tv3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部允许"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666666"
                        android:id="@+id/tv4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="步数、热量、距离数据"/>
                </LinearLayout>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_hr"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_oxygen"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="血氧"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_pressure"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="血压"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_sleep"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="睡眠"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_glucose"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="血糖参考趋势"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_fatigue"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="压力"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_friend_breathe"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv11"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="呼吸频率"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_location"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tv12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="开启位置共享"
                    android:layout_weight="1"
                    android:layout_marginStart="12.5dp"/>
                <Switch
                    android:theme="@style/MySwitch"
                    android:id="@+id/mSwitch10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:id="@+id/tv14"
                android:paddingBottom="26dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
