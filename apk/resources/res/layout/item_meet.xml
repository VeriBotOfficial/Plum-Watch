<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_666666"
        android:ellipsize="end"
        android:id="@+id/item_meet_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/item_meet_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/black"
        android:id="@+id/item_meet_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/jacket_m_standard_recording"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/item_meet_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_meet_id"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/black"
        android:id="@+id/item_meet_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_meet_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_meet_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:id="@+id/item_meet_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="5"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_meet_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/item_meet_line"
        android:background="@color/line_bg"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_meet_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/color_817F7D"
        android:id="@+id/item_meet_audio_t"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_meet_line"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_meet_source"
        android:background="@drawable/ic_meet_source_p"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_meet_audio_t"
        app:layout_constraintEnd_toStartOf="@+id/item_meet_more"
        app:layout_constraintTop_toTopOf="@+id/item_meet_audio_t"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_meet_more"
        android:background="@drawable/ic_more_2"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:rotation="90"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_meet_audio_t"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_meet_audio_t"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_meet_audio_t"/>
</androidx.constraintlayout.widget.ConstraintLayout>
