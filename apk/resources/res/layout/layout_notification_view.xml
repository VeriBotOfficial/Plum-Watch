<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_step_notify_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_logo"
        android:background="@mipmap/ic_logo_small"
        android:layout_width="16dp"
        android:layout_height="14dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wearfit"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/iv_logo"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/iv_logo"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unit_gongli"
        android:layout_alignBaseline="@+id/distance"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_toEndOf="@+id/distance"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/distance_unit"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_toEndOf="@+id/distance_unit"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/kcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/duration"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_toEndOf="@+id/duration"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_333333"
        android:id="@+id/kcal_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_qianka"
        android:layout_alignBaseline="@+id/kcal"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_toEndOf="@+id/kcal"/>
    <ImageView
        android:id="@+id/btn"
        android:layout_width="@dimen/dp_46"
        android:layout_height="@dimen/dp_46"
        android:src="@drawable/ic_sport_pause"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
