<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shape_gradient_fafafb_ffffff_left_right"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <TextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/color_b1b1b1"
        android:gravity="center_vertical"
        android:id="@+id/hot_search_index"
        android:layout_width="@dimen/dp_20"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_1"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/hot_search_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/color_ffffff"
        android:gravity="center_vertical"
        android:id="@+id/hot_search_icon"
        android:paddingLeft="@dimen/dp_2"
        android:paddingRight="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_14"
        android:minWidth="@dimen/dp_14"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp_12"/>
</LinearLayout>
