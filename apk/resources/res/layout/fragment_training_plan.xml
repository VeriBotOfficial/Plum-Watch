<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/smartRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:paddingTop="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp_12">
            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="banner广告"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clNoPlan"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_153">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:cardElevation="@dimen/dp_0"
                    app:cardMaxElevation="@dimen/dp_0">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_setplan"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/course_desc_35"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/white"
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="@string/course_desc_36"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tip"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/shape_white_r16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_22"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:paddingVertical="@dimen/dp_6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_no_plan_calendar"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_12"
                            android:textColor="@color/color_EB3E27"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/course_desc_37"
                            android:layout_marginStart="@dimen/dp_5"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/plan_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_223">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:cardElevation="@dimen/dp_0"
                    app:cardMaxElevation="@dimen/dp_0">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_plan_bg"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_21"
                    android:textStyle="bold"
                    android:textColor="@color/color_ff7300"
                    android:id="@+id/plan_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_6A6A6A"
                    android:ellipsize="end"
                    android:id="@+id/plan_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/course_plan_desc"
                    android:maxLines="1"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/plan_title"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/plan_more_cardView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginBottom="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:cardCornerRadius="@dimen/dp_20"
                    app:cardElevation="@dimen/dp_0"
                    app:cardMaxElevation="@dimen/dp_0"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:background="#4c4752"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/tip_21_0702_liu_18"/>
                </androidx.cardview.widget.CardView>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/plan_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginVertical="@dimen/dp_18"
                    app:layout_constraintBottom_toTopOf="@+id/plan_more_cardView"
                    app:layout_constraintTop_toBottomOf="@+id/plan_desc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llPlan"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl01"
                    android:background="@drawable/shape_white_r12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:id="@+id/tvTip01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/course_tip_91"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.wakeup.commonui.view.ArcHalfProcessView
                        android:id="@+id/progressBar"
                        android:layout_width="@dimen/dp_202"
                        android:layout_height="@dimen/dp_122"
                        android:layout_marginTop="@dimen/dp_20"
                        android:progressDrawable="@drawable/train_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tvTip01"
                        app:layout_constraintTop_toBottomOf="@+id/tvTip01"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_26"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/progressbar_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_50"
                        android:text="50%"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/progressBar"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_16"
                        android:textStyle="bold"
                        android:id="@+id/tv_day_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/progressbar_text"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666666"
                        android:ellipsize="end"
                        android:id="@+id/tv_con_running"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:text="@string/course_tip_93"
                        android:lines="1"
                        android:layout_marginEnd="@dimen/dp_3"
                        app:layout_constraintEnd_toStartOf="@+id/tv_time_layout"
                        app:layout_constraintStart_toStartOf="@+id/tvTip01"
                        app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#ff333333"
                        android:id="@+id/tv_running"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="@+id/tv_con_running"
                        app:layout_constraintTop_toBottomOf="@+id/tv_con_running"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:id="@+id/tv_time_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/tv_consume_layout"
                        app:layout_constraintStart_toEndOf="@+id/tv_con_running"
                        app:layout_constraintTop_toTopOf="@+id/tv_con_running">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12sp"
                                android:textColor="#ff666666"
                                android:id="@+id/tv_cumulative_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_tip_94"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#ff333333"
                                android:gravity="center"
                                android:id="@+id/tv_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="@+id/tv_cumulative_time"
                                app:layout_constraintTop_toBottomOf="@+id/tv_cumulative_time"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="end"
                        android:id="@+id/tv_consume_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_time_layout"
                        app:layout_constraintTop_toTopOf="@+id/tv_con_running">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#ff666666"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:id="@+id/tv_consume"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_tip_95"
                                android:lines="1"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="#ff333333"
                                android:gravity="end"
                                android:id="@+id/tv_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="@+id/tv_consume"
                                app:layout_constraintTop_toBottomOf="@+id/tv_consume"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_white_r10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl01">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold"
                            android:textColor="#ff333333"
                            android:id="@+id/tvTip1"
                            android:paddingBottom="@dimen/dp_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:text="@string/course_tip_05"
                            android:layout_marginStart="@dimen/dp_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/next_plan"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_jiantou_right"
                            android:paddingHorizontal="@dimen/dp_16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_12"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerview2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:layout_marginHorizontal="@dimen/dp_20"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_planTemplate"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/plan_end_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_22"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_12"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</com.scwang.smart.refresh.layout.SmartRefreshLayout>
