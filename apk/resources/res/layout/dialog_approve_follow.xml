<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@color/transp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_340">
        <View
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_100"/>
        <View
            android:id="@+id/content_bg"
            android:background="@drawable/ic_video_follow_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_38"
            app:layout_constraintDimensionRatio="10:3.4"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_close"
            android:padding="@dimen/dp_5"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:layout_margin="@dimen/dp_16"
            android:src="@drawable/close"
            app:layout_constraintEnd_toEndOf="@+id/content_bg"
            app:layout_constraintTop_toTopOf="@+id/content_bg"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_icon"
            android:background="@color/white"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/circleImageStyle"
            app:strokeColor="@color/white"
            app:strokeWidth="@dimen/dp_2"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_follow_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_21"
            android:text="@string/dialog_follow_count"
            app:layout_constraintEnd_toEndOf="@+id/iv_icon"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_fff76814"
            android:id="@+id/tv_follow_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@string/dialog_follow_tip"
            app:layout_constraintEnd_toEndOf="@+id/iv_icon"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_follow_count"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_follow_update_count"
            android:background="@drawable/gradient_dialog_follow_red"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_38"
            android:layout_marginTop="@dimen/dp_20"
            android:maxLines="2"
            android:drawableStart="@drawable/ic_update_count"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintEnd_toStartOf="@+id/tv_follow_play_count"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_follow_tip"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_follow_play_count"
            android:background="@drawable/gradient_dialog_follow_blue"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_38"
            android:maxLines="2"
            android:drawableStart="@drawable/ic_total_video_count"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_follow_update_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_follow_update_count"
            app:layout_constraintTop_toTopOf="@+id/tv_follow_update_count"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_total_time"
            android:background="@drawable/gradient_dialog_follow_blue"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_38"
            android:layout_marginTop="@dimen/dp_6"
            android:maxLines="2"
            android:drawableStart="@drawable/ic_total_video_time"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="@+id/tv_follow_update_count"
            app:layout_constraintStart_toStartOf="@+id/tv_follow_update_count"
            app:layout_constraintTop_toBottomOf="@+id/tv_follow_update_count"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_play_time"
            android:background="@drawable/gradient_dialog_follow_yellow"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_38"
            android:maxLines="2"
            android:drawableStart="@drawable/ic_today_video_time"
            android:paddingStart="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="@+id/tv_follow_play_count"
            app:layout_constraintStart_toStartOf="@+id/tv_follow_play_count"
            app:layout_constraintTop_toTopOf="@+id/tv_total_time"/>
        <Button
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/bt_follow"
            android:background="@drawable/shape_r48"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_21"
            android:text="@string/dialog_follow_click"
            android:backgroundTint="@color/color_fff76814"
            app:layout_constraintEnd_toEndOf="@+id/tv_play_time"
            app:layout_constraintStart_toStartOf="@+id/tv_total_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
