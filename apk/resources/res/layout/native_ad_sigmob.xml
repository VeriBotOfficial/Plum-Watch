<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_feed_video_ad_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:gravity="center"
            android:id="@+id/layout_home_feed_video_ad_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/transparent"
            android:id="@+id/tv_home_feed_video_ad_cta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#888888"
            android:id="@+id/tv_home_feed_video_ad_from"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_domain"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#aaaaaa"
            android:id="@+id/tv_home_feed_video_ad_domain"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_warning"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff0000"
            android:id="@+id/tv_home_feed_video_ad_warning"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/iv_home_feed_video_ad_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/iv_home_feed_video_ad_sign"
                android:visibility="gone"
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_15"
                android:src="0x7f080ce0"
                android:contentDescription="@string/empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageView
                android:id="@+id/iv_home_feed_video_ad_sign_baidu"
                android:visibility="gone"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_18"
                android:layout_marginBottom="@dimen/dp_6"
                android:src="@drawable/icon_home_page_feed_video_ad_sign_baidu"
                android:contentDescription="@string/empty"
                android:layout_marginEnd="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageView
                android:id="@+id/iv_home_feed_video_ad_sign_csj"
                android:visibility="gone"
                android:layout_width="@dimen/dp_52"
                android:layout_height="@dimen/dp_18"
                android:src="@drawable/icon_home_page_feed_video_ad_sign_csj"
                android:contentDescription="@string/empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
