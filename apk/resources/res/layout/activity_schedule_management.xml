<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_switch_calendar"
        app:titleText="@string/string_schedule_reminder"/>
    <com.wakeup.commonui.view.WeekBar
        android:id="@+id/weekBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    <com.wakeup.commonui.calendar.CustomerCalendar
        android:id="@+id/customCalendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:calendarHeight="@dimen/dp_300"
        app:defaultCalendar="week"
        app:defaultCheckedBackground="@drawable/share_ff7300_oval"
        app:defaultCheckedLunarTextColor="@color/color_ff7300"
        app:defaultCheckedSolarTextColor="@color/white"
        app:defaultUnCheckedLunarTextColor="@color/color_BCBCBC"
        app:defaultUnCheckedSolarTextColor="@color/color_151515"
        app:lastNextMothAlphaColor="50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weekBar"
        app:lunarDistance="@dimen/dp_17"
        app:lunarTextSize="@dimen/dp_11"
        app:pointDistance="@dimen/dp_25"
        app:pointLocation="down"
        app:pointSize="@dimen/dp_4"
        app:solarTextSize="@dimen/dp_15"
        app:stretchCalendarEnable="false"
        app:todayCheckedBackground="@drawable/share_ff7300_oval"
        app:todayCheckedLunarTextColor="@color/color_ff7300"
        app:todayCheckedSolarTextColor="@color/white"
        app:todayUnCheckedLunarTextColor="@color/color_BCBCBC"
        app:todayUnCheckedSolarTextColor="@color/color_151515">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/guide_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/dp_10"
                app:contentPaddingLeft="@dimen/dp_0"
                app:contentPaddingRight="@dimen/dp_0"
                app:contentPaddingTop="@dimen/dp_0"
                app:layout_constraintTop_toTopOf="parent">
                <RelativeLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_20">
                    <ImageView
                        android:id="@+id/guide_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_parallel"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <com.wakeup.commonui.view.CanVerticallyScrollView
                android:id="@+id/scrollView"
                android:tag="@string/N_factual_scroll_view"
                android:paddingTop="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_marginBottom="68dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guide_layout">
                <RelativeLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/no_data_layout"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_schedule_no_data"/>
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_5"
                            android:text="@string/schedule_empty_tip"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.wakeup.commonui.view.WeekScrollView
                        android:id="@+id/weekScrollView"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
            </com.wakeup.commonui.view.CanVerticallyScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.wakeup.commonui.calendar.CustomerCalendar>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_schedule"
        android:layout_width="@dimen/dp_108"
        android:layout_height="@dimen/dp_108"
        android:layout_marginBottom="@dimen/dp_26"
        android:src="@drawable/ic_schedule_add"
        android:paddingHorizontal="@dimen/dp_24"
        android:paddingVertical="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
