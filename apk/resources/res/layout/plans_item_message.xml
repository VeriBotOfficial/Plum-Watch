<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/loadingBubble"
        android:background="@drawable/bg_plans_message_assistant_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">
        <ImageView
            android:id="@+id/ivLoading"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/plans_chat_loading_spin"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/plans_text_secondary"
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plans_thinking"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/plans_text"
        android:id="@+id/tvText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"/>
</FrameLayout>
