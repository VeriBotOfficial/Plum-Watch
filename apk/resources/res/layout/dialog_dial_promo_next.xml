<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/shape_dial_promo_sheet_bg"
    android:paddingTop="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_14"
    android:paddingEnd="@dimen/dp_14">
    <View
        android:background="@drawable/shape_dial_promo_handle"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_3"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_badge"
        android:background="@drawable/shape_dial_promo_badge_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_3">
        <ImageView
            android:id="@+id/iv_badge_flame"
            android:visibility="gone"
            android:layout_width="@dimen/dp_13"
            android:layout_height="@dimen/dp_13"
            android:src="@drawable/ic_dial_promo_flame"
            android:layout_marginEnd="@dimen/dp_4"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8">
        <ImageView
            android:id="@+id/iv_title_check"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_dial_promo_check_circle"
            android:layout_marginEnd="@dimen/dp_5"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_888888"
        android:id="@+id/tv_next_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/dial_promo_recommend_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_next_dials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:overScrollMode="never"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_next_buy"
        android:background="@drawable/shape_dial_promo_buy_normal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_12">
        <ImageView
            android:id="@+id/iv_buy_flame"
            android:visibility="gone"
            android:layout_width="@dimen/dp_15"
            android:layout_height="@dimen/dp_15"
            android:src="@drawable/ic_dial_promo_flame"
            android:layout_marginEnd="@dimen/dp_5"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_next_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_bbbbbb"
        android:id="@+id/tv_next_close"
        android:padding="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"/>
</LinearLayout>
