<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout">
        <VideoView
            android:id="@+id/videoLoader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <com.canhub.cropper.CropImageView
            android:id="@+id/cropFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:cornerShape="rectangle"
            app:cropAutoZoomEnabled="false"
            app:cropBorderCornerColor="@color/white"
            app:cropBorderLineColor="@color/white"
            app:cropCornerRadius="24dp"
            app:cropGuidelines="off"
            app:cropMaxZoom="0"
            app:cropScaleType="center"
            app:cropShape="rectangle"/>
        <ImageView
            android:id="@+id/iconVideoPlay"
            android:background="@drawable/play_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout"
        android:background="@color/background_video_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/timeFrame"
            android:background="@drawable/rounded_textview_video_trim"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="@dimen/text_small"
                android:textColor="#efc43b"
                android:gravity="center"
                android:id="@+id/textTimeSelection"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/timeLineFrame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@+id/timeFrame"
            android:layout_marginVertical="15dp"
            android:paddingHorizontal="15dp">
            <FrameLayout
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_centerInParent="true">
                <com.wakeup.module.video.view.TimeLineView
                    android:layout_gravity="center"
                    android:id="@+id/timeLineView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_centerInParent="true"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <SeekBar
                android:layout_gravity="center_vertical"
                android:id="@+id/handlerTop"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:secondaryProgress="0"
                android:progressDrawable="@android:color/transparent"
                android:thumb="@drawable/seek_bar_line"
                android:thumbOffset="0dp"
                android:layout_centerInParent="true"/>
            <com.wakeup.module.video.view.RangeSeekBarView
                android:id="@+id/timeLineBar"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>
            <SeekBar
                android:layout_gravity="center_vertical"
                android:id="@+id/handlerTop2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:secondaryProgress="0"
                android:progressDrawable="@android:color/transparent"
                android:thumb="@drawable/seek_bar_line"
                android:thumbOffset="0dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
