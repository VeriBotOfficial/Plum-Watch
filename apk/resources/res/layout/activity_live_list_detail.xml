<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_share_gray_black"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detail_recyclerView"
        android:background="@drawable/ic_live_history_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_ccffffff_r14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_28"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_swap_black"
            android:paddingHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_source_lan_desc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="我：简体中文"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/iv_swap"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_trans_lan_desc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="对方：英文"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_swap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
