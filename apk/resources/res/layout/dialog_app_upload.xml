<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:background="0x7f080287"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginHorizontal="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:src="@drawable/ic_app_upload"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_app_upload_line"
                android:layout_width="40dp"
                android:layout_height="1dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_app_upload_line"
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:rotation="180"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="#999999"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:id="@+id/tv_upload_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:id="@+id/tv_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_go"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"/>
        <View
            android:layout_width="1dp"
            android:layout_height="16dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:padding="10dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        app:layout_constraintTop_toTopOf="@+id/ll_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
