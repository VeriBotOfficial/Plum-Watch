<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/myTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/mine_personalized_ad_set"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/mine_ad_set_description"
        android:layout_marginHorizontal="@dimen/dp_22"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_ffffff_r12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="@dimen/dp_12">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_282828"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_personalized_ad"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Switch
            android:id="@+id/switch_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/device_notify_switch_thumb"
            android:track="@drawable/device_notify_switch_track"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_666666"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/mine_ad_colse"
        android:layout_marginHorizontal="@dimen/dp_22"/>
</LinearLayout>
