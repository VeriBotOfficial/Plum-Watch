<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/tip_21_0618_01"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/name_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_consumer_name"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:id="@+id/order_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/status_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_1"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_layout">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_status"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_ff7300"
            android:id="@+id/order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/amount_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_1"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_layout">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_amount"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:id="@+id/order_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/order_number_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_1"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount_layout">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_order_number"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:id="@+id/order_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/trade_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_30"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/order_number_layout">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_trading_hours"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:id="@+id/order_trade_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/pay_platform_layout"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_1"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trade_layout">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_000000"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_payment_platform"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/color_999999"
            android:id="@+id/order_pay_platform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tv_sync"
        android:background="@drawable/shape_ff7300_r6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_43"
        android:layout_marginTop="@dimen/dp_118"
        android:text="@string/order_detail_sync_dial_status"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pay_platform_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
