<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_measure_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginBottom="@dimen/dp_16"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_measure_loading"
        android:layout_width="@dimen/dp_59"
        android:layout_height="@dimen/dp_59"
        android:layout_marginTop="@dimen/dp_28"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/rs_m_dialog_des"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/dialog_measure_cancel"
        android:background="@drawable/shape_e3e3e3_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:text="@string/btn_cancel"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"/>
</androidx.appcompat.widget.LinearLayoutCompat>
