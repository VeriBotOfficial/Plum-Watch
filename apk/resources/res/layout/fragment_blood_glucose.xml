<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_left"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tv_title_date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/single_value_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="@color/textBlack"
                android:id="@+id/bs_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/textBlack"
                android:id="@+id/bs_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mmol/L"
                android:layout_marginStart="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/bs_value"
                app:layout_constraintStart_toEndOf="@+id/bs_value"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/value_type_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bs_value">
                <TextView
                    android:textSize="12dp"
                    android:id="@+id/bs_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/value_gap_line"
                    android:background="@color/color_E3E3E3"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="4dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/color_666666"
                    android:id="@+id/bs_time_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mutable_value_layout"
            android:background="@color/white"
            android:paddingTop="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/value_layout_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:layout_constraintEnd_toStartOf="@+id/value_layout_max"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="32dp"
                    android:textStyle="bold"
                    android:textColor="@color/textBlack"
                    android:id="@+id/bs_value_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/textBlack"
                    android:id="@+id/bs_unit_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mmol/L"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/bs_value_min"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/bs_value_min"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/value_type_layout_min"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bs_value_min">
                    <TextView
                        android:textSize="12dp"
                        android:id="@+id/bs_level_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <View
                        android:background="@color/color_E3E3E3"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/color_666666"
                        android:id="@+id/bs_time_type_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/value_layout_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/value_layout_min"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="32dp"
                    android:textStyle="bold"
                    android:textColor="@color/textBlack"
                    android:id="@+id/bs_value_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@+id/bs_unit_max"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/textBlack"
                    android:id="@+id/bs_unit_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mmol/L"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/bs_value_max"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/bs_value_max"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/value_type_layout_max"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bs_value_max">
                    <TextView
                        android:textSize="12dp"
                        android:id="@+id/bs_level_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <View
                        android:background="@color/color_E3E3E3"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/color_666666"
                        android:id="@+id/bs_time_type_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date"
            android:background="@color/white"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_heart_arrow_down"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.wakeup.commonui.chart.IndicatorBarChart
            android:id="@+id/chartView"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <include
        android:id="@+id/diabetes_risk_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_diabetes_risk_entry"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_type_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/ll_type_normal"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/shape_dot_bg_low"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/color_999999"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tiwen_piandi"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_type_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="44dp"
            app:layout_constraintEnd_toStartOf="@+id/ll_type_high"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ll_type_low"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/shape_dot_bg_nor"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/color_999999"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tiwen_zhengchang"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_type_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ll_type_normal"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/shape_dot_bg_high"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/color_999999"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mianyili_piangao"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp">
        <include
            android:id="@+id/card_bg_range"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            layout="@layout/item_health_page_card"/>
        <include
            android:id="@+id/card_bg_avg"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            layout="@layout/item_health_page_card"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
