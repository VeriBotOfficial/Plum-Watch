<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_checkin_bar"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/tv_checkin_icon"
            android:background="@drawable/bg_checkin_icon_white"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="��"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:ellipsize="end"
            android:id="@+id/tv_checkin_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/checkin_earn_points"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_checkin_btn"
            app:layout_constraintStart_toEndOf="@+id/tv_checkin_icon"
            app:layout_constraintTop_toTopOf="@+id/tv_checkin_icon"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:id="@+id/tv_checkin_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/checkin_earn_points"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_checkin_btn"
            app:layout_constraintStart_toEndOf="@+id/tv_checkin_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_checkin_main"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/tv_checkin_btn"
            android:background="@drawable/bg_checkin_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkin_action"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
