<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/light_sleep_distribution_layout"
        android:background="@drawable/shape_white_r10"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_72"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/light_sleep_distribution_cardview"
            android:layout_width="7dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/dp_16"
            app:cardBackgroundColor="#3460fe"
            app:cardCornerRadius="@dimen/dp_4"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/light_sleep_distribution_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/light_sleep_distribution_tv"
            android:layout_width="@dimen/dp_0"
            android:layout_height="0dp"
            android:text="--"
            android:maxLines="1"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toTopOf="@+id/light_sleep_distribution_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/light_sleep_distribution_cardview"
            app:layout_constraintTop_toTopOf="@+id/light_sleep_distribution_cardview"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/color_999999"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/light_sleep_distribution_desc"
            android:layout_width="@dimen/dp_0"
            android:layout_height="0dp"
            android:text="@string/qinyou_qianshui"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/light_sleep_distribution_cardview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/light_sleep_distribution_cardview"
            app:layout_constraintTop_toBottomOf="@+id/light_sleep_distribution_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
