<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/ic_share_gray"
        app:titleText="@string/course_tip_39"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        android:id="@+id/goShare"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/course_tip_82"
        android:backgroundTint="@color/color_F96623"
        android:layout_marginHorizontal="@dimen/dp_44"
        android:layout_marginVertical="@dimen/dp_12"
        app:cornerRadius="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mScrollView"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/goShare"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:background="@drawable/ic_plan_share_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_117">
                <FrameLayout
                    android:id="@+id/avatar_layout"
                    android:background="@drawable/shape_write_round_bg"
                    android:layout_width="@dimen/dp_45"
                    android:layout_height="@dimen/dp_45"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivAvatar"
                        android:layout_width="@dimen/dp_44"
                        android:layout_height="@dimen/dp_44"
                        android:src="@color/grey"/>
                </FrameLayout>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tvUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_5"
                    app:layout_constraintEnd_toStartOf="@+id/time"
                    app:layout_constraintStart_toEndOf="@+id/avatar_layout"
                    app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/course_tip_83"
                    android:alpha="0.68"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvUserName"
                    app:layout_constraintTop_toBottomOf="@+id/tvUserName"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/white"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvUserName"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/ivChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scaleType="fitXY"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/share_logo"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_10"
                    android:src="@mipmap/ic_logo_small"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivQr"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    android:textColor="#372b26"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wearfit"
                    android:layout_marginStart="@dimen/dp_7"
                    app:layout_constraintStart_toEndOf="@+id/share_logo"
                    app:layout_constraintTop_toTopOf="@+id/share_logo"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_7"
                    android:text="@string/course_tip_25"
                    app:layout_constraintStart_toStartOf="@+id/share_logo"
                    app:layout_constraintTop_toBottomOf="@+id/share_logo"/>
                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="@dimen/dp_56"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:layout_marginVertical="@dimen/dp_15"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
