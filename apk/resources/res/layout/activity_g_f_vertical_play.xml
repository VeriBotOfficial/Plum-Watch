<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f4f6f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/status_bar_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/status_bar"/>
    <FrameLayout
        android:id="@+id/fl_close"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_layout">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_film_close"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <com.wakeup.module.glasses.view.GFPlayView
        android:layout_gravity="center"
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_close"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_first_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/video_view"
        app:layout_constraintEnd_toEndOf="@+id/video_view"
        app:layout_constraintStart_toStartOf="@+id/video_view"
        app:layout_constraintTop_toTopOf="@+id/video_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_view">
        <FrameLayout
            android:id="@+id/fl_play"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_play"
                android:background="@drawable/ic_g_film_play"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="#333333"
            android:id="@+id/tv_play_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fl_play"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_mute"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_mute"
                android:background="@drawable/ic_g_f_mute_open"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="#333333"
            android:id="@+id/tv_play_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/fl_mute"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:layout_gravity="bottom"
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:maxHeight="@dimen/dp_2"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_play_total"
            app:layout_constraintStart_toEndOf="@+id/tv_play_current"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CustomSeekBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
