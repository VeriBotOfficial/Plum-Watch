<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/phone_system_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_22">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_666666"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_system_tips1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30"
            android:text="@string/phone_system_tips2"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_nonemessage"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_system_tips3"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_nonephone"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_system_tips4"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_nonepower"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_system_tips5"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_20">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_noneapp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_system_tips6"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/dp_6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_36"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/bt_complete"
            android:background="@drawable/shape_e3e3e3_r6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/phone_system_completed"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_6"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bt_setting"
            android:background="@drawable/shape_ff7300_r6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/btn_setting"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_6"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
