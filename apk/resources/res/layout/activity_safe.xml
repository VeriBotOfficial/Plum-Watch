<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/safe_zhanghaoyuanquan"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@mipmap/ic_logo_small"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ff333333"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_44"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_15">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_282828"
                android:gravity="start|center_vertical"
                android:id="@+id/btnModifyPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/login_bind_phone_modify"
                app:drawableRightCompat="@drawable/ic_jiantou_right"/>
            <View
                android:id="@+id/gap_line"
                android:background="@color/color_EFEFEF"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_282828"
                android:gravity="start|center_vertical"
                android:id="@+id/btnUpdatePwd"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/safe_xiugaimima"
                app:drawableRightCompat="@drawable/ic_jiantou_right"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_282828"
            android:gravity="start|center_vertical"
            android:id="@+id/btnLogout"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/account_logout"
            android:paddingStart="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_15"
            app:drawableRightCompat="@drawable/ic_jiantou_right"/>
        <Button
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:id="@+id/btnExit"
            android:background="@drawable/bg_btn_login_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/account_exit"
            android:layout_marginHorizontal="@dimen/dp_16"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
