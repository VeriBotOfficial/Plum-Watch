<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/im_close"
            android:padding="15dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_close"/>
        <ImageView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/ic_payfail"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff363636"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/tip_21_0623_01"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_toSeeOrder"
            android:background="@drawable/shape_bg_4892ff"
            android:layout_width="254dp"
            android:layout_height="34dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tip_21_0623_02"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
