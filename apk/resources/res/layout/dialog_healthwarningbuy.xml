<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_white_r15_r3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="19sp"
            android:textColor="#ff000000"
            android:gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="订单服务"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_close"
            android:paddingRight="3dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/icon_healthwarning_close"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="43dp">
        <RelativeLayout
            android:id="@+id/rlVip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/shape_white_r5"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tvVipUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIP用户"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tvFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:text="100次"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="#ff407bff"
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="￥10.00"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#ff407bff"
                    android:id="@+id/tvBuyNow"
                    android:background="@drawable/shape_transp_line_407bff"
                    android:paddingLeft="19dp"
                    android:paddingTop="6dp"
                    android:paddingRight="19dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:text="立即购买"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivSelectPay"
                android:layout_width="39dp"
                android:layout_height="33dp"
                android:src="@mipmap/icon_healthselect"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:layout_width="16dp"
            android:layout_height="0dp"/>
        <RelativeLayout
            android:id="@+id/rlGeneral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/shape_white_r5"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tvGeneralUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="普通用户"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff000000"
                    android:id="@+id/tvFrequency1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:text="100次"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="#ff407bff"
                    android:id="@+id/tvAmount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="￥10.00"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#ff407bff"
                    android:id="@+id/tvBuyNow1"
                    android:background="@drawable/shape_transp_line_407bff"
                    android:paddingLeft="19dp"
                    android:paddingTop="6dp"
                    android:paddingRight="19dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:text="立即购买"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivSelectPay1"
                android:layout_width="39dp"
                android:layout_height="33dp"
                android:src="@mipmap/icon_healthselect"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
