<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuImage="@drawable/ic_more_log"
        app:titleText="@string/tip_21_0116_7"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llType"
        android:background="@drawable/shape_white_r12"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="12dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tip_21_0618_09"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_gravity="center"
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:padding="10dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/more"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llAd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llAdReason"
            android:background="@drawable/shape_white_r12"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="12dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff000000"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tvAdReasonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_ad_reason"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tvAdReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center"
                android:padding="10dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/more"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_issue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_white_2"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/textBlack"
                android:gravity="top"
                android:id="@+id/et_content"
                android:background="@null"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/tip_21_0618_10"
                android:minLines="10"
                android:maxLength="500"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_img"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="20dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_audio"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <FrameLayout
            android:background="@drawable/shape_white_r6"
            android:layout_width="match_parent"
            android:layout_height="243dp"
            android:layout_marginHorizontal="12dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_record"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_record_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/glasses2_issue_tip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_record_down"
                    android:background="@drawable/ic_g_record_log_down"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="-4dp"
                    app:layout_constraintEnd_toEndOf="@+id/ll_record"
                    app:layout_constraintStart_toStartOf="@+id/ll_record"
                    app:layout_constraintTop_toBottomOf="@+id/ll_record"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_record"
                    android:background="@drawable/shape_ff7300_r12"
                    android:visibility="gone"
                    android:layout_width="171dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="8dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_record_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0s"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/chat_talk_loading"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="8dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ai_robot_btn_5"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_record_start"
                    android:background="@drawable/shape_ff7300_r6"
                    android:layout_width="146dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="22dp"
                    android:text="@string/sound_tran_btn"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_record_file"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/fl_record_file"
                    android:background="@drawable/ic_g_record_log_file"
                    android:layout_width="55dp"
                    android:layout_height="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <FrameLayout
                    android:id="@+id/fl_record_delete"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-12dp"
                    android:layout_marginStart="-12dp"
                    app:layout_constraintBottom_toTopOf="@+id/fl_record_file"
                    app:layout_constraintStart_toEndOf="@+id/fl_record_file">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:background="@drawable/ic_g_record_log_delete"
                        android:layout_width="13dp"
                        android:layout_height="13dp"/>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/glasses2_issue_tip1"
            android:layout_marginHorizontal="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/glasses2_issue_tip2"
            android:layout_marginHorizontal="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/check_box_log"
            android:background="@drawable/select_switch_upload_log"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:checked="true"
            android:button="@null"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_log_tip"
            android:layout_marginStart="4dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_submit"
        android:background="@drawable/shape_dddddd_r12"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="40dp"
        android:text="@string/help_tijiao"
        android:layout_marginHorizontal="12dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffcdcdcd"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/tip_21_0618_11"
        android:layout_marginHorizontal="38dp"/>
</LinearLayout>
