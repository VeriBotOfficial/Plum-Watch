<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/shape_white_r12_topleft_topright"
    android:paddingLeft="16dp"
    android:paddingTop="28dp"
    android:paddingRight="16dp"
    android:paddingBottom="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llPermission"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="26dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_more_permission"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/publish_video_video_permission_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_more_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_management_delete"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
