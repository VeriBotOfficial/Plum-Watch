<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:background="@color/bg_main_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llComment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/dp_0">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="?attr/colorPrimary"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="pin"
                    app:layout_collapseParallaxMultiplier="0.7">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/top_bg"
                        android:background="@drawable/course_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_256"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/tvCommentTopTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_100"
                            android:layout_marginStart="@dimen/space_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_ccffffff"
                            android:id="@+id/tvFinishCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:layout_marginStart="@dimen/space_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvCommentTopTitle"/>
                        <TextView
                            android:textSize="@dimen/sp_11"
                            android:textColor="@color/color_ccffffff"
                            android:id="@+id/tvKacl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_19"
                            android:layout_marginStart="@dimen/space_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvFinishCount"/>
                        <TextView
                            android:textSize="@dimen/sp_11"
                            android:textColor="@color/color_ccffffff"
                            android:id="@+id/tvMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_19"
                            android:layout_marginStart="@dimen/space_16"
                            app:layout_constraintStart_toEndOf="@+id/tvKacl"
                            app:layout_constraintTop_toBottomOf="@+id/tvFinishCount"/>
                        <TextView
                            android:textSize="@dimen/sp_11"
                            android:textColor="@color/color_ccffffff"
                            android:id="@+id/tvGrade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_19"
                            android:layout_marginStart="@dimen/space_16"
                            app:layout_constraintStart_toEndOf="@+id/tvMin"
                            app:layout_constraintTop_toBottomOf="@+id/tvFinishCount"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.legacy.widget.Space
                        android:id="@+id/space"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/space_22"
                        app:layout_constraintBottom_toBottomOf="@+id/top_bg"
                        app:layout_constraintStart_toStartOf="@+id/top_bg"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/ll_menu"
                        android:background="@drawable/shape_white_50"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_44"
                        android:layout_marginHorizontal="@dimen/space_52"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/space">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <com.wakeup.commonui.view.thumbsup.ThumbsUpCountView
                                android:layout_gravity="center"
                                android:id="@+id/tv_praise"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                app:thumbsup_off_drawable="@drawable/ic_zan_off"
                                app:thumbsup_off_text_color="@color/color_333333"
                                app:thumbsup_on_drawable="@drawable/ic_zan_on"
                                app:thumbsup_on_show_circle="false"
                                app:thumbsup_on_show_decoration="false"
                                app:thumbsup_on_text_color="@color/color_333333"
                                app:thumbsup_text_size="@dimen/sp_14"/>
                        </FrameLayout>
                        <com.wakeup.feature.course.widget.DrawableCenterTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_333333"
                            android:gravity="center"
                            android:id="@+id/tv_comment"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="0"
                            android:drawablePadding="@dimen/dp_4"
                            android:layout_weight="1"
                            app:drawableStartCompat="@drawable/comment"/>
                        <com.wakeup.feature.course.widget.DrawableCenterTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_333333"
                            android:gravity="center"
                            android:id="@+id/tv_share"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="0"
                            android:drawablePadding="@dimen/dp_4"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/share"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="@dimen/dp_30"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/ic_back_black"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_15"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ff333333"
                android:id="@+id/tvCommentCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/course_tip_17"
                android:layout_marginStart="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.scwang.smart.refresh.layout.SmartRefreshLayout
                android:id="@+id/smartRefreshLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCommentCount"
                app:layout_constraintVertical_bias="0"
                app:srlEnableLoadMoreWhenContentNotFull="false"
                app:srlEnableRefresh="false">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </com.scwang.smart.refresh.layout.SmartRefreshLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/llComment"
        android:background="@drawable/bg_shape_bolder_top_bottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:textSize="13sp"
            android:textColorHint="@color/color_cccccc"
            android:id="@+id/editText"
            android:background="@drawable/bg_shape_edittext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/course_tip_19"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginVertical="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_16"/>
        <TextView
            android:enabled="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/txt_color_push_selector"
            android:gravity="center"
            android:id="@+id/btnPush"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/course_tip_20"
            android:paddingHorizontal="@dimen/dp_12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
