<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/plans_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@color/plans_card"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp">
            <ImageView
                android:id="@+id/ivBack"
                android:background="@drawable/bg_plans_icon_circle_gray"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_plans_back_arrow"
                android:contentDescription="@null"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/plans_text"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/plans_message_detail_title"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/plans_text_secondary"
                    android:id="@+id/tvAiDisclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/plans_ai_generated_disclaimer"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivMore"
                android:padding="6dp"
                android:visibility="visible"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_plans_more_horiz"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/heroBlock"
                android:background="@drawable/bg_plans_detail_hero"
                android:paddingTop="24dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="36sp"
                    android:id="@+id/tvEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffedd5"
                        android:id="@+id/tvMetaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffedd5"
                        android:ellipsize="end"
                        android:id="@+id/tvTaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/plans_text"
                    android:id="@+id/tvBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvThread"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/inputBar"
        android:background="@color/plans_card"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <EditText
            android:textSize="14sp"
            android:id="@+id/etChat"
            android:background="@drawable/bg_plans_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:hint="@string/plans_chat_on_record_hint"
            android:maxLines="4"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:padding="0dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text=""
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/plans_send"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/plans_primary"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_plans_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"/>
    </LinearLayout>
</LinearLayout>
