<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/fl_close"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_glasses_wifi_close"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/glasses_wifi_tip_scan_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ScrollView
            android:id="@+id/sv_desc"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tip">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses_wifi_tip_scan_tip_tile1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses_wifi_tip_scan_tip_desc1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/glasses_wifi_tip_scan_tip_tile2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses_wifi_tip_scan_tip_desc2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/glasses_wifi_tip_scan_tip_tile3"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16dp"
                    android:textColor="#666d80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glasses_wifi_tip_scan_tip_desc3"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="78dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sure"
            android:background="@drawable/shape_ff7300_r999"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_setting"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
