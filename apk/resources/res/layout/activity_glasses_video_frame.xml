<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f4f6f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/status_bar_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/status_bar"/>
    <FrameLayout
        android:id="@+id/fl_close"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_layout">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_film_close"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_export"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="60dp"
        android:text="@string/deviceadmin_baocun"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fl_close"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_frame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_export"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/glasses2_film_frame_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_frame"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="6dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_tip"
        app:layout_constraintStart_toStartOf="@+id/tv_tip"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="212dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:id="@+id/tv_tip2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/glasses2_film_frame_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_frame"
            android:layout_width="0dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_line"
            android:background="@drawable/shape_333333_r999"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tip2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
