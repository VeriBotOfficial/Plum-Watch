<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/device_enter_blank_access_card"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_ff000000"
        android:gravity="center_horizontal"
        android:id="@+id/tv_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35.5dp"
        android:text="适用类型"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_1"
        android:background="@drawable/shape_white_r12_line_eeeeee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17.5dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="17.5dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_1">
        <ImageView
            android:id="@+id/iv_control_card1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="53dp"
            android:layout_marginTop="19.5dp"
            android:layout_marginRight="21dp"
            android:src="@drawable/control_card1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_control_card2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19.5dp"
            android:src="@drawable/control_card2"
            android:layout_marginEnd="72.5dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58.5dp"
            android:layout_marginTop="12.5dp"
            android:layout_marginBottom="14.5dp"
            android:text="普通门禁卡"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_control_card1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.5dp"
            android:layout_marginRight="58.5dp"
            android:layout_marginBottom="14.5dp"
            android:text="异形门禁卡"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_control_card2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_FF666666"
        android:id="@+id/tv_content1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="26.5dp"
        android:text="步骤一：生成空白卡"
        app:layout_constraintTop_toBottomOf="@+id/cl_1"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_FF666666"
        android:id="@+id/tv_content2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:text="手机生成空白卡，此卡片支持录入门禁"
        app:layout_constraintTop_toBottomOf="@+id/tv_content1"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_FF666666"
        android:id="@+id/tv_content3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="21.5dp"
        android:text="步骤二：录入门禁卡"
        app:layout_constraintTop_toBottomOf="@+id/tv_content2"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_FF666666"
        android:id="@+id/tv_content4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:text="前往物业管理员，交给工作人员写入数据"
        app:layout_constraintTop_toBottomOf="@+id/tv_content3"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="169.5dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_content4">
        <Switch
            android:id="@+id/cbOk"
            android:background="@drawable/select_switch_login"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:thumb="@null"
            android:track="@null"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_Tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我已经阅读并同意"
            android:maxLines="1"
            android:paddingStart="10dp"/>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/btn_generate"
        android:background="@drawable/shape_00bbff_r13"
        android:layout_width="match_parent"
        android:layout_height="43.5dp"
        android:layout_marginLeft="82dp"
        android:layout_marginTop="28.5dp"
        android:layout_marginRight="83dp"
        android:text="生成空白卡"
        app:layout_constraintTop_toBottomOf="@+id/ll_select"/>
</androidx.constraintlayout.widget.ConstraintLayout>
