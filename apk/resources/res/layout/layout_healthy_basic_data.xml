<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/shape_white_r14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="14dp"
    android:layout_marginBottom="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tip_21_1129_04"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_fit_arrow"
                android:background="@mipmap/ic_right_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/black"
                    android:id="@+id/tv_kcal_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:text="@string/calorie_text"
                    android:drawableLeft="@drawable/ic_kcal"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_kcal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="--"
                    android:layout_below="@+id/tv_kcal_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_88000000"
                    android:id="@+id/tv_kcal_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="/500千卡"
                    android:layout_below="@+id/tv_kcal_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/black"
                    android:id="@+id/tv_step_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:text="@string/tip_21_0113_2"
                    android:drawableLeft="@drawable/ic_step"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_step_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="--"
                    android:layout_below="@+id/tv_step_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_88000000"
                    android:id="@+id/tv_step_value_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="/4000步"
                    android:layout_below="@+id/tv_step_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/black"
                    android:id="@+id/tv_exercise_time_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:text="@string/user_exercise_duration"
                    android:drawableLeft="@drawable/icon_exercise_time"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="--"
                    android:layout_below="@+id/tv_exercise_time_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_88000000"
                    android:id="@+id/tv_duration_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="/30分钟"
                    android:layout_below="@+id/tv_duration_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/black"
                    android:id="@+id/tv_sport_count_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:text="@string/home_sport_count"
                    android:drawableLeft="@drawable/icon_frequency"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_20"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_sport_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="--"
                    android:layout_below="@+id/tv_sport_count_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_10"
                    android:textColor="@color/color_88000000"
                    android:id="@+id/tv_sport_count_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_4"
                    android:text="/10次"
                    android:layout_below="@+id/tv_sport_count"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
