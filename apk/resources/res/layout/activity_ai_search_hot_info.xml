<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/bk_search_history"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smartRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_history_particular_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srlEnableLoadMore="false"
        app:srlEnableLoadMoreWhenContentNotFull="false"
        app:srlEnableOverScrollDrag="false"
        app:srlEnableRefresh="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/color_0D0D12"
                android:id="@+id/tv_hot_info_text"
                android:background="@drawable/shape_ai_search_line"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_74"
                android:text="@string/ai_search_hot_news_section"
                android:layout_marginHorizontal="@dimen/dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"/>
        </LinearLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_history_particular_search"
        android:background="@color/color_f4f6f8"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_hot_info_search_back"
            android:background="@drawable/ic_history_particular_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_20"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/shape_ffffff_r999_stroke_box2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/sp_14"
                android:gravity="center_vertical"
                android:id="@+id/et_ai_search_edit_text"
                android:background="@null"
                android:paddingBottom="@dimen/dp_25"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_75"
                android:layout_marginLeft="@dimen/dp_19"
                android:layout_marginRight="@dimen/dp_20"
                android:hint="@string/ai_search_text"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="actionSearch"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_ai_search_speech_to_text"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
