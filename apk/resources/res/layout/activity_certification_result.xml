<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:textColor="@color/color_333333"
        android:id="@+id/real_name_certification_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_editor_absoluteX="@dimen/dp_0"
        app:titleText="@string/real_name_authentication_process"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_ffffff_r12"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_248"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/real_name_certification_title_bar">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_cert_result_success"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_60"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:gravity="center"
                    android:background="@drawable/shape_ff7300_r16"
                    android:padding="@dimen/dp_8"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:src="@drawable/ic_cert_right"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:text="@string/real_name_authentication_success_msg"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tv_cert_result_back"
                android:background="@drawable/shape_ff7300_r999"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="返回（3s）"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_cert_result_fail"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_60"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:gravity="center"
                    android:id="@+id/cert_finish"
                    android:background="@drawable/shape_ff5858_r16"
                    android:padding="@dimen/dp_8"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:src="@drawable/ic_cert_result_fail"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:text="@string/real_name_authentication_failure_msg"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_cert_result_exit"
                    android:background="@drawable/shape_e3e3e3_r6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginRight="@dimen/dp_6"
                    android:text="@string/real_name_authentication_exit_action"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_cert_result_retry"
                    android:background="@drawable/shape_ff7300_r6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginLeft="@dimen/dp_6"
                    android:text="@string/real_name_authentication_retry_action"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
