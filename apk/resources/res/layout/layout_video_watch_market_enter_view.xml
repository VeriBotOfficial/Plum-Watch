<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_view_watch_enter"
    android:background="@drawable/bg_shape_000000_r8"
    android:layout_width="wrap_content"
    android:layout_height="45dp"
    android:paddingHorizontal="8dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_watch_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#d7d7d7"
        android:layout_gravity="center"
        android:id="@+id/tv_watch_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_buy"
        android:background="@drawable/shape_gradient_ff4502_ff6c11_left_right"
        android:layout_width="52dp"
        android:layout_height="26dp"
        android:text="@string/energy_buy"
        android:singleLine="true"
        android:layout_marginStart="10dp"/>
</LinearLayout>
