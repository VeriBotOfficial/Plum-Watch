<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_news_back"
            android:contentDescription="@null"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/news_daily_orange"
            android:gravity="center"
            android:id="@+id/btnSubscribe"
            android:background="@drawable/bg_news_btn_subscribe"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="52dp"
            android:text="@string/news_daily_subscribe"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"/>
        <ImageView
            android:id="@+id/btnShare"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_news_share"
            android:contentDescription="@string/news_daily_share"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/headerBlock"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivHeaderCover"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:src="@drawable/ic_news_cover"
                android:scaleType="centerCrop"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:id="@+id/tvFixedTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <FrameLayout
                android:id="@+id/btnHeaderPlay"
                android:background="@drawable/bg_news_play_circle_outline"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivHeaderPlay"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_news_play_orange"
                    android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/news_daily_text_primary"
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnOpenHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="4dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/news_daily_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/news_daily_brief_label"/>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_news_chevron"
                android:contentDescription="@null"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/seekBar"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:maxHeight="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_news_seekbar"
            android:minHeight="4dp"
            android:thumb="@drawable/bg_news_seek_thumb_touch"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/news_daily_text_muted"
                android:id="@+id/tvCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/news_daily_text_muted"
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBlock">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/news_daily_text_secondary"
                android:id="@+id/tvBody"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:paddingHorizontal="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/news_daily_text_primary"
                    android:id="@+id/tvPastTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/news_daily_past_title"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/news_daily_orange"
                    android:id="@+id/btnAll"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/news_daily_all"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPast"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
