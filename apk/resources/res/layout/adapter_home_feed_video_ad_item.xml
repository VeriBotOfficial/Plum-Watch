<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_ad"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_home_feed_video_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/layout_home_feed_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.anythink.nativead.api.ATNativeAdView
            android:id="@+id/view_home_feed_video_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_home_feed_video_ad_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/layout_home_feed_video_ad_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/layout_home_feed_video_ad_icon"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/transparent"
                android:id="@+id/tv_home_feed_video_ad_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_from"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_home_feed_video_ad_icon"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00000000"
                android:id="@+id/tv_home_feed_video_ad_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad from: xxx"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_desc"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00000000"
                android:id="@+id/tv_home_feed_video_ad_desc"
                android:layout_width="58dp"
                android:layout_height="22dp"
                android:text="Sponsored"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_title"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00000000"
                android:id="@+id/tv_home_feed_video_ad_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sponsored"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_domain"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00000000"
                android:id="@+id/tv_home_feed_video_ad_domain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="www.example.com"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/tv_home_feed_video_ad_warning"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00000000"
                android:id="@+id/tv_home_feed_video_ad_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sponsored"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toTopOf="@+id/fl_home_feed_video_logo"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:id="@+id/fl_home_feed_video_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toTopOf="@+id/fl_home_feed_video_logo_container"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:id="@+id/fl_home_feed_video_logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_6"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <ImageView
                    android:gravity="center_vertical"
                    android:id="@+id/iv_home_feed_video_ad_sign"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_15"
                    android:src="@drawable/icon_feed_oversea_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/empty"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <com.anythink.nativead.api.ATNativeImageView
                    android:id="@+id/iv_home_feed_video_ad_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_15"
                    android:contentDescription="@string/empty"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <ImageView
                    android:id="@+id/iv_home_feed_video_ad_sign_baidu"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_14"
                    android:src="@drawable/icon_home_page_feed_video_ad_sign_baidu"
                    android:contentDescription="@string/empty"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <ImageView
                    android:id="@+id/iv_home_feed_video_ad_sign_csj"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_39"
                    android:layout_height="@dimen/dp_14"
                    android:src="@drawable/icon_home_page_feed_video_ad_sign_csj"
                    android:contentDescription="@string/empty"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:visibility="visible"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_margin="6dp"
        android:src="0x7f080536"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
