<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/glasses_my_audio"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_head"
        android:background="@drawable/ic_audio_head"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_marginTop="86dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_calendar"
        app:layout_constraintEnd_toEndOf="@+id/fl_play_state"
        app:layout_constraintStart_toStartOf="@+id/cl_play_info"
        app:layout_constraintTop_toBottomOf="@+id/iv_head"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_calendar"
        android:background="@drawable/ic_item_calendar"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_calendar"
        app:layout_constraintStart_toStartOf="@+id/cl_play_info"
        app:layout_constraintTop_toTopOf="@+id/tv_calendar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_calendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/iv_calendar"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_time"
        android:background="@drawable/ic_item_time"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintStart_toStartOf="@+id/cl_play_info"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_play_info"
        app:layout_constraintStart_toEndOf="@+id/iv_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_calendar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_play_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_marginHorizontal="33dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_play_state">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/play_seek_bar"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_12"
            android:maxHeight="@dimen/dp_2"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_style_ff7300"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/bg_seek_bar_thumb_6"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            app:layout_constraintStart_toStartOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_999999"
            android:id="@+id/play_duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            app:layout_constraintEnd_toEndOf="@+id/play_seek_bar"
            app:layout_constraintTop_toBottomOf="@+id/play_seek_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_play_state"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_audio_state"
            android:background="@drawable/ic_audio_play"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
