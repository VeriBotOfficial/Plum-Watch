<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_ai_loading"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_113"
        android:layout_marginTop="@dimen/dp_28"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_46"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/ai_dial_plate_generating"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="12dp">
            <ProgressBar
                android:id="@+id/ai_progressBar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/layer_list_progress_drawable_3"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/ai_btn_install"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                android:elevation="2dp"/>
        </RelativeLayout>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
