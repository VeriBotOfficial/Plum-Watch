<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/login_bind_phone_modify"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/modify_phone_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginHorizontal="26dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPhone"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/reg_phone_hint"
            android:singleLine="true"
            android:inputType="phone"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etImageCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/tip_21_0901_01"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"/>
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="43dp">
            <ImageView
                android:id="@+id/ivImage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="@color/textBlack"
                android:gravity="end|center_vertical"
                android:id="@+id/tvImgCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="图形验证码"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginHorizontal="@dimen/dp_30">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/login_hint_code"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_F96623"
            android:id="@+id/tvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registered_fasongyanzhengma"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dp_30"/>
    <Button
        android:enabled="false"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/btnNext"
        android:background="@drawable/bg_btn_login_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_30"/>
</androidx.appcompat.widget.LinearLayoutCompat>
