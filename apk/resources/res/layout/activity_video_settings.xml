<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/setting_shezhi"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_play_setting"
            android:layout_marginHorizontal="@dimen/dp_24"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_12">
            <Switch
                android:id="@+id/switch_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toStartOf="@+id/switch_1"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_mute"
                    android:maxLines="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/video_cancel_mute"
                    android:maxLines="1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_history_setting"
            android:layout_marginHorizontal="@dimen/dp_24"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_12">
            <Switch
                android:id="@+id/switch_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/device_notify_switch_thumb"
                android:track="@drawable/device_notify_switch_track"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/video_open_history"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/switch_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
