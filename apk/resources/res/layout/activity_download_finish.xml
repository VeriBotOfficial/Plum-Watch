<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:textColor="@color/color_333333"
        android:id="@+id/save_finish_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/jacket_m_e_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_download_icon"
        android:background="@drawable/ic_download_icon"
        android:layout_width="66.5dp"
        android:layout_height="73.5dp"
        android:layout_marginTop="146dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/save_finish_title_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_file_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_download_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_817F7D"
        android:id="@+id/tv_file_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/jacket_m_s_file_format_"
        app:layout_constraintEnd_toStartOf="@+id/tv_file_style_ex"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/color_817F7D"
        android:id="@+id/tv_file_style_ex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text=" .docx"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_file_style"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_download_save_local"
        android:background="@drawable/ic_download_save_local"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginLeft="73dp"
        android:layout_marginTop="192dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="#999999"
        android:id="@+id/tv_save_local"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="76dp"
        android:layout_marginTop="14dp"
        android:text="@string/jacket_m_e_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/m_download_save_local"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/m_download_send_friend"
        android:background="@drawable/ic_download_send_file"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="192dp"
        android:layout_marginStart="88dp"
        app:layout_constraintStart_toEndOf="@+id/m_download_save_local"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="#999999"
        android:id="@+id/tv_send_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="82dp"
        android:layout_marginTop="14dp"
        android:text="@string/jacket_m_e_share"
        app:layout_constraintStart_toEndOf="@+id/tv_save_local"
        app:layout_constraintTop_toBottomOf="@+id/m_download_send_friend"/>
</androidx.constraintlayout.widget.ConstraintLayout>
