<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/aim_bg_home_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp"
    android:clipToOutline="true">
    <com.wakeup.feature.aimusic.widget.SquareFrameLayout
        android:id="@+id/coverBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/coverPlaceholder"
            android:background="@drawable/aim_grad_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ivCover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:background="@drawable/aim_bg_play_overlay"
            android:padding="7dp"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="8dp"
            android:src="@drawable/aim_ic_play"/>
    </com.wakeup.feature.aimusic.widget.SquareFrameLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="9dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#bbbbbb"
        android:ellipsize="end"
        android:id="@+id/tvGenre"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="9dp"/>
</LinearLayout>
