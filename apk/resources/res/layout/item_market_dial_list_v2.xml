<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@drawable/bg_dial_card_v2"
    android:paddingTop="@dimen/dp_6"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_2"
    android:foreground="?android:attr/selectableItemBackground"
    android:elevation="2dp"
    android:paddingHorizontal="@dimen/dp_0">
    <com.wakeup.commonui.view.SquareImageView
        android:id="@+id/iv_image"
        android:background="@drawable/bg_dial_thumb_placeholder_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_282828"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:maxLines="2"
        android:minLines="2"
        android:lineSpacingMultiplier="1.05"
        android:fontFamily="sans-serif-medium"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:minHeight="@dimen/dp_20"
        android:paddingHorizontal="@dimen/dp_3"
        android:paddingVertical="@dimen/dp_2">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bonus"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_2"
            app:srcCompat="@drawable/ic_exchange_bonus"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/color_fff76814"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
