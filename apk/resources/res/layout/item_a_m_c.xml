<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginHorizontal="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_generate_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_create"
            android:background="@drawable/ic_a_m_create"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/iv_play_animation"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_create"
            app:layout_constraintStart_toEndOf="@+id/iv_create"
            app:layout_constraintTop_toTopOf="@+id/iv_create"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_9a9a9a"
            android:id="@+id/tv_generate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_a_m_generating"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_create"
            app:layout_constraintStart_toEndOf="@+id/iv_play_animation"
            app:layout_constraintTop_toTopOf="@+id/iv_create"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
