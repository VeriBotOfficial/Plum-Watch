<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rlTop"
    android:background="@drawable/shape_white_r12_line_eaeaea"
    android:paddingBottom="17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivAvatar"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:shapeAppearanceOverlay="@style/circleImageStyle"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/textGray"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvFriendTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivEditNicName"
            android:padding="7dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_edit"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/tvAgo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_below="@+id/ll1"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/tvAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="--"
        android:layout_below="@+id/tvAgo"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tvRemind"
        android:background="@drawable/shape_bule_24"
        android:padding="8dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textColor="@color/red"
        android:id="@+id/tvOnlineHint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/tvAddress"/>
</RelativeLayout>
