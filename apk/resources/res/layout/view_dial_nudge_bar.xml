<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_dial_nudge_root"
    android:background="@drawable/bg_dial_nudge_bar"
    android:paddingTop="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_15"
    android:paddingEnd="@dimen/dp_15">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_dial_nudge_dial"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/chamfer10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_dial_nudge_tx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_6">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:ellipsize="end"
            android:id="@+id/tv_dial_nudge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_dial_nudge_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6">
            <TextView
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:textColor="#f5320d"
                android:ellipsize="end"
                android:id="@+id/tv_dial_nudge_cut"
                android:background="@drawable/bg_dial_nudge_cut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="96dp"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/dp_6"
                android:paddingHorizontal="@dimen/dp_5"
                android:paddingVertical="@dimen/dp_2"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="#1a1a1a"
                android:ellipsize="end"
                android:id="@+id/tv_dial_nudge_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_dial_nudge_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:paddingHorizontal="@dimen/dp_2">
        <ImageView
            android:id="@+id/iv_dial_nudge_clock"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_dial_nudge_clock"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:ellipsize="end"
            android:id="@+id/tv_dial_nudge_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_dial_nudge_action"
        android:background="@drawable/bg_dial_nudge_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:text="@string/dial_nudge_pay_now"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_6"
        android:paddingHorizontal="@dimen/dp_14"
        android:paddingVertical="@dimen/dp_10"/>
</LinearLayout>
