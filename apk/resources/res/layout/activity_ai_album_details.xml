<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#081431"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/ai_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backImage="@drawable/ic_back_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleColor="@color/white"
        app:titleText="@string/ai_album_title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/ai_details_cv"
                android:layout_width="match_parent"
                android:layout_height="530dp"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_38"
                android:layout_marginEnd="@dimen/dp_38"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ai_album_details_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="#442f99"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_22"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_22"
                android:text="@string/ai_album_des"
                android:layout_marginStart="@dimen/dp_12"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/white"
                android:id="@+id/ai_album_details_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_12"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/ai_album_create"
        android:background="@drawable/shape_7644ff_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_margin="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/ai_album_setting"/>
</androidx.appcompat.widget.LinearLayoutCompat>
