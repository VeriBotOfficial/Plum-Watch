<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_20"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:text="@string/string_met_week_goal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_25"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/color_333333"
                android:id="@+id/met_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="#4a4a4a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MET-min"
                android:layout_marginStart="@dimen/dp_5"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <SeekBar
            android:id="@+id/seek_bar"
            android:padding="@dimen/dp_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_25"
            android:maxHeight="@dimen/dp_10"
            android:max="100"
            android:progress="20"
            android:progressDrawable="@drawable/drawable_seekbar_write_r14"
            android:thumb="@drawable/bg_seek_bar_thumb_ff7322"
            android:thumbOffset="@dimen/dp_0"
            android:splitTrack="false"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp_25"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/textBlack"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_cancel"
                android:layout_weight="1"/>
            <View
                android:id="@+id/space"
                android:layout_width="16dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:background="@drawable/shape_ff7300_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
