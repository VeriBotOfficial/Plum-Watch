<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivImmersiveBlur"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentColumn"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:id="@+id/coverBox"
            android:background="@drawable/aim_bg_cover_rounded"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46">
            <FrameLayout
                android:id="@+id/coverPlaceholder"
                android:background="@drawable/aim_grad_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/aim_ic_music_note"/>
            </FrameLayout>
            <com.wakeup.feature.aimusic.ui.widget.SoftEdgeImageView
                android:id="@+id/ivCover"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:layout_gravity="top"
                android:id="@+id/coverFadeTop"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/coverFadeBottom"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <com.wakeup.commonui.ad.ScenarioBannerView
                android:layout_gravity="bottom"
                android:id="@+id/viewScenarioBanner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bannerCornerRadius="0dp"
                app:cardElevation="0dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lyricsMini"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="46dp"
            android:paddingVertical="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llMusicLyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_text"
                    android:ellipsize="end"
                    android:id="@+id/tvLyricLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/aim_text_muted"
                    android:ellipsize="end"
                    android:id="@+id/tvLyricLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/llAsmrScript"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#c7ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tvAsmrScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginEnd="58dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#8cffffff"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/tvAsmrExpand"
                    android:background="@drawable/aim_bg_asmr_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aim_asmr_expand"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/infoBlock"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_text"
                    android:ellipsize="end"
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_accent"
                    android:ellipsize="end"
                    android:id="@+id/tvGenre"
                    android:background="@drawable/aim_bg_genre_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="96dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="0"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"/>
                <ImageView
                    android:id="@+id/btnLike"
                    android:padding="4dp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/aim_ic_heart_outline"
                    android:layout_weight="0"
                    android:contentDescription="@string/aim_like"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/btnArtist"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingVertical="4dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_text_secondary"
                    android:ellipsize="end"
                    android:id="@+id/tvArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/aim_text_muted"
                    android:id="@+id/tvArtistChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ctrlBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <SeekBar
                android:id="@+id/seekBar"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:maxHeight="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/aim_seek_progress"
                android:minHeight="3dp"
                android:thumb="@drawable/aim_seek_thumb"
                android:thumbOffset="0dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:splitTrack="false"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/aim_text_muted"
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:layout_weight="1"
                    android:fontFamily="monospace"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/aim_text_muted"
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/btnMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ivMode"
                            android:background="@drawable/aim_bg_ctrl_circle"
                            android:padding="12dp"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/aim_ic_mode_order"/>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/llModeTimer"
                            android:background="@drawable/aim_bg_ctrl_circle"
                            android:visibility="gone"
                            android:layout_width="46dp"
                            android:layout_height="46dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/aim_ic_sleep_timer_mini"/>
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#e0ffffff"
                                android:id="@+id/tvModeTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>
                    </FrameLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/aim_text_muted"
                        android:id="@+id/tvModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/aim_play_mode"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.2">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/btnPlayPause"
                        android:background="@drawable/aim_bg_white_circle"
                        android:padding="18dp"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/aim_ic_play_dark"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/btnList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@drawable/aim_bg_ctrl_circle"
                            android:padding="12dp"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/aim_ic_list"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/aim_text_muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/aim_list"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lyricsFull"
        android:background="@color/aim_feed_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:paddingTop="48dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btnLyricsClose"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/aim_ic_back"
                android:layout_marginStart="12dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/aim_text"
                    android:ellipsize="end"
                    android:id="@+id/tvLyricsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/aim_text_muted"
                    android:ellipsize="end"
                    android:id="@+id/tvLyricsArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingHorizontal="24dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/aim_text_muted"
                android:layout_gravity="center"
                android:id="@+id/tvNoLyrics"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aim_no_lyrics"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
