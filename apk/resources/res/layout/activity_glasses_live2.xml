<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/surface_view_card"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextureView
                android:layout_gravity="center_vertical"
                android:id="@+id/rtsp_view"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:shapeAppearanceOverlay="@style/chamfer10dp"/>
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_battery_new"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phancy_glasses_live_tips4"
                android:layout_marginHorizontal="24dp"/>
        </FrameLayout>
        <View
            android:id="@+id/live_gradient_bottom_bg"
            android:background="@drawable/shape_glass_live_gradient_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_glass_camera_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="64dp"
            android:layout_marginBottom="148dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_glass"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_glass"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/txt_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="150dp"
                android:text="@string/phancy_glasses_video"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_phone_camera_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="148dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_phone_camera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_phone_camera_disable"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_99ffffff"
                android:ellipsize="end"
                android:id="@+id/txt_phone_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="150dp"
                android:text="@string/phancy_glasses_phone_front_camera"
                android:maxLines="1"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/sp_16"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/btn_start_live"
            android:background="@drawable/shape_ff7300_r999"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="58dp"
            android:text="@string/phancy_glasses_start_live"
            android:lines="1"
            android:layout_marginHorizontal="24dp"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <LinearLayout
            android:id="@+id/layout_guide"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textColor="@color/color_eeeeee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phancy_glasses_live_tips2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_r"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/statusBar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_bar"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/back_img"
                    android:padding="14dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_back_white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ble_grey"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/tv_name"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="150dp"
                    android:text=""
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_bar_live"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="150dp"
                    android:text=""
                    android:maxLines="1"
                    android:layout_marginStart="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_battery"
                    android:layout_width="33dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_phancy_device_battery_100"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_video_disconnect"
                    app:layout_constraintStart_toEndOf="@+id/iv_video_disconnect"
                    app:layout_constraintTop_toTopOf="@+id/iv_video_disconnect"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_video_disconnect"
                    android:layout_width="10dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/ic_bluetooth_white"
                    app:layout_constraintStart_toStartOf="@+id/tv_name1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/right_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/ic_living_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:maxWidth="140dp"
                        android:layout_marginEnd="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/shape_glass_live_red_dot"
                            android:scaleType="center"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/phancy_glasses_living"
                            android:lines="1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/img_finish_live"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ic_stop_class_live"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
