<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.wakeup.commonui.MyTitleBar
            android:id="@+id/view_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/sleep_debug_title"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textSize="16dp"
            android:textColor="@color/black"
            android:id="@+id/switch_mock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sleep_debug_mock_connect"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sleep_debug_capacity"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3"
            android:hint="total 总槽位"
            android:inputType="number"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_cur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:hint="cur 已用槽位"
            android:inputType="number"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_single_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="240000"
            android:hint="singleSize 单文件字节上限"
            android:inputType="number"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="设备已存文件名（逗号分隔）"
            android:inputType="text"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sleep_debug_send_info"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sleep_debug_info_behavior"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rb_info_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="成功"/>
            <RadioButton
                android:id="@+id/rb_info_timeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="超时"
                android:layout_marginStart="12dp"/>
            <RadioButton
                android:id="@+id/rb_info_fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="失败"
                android:layout_marginStart="12dp"/>
        </RadioGroup>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sleep_debug_send_behavior"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rb_send_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="成功"/>
            <RadioButton
                android:id="@+id/rb_send_fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="失败"
                android:layout_marginStart="12dp"/>
            <RadioButton
                android:id="@+id/rb_send_stuck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卡进度"
                android:layout_marginStart="12dp"/>
            <RadioButton
                android:id="@+id/rb_send_slow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="慢速"
                android:layout_marginStart="12dp"/>
        </RadioGroup>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_fail_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="501"
            android:hint="失败错误码 (500~504)"
            android:inputType="number"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_open_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sleep_debug_open_editor"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_open_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sleep_debug_open_local"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
