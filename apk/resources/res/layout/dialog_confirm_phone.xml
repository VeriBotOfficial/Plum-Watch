<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_r012"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:elevation="2dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/textBlack"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_20"
            android:text="@string/tip_21_0520_08"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:id="@+id/tv_tips2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/login_bind_phone_confirm_tips"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_pair"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_55"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_20">
            <Button
                android:textSize="@dimen/sp_14"
                android:id="@+id/bt_cancel"
                android:background="@drawable/shape_grey_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dialog_quxiao"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_6"/>
            <Button
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:id="@+id/bt_confirm"
                android:background="@drawable/shape_orange_r6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_21_0520_08"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"
                android:layout_marginStart="@dimen/dp_6"/>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
