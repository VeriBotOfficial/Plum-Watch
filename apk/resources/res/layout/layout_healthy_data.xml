<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ll_basic_data"
        android:background="@drawable/shape_white_r14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="8dp"
        layout="@layout/layout_healthy_basic_data"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="14dp">
        <RelativeLayout
            android:id="@+id/rl_heart_rate"
            android:background="@drawable/shape_white_r16"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tv_heart_rate_title"
                android:background="@drawable/ic_heart_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="6dp"
                android:text="@string/home_xinlv"
                android:layout_toRightOf="@+id/tv_heart_rate_title"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@mipmap/ic_right_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_alignParentRight="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_heart_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/gray"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_20"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_heart_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-4dp"
                android:text="--"
                android:layout_alignParentBottom="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/black"
                android:id="@+id/tv_heart_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/heart_unit"
                android:layout_toRightOf="@+id/tv_heart_value"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_healthy_more_data"
            android:background="@drawable/shape_white_r16"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tv_heart_rate_more_title"
                android:background="@drawable/ic_heart_rate_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="6dp"
                android:text="@string/more_data_str"
                android:layout_toRightOf="@+id/tv_heart_rate_more_title"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@mipmap/ic_right_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_alignParentRight="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_99000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/more_data_str2"
                android:layout_below="@+id/tv_heart_rate_more_title"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
