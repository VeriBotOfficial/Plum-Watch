<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/health_function_container"
    android:background="@drawable/shape_ffffff_r12"
    android:paddingTop="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_24">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fl_steps_rank_entry"
        android:paddingBottom="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_steps_rank_icon"
            android:layout_width="@dimen/dp_14"
            android:layout_height="@dimen/dp_14"
            android:src="@mipmap/rank_icon"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="#f76814"
            android:id="@+id/tv_steps_rank_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/steps_rank_today_default"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp_4"/>
        <ImageView
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:src="@drawable/ic_headphone_arrow_right"
            android:tint="#f76814"
            android:layout_marginStart="@dimen/dp_2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps_rank_entry">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon_calorie"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/icon_device_equipment_defult"
                android:layout_marginEnd="@dimen/dp_2"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:id="@+id/title_calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_120"
                android:text="@string/calorie_text"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="@color/color_000000"
            android:ellipsize="end"
            android:id="@+id/calorie_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="0"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:id="@+id/calorie_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/title_homapage_device_calorie_unit"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_exercise_duration"
        app:layout_constraintStart_toEndOf="@+id/layout_calorie"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps_rank_entry">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon_steps"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/icon_device_equipment_defult"
                android:layout_marginEnd="@dimen/dp_2"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:id="@+id/title_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_120"
                android:text="@string/sub_view_steps_title"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="@color/color_000000"
            android:ellipsize="end"
            android:id="@+id/steps_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="0"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:id="@+id/steps_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/title_homapage_device_steps_unit"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_exercise_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/divider_health_insight"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps_rank_entry">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon_exercise_duration"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/icon_device_equipment_defult"
                android:layout_marginEnd="@dimen/dp_2"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:id="@+id/title_exercise_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_120"
                android:text="@string/sport_yundongshichang"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="@color/color_000000"
            android:ellipsize="end"
            android:id="@+id/exercise_duration_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="0"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:id="@+id/exercise_duration_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/title_homapage_device_exercise_duration_unit"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_health_insight"
        android:background="@color/color_f1f3f5"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_health_insight"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps_rank_entry"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_health_insight"
        android:background="@drawable/shape_eef0ff_r12"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_steps_rank_entry">
        <ImageView
            android:id="@+id/icon_health_insight"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_health_insight_brain"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="#6c63ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@string/health_insight_title"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
