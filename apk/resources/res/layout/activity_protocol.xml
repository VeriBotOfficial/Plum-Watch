<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/protocol_xieyiyutiaokuan"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tv_user"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/protocol_yonghuxieyi"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvPrivacy"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/protocol_yinsizhengce"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:id="@+id/lineAuthenProtocal"
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvAuthenProtocal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/real_name_authentication_service_agreement"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:id="@+id/line1"
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvVideoProtocal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/publish_video_video_protocal_tips2"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:id="@+id/line2"
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvPaidVideoProtocal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/collection_short_drama_payment_service_agreement"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvSdkProtocal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/string_protocol_1"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/textBlack"
        android:gravity="center_vertical"
        android:id="@+id/tvInfoProtocal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/string_protocol_2"
        android:paddingHorizontal="20dp"
        app:drawableRightCompat="@drawable/ic_jiantou_right"/>
</LinearLayout>
