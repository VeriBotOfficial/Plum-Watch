<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/log_collection"/>
    <com.wakeup.commonui.progress.CircleProgressBar
        android:layout_gravity="center"
        android:id="@+id/circleProgress"
        android:layout_width="@dimen/dp_106"
        android:layout_height="@dimen/dp_106"
        android:layout_marginTop="@dimen/dp_64"
        android:layout_centerInParent="true"
        app:circleBgColor="@color/white"
        app:circleProgressAColor="@color/color_fa9632"
        app:circleProgressBColor="@color/transp"
        app:circleWidth="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"
        app:openAngle="0"
        app:showSmallPoint="false"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_fail"
        android:background="@drawable/ic_log_collection_fail"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:layout_constraintBottom_toBottomOf="@+id/circleProgress"
        app:layout_constraintEnd_toEndOf="@+id/circleProgress"
        app:layout_constraintStart_toStartOf="@+id/circleProgress"
        app:layout_constraintTop_toTopOf="@+id/circleProgress"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_progress_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        app:layout_constraintBottom_toBottomOf="@+id/circleProgress"
        app:layout_constraintEnd_toEndOf="@+id/circleProgress"
        app:layout_constraintStart_toStartOf="@+id/circleProgress"
        app:layout_constraintTop_toTopOf="@+id/circleProgress"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_64"
        android:text="@string/log_collection_in_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circleProgress"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_666666"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/log_collection_description"
        android:layout_marginHorizontal="@dimen/dp_26"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_recollection"
        android:background="@drawable/shape_ff7300_r6"
        android:visibility="gone"
        android:layout_width="@dimen/dp_140"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_46"
        android:text="@string/log_collection_recollect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint"/>
    <TextView
        android:textColor="@color/color_ff7300"
        android:id="@+id/tv_skip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_28"
        android:text="@string/direct_feedback_questions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_recollection"/>
</androidx.constraintlayout.widget.ConstraintLayout>
