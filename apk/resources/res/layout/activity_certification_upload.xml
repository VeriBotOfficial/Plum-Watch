<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/ic_real_name_cert_background"
        android:layout_width="match_parent"
        android:layout_height="525dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wakeup.commonui.MyTitleBar
        android:textColor="@color/color_333333"
        android:id="@+id/real_name_certification_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_editor_absoluteX="@dimen/dp_0"
        app:titleText="@string/real_name_authentication_process"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ly_flow_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/real_name_certification_title_bar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-15dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/cert_finish"
                android:background="@drawable/shape_ff7300_r16"
                android:padding="@dimen/dp_8"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_34"
                android:src="@drawable/ic_cert_right"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/real_name_authentication_fill_identity_info_step"/>
        </LinearLayout>
        <View
            android:background="@drawable/shape_dotted_line"
            android:layout_width="@dimen/dp_119"
            android:layout_height="5dp"
            android:layout_marginBottom="@dimen/dp_10"
            android:layerType="software"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-15dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/shape_ff7300_r16"
                android:layout_width="@dimen/dp_34"
                android:layout_height="@dimen/dp_34"
                android:text="2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/real_name_authentication_upload_id_card_image_action"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_ffffff_r12"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/ly_flow_chart">
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_666666"
                    android:id="@+id/tv_upload_pic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_6"
                    android:text="@string/real_name_authentication_upload_id_card_photo_request"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_passport_cert_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cll_select_passport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_passport_img"
                            android:layout_width="@dimen/dp_222"
                            android:layout_height="@dimen/dp_139"
                            android:src="@drawable/ic_cert_passport"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_shot_cert_photo"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_ff7300"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:text="@string/real_name_authentication_upload_passport_front_page_action"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_id_card_cert_content"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:background="@drawable/ic_cert_describe"
                            android:layout_width="@dimen/dp_16"
                            android:layout_height="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_3"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_666666"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/real_name_authentication_ensure_id_card_validity_check"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_22">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cll_select_id_card_front"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_id_card_front"
                                android:layout_width="@dimen/dp_222"
                                android:layout_height="@dimen/dp_139"
                                android:src="@drawable/ic_cert_id_card_front"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_shot_cert_photo"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_ff7300"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:text="@string/real_name_authentication_upload_id_card_front_side_action"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_22">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cll_select_id_card_back"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_id_card_back"
                                android:layout_width="@dimen/dp_222"
                                android:layout_height="@dimen/dp_139"
                                android:src="@drawable/ic_cert_id_card_back"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_shot_cert_photo"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_ff7300"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:text="@string/real_name_authentication_upload_id_card_back_side_action"/>
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:enabled="false"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_id_card_cert_summit"
                    android:background="@drawable/select_btn_switch_ffd9b9_ff7300_r6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_30"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginBottom="@dimen/dp_6"
                    android:text="@string/real_name_authentication_next_step_action"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
