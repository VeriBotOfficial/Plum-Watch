<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:textColor="@color/color_333333"
        android:id="@+id/report_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/report_creator"/>
    <ExpandableListView
        android:id="@+id/expandableListView"
        android:background="@drawable/shape_ffffff_r12"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_30"
        android:groupIndicator="@null"
        android:divider="@null"
        app:layout_constraintBottom_toTopOf="@+id/report_summit"
        app:layout_constraintTop_toBottomOf="@+id/report_title_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_report"
        android:background="@drawable/shape_ffffff_r12"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_30"
        android:groupIndicator="@null"
        android:divider="@null"
        app:layout_constraintBottom_toTopOf="@+id/report_summit"
        app:layout_constraintTop_toBottomOf="@+id/report_title_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/report_summit"
        android:background="@drawable/shape_ffffd9b9_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_50"
        android:text="@string/material_report_submit_action"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
