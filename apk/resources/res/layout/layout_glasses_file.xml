<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_file_imp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/shape_white_r8"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_album_file"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="17dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_file_impl_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_file_impl_start"
            android:background="@drawable/shape_ff7300_r999"
            android:visibility="visible"
            android:layout_width="78dp"
            android:layout_height="28dp"
            android:text="@string/glasses_import"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"/>
        <FrameLayout
            android:id="@+id/fl_file_impl_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/pb_file_impl_progress"
                android:layout_width="78dp"
                android:layout_height="28dp"
                android:max="100"
                android:progressDrawable="@drawable/layer_list_progress_drawable"
                android:layout_centerInParent="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_file_impl_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
