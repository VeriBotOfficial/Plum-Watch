<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/tabLayout"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingTop="0dp"
            app:tabRippleColor="@color/colorTransparent"
            app:tabSelectedTextColor="@color/color_ec7445"
            app:tabTextColor="@color/text_black"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/iv_ai_person"
            android:layout_centerHorizontal="true"
            android:alpha="0"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_wc_bubble"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_2"
            android:layout_above="@+id/iv_ai_person"
            android:layout_centerHorizontal="true"
            android:alpha="0">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_wc_bubble_text"
                android:background="@drawable/bg_wc_bubble_filled"
                android:paddingTop="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/benefits_worldcup_bubble_tip"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:elevation="2dp"
                android:letterSpacing="0.04"/>
            <View
                android:background="@drawable/bg_wc_bubble_tail"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_marginTop="-7dp"
                android:rotation="45"
                android:elevation="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_mine_v2_bubble"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:alpha="0"
            android:layout_alignParentEnd="true"
            android:elevation="4dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13sp"
                android:textColor="#ffffffff"
                android:ellipsize="none"
                android:gravity="center"
                android:id="@+id/tv_mine_v2_bubble_text"
                android:background="@drawable/bg_mine_v2_tab_bubble"
                android:paddingTop="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_v2_tab_bubble_tip"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"/>
            <View
                android:id="@+id/v_mine_v2_bubble_tail"
                android:background="@drawable/bg_mine_v2_tab_bubble_tail"
                android:layout_width="12dp"
                android:layout_height="6dp"
                android:layout_marginTop="-1dp"/>
        </LinearLayout>
        <com.wakeup.commonui.view.NovelReadGuidePopView
            android:id="@+id/novel_pop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:layout_above="@+id/iv_ai_person"
            android:alpha="0"/>
        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/iv_ai_person"
            android:visibility="gone"
            android:layout_width="@dimen/dp_65"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_5"
            android:src="@drawable/ic_ai_agent_new"
            android:scaleType="fitCenter"
            android:layout_alignBottom="@+id/tabLayout"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fl_rn_fragment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.wakeup.howear.view.newui.view.TransparentHoleView
        android:id="@+id/hole_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
