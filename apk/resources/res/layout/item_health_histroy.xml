<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginStart="20dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_line_broken"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/icon_dot_blue"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"/>
        <RelativeLayout
            android:orientation="vertical"
            android:background="@drawable/shape_white_r10"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvWarningInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="心率    120次/分钟"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="已通知你的家人"
                    android:layout_below="@+id/tvWarningInfo"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/red"
                android:id="@+id/tvWarningType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="过高"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
