<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="215dp"
    android:layout_marginVertical="@dimen/dp_12">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bg_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_course_top_bg"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_36"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="0"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration_desc"/>
    <androidx.cardview.widget.CardView
        android:layout_width="4dp"
        android:layout_height="@dimen/dp_15"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/color_ff7300"
        app:cardCornerRadius="@dimen/dp_3"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/duration_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/course_desc_1"
        android:layout_marginStart="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:layout_width="4dp"
        android:layout_height="@dimen/dp_15"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/color_4C4752"
        app:cardCornerRadius="@dimen/dp_3"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/desc_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxWidth="@dimen/dp_150"
        android:text="@string/today_duration_title"
        android:maxLines="1"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_20"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/today_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:text="0"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc_1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/desc_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/consume"
        android:layout_marginStart="@dimen/dp_29"
        app:layout_constraintStart_toEndOf="@+id/desc_1"
        app:layout_constraintTop_toBottomOf="@+id/duration"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_20"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/today_calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="0"
        app:layout_constraintStart_toStartOf="@+id/desc_3"
        app:layout_constraintTop_toBottomOf="@+id/desc_3"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_20"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:cardBackgroundColor="@color/color_4C4752"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/total_course"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/tip_21_0426_11"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
