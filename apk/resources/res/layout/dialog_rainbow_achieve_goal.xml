<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close"
        android:padding="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:src="@drawable/ic_close_white"
        android:layout_marginEnd="@dimen/dp_35"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        app:layout_constraintTop_toBottomOf="@+id/close">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/rainbow_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.wakeup.commonui.view.RainbowRingView
                android:id="@+id/rainbow_view"
                android:layout_width="@dimen/dp_280"
                android:layout_height="@dimen/dp_280"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:viewSize="max"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/target_duration_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-110dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rainbow_view"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/target_kcal_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/target_duration_desc"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/target_active_time_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/target_kcal_desc"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:text="@string/rainbow_achieve_desc_1"
                android:paddingHorizontal="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/target_active_time_desc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/rainbow_step_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_18"
                android:textColor="@color/white"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rainbow_achieve_desc_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/content_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_36"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10000"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/white"
                    android:layout_gravity="bottom"
                    android:id="@+id/content_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_3"
                    android:text="@string/ke_21_8_18_10"
                    android:layout_marginStart="@dimen/dp_5"
                    app:layout_constraintBottom_toBottomOf="@+id/content"
                    app:layout_constraintStart_toEndOf="@+id/content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_play_animation"
                android:layout_width="@dimen/dp_250"
                android:layout_height="@dimen/dp_250"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content_ll"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/goal_complete_anim"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_135"
                android:src="@drawable/ic_step_goal_reach_icon"
                app:layout_constraintBottom_toBottomOf="@+id/iv_play_animation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_play_animation"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rainbow_achieve_desc_3"
                android:paddingHorizontal="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_play_animation"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/save"
        android:background="@drawable/shape_33ffffff_r6"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_50"
        android:text="@string/tip_21_1204_03"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
