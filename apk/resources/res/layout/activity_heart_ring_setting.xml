<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/color_f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/rs_m_setting"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/heart_ring_setting_cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/heart_setting_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/rs_m_time_interval"
                android:layout_marginStart="@dimen/dp_13"
                app:layout_constraintEnd_toStartOf="@+id/heart_setting_state_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:gravity="end"
                android:id="@+id/heart_setting_state_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_3"
                android:minWidth="@dimen/dp_42"
                android:text="@string/rs_m_setting_no"
                android:layout_marginEnd="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/heart_setting_title"
                app:layout_constraintEnd_toStartOf="@+id/heart_setting_more"
                app:layout_constraintTop_toTopOf="@+id/heart_setting_title"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heart_setting_more"
                android:background="@drawable/ic_arrowgrey_right"
                android:layout_width="10dp"
                android:layout_height="15dp"
                android:layout_marginEnd="@dimen/dp_13"
                app:layout_constraintBottom_toBottomOf="@+id/heart_setting_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/heart_setting_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_666666"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_20"
                android:text="@string/rs_m_setting_des"
                android:layout_marginEnd="@dimen/dp_13"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/heart_setting_title"
                app:layout_constraintTop_toBottomOf="@+id/heart_setting_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.appcompat.widget.LinearLayoutCompat>
