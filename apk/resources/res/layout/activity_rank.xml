<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/parallax"
        android:layout_width="match_parent"
        android:layout_height="670dp"
        android:layout_marginTop="-300dp"
        android:src="@drawable/image_default_avatar"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="Wearfit"
        app:layout_collapseMode="parallax"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smartRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        app:srlEnablePreviewInEditMode="false">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentScrim="?attr/colorPrimary"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll"
                    app:titleEnabled="false">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/rlTop"
                            android:layout_width="match_parent"
                            android:layout_height="300dp">
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:id="@+id/tvCoverName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/dp_10"
                                android:maxLines="1"
                                android:shadowColor="@color/color_80000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="10"
                                android:layout_marginStart="@dimen/dp_50"
                                app:layout_constraintBottom_toTopOf="@+id/tv2"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivCoverAvatar"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/image_default_avatar"
                                android:scaleType="centerCrop"
                                android:layout_marginEnd="@dimen/dp_15"
                                app:layout_constraintBottom_toBottomOf="@+id/tvCoverName"
                                app:layout_constraintEnd_toStartOf="@+id/tvCoverName"
                                app:layout_constraintTop_toTopOf="@+id/tvCoverName"
                                app:shapeAppearanceOverlay="@style/circleStyle"/>
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/tv2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/dp_20"
                                android:text="@string/rank_zhanlinglefengmian"
                                android:shadowColor="@color/color_80000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="10"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:contentDescription="我的锻炼数据"
                            android:paddingStart="20dp">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/textGray"
                                android:id="@+id/tv_rank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"/>
                            <RelativeLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/image_default_avatar"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/circleStyle"/>
                                <ImageView
                                    android:id="@+id/iv_vip"
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:src="@drawable/icon_isvip_show"
                                    android:layout_alignParentBottom="true"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/textBlack"
                                    android:ellipsize="end"
                                    android:id="@+id/tvName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"/>
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/iv_country"
                                    android:visibility="gone"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_marginTop="4dp"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearance="@style/circleStyle"
                                    app:strokeColor="@color/transp"
                                    app:strokeWidth="0dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_00bbff"
                                android:id="@+id/tv_stepCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:id="@+id/ll_like"
                                android:paddingLeft="20dp"
                                android:paddingRight="20dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/textGray"
                                    android:id="@+id/tv_like"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <ImageView
                                    android:id="@+id/iv_like"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <View
                    android:background="@color/bg"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/flToolBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_65">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/toolbar"
            android:paddingTop="@dimen/dp_25"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_1228_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/btnShare"
                android:padding="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_share_gray_black"
                android:layout_marginEnd="@dimen/dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/btnBack"
            android:padding="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_25"
            android:src="@drawable/ic_back_black"/>
    </FrameLayout>
</FrameLayout>
