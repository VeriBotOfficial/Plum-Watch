<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miniRoot"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/miniPill"
        android:background="@drawable/aim_bg_mini_pill_r"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingVertical="6dp">
        <FrameLayout
            android:id="@+id/miniBall"
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/miniCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/aim_grad_a"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/miniState"
                android:background="@drawable/aim_bg_mini_scrim"
                android:padding="5dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/aim_ic_pause"
                android:contentDescription="@string/aim_mini_open"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/miniClose"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/aim_ic_mini_close_dark"
            android:contentDescription="@string/aim_mini_close"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</FrameLayout>
