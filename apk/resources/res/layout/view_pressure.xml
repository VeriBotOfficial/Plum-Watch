<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_data"
        android:background="@drawable/bg_white_8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_pressure"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_pressure_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:id="@+id/gradient_line"
            android:background="@drawable/gradient_sport_record"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_11"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_value_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="left"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_weight="1"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:layout_weight="1"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:layout_weight="1"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="75"
                    android:layout_weight="1"/>
                <TextView
                    android:gravity="right"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="99"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:id="@+id/cursor_line"
                android:background="#71da00"
                android:layout_width="@dimen/dp_2"
                android:layout_height="@dimen/dp_15"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginEnd="@dimen/dp_16"/>
            <View
                android:id="@+id/cursor_dot"
                android:background="#71da00"
                android:visibility="gone"
                android:layout_width="@dimen/dp_4"
                android:layout_height="@dimen/dp_4"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_below="@+id/cursor_line"
                android:layout_centerHorizontal="true"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            android:layout_marginStart="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_step_number_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <Button
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_fff05800"
                android:id="@+id/edit"
                android:background="@drawable/button_background_lianghao"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dp_60"
                android:minHeight="@dimen/dp_24"
                android:text="@string/pressure_value_1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/iv_empty"
        android:background="@drawable/bg_white_8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_138"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:background="@drawable/ic_home_pressure"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_view_pressure_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:background="@drawable/gradient_sport_record_empty"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_11"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="25"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="50"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="75"
                android:layout_weight="1"/>
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="99"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            android:layout_marginStart="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/none_data"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_add"
        android:background="@drawable/ic_home_increase"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_del"
        android:background="@drawable/ic_home_reduce"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"/>
</FrameLayout>
