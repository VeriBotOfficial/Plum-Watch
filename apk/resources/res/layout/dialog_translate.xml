<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_22">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_translate_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_6"
        android:text="@string/language_translate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_4F4E4D"
        android:id="@+id/tv_choose_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/jacket_m_s_language"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_translate_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_333333"
        android:gravity="center_vertical"
        android:id="@+id/btn_translate_list"
        android:background="@drawable/translate_background"
        android:paddingLeft="@dimen/dp_9"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/string_no_trans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_choose_language"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/show_trans_lan"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_translate_list">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_4F4E4D"
            android:id="@+id/tv_cotent_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/jacket_m_lan_show"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_translate_list"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radioGroup"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cotent_show">
            <RadioButton
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ff000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/rb_all_lan_show"
                android:background="@drawable/select_check_box"
                android:layout_width="@dimen/dp_88"
                android:layout_height="match_parent"
                android:button="@null"
                android:text="@string/jacket_m_d_language"
                android:maxLines="2"/>
            <RadioButton
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ff000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/rb_only_trs_show"
                android:background="@drawable/select_check_box"
                android:layout_width="@dimen/dp_88"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_7"
                android:button="@null"
                android:text="@string/jacket_m_translate_show"
                android:maxLines="2"
                style="@style/MyCheckBox"/>
            <RadioButton
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ff000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/rb_only_show"
                android:background="@drawable/select_check_box"
                android:layout_width="@dimen/dp_88"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_7"
                android:button="@null"
                android:text="@string/jacket_m_original"
                android:maxLines="2"
                style="@style/MyCheckBox"/>
        </RadioGroup>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_translate_ok"
        android:background="@drawable/shape_ff7300_r999"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/btn_confirm"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_translate_cancel"
        app:layout_constraintTop_toBottomOf="@+id/show_trans_lan"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_translate_cancel"
        android:background="@drawable/shape_e3e3e3_r999"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/btn_cancel"
        android:drawablePadding="@dimen/dp_4"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_translate_ok"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/show_trans_lan"/>
</androidx.constraintlayout.widget.ConstraintLayout>
