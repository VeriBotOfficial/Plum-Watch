<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/setting_shezhi"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llSafe"
        android:background="@color/white"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_safe"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:id="@+id/tvSafe"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/setting_zhanghaoyuanquan"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:id="@+id/line1"
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llUnit"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_unit"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:id="@+id/tvUnit"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/setting_danwei"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <TextView
            android:id="@+id/tvSetUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:id="@+id/line2"
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llTemperature"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_temperature"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:id="@+id/tvTemperature"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/tip_21_0308_01"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <TextView
            android:id="@+id/tvSetTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llPrivacy"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_privacy"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:id="@+id/tvPrivacy"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/setting_yingsi"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llProtocol"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_protocol"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/setting_xieyiyutiaokuan"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llClean"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_clean"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:id="@+id/tvClean"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/setting_qinglihuancun"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <ImageView
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_jiantou_right"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llRoam"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_setting_roam"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textBlack"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/mine_roam"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"/>
        <Switch
            android:id="@+id/switch_roam"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/device_notify_switch_thumb"
            android:track="@drawable/device_notify_switch_track"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</LinearLayout>
