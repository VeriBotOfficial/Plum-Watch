<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baidu.mapapi.map.TextureMapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/gray_bg"
        android:background="@color/color_f6f6f6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/route_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:elevation="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:cardCornerRadius="@dimen/dp_12"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:padding="14dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back_black"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/start_end_layout"
                android:background="@drawable/shape_f6f6f6_r12"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_90"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintBottom_toTopOf="@+id/tabLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/back"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/route_start_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_map_outset"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_route_start"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_route_start"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/route_end_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_map_destination"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/et_route_end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/et_route_end"/>
                <View
                    android:background="@drawable/shape_dash_line"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layerType="software"
                    app:layout_constraintBottom_toTopOf="@+id/route_end_point"
                    app:layout_constraintEnd_toEndOf="@+id/route_start_point"
                    app:layout_constraintStart_toStartOf="@+id/route_start_point"
                    app:layout_constraintTop_toBottomOf="@+id/route_start_point"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_4D4D4D"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_route_start"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_0"
                    android:text="@string/navi_my_location"
                    android:maxLines="1"
                    android:lines="1"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_20"
                    app:layout_constraintBottom_toTopOf="@+id/et_route_end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/route_start_point"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_weight="1"/>
                <View
                    android:background="@color/color_e6e6e6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_0_5"
                    app:layout_constraintEnd_toEndOf="@+id/tv_route_start"
                    app:layout_constraintStart_toStartOf="@+id/tv_route_start"
                    app:layout_constraintTop_toBottomOf="@+id/tv_route_start"/>
                <EditText
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_4D4D4D"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/et_route_end"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_0"
                    android:hint="@string/navi_enter_end_point"
                    android:maxLines="1"
                    android:lines="1"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/route_end_point"
                    app:layout_constraintTop_toBottomOf="@+id/tv_route_start"
                    app:layout_constraintVertical_weight="1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.flyco.tablayout.CommonTabLayout
                android:orientation="horizontal"
                android:id="@+id/tabLayout"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/start_end_layout"
                app:layout_constraintStart_toStartOf="@+id/start_end_layout"
                app:layout_constraintTop_toBottomOf="@+id/start_end_layout"
                app:tl_iconGravity="LEFT"
                app:tl_iconHeight="@dimen/dp_25"
                app:tl_iconWidth="@dimen/dp_25"
                app:tl_indicator_color="@color/color_ff7300"
                app:tl_indicator_corner_radius="@dimen/dp_15"
                app:tl_indicator_height="@dimen/dp_30"
                app:tl_indicator_margin_top="@dimen/dp_5"
                app:tl_indicator_style="BLOCK"
                app:tl_textSelectColor="@color/white"
                app:tl_textUnselectColor="@color/color_4D4D4D"
                app:tl_textsize="12dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/start_navi_layout"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/route_list_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_112"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/start_navi"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/route_tab_layout_1"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/layout_route_detail_item"/>
            <include
                android:id="@+id/route_tab_layout_2"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/layout_route_detail_item"/>
            <include
                android:id="@+id/route_tab_layout_3"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/layout_route_detail_item"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start_navi"
            android:background="@drawable/select_btn_ff7300_r6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_25"
            android:layout_marginBottom="@dimen/dp_25"
            android:text="@string/navi_start"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/route_list_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/recyclerView_layout"
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:layout_marginVertical="@dimen/dp_16"
        app:cardCornerRadius="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/route_layout">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:background="@drawable/shape_white_r12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/route_layout"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
