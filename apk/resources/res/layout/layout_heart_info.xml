                android:id="@+id/tv_normal_hr_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
        </LinearLayout>
        <View
            android:background="@color/bg"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_6A6A6A"
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_22_0104_14"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_6A6A6A"
                android:gravity="center_vertical"
                android:id="@+id/tv_hr_fast_low"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_333333"
                android:gravity="center_vertical"
                android:id="@+id/tv_hr_fast_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
        </LinearLayout>
        <View
            android:background="@color/bg"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_6A6A6A"
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/tip_22_0104_15"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_6A6A6A"
                android:gravity="center_vertical"
                android:id="@+id/tv_hr_slow_low"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_333333"
                android:gravity="center_vertical"
                android:id="@+id/tv_hr_slow_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_8"/>
        </LinearLayout>
        <View
            android:background="@color/bg"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
