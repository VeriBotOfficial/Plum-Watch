<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menuTextColor="@color/color_333333"
        app:titleText="@string/sport_set"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_key_define"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_watermaker"
            android:background="@drawable/ic_watermaker"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_watermaker"
            app:layout_constraintEnd_toStartOf="@+id/tv_watermaker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_watermaker"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tv_watermaker"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/glasses_water_set"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@+id/swtich_watermark"
            app:layout_constraintStart_toEndOf="@+id/iv_watermaker"
            app:layout_constraintTop_toTopOf="parent"/>
        <Switch
            android:id="@+id/swtich_watermark"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/device_notify_switch_thumb"
            android:track="@drawable/device_notify_switch_track"
            app:layout_constraintBottom_toBottomOf="@+id/tv_watermaker"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_watermaker"/>
        <View
            android:background="@color/color_f1f1f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_watermaker"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tv_logo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_watermaker"/>
        <CheckBox
            android:id="@+id/rb_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@drawable/checkbox_style_new_ui"
            app:layout_constraintBottom_toBottomOf="@+id/tv_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_logo"/>
        <View
            android:background="@color/color_f1f1f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_logo"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/qinyou_shijian_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_logo"/>
        <CheckBox
            android:id="@+id/rb_time"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@drawable/checkbox_style_new_ui"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_time"/>
        <View
            android:background="@color/color_f1f1f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tv_custom"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/qinyou_zidingyi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/color_666666"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_custom_content"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/rb_custom"
            app:layout_constraintStart_toEndOf="@+id/tv_custom"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <CheckBox
            android:id="@+id/rb_custom"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@drawable/checkbox_style_new_ui"
            app:layout_constraintBottom_toBottomOf="@+id/tv_custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_custom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_media"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_media"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/glasses_s_multi_media"
            android:layout_marginStart="8dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrowgrey_right"
            android:layout_marginEnd="8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/ll_auto_store"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_g_setting_auto_store"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="14dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_auto_save"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/glasses_auto_save_tip"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <Switch
            android:id="@+id/switch_auto_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/device_notify_switch_thumb"
            android:track="@drawable/device_notify_switch_track"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
