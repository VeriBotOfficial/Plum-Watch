<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:menuImage="@drawable/card_delete"
        app:titleText="详情"/>
    <ImageView
        android:id="@+id/iv_card"
        android:background="@drawable/ic_card_color1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17.5dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="18dp"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginTop="46.5dp"
        android:text="门卡1"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17.5dp"
        android:layout_marginTop="35dp"
        android:layout_marginRight="18dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_card">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/color_ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卡片名称"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_FF666666"
            android:id="@+id/tv_card_name_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="17.5dp"
            android:text="门卡1"
            app:layout_constraintRight_toLeftOf="@+id/iv_jt"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_jt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_jiantou_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17.5dp"
        android:layout_marginTop="21dp"
        android:layout_marginRight="18dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_1">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/color_ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="封面颜色"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_bg_small"
            android:layout_width="61dp"
            android:layout_height="29.8dp"
            android:layout_marginRight="17.5dp"
            android:src="@drawable/ic_card_color1"
            app:layout_constraintRight_toLeftOf="@+id/iv_jt2"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_jt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_jiantou_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textColor="@color/white"
        android:id="@+id/bt_synchronization"
        android:background="@drawable/shape_00bbff_r13"
        android:layout_width="155.5dp"
        android:layout_height="43dp"
        android:layout_marginTop="128.5dp"
        android:layout_marginBottom="49dp"
        android:text="写入穿戴设备"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
