<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_last"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_666666"
                android:gravity="center"
                android:id="@+id/tvDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_right"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_jiantou"
                android:rotation="180"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/textBlack"
                android:id="@+id/tv_metmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/textBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MET-min"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date"
            android:background="@color/white"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_heart_arrow_down"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.wakeup.commonui.chart.IndicatorBarChart
            android:id="@+id/mNormalBarChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout
        android:background="@drawable/shape_white_r12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginHorizontal="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_6">
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/color_999999"
                android:id="@+id/tv_tip1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/dp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MET-min"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_6">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_999999"
                    android:id="@+id/tv_tip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/met_edit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_active_time_edit"
                    android:layout_marginStart="@dimen/dp_5"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/dp_24"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tv_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/textBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="MET-min"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
