<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:background="@color/color_f8f8f8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_f3f3f3_r10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <RelativeLayout
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/mFrameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5.5dp"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMap"
                    android:background="@drawable/shape_top_f3f3f3_r10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shapeAppearanceOverlay="@style/chamferTop12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llData"
                    android:background="@drawable/shape_white_r12"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="90dp"
                    android:layout_marginRight="5dp"
                    android:layout_alignParentBottom="true"
                    android:elevation="2dp">
                    <LinearLayout
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingLeft="24dp"
                        android:paddingTop="20dp"
                        android:paddingRight="24dp"
                        android:paddingBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivAvatar"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingRight="12dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/textGray"
                                    android:ellipsize="end"
                                    android:id="@+id/tvName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textColor="@color/textGray"
                                    android:id="@+id/tvTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="10dp">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivLocation"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/icon_share_location"
                                app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingRight="12dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="12sp"
                                    android:textColor="@color/textGray"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical"
                                    android:id="@+id/tvLocation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/mRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="20dp"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.5dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/ic_logo_small"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_999999"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Wearfit"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
