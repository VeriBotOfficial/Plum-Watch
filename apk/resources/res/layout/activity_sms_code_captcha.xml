<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@mipmap/ic_logo_small"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginHorizontal="16dp">
        <EditText
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etPhone"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:singleLine="true"
            android:inputType="phone"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etImageCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/tip_21_0901_01"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"/>
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="100dp"
            android:layout_height="43dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/textBlack"
            android:textColorHint="@color/textGray"
            android:id="@+id/etCode"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/login_hint_code"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_F96623"
            android:id="@+id/tvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registered_fasongyanzhengma"/>
    </LinearLayout>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <Button
        android:enabled="false"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/btnNext"
        android:background="@drawable/bg_btn_login_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp_44"
        android:text="@string/registered_xiayibu"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
