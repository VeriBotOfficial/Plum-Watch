<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/string_schedule_reminder"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/add_schedule"
        app:layout_constraintTop_toBottomOf="@+id/mTopBar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:textColorHint="@color/color_666666"
                android:gravity="center_vertical"
                android:id="@+id/schedule_title"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/schedule_reminder_hint_title"
                android:maxLength="16"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/schedule_time_layout"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/start_time_layout"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_100"
                    app:layout_constraintEnd_toStartOf="@+id/end_time_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_666666"
                        android:id="@+id/start_time_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10月21日 周五"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp_20"
                        android:textColor="@color/color_333333"
                        android:id="@+id/start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="15:00"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/start_time_date"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/end_time_layout"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_100"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/start_time_layout"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_666666"
                        android:id="@+id/end_time_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10月21日 周五"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp_20"
                        android:textColor="@color/color_333333"
                        android:id="@+id/end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="15:00"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/end_time_date"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/schedule_day_full_layout"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/end_time_layout">
                    <View
                        android:id="@+id/line"
                        android:background="@color/color_e6e6e6"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_0_5"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/color_333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_day"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line"/>
                    <Switch
                        android:id="@+id/broadcast_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/device_notify_switch_thumb"
                        android:track="@drawable/device_notify_switch_track"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/reminder_layout"
                android:background="@drawable/shape_white_r12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_333333"
                    android:id="@+id/reminder_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_right_small"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/reminder_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="开始前15分钟提醒我"
                    android:lines="1"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_7"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/right"
                    app:layout_constraintStart_toEndOf="@+id/reminder_title"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <EditText
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:textColorHint="@color/color_666666"
                android:gravity="start"
                android:id="@+id/detail_content"
                android:background="@drawable/shape_white_r12"
                android:paddingTop="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_150"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/add_detail_hint"
                android:maxLength="32"
                android:paddingStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_12"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/add_schedule"
        android:background="@drawable/shape_ff7300_r6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/add_schedule"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
