<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_search_top"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_12">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="@dimen/dp_6"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/ic_back_black"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_search_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_4"
            android:paddingHorizontal="@dimen/dp_12">
            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_search_gray"/>
            <EditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_333333"
                android:textColorHint="@color/color_999999"
                android:id="@+id/et_search"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/dial_search_hint"
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="@dimen/dp_8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/color_ec7445"
            android:gravity="center"
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:text="@string/dial_search_btn"
            android:paddingStart="@dimen/dp_12"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_search_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_hot_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/dial_hot_search_title"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/fl_hot_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:alignItems="center"
                app:flexWrap="wrap"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_history_header"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_search_history_title"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_delete_history"
                    android:padding="@dimen/dp_2"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_delete_history"/>
            </LinearLayout>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/fl_history_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:alignItems="center"
                app:flexWrap="wrap"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/fl_search_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_result"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp_6"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_999999"
            android:gravity="center"
            android:id="@+id/tv_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dial_search_no_result"/>
    </FrameLayout>
</LinearLayout>
