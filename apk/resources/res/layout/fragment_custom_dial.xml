<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/card_banner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:cardCornerRadius="@dimen/dp_12">
            <com.youth.banner.Banner
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_135"
                app:indicator_drawable_selected="@drawable/shape_indicator_selected"
                app:indicator_drawable_unselected="@drawable/shape_indicator_unselected"/>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_diy"
            android:background="@drawable/shape_e3dbff_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="22dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_diy"
                android:background="@drawable/ic_custom_diy_bg"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_diy_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DIY表盘"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_diy"
                app:layout_constraintTop_toTopOf="@+id/iv_diy"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_diy_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="支持上传图片自定义表盘，时间、日期等元素可自由拖动，轻松打造个性化设计"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_diy"
                app:layout_constraintTop_toBottomOf="@+id/tv_diy_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_album"
            android:background="@drawable/shape_ffe9db_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="22dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_album"
                android:background="@drawable/img_album_zh"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_album_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_new_album_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_album"
                app:layout_constraintTop_toTopOf="@+id/iv_album"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_album_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dial_new_album_desc"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_album"
                app:layout_constraintTop_toBottomOf="@+id/tv_album_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_module"
            android:background="@drawable/shape_e3f9ff_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_module"
                android:background="@drawable/img_module_zh"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_module_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_new_module_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_module"
                app:layout_constraintTop_toTopOf="@+id/iv_module"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_module_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dial_new_module_desc"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_module"
                app:layout_constraintTop_toBottomOf="@+id/tv_module_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_video"
            android:background="@drawable/shape_f3e8ff_r12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_video"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="@dimen/dp_6"
                app:cardElevation="@dimen/dp_0"
                app:cardMaxElevation="@dimen/dp_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <SurfaceView
                    android:layout_gravity="center"
                    android:id="@+id/iv_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_video_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_new_video_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/cardView_video"
                app:layout_constraintTop_toTopOf="@+id/cardView_video"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_video_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dial_new_video_desc"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardView_video"
                app:layout_constraintTop_toBottomOf="@+id/tv_video_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_puzzle"
            android:background="@drawable/shape_fff99c_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_puzzle"
                android:background="@drawable/img_puzzle"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_puzzle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_new_puzzle_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_puzzle"
                app:layout_constraintTop_toTopOf="@+id/iv_puzzle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_puzzle_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dial_new_puzzle_desc"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_puzzle"
                app:layout_constraintTop_toBottomOf="@+id/tv_puzzle_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_menu"
            android:background="@drawable/shape_ffde88_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_menu"
                android:background="@drawable/img_menu_zh"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/menu_wallpaper_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_menu"
                app:layout_constraintTop_toTopOf="@+id/iv_menu"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_menu_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/menu_wallpaper_info"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_menu"
                app:layout_constraintTop_toBottomOf="@+id/tv_menu_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_personal_ring"
            android:background="@drawable/shape_ffd6d8_r12"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_personal_ring"
                android:background="@drawable/ic_custom_ring_bg"
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundImageStyle_6"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_personal_ring_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/make_personal_ring"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/iv_personal_ring"
                app:layout_constraintTop_toTopOf="@+id/iv_personal_ring"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_personal_ring_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/personal_ring_desc"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_personal_ring"
                app:layout_constraintTop_toBottomOf="@+id/tv_personal_ring_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
