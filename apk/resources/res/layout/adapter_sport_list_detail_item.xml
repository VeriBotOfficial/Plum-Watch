<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_white_r12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_78">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sport_type_iv"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_42"
        android:src="@drawable/ic_bg_sport_type_n_2"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/sport_type_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sport_type_iv"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_999999"
            android:id="@+id/sport_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7月11日 16:12"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_3"
            android:layout_toStartOf="@+id/sport_start_time"
            app:layout_constraintEnd_toStartOf="@+id/sport_start_time"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sport_device_type_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_type_device"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintStart_toEndOf="@+id/sport_type_tv"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sport_device_repeated_iv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_repeated"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintStart_toEndOf="@+id/sport_device_type_iv"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sport_device_unusually_iv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_abnormal"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintEnd_toStartOf="@+id/sport_start_time"
                app:layout_constraintStart_toEndOf="@+id/sport_device_repeated_iv"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:ellipsize="marquee"
            android:id="@+id/sport_type_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="户外跑步"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_toStartOf="@+id/icon_layout"
            android:layout_alignParentStart="true"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_20"
        android:textColor="@color/color_333333"
        android:id="@+id/sport_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:text="1.91"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/sport_type_iv"
        app:layout_constraintTop_toBottomOf="@+id/sport_type_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/sport_distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:layout_marginBottom="@dimen/dp_3"
        android:text="@string/sport_gongli"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/sport_distance"
        app:layout_constraintStart_toEndOf="@+id/sport_distance"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/sport_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="00:00:23"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/sport_distance_unit"
        app:layout_constraintTop_toBottomOf="@+id/sport_type_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_333333"
        android:id="@+id/sport_pace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="12′49″公里/小时"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/sport_duration"
        app:layout_constraintTop_toBottomOf="@+id/sport_type_layout"/>
    <View
        android:id="@+id/line"
        android:background="@color/color_e6e6e6"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/sport_type_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
