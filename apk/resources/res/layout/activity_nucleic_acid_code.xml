<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/nucleic_back_img"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wakeup.commonui.MyTitleBar
        android:id="@+id/mTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/nucleic_22_0908_00"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_white_r12"
        android:padding="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_24"
        android:layout_below="@+id/mTopBar">
        <RelativeLayout
            android:id="@+id/rl_image"
            android:background="@drawable/shape_white_r12_line"
            android:padding="10dp"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_margin="20dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_add_qr_nucleic"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/iv_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/textGray"
            android:id="@+id/tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nucleic_22_0908_03"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/textGray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nucleic_22_0908_01"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/textGray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/nucleic_22_0908_04"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/textGray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nucleic_22_0908_02"/>
        <View
            android:background="@color/color_e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_margin="@dimen/dp_10"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/textGray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nucleic_22_0908_05"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:id="@+id/tv_click_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nucleic_22_0908_06"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="18sp"
        android:textColor="@color/color_4AD2AC"
        android:gravity="center"
        android:id="@+id/btn_next"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="50dp"
        android:text="@string/nucleic_22_0908_07"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
