<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_94"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/bg_card"
        android:layout_width="@dimen/dp_94"
        android:layout_height="@dimen/dp_94"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0"
        app:cardMaxElevation="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bg_iv"
            android:layout_width="@dimen/dp_94"
            android:layout_height="@dimen/dp_94"
            android:src="@drawable/ic_course_hot_default"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="全身爆汗燃脂"
        android:lines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_card"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/color_999999"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="13分钟 · L1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/freeIv"
        android:background="@drawable/ic_train_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/freeTv"
        app:layout_constraintEnd_toEndOf="@+id/freeTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/color_AF6800"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/freeTv"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_55"
        android:text="vip"
        android:lines="1"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
