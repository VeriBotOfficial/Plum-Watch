<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_r14"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/run_current"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/content_unit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/unit_gongli"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/dp_16"
            android:textColor="@color/color_333333"
            android:textColorHint="@color/color_999999"
            android:gravity="center_vertical"
            android:id="@+id/content_edt"
            android:background="@null"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_22"
            android:hint="@string/enter_km"
            app:layout_constraintEnd_toStartOf="@+id/content_unit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <View
            android:background="#f1f1f1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="@+id/content_edt"
            app:layout_constraintStart_toStartOf="@+id/content_edt"
            app:layout_constraintTop_toBottomOf="@+id/content_edt"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/color_666666"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/motion_calibartion_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_edt"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintTop_toBottomOf="@+id/desc">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/color_333333"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/shape_e3e3e3_r6"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:text="@string/btn_cancel"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_7"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/sure"
                android:background="@drawable/select_btn_ff7300_r6"
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:text="@string/confirm_modification"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_7"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
