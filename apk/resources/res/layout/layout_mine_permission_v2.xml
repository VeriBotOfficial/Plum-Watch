<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_ff000000"
        android:id="@+id/my_other_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_mine_permission"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_sport_permission"
            android:background="@drawable/shape_white_r12"
            android:padding="@dimen/dp_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_6">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_sport_permission"
                android:background="@drawable/bg_mine_v2_icon_blue"
                android:padding="9dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_mine_sport_permission"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/mine_v2_icon_blue"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:id="@+id/iv_sport_permission_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/sport_mine_permission_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_sport_permission"/>
            <TextView
                android:textSize="@dimen/dp_11"
                android:textColor="@color/color_999999"
                android:id="@+id/iv_sport_permission_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sport_mine_permission_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_sport_permission_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_windows_permission"
            android:background="@drawable/shape_white_r12"
            android:padding="@dimen/dp_12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_6">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_windows_permission"
                android:background="@drawable/bg_mine_v2_icon_orange"
                android:padding="9dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_windows_permission"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/mine_v2_icon_orange"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/switch_windows"
                android:background="@drawable/ic_windows_permission_close"
                android:layout_width="50dp"
                android:layout_height="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/color_ff000000"
                android:ellipsize="end"
                android:id="@+id/iv_windows_permission_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/glasses2_windows_permission_title"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_windows_permission"/>
            <TextView
                android:textSize="@dimen/dp_11"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:id="@+id/iv_windows_permission_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/glasses2_windows_permission_desc"
                android:maxLines="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_windows_permission_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
