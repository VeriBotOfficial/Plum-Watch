<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_select"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <ImageView
                    android:id="@+id/iv_last"
                    android:padding="10dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_turn_left"
                    android:layout_marginEnd="@dimen/dp_6"/>
                <TextView
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_333333"
                    android:gravity="center"
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/iv_right"
                    android:padding="10dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_turn_right"
                    android:layout_marginStart="@dimen/dp_6"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_333333"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_3"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_select_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30">
                <LinearLayout
                    android:id="@+id/ll_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ll_nap_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_666666"
                        android:id="@+id/tv_night_sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/night_sleep"/>
                    <TextView
                        android:textSize="@dimen/dp_22"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack"
                        android:id="@+id/tv_selectHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack"
                        android:id="@+id/tv1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hour"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="@dimen/dp_22"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack"
                        android:id="@+id/tv_selectMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack"
                        android:id="@+id/tv2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/min"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_nap_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    app:layout_constraintBottom_toBottomOf="@+id/ll_duration"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ll_duration"
                    app:layout_constraintTop_toTopOf="@+id/ll_duration">
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_nap"/>
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textStyle="bold"
                        android:textColor="@color/color_333333"
                        android:id="@+id/tv_nap_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_date"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_666666"
                            android:id="@+id/tv_total_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_strength_total_duration"
                            app:layout_constraintBottom_toBottomOf="@+id/sleep_w_hour_desc"
                            app:layout_constraintEnd_toStartOf="@+id/sleep_w_hour"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/sleep_w_hour_desc"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_26"
                            android:textStyle="bold"
                            android:textColor="@color/textBlack"
                            android:id="@+id/sleep_w_hour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            app:layout_constraintEnd_toStartOf="@+id/sleep_w_hour_desc"
                            app:layout_constraintStart_toEndOf="@+id/tv_total_duration"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/textBlack"
                            android:id="@+id/sleep_w_hour_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hour"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/sleep_w_hour"
                            app:layout_constraintEnd_toStartOf="@+id/sleep_w_min"
                            app:layout_constraintStart_toEndOf="@+id/sleep_w_hour"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dp_26"
                            android:textStyle="bold"
                            android:textColor="@color/textBlack"
                            android:id="@+id/sleep_w_min"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toStartOf="@+id/sleep_w_min_desc"
                            app:layout_constraintStart_toEndOf="@+id/sleep_w_hour_desc"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/textBlack"
                            android:id="@+id/sleep_w_min_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/min"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/sleep_w_min"
                            app:layout_constraintStart_toEndOf="@+id/sleep_w_min"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:layout_gravity="center"
                        android:id="@+id/tv_sleep_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_4"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/sleep_color_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_30"
                android:layout_marginEnd="@dimen/dp_30">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:background="@color/color_sleep_wake"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_10"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_10"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wake"
                        android:layout_marginStart="@dimen/dp_3"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_rem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:background="@color/color_sleep_rem"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_10"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_10"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/string_rem"
                        android:layout_marginStart="@dimen/dp_3"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:background="@color/color_sleep_shallow"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_10"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_10"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_sleep"
                        android:layout_marginStart="@dimen/dp_3"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:background="@color/color_sleep_deep"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_10"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_10"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deep_sleep"
                        android:layout_marginStart="@dimen/dp_3"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_nap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:background="@color/mine_bg_yellow"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_10"
                        app:shapeAppearanceOverlay="@style/circleImageStyle"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_10"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_nap"
                        android:layout_marginStart="@dimen/dp_3"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center_horizontal"
                android:id="@+id/card_day"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_9B54FF"
                    android:id="@+id/sleep_desc"
                    android:background="@color/color_ECE2FF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_4"/>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18">
                <com.wakeup.commonui.chart.IndicatorBarChart
                    android:id="@+id/mSleepBarNormalChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"/>
                <com.wakeup.commonui.chart.lenovo.LenovoSleepChart
                    android:id="@+id/mSleepBarDayChart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_15"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/no_data"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_tip6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/sleep_distribution_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="夜间睡眠分布"
        android:layout_marginStart="@dimen/dp_22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sleep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="@dimen/dp_12"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/sleep_detail_layout"
        android:background="@drawable/shape_white_r12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_12">
        <include
            android:id="@+id/sleep_detail_list"
            android:visibility="visible"
            layout="@layout/lenovo_layout_sleep_detail_list"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
