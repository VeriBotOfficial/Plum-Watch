<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/color_33fa7d22"/>
            <size
                android:height="10dp"
                android:width="10dp"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/color_fa7d22"/>
            <size
                android:height="4dp"
                android:width="4dp"/>
        </shape>
    </item>
</layer-list>
