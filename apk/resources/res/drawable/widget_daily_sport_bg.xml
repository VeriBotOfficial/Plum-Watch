<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/widget_corner_radius_large"/>
            <gradient
                android:startColor="#ffb45a"
                android:endColor="#3a0e27"
                android:angle="315"
                android:type="linear"
                android:centerColor="#ff6a2c"/>
        </shape>
    </item>
    <item
        android:gravity="end|bottom"
        android:height="140dp"
        android:width="140dp"
        android:right="-30dp"
        android:bottom="-30dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#80ff3d7f"
                android:endColor="#00ff3d7f"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="70dp"/>
        </shape>
    </item>
    <item
        android:gravity="start|top"
        android:height="44dp"
        android:width="40dp"
        android:drawable="@drawable/widget_bg_foot_small"
        android:left="14dp"
        android:top="32dp"/>
    <item
        android:gravity="end|bottom"
        android:height="66dp"
        android:width="60dp"
        android:drawable="@drawable/widget_bg_foot_big"
        android:right="8dp"
        android:bottom="12dp"/>
</layer-list>
