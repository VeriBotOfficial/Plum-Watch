<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/gradient_layer"
        android:top="@dimen/dp_18">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0">
            <shape>
                <gradient
                    android:startColor="#66ffa36e"
                    android:endColor="#66ffddc9"
                    android:angle="0"/>
            </shape>
        </rotate>
    </item>
</layer-list>
