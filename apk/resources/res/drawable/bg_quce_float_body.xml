<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#22fbbf24"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#22f49400"/>
            <stroke
                android:width="2dp"
                android:color="#fbbf24"/>
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#fb923c"
                android:endColor="#7c2d12"
                android:angle="315"
                android:type="linear"
                android:centerColor="#ea580c"/>
        </shape>
    </item>
</layer-list>
