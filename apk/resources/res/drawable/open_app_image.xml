<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@mipmap/image_launcher_bg"/>
    </item>
    <item android:top="@dimen/dp_200">
        <bitmap
            android:gravity="top"
            android:src="@mipmap/ic_logo_small"/>
    </item>
    <item android:top="@dimen/dp_24">
        <bitmap
            android:gravity="center_horizontal"
            android:src="@mipmap/launcher_slogan"/>
    </item>
    <item android:bottom="@dimen/dp_94">
        <bitmap
            android:gravity="bottom"
            android:src="@mipmap/image_launcher_bottom_current"/>
    </item>
</layer-list>
