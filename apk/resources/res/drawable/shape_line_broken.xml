<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="-0.8dp"
        android:right="-0.5dp"
        android:bottom="-0.5dp">
        <shape>
            <solid android:color="@color/transp"/>
