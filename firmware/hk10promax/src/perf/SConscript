from building import *
import rtconfig

# get current dir path
cwd = GetCurrentDir()

# init src and inc vars
src = []
inc = []

# add LittlevGL common include
# Physical SF32LB525 peripherals are not part of the Windows PC simulator.
if not GetDepend('BSP_USING_PC_SIMULATOR'):
    src = src + Glob('*.c')

LOCAL_CCFLAGS = ''

group = DefineGroup('PERF', src, depend = [''], CPPPATH = inc, LOCAL_CCFLAGS = LOCAL_CCFLAGS)

Return('group')
