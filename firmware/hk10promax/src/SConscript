from building import *
import rtconfig
import os

src = []
inc = []
cwd = GetCurrentDir() # get current dir path

if GetDepend('BSP_USING_PC_SIMULATOR'):
    # Use a simulator entry point without physical LCD, GPIO, button or vibration drivers.
    src += [f for f in Glob('*.c') if os.path.basename(str(f)) not in ('watch_app.c', 'watch_app_pc.c')]
    src += ['watch_app_pc.c']
else:
    # The PC simulator entry point depends on Win32 and must never enter the GCC watch build.
    src += [f for f in Glob('*.c') if os.path.basename(str(f)) != 'watch_app_pc.c']
inc+= [cwd]

#Add resources.
# Ensure directory is created before any builder is executed
# If the path is not present, it would not be added in "include path" and 'lang_pack.h' dependency would not work
Execute(Mkdir('resource/strings'))
src.extend(SConscript(os.path.join(cwd, 'resource/images/SConscript'), variant_dir="resource/images", duplicate=0))
src.extend(SConscript(os.path.join(cwd, 'resource/fonts/SConscript'), variant_dir="resource/fonts", duplicate=0))
src.extend(SConscript(os.path.join(cwd, 'resource/strings/SConscript'), variant_dir="resource/strings", duplicate=0))

#Add GUI applications
app_objs = SConscript(os.path.join(cwd, 'gui_apps/SConscript'), variant_dir="gui_apps", duplicate=0)

src.extend(app_objs)

# Add applications utils.
# The PC simulator supplies its own startup and has no physical flash device.
# Do not compile the firmware-only startup or flash filesystem there: those
# sources include SoC flash/IO driver headers that are intentionally absent
# from the pc_hcpu board. Keep them in the hardware firmware build.
if not GetDepend('BSP_USING_PC_SIMULATOR'):
    src.extend(SConscript(os.path.join(cwd, 'main/SConscript'), variant_dir="app_utils", duplicate=0))
    src.extend(SConscript(os.path.join(cwd, 'fs/SConscript'), variant_dir="fs", duplicate=0))

src.extend(SConscript(os.path.join(cwd, 'flashdb/SConscript'), variant_dir="flashdb", duplicate=0))
src.extend(SConscript(os.path.join(cwd, 'perf/SConscript'), variant_dir="perf", duplicate=0))
src.extend(SConscript(os.path.join(cwd, 'utils/SConscript'), variant_dir="utils", duplicate=0))

group = DefineGroup('app', src, depend = ['PKG_USING_LITTLEVGL2RTT'], CPPPATH = inc)
Return('group')
