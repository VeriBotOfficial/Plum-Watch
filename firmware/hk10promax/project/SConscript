import os
from building import *

cwd = GetCurrentDir()
objs = []
list = os.listdir(cwd)

# Add SDK
Import('SIFLI_SDK')

# The SiFli v2.4 RT-Thread watchdog and motor headers use uint32_t/uint8_t
# without including <stdint.h>. MSVC does not get these typedefs indirectly.
# Force-include the standard header for the PC simulator only; leave the
# physical watch firmware toolchain and its include order unchanged.
if GetBoardName() == 'pc_hcpu':
    GetCurrentEnv().AppendUnique(CCFLAGS=['/FIstdint.h'])

objs.extend(SConscript(os.path.join(SIFLI_SDK, 'SConscript'), variant_dir="sifli_sdk", duplicate=0))

# Add application source code
# workaround: src folder must be created before resource/strings folder is used, otherwise langpack would not be built
Execute(Mkdir('src'))
objs.extend(SConscript(cwd+'/../src/SConscript', variant_dir="src", duplicate=0))

Return('objs')
